@inject EquipamentoRepository Repo
@inject FrameRepository Frames
@inject LimiteMotorRepository Limites
@inject ItemModeloRepository Itens

<p class="subtitle">
    Os equipamentos e a relação <strong>ventilador × cubo</strong>. VAX e Joy ficam na
    <strong>mesma lista</strong>: cada linha diz na coluna <em>Série</em> de qual linha de
    produto ela é. O número de cada célula é a rotação máxima (V-Belt) daquela combinação.
</p>

<!-- ---------- verificador ---------- -->
<div class="panel" style="margin-bottom:16px">
    <div class="toolbar" style="margin-bottom:0; flex-wrap:wrap">
        <strong>Verificar combinação</strong>

        <label style="display:flex; align-items:center; gap:6px">
            <span class="subtitle" style="margin:0">Ventilador</span>
            <select class="cell" @bind="_vVentilador" @bind:after="TrocarVentilador">
                @foreach (var g in _diametros.GroupBy(i => i.Serie))
                {
                    <optgroup label="@g.Key">
                        @foreach (var d in g)
                        {
                            <option value="@d.Id">@d.Rotulo</option>
                        }
                    </optgroup>
                }
            </select>
        </label>

        <label style="display:flex; align-items:center; gap:6px">
            <span class="subtitle" style="margin:0">Cubo</span>
            <select class="cell" @bind="_vCubo" @bind:after="Verificar">
                @foreach (var c in CubosDaSerieVerificada)
                {
                    <option value="@c.Id">@c.Rotulo</option>
                }
            </select>
            <span class="subtitle" style="margin:0">da série @SerieVerificada</span>
        </label>

        <label style="display:flex; align-items:center; gap:6px">
            <span class="subtitle" style="margin:0">Rotação</span>
            <input class="cell" style="width:105px" type="number" min="0"
                   @bind="_vRpm" @bind:event="oninput" @bind:after="Verificar" />
            <span class="subtitle" style="margin:0">rpm</span>
        </label>

        <label style="display:flex; align-items:center; gap:6px">
            <span class="subtitle" style="margin:0">Motor</span>
            <select class="cell" @bind="_vPadrao" @bind:after="TrocarPadrao">
                @foreach (var p in FrameRepository.Padroes)
                {
                    <option value="@p">@p</option>
                }
            </select>
            <select class="cell" @bind="_vFrame" @bind:after="Verificar">
                <option value="">—</option>
                @foreach (var f in FramesDoPadrao)
                {
                    <option value="@f.Nome">@f.Nome</option>
                }
            </select>
        </label>
    </div>

    @if (_rotacao is not null)
    {
        <div class="@EstiloRotacao(_rotacao.Situacao)" style="margin-top:14px">
            @IconeRotacao(_rotacao.Situacao) @_rotacao.Mensagem
        </div>
    }
    @if (_motor is not null)
    {
        <div class="@EstiloMotor(_motor.Situacao)" style="margin-top:10px">
            @IconeMotor(_motor.Situacao) @_motor.Mensagem
        </div>
    }
</div>

<!-- ---------- incluir ventilador / cubo ---------- -->
<div class="toolbar" style="flex-wrap:wrap; gap:18px">
    @foreach (var tipo in new[] { ItemModelo.TipoVentilador, ItemModelo.TipoCubo })
    {
        var t = tipo;
        var ventilador = t == ItemModelo.TipoVentilador;

        <div class="toolbar" style="margin:0; flex-wrap:nowrap">
            <strong>@(ventilador ? "Fan Diameter" : "Fan Hub Diameter")</strong>
            <span class="val-count">@(ventilador ? _diametros.Count : _cubos.Count)</span>
            <select class="cell" style="max-width:88px"
                    value="@(ventilador ? _novaSerieVentilador : _novaSerieCubo)"
                    @onchange="e => GuardarNovaSerie(t, e.Value?.ToString() ?? string.Empty)">
                @foreach (var x in _series)
                {
                    <option value="@x" selected="@(x == (ventilador ? _novaSerieVentilador : _novaSerieCubo))">@x</option>
                }
            </select>
            <input class="cell" style="width:130px" placeholder="@(ventilador ? "novo ventilador" : "novo cubo")"
                   value="@(ventilador ? _novoVentilador : _novoCubo)"
                   @onchange="e => GuardarNovo(t, e.Value?.ToString() ?? string.Empty)" />
            <button class="btn-primary" @onclick="() => IncluirRotulo(t)"
                    disabled="@((ventilador ? _novoVentilador : _novoCubo).Trim().Length == 0)">
                + Incluir
            </button>
            @Limpeza(ventilador ? AlvoVentiladores : AlvoCubos)
        </div>
    }
</div>

<!-- ---------- a matriz ---------- -->
<div class="toolbar" style="flex-wrap:wrap">
    <span class="subtitle" style="margin:0">
        @_todos.Count combinação(ões) · @_diametros.Count ventilador(es) · @_cubos.Count cubo(s)
    </span>
    @Limpeza(AlvoCombinacoes)
    <span style="flex:1"></span>
    @if (_msg is not null)
    {
        <span class="saved-flag">@_msg</span>
    }
</div>

@if (_diametros.Count == 0 && _cubos.Count == 0)
{
    <div class="panel">
        <p class="subtitle" style="margin:0">
            A tabela está vazia. Cadastre um <strong>Fan Diameter</strong> e um
            <strong>Fan Hub Diameter</strong> na barra acima — ou suba a sua planilha pelo
            <em>Importar Excel</em> — e a matriz aparece aqui.
        </p>
    </div>
}
else
{
<div class="panel" style="padding:0; overflow-x:auto">
    <table class="grid">
        <thead>
            <tr>
                <th class="nowrap" rowspan="3" style="min-width:280px">Fan Diameter</th>
                <th class="center" colspan="@Math.Max(1, _cubos.Count)">Fan Hub Diameter</th>
            </tr>
            <tr>
                @foreach (var g in GruposDeCubos())
                {
                    <th class="center" colspan="@g.Quantas">@g.Serie</th>
                }
            </tr>
            <tr>
                @foreach (var c in _cubos)
                {
                    var cubo = c;
                    <th class="center" style="min-width:160px">
                        <div style="display:flex; gap:4px; justify-content:center">
                            <select class="cell" style="max-width:74px" value="@cubo.Serie"
                                    @onchange="e => TrocarSerieItem(cubo, e.Value?.ToString() ?? string.Empty)">
                                @foreach (var x in _series)
                                {
                                    <option value="@x" selected="@(x == cubo.Serie)">@x</option>
                                }
                            </select>
                            <input class="cell" style="width:120px; font-weight:600" value="@cubo.Rotulo"
                                   @onchange="e => RenomearRotulo(cubo, e.Value?.ToString() ?? string.Empty)" />
                        </div>
                        <div class="nowrap" style="margin-top:2px">
                            @Controles(cubo)
                        </div>
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var v in _diametros)
            {
                var vent = v;
                <tr @key="vent.Id">
                    <td class="nowrap">
                        <div style="display:flex; gap:4px; align-items:center">
                            <select class="cell" style="max-width:74px" value="@vent.Serie"
                                    @onchange="e => TrocarSerieItem(vent, e.Value?.ToString() ?? string.Empty)">
                                @foreach (var x in _series)
                                {
                                    <option value="@x" selected="@(x == vent.Serie)">@x</option>
                                }
                            </select>
                            <input class="cell" style="width:120px; font-weight:600" value="@vent.Rotulo"
                                   @onchange="e => RenomearRotulo(vent, e.Value?.ToString() ?? string.Empty)" />
                            @Controles(vent)
                        </div>
                    </td>
                    @foreach (var c in _cubos)
                    {
                        var cubo = c;
                        @if (cubo.Serie != vent.Serie)
                        {
                            <td class="center" style="opacity:.25"
                                title="@($"{vent.Serie} não se combina com {cubo.Serie}")">·</td>
                        }
                        else
                        {
                            var eq = Achar(vent.Serie, vent.Rotulo, cubo.Rotulo);
                            <td class="center @(eq is null ? "" : "combina")">
                                <input class="cell" style="width:86px; text-align:center"
                                       value="@(eq?.RpmMax.ToString() ?? "")"
                                       title="@(eq is null ? "Não cabe" : $"Máx. {eq.RpmMax} rpm (V-Belt)")"
                                       @onchange="e => Editar(vent.Serie, vent.Rotulo, cubo.Rotulo, e.Value?.ToString() ?? string.Empty)" />
                            </td>
                        }
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
}

<p class="subtitle" style="margin-top:12px">
    Célula preenchida (amarela) = o ventilador cabe naquele cubo, e o valor é o teto de rotação.
    Célula vazia = combinação que não existe. Apagar o número tira a combinação; digitar um
    número numa célula vazia cria a combinação. O <strong>·</strong> apagado é cruzamento de
    séries diferentes — um ventilador VAX não entra num cubo Joy. A série, o nome e a posição
    de cada ventilador e de cada cubo se editam no próprio cabeçalho.
</p>

<!-- ---------- a lista cruzada: código e preço ---------- -->
<h3 style="margin:26px 0 6px">Equipamentos — código e preço</h3>
<p class="subtitle">
    Uma lista só, <strong>cruzando ventilador e cubo</strong>: cada linha é uma célula amarela
    da matriz, ou seja, um equipamento de verdade. É por isso que o código e o preço estão
    aqui e não em duas listas soltas — o 3000 no cubo 1800 e o 3000 no cubo 2100 são dois
    equipamentos diferentes.
</p>

<div class="toolbar" style="flex-wrap:wrap">
    <strong>Nova combinação</strong>
    <select class="cell" style="max-width:88px" value="@_combSerie"
            @onchange="e => TrocarSerieNova(e.Value?.ToString() ?? string.Empty)">
        @foreach (var x in _series)
        {
            <option value="@x" selected="@(x == _combSerie)">@x</option>
        }
    </select>
    <select class="cell" style="max-width:150px" @bind="_combVentilador">
        @foreach (var d in _diametros.Where(i => i.Serie == _combSerie))
        {
            <option value="@d.Rotulo">@d.Rotulo</option>
        }
    </select>
    <span class="subtitle" style="margin:0">no cubo</span>
    <select class="cell" style="max-width:170px" @bind="_combCubo">
        @foreach (var c in _cubos.Where(i => i.Serie == _combSerie))
        {
            <option value="@c.Rotulo">@c.Rotulo</option>
        }
    </select>
    <input class="cell" style="width:100px" type="number" min="1" placeholder="rpm" @bind="_combRpm" />
    <button class="btn-primary" @onclick="IncluirCombinacao">+ Incluir</button>

    <span style="flex:1"></span>
    <input class="cell" style="width:190px" placeholder="filtrar…" value="@_filtro"
           @oninput="e => _filtro = e.Value?.ToString() ?? string.Empty" />
</div>

<div class="panel" style="padding:0; overflow-x:auto">
    <table class="grid">
        <thead>
            <tr>
                <th class="nowrap" style="width:90px">Série</th>
                <th class="nowrap">Fan Diameter</th>
                <th class="nowrap">Fan Hub Diameter</th>
                <th class="nowrap" style="width:150px">Rotação máx (rpm)</th>
                <th class="nowrap" style="width:150px">Código</th>
                <th class="nowrap" style="width:150px">Preço</th>
                <th class="nowrap" style="width:90px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Combinacoes())
            {
                var eq = e;
                <tr @key="eq.Id">
                    <td class="nowrap"><span class="val-count">@eq.Serie</span></td>
                    <td class="nowrap"><strong>@eq.Diametro</strong></td>
                    <td class="nowrap"><strong>@eq.Cubo</strong></td>
                    <td>
                        <input class="cell" style="max-width:130px; text-align:right"
                               value="@eq.RpmMax"
                               @onchange="a => Editar(eq.Serie, eq.Diametro, eq.Cubo, a.Value?.ToString() ?? string.Empty)" />
                    </td>
                    <td>
                        <input class="cell" style="max-width:130px" placeholder="—" value="@eq.Codigo"
                               @onchange="a => DefinirCombinacao(eq, a.Value?.ToString() ?? string.Empty, null)" />
                    </td>
                    <td>
                        <input class="cell" style="max-width:130px; text-align:right" placeholder="—" value="@eq.Preco"
                               @onchange="a => DefinirCombinacao(eq, null, a.Value?.ToString() ?? string.Empty)" />
                    </td>
                    <td class="nowrap center">
                        @if (_apagarComb == eq.Id)
                        {
                            <button class="btn-link" @onclick="() => ApagarCombinacao(eq)">Sim</button>
                            <button class="btn-link" @onclick="@(() => _apagarComb = null)">Não</button>
                        }
                        else
                        {
                            <button class="btn-link" title="Apagar a combinação"
                                    @onclick="@(() => _apagarComb = eq.Id)">✕</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p class="subtitle" style="margin-top:12px">
    A ordem é a do cadastro de ventiladores e, dentro dele, a dos cubos — a mesma da matriz.
    Apagar aqui é o mesmo que apagar o número da célula lá em cima.
</p>

<!-- ---------- motor máximo por cubo ---------- -->
<div class="toolbar" style="margin:26px 0 6px; flex-wrap:wrap">
    <h3 style="margin:0">Motor máximo por cubo</h3>
    @Limpeza(AlvoLimites)
</div>
<p class="subtitle">
    O maior frame que cabe dentro de cada cubo (a linha <em>Maximum Internal Motor</em> da
    planilha). A comparação é feita pela posição do frame na escada de tamanho da aba
    <a href="/axiais/motores">Motores</a> — por isso a ordem de lá importa.
</p>

<div class="panel" style="padding:0; overflow-x:auto">
    <table class="grid">
        <thead>
            <tr>
                <th class="nowrap" style="width:96px">Série</th>
                <th class="nowrap">Cubo</th>
                @foreach (var p in FrameRepository.Padroes)
                {
                    <th class="nowrap">@p</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var c in _cubos)
            {
                var cubo = c;
                <tr @key="cubo.Id">
                    <td class="nowrap"><span class="val-count">@cubo.Serie</span></td>
                    <td class="nowrap"><strong>@cubo.Rotulo</strong></td>
                    @foreach (var p in FrameRepository.Padroes)
                    {
                        var padrao = p;
                        var atual = FrameLimite(cubo.Serie, cubo.Rotulo, padrao);
                        <td>
                            <select class="cell" style="max-width:200px" value="@atual"
                                    @onchange="e => DefinirLimite(cubo.Serie, cubo.Rotulo, padrao, e.Value?.ToString() ?? string.Empty)">
                                <option value="">— não cadastrado —</option>
                                @foreach (var f in _frames.Where(f => f.Padrao == padrao))
                                {
                                    <option value="@f.Nome" selected="@(f.Nome == atual)">@f.Nome</option>
                                }
                                @if (atual.Length > 0 && _frames.All(f => f.Padrao != padrao || f.Nome != atual))
                                {
                                    <option value="@atual" selected>@atual (fora da lista)</option>
                                }
                            </select>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<Equipamento> _todos = new();
    private List<FrameMotor> _frames = new();
    private List<LimiteMotor> _limites = new();
    private List<ItemModelo> _itens = new();

    private string _novoVentilador = "";
    /// <summary>A combinação que está sendo montada na barra "Nova combinação".</summary>
    private string _combSerie = ItemModelo.Series[0];
    private string _combVentilador = "";
    private string _combCubo = "";
    private int _combRpm = 1800;
    /// <summary>Filtro de texto da lista cruzada.</summary>
    private string _filtro = "";
    /// <summary>Id da combinação aguardando confirmação para ser apagada.</summary>
    private string? _apagarComb;
    private string _novoCubo = "";
    private string _novaSerieVentilador = ItemModelo.Series[0];
    private string _novaSerieCubo = ItemModelo.Series[0];
    /// <summary>Id do item aguardando confirmação para ser apagado.</summary>
    private string? _apagarRotulo;

    /// <summary>As séries que aparecem na coluna Série (VAX, Joy e o que mais houver).</summary>
    private List<string> _series = new();

    /// <summary>A lista mandante, das duas séries juntas e na ordem gravada.</summary>
    private List<ItemModelo> _diametros = new();
    private List<ItemModelo> _cubos = new();

    private string _vVentilador = "";
    private string _vCubo = "";
    private int _vRpm = 1800;
    private string _vPadrao = "IEC";
    private string _vFrame = "";

    private RegraRotacao.Resultado? _rotacao;
    private RegraMotor.Resultado? _motor;
    private string? _msg;

    protected override void OnInitialized()
    {
        Repo.SemearSeVazio();
        Frames.SemearSeVazio();
        Limites.SemearSeVazio();
        Recarregar();

        _vVentilador = _diametros.FirstOrDefault()?.Id ?? "";
        _vCubo = CubosDaSerieVerificada.FirstOrDefault()?.Id ?? "";
        Verificar();
    }

    private void Recarregar()
    {
        _todos = Repo.Todos();
        _frames = Frames.Todos();
        _limites = Limites.Todos();

        Itens.SemearDaMatriz(_todos);
        // junta as duas séries numa sequência só; depois da primeira vez não faz nada
        Itens.NormalizarOrdem();
        _itens = Itens.Todos();

        _series = ItemModelo.Series
            .Concat(_itens.Select(i => i.Serie))
            .Concat(_todos.Select(e => e.Serie))
            .Where(s => s.Length > 0)
            .Distinct()
            .OrderBy(ItemModelo.OrdemDaSerie)
            .ThenBy(s => s)
            .ToList();

        // as linhas e as colunas da matriz saem da LISTA, não do que a matriz
        // tem — é o que permite um ventilador novo, ainda sem nenhuma
        // combinação, já aparecer para ser preenchido
        _diametros = _itens.Where(i => i.Tipo == ItemModelo.TipoVentilador).ToList();
        _cubos = _itens.Where(i => i.Tipo == ItemModelo.TipoCubo).ToList();

        AjustarNovaCombinacao();
    }

    // ---------- o verificador ----------

    private ItemModelo? VentiladorVerificado =>
        _diametros.FirstOrDefault(i => i.Id == _vVentilador) ?? _diametros.FirstOrDefault();

    /// <summary>A série sai do ventilador escolhido — não há mais seletor de série.</summary>
    private string SerieVerificada => VentiladorVerificado?.Serie ?? _series.FirstOrDefault() ?? "";

    private List<ItemModelo> CubosDaSerieVerificada =>
        _cubos.Where(c => c.Serie == SerieVerificada).ToList();

    private List<FrameMotor> FramesDoPadrao =>
        _frames.Where(f => f.Padrao == _vPadrao).OrderBy(f => f.Ordem).ToList();

    /// <summary>
    /// Trocar de ventilador pode trocar de série, e aí os cubos oferecidos são
    /// outros: o que estava escolhido não vale mais.
    /// </summary>
    private void TrocarVentilador()
    {
        var cubos = CubosDaSerieVerificada;
        if (cubos.All(c => c.Id != _vCubo)) _vCubo = cubos.FirstOrDefault()?.Id ?? "";
        Verificar();
    }

    private void TrocarPadrao()
    {
        // trocar IEC ↔ NEMA muda a lista de frames: o escolhido antes não vale mais
        _vFrame = "";
        Verificar();
    }

    private void Verificar()
    {
        var vent = VentiladorVerificado;
        var cubo = _cubos.FirstOrDefault(c => c.Id == _vCubo);

        if (vent is null || cubo is null || cubo.Serie != vent.Serie)
        {
            _rotacao = null;
            _motor = null;
            return;
        }

        _rotacao = RegraRotacao.Verificar(_todos, vent.Serie, vent.Rotulo, cubo.Rotulo, _vRpm);
        _motor = _vFrame.Length == 0
            ? null
            : RegraMotor.Verificar(_limites, _frames, vent.Serie, cubo.Rotulo, _vPadrao, _vFrame);
    }

    // ---------- a matriz ----------

    private Equipamento? Achar(string serie, string diametro, string cubo) => _todos
        .FirstOrDefault(e => e.Serie == serie && e.Diametro == diametro && e.Cubo == cubo);

    /// <summary>
    /// As colunas da matriz vêm da lista única, então uma série ocupa um trecho
    /// contínuo de colunas — é esse trecho que vira o cabeçalho "VAX"/"Joy".
    /// </summary>
    private List<(string Serie, int Quantas)> GruposDeCubos()
    {
        var grupos = new List<(string Serie, int Quantas)>();
        foreach (var c in _cubos)
        {
            if (grupos.Count > 0 && grupos[^1].Serie == c.Serie)
                grupos[^1] = (c.Serie, grupos[^1].Quantas + 1);
            else
                grupos.Add((c.Serie, 1));
        }
        return grupos;
    }

    // ---------- limpar uma lista ----------

    /// <summary>
    /// Uma lista que pode ser esvaziada: quantos registros tem hoje, o que a
    /// limpeza leva junto (o texto da confirmação) e como limpar.
    /// </summary>
    private sealed record Alvo(string Chave, Func<int> Quantos, string Explica, Action Limpar);

    /// <summary>Chave do alvo aguardando confirmação; nulo = ninguém perguntou nada.</summary>
    private string? _limpando;

    // Apagar o cadastro de ventiladores (ou de cubos) obriga a apagar também as
    // combinações: toda combinação tem os dois lados, e a lista é semeada de
    // volta a partir da matriz — sobrar combinação recriaria o rótulo apagado.
    private Alvo AlvoVentiladores => new(
        "ventiladores", () => _diametros.Count,
        "ventilador(es) — e, com eles, todas as combinações da matriz",
        () => { Repo.Limpar(); Itens.LimparTipo(ItemModelo.TipoVentilador); });

    private Alvo AlvoCubos => new(
        "cubos", () => _cubos.Count,
        "cubo(s) — e, com eles, todas as combinações e os limites de motor",
        () => { Repo.Limpar(); Limites.Limpar(); Itens.LimparTipo(ItemModelo.TipoCubo); });

    private Alvo AlvoCombinacoes => new(
        "combinacoes", () => _todos.Count,
        "combinação(ões) da matriz — o cadastro de ventiladores e de cubos fica de pé",
        () => Repo.Limpar());

    private Alvo AlvoLimites => new(
        "limites", () => _limites.Count,
        "limite(s) de motor",
        () => Limites.Limpar());

    /// <summary>O botão 🗑 Limpar de uma lista, com a confirmação no lugar dele.</summary>
    private RenderFragment Limpeza(Alvo alvo) => @<text>
        @if (_limpando == alvo.Chave)
        {
            <span class="aviso aviso-alerta" style="margin:0; padding:5px 9px">
                Apagar @alvo.Quantos() @alvo.Explica?
            </span>
            <button class="btn-link" @onclick="() => ExecutarLimpeza(alvo)">Sim, limpar</button>
            <button class="btn-link" @onclick="@(() => _limpando = null)">Cancelar</button>
        }
        else
        {
            <button class="btn-link" title="Esvaziar esta lista" disabled="@(alvo.Quantos() == 0)"
                    @onclick="@(() => _limpando = alvo.Chave)">🗑 Limpar</button>
        }
    </text>;

    private void ExecutarLimpeza(Alvo alvo)
    {
        var quantos = alvo.Quantos();
        alvo.Limpar();
        _limpando = null;

        Recarregar();
        if (_diametros.All(d => d.Id != _vVentilador))
            _vVentilador = _diametros.FirstOrDefault()?.Id ?? "";
        TrocarVentilador();

        _msg = $"Limpo: {quantos} {alvo.Explica}.";
    }

    /// <summary>
    /// Os botões de posição e de exclusão de um ventilador ou de um cubo. Ficam
    /// no cabeçalho da matriz — que é onde a lista de ventiladores (as linhas) e
    /// a de cubos (as colunas) de fato moram. A seta acompanha o sentido: o
    /// ventilador sobe e desce, o cubo anda para os lados.
    /// </summary>
    private RenderFragment Controles(ItemModelo item) => @<text>
        @{ var linha = item.Tipo == ItemModelo.TipoVentilador; }
        <button class="btn-link" title="@(linha ? "Subir" : "Mover para a esquerda")"
                @onclick="() => MoverRotulo(item, -1)">@(linha ? "↑" : "←")</button>
        <button class="btn-link" title="@(linha ? "Descer" : "Mover para a direita")"
                @onclick="() => MoverRotulo(item, 1)">@(linha ? "↓" : "→")</button>
        @if (_apagarRotulo == item.Id)
        {
            <button class="btn-link" @onclick="() => ApagarRotulo(item)">Sim</button>
            <button class="btn-link" @onclick="@(() => _apagarRotulo = null)">Não</button>
        }
        else
        {
            <button class="btn-link" title="@(linha ? "Apagar a linha inteira" : "Apagar a coluna inteira")"
                    @onclick="@(() => _apagarRotulo = item.Id)">✕</button>
        }
    </text>;

    /// <summary>
    /// A própria matriz é o editor: número na célula cria/atualiza a combinação,
    /// célula apagada tira a combinação da tabela.
    /// </summary>
    private void Editar(string serie, string diametro, string cubo, string texto)
    {
        var existente = Achar(serie, diametro, cubo);
        texto = texto.Trim();

        if (texto.Length == 0)
        {
            if (existente is not null)
            {
                Repo.Apagar(existente.Id);
                _msg = $"{serie} {diametro} / {cubo}: combinação removida.";
            }
        }
        else if (int.TryParse(texto, out var rpm) && rpm > 0)
        {
            Repo.Salvar(new Equipamento
            {
                Serie = serie, Diametro = diametro, Cubo = cubo, RpmMax = rpm,
                // mexer na rotação não pode apagar o que já foi codificado
                Codigo = existente?.Codigo ?? "", Preco = existente?.Preco ?? "",
            });
            _msg = $"{serie} {diametro} / {cubo}: máx. {rpm} rpm.";
        }
        else
        {
            _msg = $"\"{texto}\" não é uma rotação válida.";
        }

        Recarregar();
        Verificar();
    }

    // ---------- editar a lista de ventiladores e cubos ----------

    private void GuardarNovo(string tipo, string texto)
    {
        if (tipo == ItemModelo.TipoVentilador) _novoVentilador = texto;
        else _novoCubo = texto;
    }

    private void GuardarNovaSerie(string tipo, string serie)
    {
        if (tipo == ItemModelo.TipoVentilador) _novaSerieVentilador = serie;
        else _novaSerieCubo = serie;
    }

    private List<ItemModelo> ListaDe(string tipo) =>
        tipo == ItemModelo.TipoVentilador ? _diametros : _cubos;

    private void IncluirRotulo(string tipo)
    {
        var ventilador = tipo == ItemModelo.TipoVentilador;
        var nome = (ventilador ? _novoVentilador : _novoCubo).Trim();
        var serie = ventilador ? _novaSerieVentilador : _novaSerieCubo;
        if (nome.Length == 0) return;

        var lista = ListaDe(tipo);
        if (Existe(lista, serie, nome))
        {
            _msg = $"\"{nome}\" já existe na lista, na série {serie}.";
            return;
        }

        Itens.Salvar(new ItemModelo
        {
            Serie = serie, Tipo = tipo, Rotulo = nome,
            Ordem = lista.Count == 0 ? 1 : lista[^1].Ordem + 1,
        });

        if (ventilador) _novoVentilador = ""; else _novoCubo = "";
        Recarregar();
        _msg = $"{tipo} {nome} ({serie}) incluído. A linha já aparece na matriz, à espera das rotações.";
    }

    /// <summary>Mesmo rótulo pode existir em VAX e em Joy — a dupla é (série, rótulo).</summary>
    private static bool Existe(List<ItemModelo> lista, string serie, string rotulo, string? exceto = null) =>
        lista.Any(i => i.Id != exceto && i.Serie == serie &&
                       i.Rotulo.Equals(rotulo, StringComparison.OrdinalIgnoreCase));

    private void RenomearRotulo(ItemModelo item, string texto)
    {
        var para = texto.Trim();
        if (para.Length == 0 || para == item.Rotulo) { Recarregar(); return; }

        if (Existe(ListaDe(item.Tipo), item.Serie, para, exceto: item.Id))
        {
            _msg = $"\"{para}\" já existe na lista, na série {item.Serie}.";
            Recarregar();
            return;
        }

        var (movidas, _, limites) = Mudar(item, item.Serie, para);

        _msg = $"{item.Tipo} \"{item.Rotulo}\" passou a se chamar \"{para}\" — {movidas} combinação(ões)" +
               (limites > 0 ? $" e {limites} limite(s) de motor" : "") + " foram junto.";
        DepoisDeMexer();
    }

    /// <summary>
    /// Trocar a série leva o rótulo de linha de produto. As combinações vão
    /// junto, mas só as que continuam fazendo sentido: se o par do outro lado
    /// não existe na série de destino, a combinação é descartada — e a mensagem
    /// diz quantas foram.
    /// </summary>
    private void TrocarSerieItem(ItemModelo item, string serie)
    {
        serie = serie.Trim();
        if (serie.Length == 0 || serie == item.Serie) { Recarregar(); return; }

        if (Existe(ListaDe(item.Tipo), serie, item.Rotulo, exceto: item.Id))
        {
            _msg = $"A série {serie} já tem \"{item.Rotulo}\" na lista.";
            Recarregar();
            return;
        }

        var (movidas, descartadas, limites) = Mudar(item, serie, item.Rotulo);

        _msg = $"{item.Tipo} {item.Rotulo}: {item.Serie} → {serie}" +
               (movidas > 0 ? $", {movidas} combinação(ões) foram junto" : "") +
               (descartadas > 0 ? $", {descartadas} não valiam mais na série nova e saíram" : "") +
               (limites > 0 ? $", {limites} limite(s) de motor foram junto" : "") + ".";
        DepoisDeMexer();
    }

    /// <summary>
    /// Regrava o item com a série e/ou o rótulo novos e leva junto o que aponta
    /// para ele. Série e rótulo fazem parte do id dos registros — do item, das
    /// combinações e dos limites —, então cada um é apagado e regravado.
    /// </summary>
    private (int Movidas, int Descartadas, int Limites) Mudar(
        ItemModelo item, string serie, string rotulo)
    {
        Itens.Apagar(item.Id);
        Itens.Salvar(new ItemModelo
        {
            Serie = serie, Tipo = item.Tipo, Rotulo = rotulo, Ordem = item.Ordem,
        });

        var ventilador = item.Tipo == ItemModelo.TipoVentilador;
        var mudouDeSerie = serie != item.Serie;

        // na série de destino, os rótulos do OUTRO lado: uma combinação só
        // sobrevive à mudança de série se o par dela também existir lá
        var pares = _itens
            .Where(i => i.Serie == serie &&
                        i.Tipo == (ventilador ? ItemModelo.TipoCubo : ItemModelo.TipoVentilador))
            .Select(i => i.Rotulo)
            .ToHashSet();

        int movidas = 0, descartadas = 0, limites = 0;

        foreach (var e in _todos.Where(e => e.Serie == item.Serie &&
                                            (ventilador ? e.Diametro : e.Cubo) == item.Rotulo))
        {
            Repo.Apagar(e.Id);

            if (mudouDeSerie && !pares.Contains(ventilador ? e.Cubo : e.Diametro))
            {
                descartadas++;
                continue;
            }

            Repo.Salvar(new Equipamento
            {
                Serie = serie,
                Diametro = ventilador ? rotulo : e.Diametro,
                Cubo = ventilador ? e.Cubo : rotulo,
                RpmMax = e.RpmMax,
                Codigo = e.Codigo, Preco = e.Preco,
            });
            movidas++;
        }

        if (!ventilador)
        {
            foreach (var l in _limites.Where(l => l.Serie == item.Serie && l.Cubo == item.Rotulo))
            {
                Limites.Apagar(l.Id);
                Limites.Salvar(new LimiteMotor
                {
                    Serie = serie, Cubo = rotulo, Padrao = l.Padrao, Frame = l.Frame,
                });
                limites++;
            }
        }

        return (movidas, descartadas, limites);
    }

    /// <summary>Apaga o rótulo, as combinações dele na matriz e, se for cubo, os limites.</summary>
    private void ApagarRotulo(ItemModelo item)
    {
        var ventilador = item.Tipo == ItemModelo.TipoVentilador;

        var combinacoes = _todos
            .Where(e => e.Serie == item.Serie && (ventilador ? e.Diametro : e.Cubo) == item.Rotulo)
            .ToList();
        foreach (var e in combinacoes) Repo.Apagar(e.Id);

        var limites = ventilador
            ? new List<LimiteMotor>()
            : _limites.Where(l => l.Serie == item.Serie && l.Cubo == item.Rotulo).ToList();
        foreach (var l in limites) Limites.Apagar(l.Id);

        Itens.Apagar(item.Id);
        _apagarRotulo = null;

        _msg = $"{item.Tipo} {item.Rotulo} ({item.Serie}) apagado, com {combinacoes.Count} combinação(ões)" +
               (limites.Count > 0 ? $" e {limites.Count} limite(s) de motor" : "") + ".";
        DepoisDeMexer();
    }

    private void MoverRotulo(ItemModelo item, int direcao)
    {
        var lista = ListaDe(item.Tipo);
        var i = lista.FindIndex(x => x.Id == item.Id);
        var j = i + direcao;
        if (i < 0 || j < 0 || j >= lista.Count) return;

        var atual = lista[i];
        var vizinho = lista[j];
        (atual.Ordem, vizinho.Ordem) = (vizinho.Ordem, atual.Ordem);
        Itens.Salvar(atual);
        Itens.Salvar(vizinho);

        Recarregar();
        _msg = null;
    }

    /// <summary>Recarrega e conserta o que o verificador tinha escolhido.</summary>
    private void DepoisDeMexer()
    {
        Recarregar();
        if (_diametros.All(d => d.Id != _vVentilador))
            _vVentilador = _diametros.FirstOrDefault()?.Id ?? "";
        TrocarVentilador();
    }

    // ---------- a lista cruzada ----------

    /// <summary>
    /// As combinações na ordem da tela: a do cadastro de ventiladores e, dentro
    /// dele, a dos cubos. É a mesma leitura da matriz, linha por linha.
    /// </summary>
    private List<Equipamento> Combinacoes()
    {
        int Pos(string serie, string tipo, string rotulo) =>
            _itens.FirstOrDefault(i => i.Serie == serie && i.Tipo == tipo && i.Rotulo == rotulo)
                ?.Ordem ?? int.MaxValue;

        var filtro = _filtro.Trim();

        return _todos
            .Where(e => filtro.Length == 0 || Casa(e, filtro))
            .OrderBy(e => Pos(e.Serie, ItemModelo.TipoVentilador, e.Diametro))
            .ThenBy(e => Pos(e.Serie, ItemModelo.TipoCubo, e.Cubo))
            .ToList();
    }

    private static bool Casa(Equipamento e, string filtro) =>
        new[] { e.Serie, e.Diametro, e.Cubo, e.Codigo, e.RpmMax.ToString() }
            .Any(t => t.Contains(filtro, StringComparison.OrdinalIgnoreCase));

    private void TrocarSerieNova(string serie)
    {
        _combSerie = serie;
        // os ventiladores e os cubos oferecidos são os daquela série: o que
        // estava escolhido não vale mais
        AjustarNovaCombinacao();
    }

    /// <summary>Deixa os seletores da nova combinação apontando para algo que existe.</summary>
    private void AjustarNovaCombinacao()
    {
        var vents = _diametros.Where(i => i.Serie == _combSerie).Select(i => i.Rotulo).ToList();
        var cubos = _cubos.Where(i => i.Serie == _combSerie).Select(i => i.Rotulo).ToList();

        if (!vents.Contains(_combVentilador)) _combVentilador = vents.FirstOrDefault() ?? "";
        if (!cubos.Contains(_combCubo)) _combCubo = cubos.FirstOrDefault() ?? "";
    }

    private void IncluirCombinacao()
    {
        var vent = _combVentilador;
        var cubo = _combCubo;

        if (vent.Length == 0 || cubo.Length == 0)
        {
            _msg = $"A série {_combSerie} ainda não tem ventilador e cubo cadastrados.";
            return;
        }

        if (Achar(_combSerie, vent, cubo) is not null)
        {
            _msg = $"{_combSerie} {vent} / {cubo} já está na lista.";
            return;
        }

        if (_combRpm <= 0)
        {
            _msg = "A rotação máxima precisa ser maior que zero.";
            return;
        }

        Editar(_combSerie, vent, cubo, _combRpm.ToString());
    }

    /// <summary>
    /// Grava código e/ou preço da COMBINAÇÃO. O parâmetro que vier nulo não é
    /// mexido — é o mesmo registro alimentado por dois campos.
    /// </summary>
    private void DefinirCombinacao(Equipamento eq, string? codigo, string? preco)
    {
        var novoCodigo = (codigo ?? eq.Codigo).Trim();
        var novoPreco = (preco ?? eq.Preco).Trim();

        if (novoPreco.Length > 0 && DadosExcel.Numero(novoPreco) is null)
        {
            _msg = $"\"{novoPreco}\" não parece um preço. Use 1234,56 ou 1234.56.";
            Recarregar();
            return;
        }

        if (novoCodigo == eq.Codigo && novoPreco == eq.Preco) return;

        eq.Codigo = novoCodigo;
        eq.Preco = novoPreco;
        Repo.Salvar(eq);

        _msg = $"{eq.Serie} {eq.Diametro} / {eq.Cubo}: " +
               (novoCodigo.Length > 0 ? $"código {novoCodigo}" : "sem código") +
               (novoPreco.Length > 0 ? $", preço {novoPreco}" : "");

        Recarregar();
    }

    private void ApagarCombinacao(Equipamento eq)
    {
        Repo.Apagar(eq.Id);
        _apagarComb = null;
        _msg = $"{eq.Serie} {eq.Diametro} / {eq.Cubo}: combinação removida.";
        Recarregar();
        Verificar();
    }

    // ---------- limite de motor ----------

    private string FrameLimite(string serie, string cubo, string padrao) => _limites
        .FirstOrDefault(l => l.Serie == serie && l.Cubo == cubo && l.Padrao == padrao)?.Frame ?? "";

    private void DefinirLimite(string serie, string cubo, string padrao, string frame)
    {
        var existente = _limites.FirstOrDefault(l =>
            l.Serie == serie && l.Cubo == cubo && l.Padrao == padrao);

        if (frame.Length == 0)
        {
            if (existente is not null)
            {
                Limites.Apagar(existente.Id);
                _msg = $"{serie} · cubo {cubo} · {padrao}: limite de motor removido.";
            }
        }
        else
        {
            Limites.Salvar(new LimiteMotor
            {
                Serie = serie, Cubo = cubo, Padrao = padrao, Frame = frame,
            });
            _msg = $"{serie} · cubo {cubo} · {padrao}: motor máximo {frame}.";
        }

        Recarregar();
        Verificar();
    }

    // ---------- aparência dos avisos ----------

    private static string EstiloRotacao(RegraRotacao.Situacao s) => s switch
    {
        RegraRotacao.Situacao.Ok => "aviso aviso-ok",
        RegraRotacao.Situacao.AcimaDaRotacao => "aviso aviso-alerta",
        _ => "aviso aviso-erro",
    };

    private static string IconeRotacao(RegraRotacao.Situacao s) => s switch
    {
        RegraRotacao.Situacao.Ok => "✓",
        RegraRotacao.Situacao.AcimaDaRotacao => "⚠",
        _ => "✕",
    };

    private static string EstiloMotor(RegraMotor.Situacao s) => s switch
    {
        RegraMotor.Situacao.Ok => "aviso aviso-ok",
        RegraMotor.Situacao.AcimaDoLimite => "aviso aviso-alerta",
        RegraMotor.Situacao.SemLimite => "aviso aviso-neutro",
        _ => "aviso aviso-erro",
    };

    private static string IconeMotor(RegraMotor.Situacao s) => s switch
    {
        RegraMotor.Situacao.Ok => "✓",
        RegraMotor.Situacao.AcimaDoLimite => "⚠",
        RegraMotor.Situacao.SemLimite => "•",
        _ => "✕",
    };
}
