@inject EquipamentoRepository Repo
@inject FrameRepository Frames
@inject LimiteMotorRepository Limites
@inject ItemModeloRepository Itens

<p class="subtitle">
    Os equipamentos e a relação <strong>ventilador × cubo</strong>, por linha de produto.
    O número de cada célula é a rotação máxima (V-Belt) daquela combinação.
</p>

@if (_series.Count > 1)
{
    <div class="tabs">
        @foreach (var s in _series)
        {
            <button class="tab @(s == _serie ? "active" : "")" @onclick="() => TrocarSerie(s)">@s</button>
        }
    </div>
}

<!-- ---------- verificador ---------- -->
<div class="panel" style="margin-bottom:16px">
    <div class="toolbar" style="margin-bottom:0; flex-wrap:wrap">
        <strong>Verificar combinação</strong>

        <label style="display:flex; align-items:center; gap:6px">
            <span class="subtitle" style="margin:0">Ventilador</span>
            <select class="cell" @bind="_vDiametro" @bind:after="Verificar">
                @foreach (var d in _diametros)
                {
                    <option value="@d">@d</option>
                }
            </select>
        </label>

        <label style="display:flex; align-items:center; gap:6px">
            <span class="subtitle" style="margin:0">Cubo</span>
            <select class="cell" @bind="_vCubo" @bind:after="Verificar">
                @foreach (var c in _cubos)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </label>

        <label style="display:flex; align-items:center; gap:6px">
            <span class="subtitle" style="margin:0">Rotação</span>
            <input class="cell" style="width:105px" type="number" min="0"
                   @bind="_vRpm" @bind:event="oninput" @bind:after="Verificar" />
            <span class="subtitle" style="margin:0">rpm</span>
        </label>

        <label style="display:flex; align-items:center; gap:6px">
            <span class="subtitle" style="margin:0">Motor</span>
            <select class="cell" @bind="_vPadrao" @bind:after="TrocarPadrao">
                @foreach (var p in FrameRepository.Padroes)
                {
                    <option value="@p">@p</option>
                }
            </select>
            <select class="cell" @bind="_vFrame" @bind:after="Verificar">
                <option value="">—</option>
                @foreach (var f in FramesDoPadrao)
                {
                    <option value="@f.Nome">@f.Nome</option>
                }
            </select>
        </label>
    </div>

    @if (_rotacao is not null)
    {
        <div class="@EstiloRotacao(_rotacao.Situacao)" style="margin-top:14px">
            @IconeRotacao(_rotacao.Situacao) @_rotacao.Mensagem
        </div>
    }
    @if (_motor is not null)
    {
        <div class="@EstiloMotor(_motor.Situacao)" style="margin-top:10px">
            @IconeMotor(_motor.Situacao) @_motor.Mensagem
        </div>
    }
</div>

<!-- ---------- a matriz ---------- -->
<div class="toolbar" style="flex-wrap:wrap">
    <span class="subtitle" style="margin:0">
        @_daSerie.Count combinação(ões) · @_diametros.Count ventilador(es) · @_cubos.Count cubo(s)
    </span>
    <span style="flex:1"></span>
    @if (_msg is not null)
    {
        <span class="saved-flag">@_msg</span>
    }
</div>

<div class="panel" style="padding:0; overflow-x:auto">
    <table class="grid">
        <thead>
            <tr>
                <th class="nowrap" rowspan="2">Fan Diameter</th>
                <th class="center" colspan="@_cubos.Count">Fan Hub Diameter</th>
            </tr>
            <tr>
                @foreach (var c in _cubos)
                {
                    <th class="nowrap center">@c</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var d in _diametros)
            {
                <tr @key="d">
                    <td class="nowrap"><strong>@d</strong></td>
                    @foreach (var c in _cubos)
                    {
                        var diam = d;
                        var cubo = c;
                        var eq = Achar(diam, cubo);
                        <td class="center @(eq is null ? "" : "combina")">
                            <input class="cell" style="width:86px; text-align:center"
                                   value="@(eq?.RpmMax.ToString() ?? "")"
                                   title="@(eq is null ? "Não cabe" : $"Máx. {eq.RpmMax} rpm (V-Belt)")"
                                   @onchange="e => Editar(diam, cubo, e.Value?.ToString() ?? string.Empty)" />
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<p class="subtitle" style="margin-top:12px">
    Célula preenchida (amarela) = o ventilador cabe naquele cubo, e o valor é o teto de rotação.
    Célula vazia = combinação que não existe. Apagar o número tira a combinação; digitar um
    número numa célula vazia cria a combinação.
</p>

<!-- ---------- código e preço do ventilador e do cubo ---------- -->
<h3 style="margin:26px 0 6px">Ventiladores e cubos — código e preço</h3>
<p class="subtitle">
    A lista sai da matriz acima: o que existe lá aparece aqui para receber
    <strong>código</strong> e <strong>preço</strong>. Um rótulo que saia da matriz some
    daqui também.
</p>

<div class="prop-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:16px; align-items:start">
    @foreach (var tipo in new[] { ItemModelo.TipoVentilador, ItemModelo.TipoCubo })
    {
        var t = tipo;
        var rotulos = t == ItemModelo.TipoVentilador ? _diametros : _cubos;

        <div>
            <div class="toolbar" style="margin-bottom:8px; flex-wrap:wrap">
                <strong>@(t == ItemModelo.TipoVentilador ? "Fan Diameter" : "Fan Hub Diameter")</strong>
                <span class="val-count">@rotulos.Count</span>
                <input class="cell" style="min-width:150px" placeholder="@(t == ItemModelo.TipoVentilador ? "novo ventilador" : "novo cubo")"
                       value="@(t == ItemModelo.TipoVentilador ? _novoVentilador : _novoCubo)"
                       @onchange="e => GuardarNovo(t, e.Value?.ToString() ?? string.Empty)" />
                <button class="btn-primary" @onclick="() => IncluirRotulo(t)"
                        disabled="@((t == ItemModelo.TipoVentilador ? _novoVentilador : _novoCubo).Trim().Length == 0)">
                    + Incluir
                </button>
            </div>
            <div class="panel" style="padding:0; overflow-x:auto">
                <table class="grid">
                    <thead>
                        <tr>
                            <th class="nowrap">@t</th>
                            <th class="nowrap" style="width:130px">Código</th>
                            <th class="nowrap" style="width:150px">Preço</th>
                            <th class="nowrap" style="width:120px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in rotulos)
                        {
                            var rotulo = r;
                            var item = AcharItem(t, rotulo);
                            <tr @key="@(t + rotulo)">
                                <td>
                                    <input class="cell" style="font-weight:600; max-width:170px" value="@rotulo"
                                           @onchange="e => RenomearRotulo(t, rotulo, e.Value?.ToString() ?? string.Empty)" />
                                </td>
                                <td>
                                    <input class="cell" style="max-width:115px" placeholder="—"
                                           value="@(item?.Codigo ?? "")"
                                           @onchange="e => DefinirItem(t, rotulo, e.Value?.ToString() ?? string.Empty, null)" />
                                </td>
                                <td>
                                    <input class="cell" style="max-width:130px; text-align:right" placeholder="—"
                                           value="@(item?.Preco ?? "")"
                                           @onchange="e => DefinirItem(t, rotulo, null, e.Value?.ToString() ?? string.Empty)" />
                                </td>
                                <td class="nowrap center">
                                    <button class="btn-link" title="Subir" @onclick="() => MoverRotulo(t, rotulo, -1)">↑</button>
                                    <button class="btn-link" title="Descer" @onclick="() => MoverRotulo(t, rotulo, 1)">↓</button>
                                    @if (_apagarRotulo == t + "|" + rotulo)
                                    {
                                        <button class="btn-link" @onclick="() => ApagarRotulo(t, rotulo)">Sim</button>
                                        <button class="btn-link" @onclick="@(() => _apagarRotulo = null)">Não</button>
                                    }
                                    else
                                    {
                                        <button class="btn-link" title="Apagar a linha inteira"
                                                @onclick="@(() => _apagarRotulo = t + "|" + rotulo)">✕</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- ---------- motor máximo por cubo ---------- -->
<h3 style="margin:26px 0 6px">Motor máximo por cubo</h3>
<p class="subtitle">
    O maior frame que cabe dentro de cada cubo (a linha <em>Maximum Internal Motor</em> da
    planilha). A comparação é feita pela posição do frame na escada de tamanho da aba
    <a href="/axiais/motores">Motores</a> — por isso a ordem de lá importa.
</p>

<div class="panel" style="padding:0; overflow-x:auto">
    <table class="grid">
        <thead>
            <tr>
                <th class="nowrap">Cubo</th>
                @foreach (var p in FrameRepository.Padroes)
                {
                    <th class="nowrap">@p</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var c in _cubos)
            {
                var cubo = c;
                <tr @key="cubo">
                    <td class="nowrap"><strong>@cubo</strong></td>
                    @foreach (var p in FrameRepository.Padroes)
                    {
                        var padrao = p;
                        var atual = FrameLimite(cubo, padrao);
                        <td>
                            <select class="cell" style="max-width:200px" value="@atual"
                                    @onchange="e => DefinirLimite(cubo, padrao, e.Value?.ToString() ?? string.Empty)">
                                <option value="">— não cadastrado —</option>
                                @foreach (var f in _frames.Where(f => f.Padrao == padrao))
                                {
                                    <option value="@f.Nome" selected="@(f.Nome == atual)">@f.Nome</option>
                                }
                                @if (atual.Length > 0 && _frames.All(f => f.Padrao != padrao || f.Nome != atual))
                                {
                                    <option value="@atual" selected>@atual (fora da lista)</option>
                                }
                            </select>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<Equipamento> _todos = new();
    private List<Equipamento> _daSerie = new();
    private List<FrameMotor> _frames = new();
    private List<LimiteMotor> _limites = new();
    private List<ItemModelo> _itens = new();

    private string _novoVentilador = "";
    private string _novoCubo = "";
    /// <summary>Rótulo aguardando confirmação para ser apagado ("tipo|rótulo").</summary>
    private string? _apagarRotulo;

    private List<string> _series = new();
    private List<string> _diametros = new();
    private List<string> _cubos = new();

    private string _serie = "VAX";
    private string _vDiametro = "";
    private string _vCubo = "";
    private int _vRpm = 1800;
    private string _vPadrao = "IEC";
    private string _vFrame = "";

    private RegraRotacao.Resultado? _rotacao;
    private RegraMotor.Resultado? _motor;
    private string? _msg;

    protected override void OnInitialized()
    {
        Repo.SemearSeVazio();
        Frames.SemearSeVazio();
        Limites.SemearSeVazio();
        Recarregar();

        _vDiametro = _diametros.FirstOrDefault() ?? "";
        _vCubo = _cubos.FirstOrDefault() ?? "";
        Verificar();
    }

    private void Recarregar()
    {
        _todos = Repo.Todos();
        _frames = Frames.Todos();
        _limites = Limites.Todos();
        Itens.SemearDaMatriz(_todos);
        _itens = Itens.Todos();

        // VAX primeiro, Joy depois, e qualquer linha nova em ordem alfabética.
        var preferida = new[] { "VAX", "Joy" };
        _series = _todos.Select(e => e.Serie).Distinct()
            .OrderBy(s => Array.IndexOf(preferida, s) is var i && i >= 0 ? i : preferida.Length)
            .ThenBy(s => s)
            .ToList();
        if (!_series.Contains(_serie) && _series.Count > 0) _serie = _series[0];

        _daSerie = _todos.Where(e => e.Serie == _serie).ToList();

        // as linhas e as colunas da matriz saem da LISTA, não do que a matriz
        // tem — é o que permite um ventilador novo, ainda sem nenhuma
        // combinação, já aparecer para ser preenchido
        _diametros = _itens.Where(i => i.Serie == _serie && i.Tipo == ItemModelo.TipoVentilador)
            .Select(i => i.Rotulo).ToList();
        _cubos = _itens.Where(i => i.Serie == _serie && i.Tipo == ItemModelo.TipoCubo)
            .Select(i => i.Rotulo).ToList();
    }

    private List<FrameMotor> FramesDoPadrao =>
        _frames.Where(f => f.Padrao == _vPadrao).OrderBy(f => f.Ordem).ToList();

    private void TrocarSerie(string serie)
    {
        _serie = serie;
        Recarregar();
        if (!_diametros.Contains(_vDiametro)) _vDiametro = _diametros.FirstOrDefault() ?? "";
        if (!_cubos.Contains(_vCubo)) _vCubo = _cubos.FirstOrDefault() ?? "";
        Verificar();
    }

    private void TrocarPadrao()
    {
        // trocar IEC ↔ NEMA muda a lista de frames: o escolhido antes não vale mais
        _vFrame = "";
        Verificar();
    }

    private Equipamento? Achar(string diametro, string cubo) =>
        _daSerie.FirstOrDefault(e => e.Diametro == diametro && e.Cubo == cubo);

    // ---------- editar a lista de ventiladores e cubos ----------

    private void GuardarNovo(string tipo, string texto)
    {
        if (tipo == ItemModelo.TipoVentilador) _novoVentilador = texto;
        else _novoCubo = texto;
    }

    private List<ItemModelo> ListaDe(string tipo) =>
        _itens.Where(i => i.Serie == _serie && i.Tipo == tipo).OrderBy(i => i.Ordem).ToList();

    private void IncluirRotulo(string tipo)
    {
        var nome = (tipo == ItemModelo.TipoVentilador ? _novoVentilador : _novoCubo).Trim();
        if (nome.Length == 0) return;

        var lista = ListaDe(tipo);
        if (lista.Any(i => i.Rotulo.Equals(nome, StringComparison.OrdinalIgnoreCase)))
        {
            _msg = $"\"{nome}\" já existe na lista de {tipo.ToLowerInvariant()}es.";
            return;
        }

        Itens.Salvar(new ItemModelo
        {
            Serie = _serie, Tipo = tipo, Rotulo = nome,
            Ordem = lista.Count == 0 ? 1 : lista[^1].Ordem + 1,
        });

        if (tipo == ItemModelo.TipoVentilador) _novoVentilador = ""; else _novoCubo = "";
        Recarregar();
        _msg = $"{tipo} {nome} incluído. A linha já aparece na matriz, à espera das rotações.";
    }

    /// <summary>
    /// Renomear leva junto tudo o que aponta para o rótulo: as combinações da
    /// matriz e, no caso do cubo, também os limites de motor. O rótulo faz parte
    /// do id desses registros, então cada um é apagado e regravado.
    /// </summary>
    private void RenomearRotulo(string tipo, string de, string texto)
    {
        var para = texto.Trim();
        if (para.Length == 0 || para == de) { Recarregar(); return; }

        if (ListaDe(tipo).Any(i => i.Rotulo != de &&
                                   i.Rotulo.Equals(para, StringComparison.OrdinalIgnoreCase)))
        {
            _msg = $"\"{para}\" já existe na lista de {tipo.ToLowerInvariant()}es.";
            Recarregar();
            return;
        }

        var item = AcharItem(tipo, de);
        if (item is not null)
        {
            Itens.Apagar(item.Id);
            Itens.Salvar(new ItemModelo
            {
                Serie = _serie, Tipo = tipo, Rotulo = para,
                Codigo = item.Codigo, Preco = item.Preco, Ordem = item.Ordem,
            });
        }

        var ventilador = tipo == ItemModelo.TipoVentilador;
        var afetadas = 0;
        foreach (var e in _todos.Where(e => e.Serie == _serie &&
                                           (ventilador ? e.Diametro : e.Cubo) == de))
        {
            Repo.Apagar(e.Id);
            Repo.Salvar(new Equipamento
            {
                Serie = e.Serie,
                Diametro = ventilador ? para : e.Diametro,
                Cubo = ventilador ? e.Cubo : para,
                RpmMax = e.RpmMax,
            });
            afetadas++;
        }

        var limitesAfetados = 0;
        if (!ventilador)
        {
            foreach (var l in _limites.Where(l => l.Serie == _serie && l.Cubo == de))
            {
                Limites.Apagar(l.Id);
                Limites.Salvar(new LimiteMotor
                {
                    Serie = l.Serie, Cubo = para, Padrao = l.Padrao, Frame = l.Frame,
                });
                limitesAfetados++;
            }
        }

        Recarregar();
        if (_vDiametro == de && ventilador) _vDiametro = para;
        if (_vCubo == de && !ventilador) _vCubo = para;
        Verificar();

        _msg = $"{tipo} \"{de}\" passou a se chamar \"{para}\" — {afetadas} combinação(ões)" +
               (limitesAfetados > 0 ? $" e {limitesAfetados} limite(s) de motor" : "") + " foram junto.";
    }

    /// <summary>Apaga o rótulo, as combinações dele na matriz e, se for cubo, os limites.</summary>
    private void ApagarRotulo(string tipo, string rotulo)
    {
        var ventilador = tipo == ItemModelo.TipoVentilador;

        var combinacoes = _todos
            .Where(e => e.Serie == _serie && (ventilador ? e.Diametro : e.Cubo) == rotulo)
            .ToList();
        foreach (var e in combinacoes) Repo.Apagar(e.Id);

        var limites = ventilador
            ? new List<LimiteMotor>()
            : _limites.Where(l => l.Serie == _serie && l.Cubo == rotulo).ToList();
        foreach (var l in limites) Limites.Apagar(l.Id);

        var item = AcharItem(tipo, rotulo);
        if (item is not null) Itens.Apagar(item.Id);

        _apagarRotulo = null;
        Recarregar();
        if (!_diametros.Contains(_vDiametro)) _vDiametro = _diametros.FirstOrDefault() ?? "";
        if (!_cubos.Contains(_vCubo)) _vCubo = _cubos.FirstOrDefault() ?? "";
        Verificar();

        _msg = $"{tipo} {rotulo} apagado, com {combinacoes.Count} combinação(ões)" +
               (limites.Count > 0 ? $" e {limites.Count} limite(s) de motor" : "") + ".";
    }

    private void MoverRotulo(string tipo, string rotulo, int direcao)
    {
        var lista = ListaDe(tipo);
        var i = lista.FindIndex(x => x.Rotulo == rotulo);
        var j = i + direcao;
        if (i < 0 || j < 0 || j >= lista.Count) return;

        var atual = lista[i];
        var vizinho = lista[j];
        (atual.Ordem, vizinho.Ordem) = (vizinho.Ordem, atual.Ordem);
        Itens.Salvar(atual);
        Itens.Salvar(vizinho);

        Recarregar();
        _msg = null;
    }

    // ---------- código e preço ----------

    private ItemModelo? AcharItem(string tipo, string rotulo) => _itens
        .FirstOrDefault(i => i.Serie == _serie && i.Tipo == tipo && i.Rotulo == rotulo);

    /// <summary>
    /// Grava código e/ou preço do ventilador ou do cubo. O parâmetro que vier
    /// nulo não é mexido — é o mesmo registro alimentado por dois campos.
    /// </summary>
    private void DefinirItem(string tipo, string rotulo, string? codigo, string? preco)
    {
        var atual = AcharItem(tipo, rotulo);

        var novoCodigo = (codigo ?? atual?.Codigo ?? "").Trim();
        var novoPreco = (preco ?? atual?.Preco ?? "").Trim();

        if (novoPreco.Length > 0 && DadosExcel.Numero(novoPreco) is null)
        {
            _msg = $"\"{novoPreco}\" não parece um preço. Use 1234,56 ou 1234.56.";
            Recarregar();
            return;
        }

        if (atual is not null && novoCodigo == atual.Codigo && novoPreco == atual.Preco) return;

        if (novoCodigo.Length == 0 && novoPreco.Length == 0)
        {
            // a linha continua na lista (é ela que forma a matriz); só esvazia
            if (atual is not null)
            {
                atual.Codigo = "";
                atual.Preco = "";
                Itens.Salvar(atual);
                _msg = $"{tipo} {rotulo}: código e preço apagados.";
            }
        }
        else
        {
            Itens.Salvar(new ItemModelo
            {
                Serie = _serie, Tipo = tipo, Rotulo = rotulo,
                Codigo = novoCodigo, Preco = novoPreco,
                Ordem = atual?.Ordem ?? ListaDe(tipo).Count + 1,
            });
            _msg = $"{tipo} {rotulo}: " +
                   (novoCodigo.Length > 0 ? $"código {novoCodigo}" : "sem código") +
                   (novoPreco.Length > 0 ? $", preço {novoPreco}" : "");
        }

        Recarregar();
    }

    private string FrameLimite(string cubo, string padrao) => _limites
        .FirstOrDefault(l => l.Serie == _serie && l.Cubo == cubo && l.Padrao == padrao)?.Frame ?? "";

    private void Verificar()
    {
        if (_vDiametro.Length == 0 || _vCubo.Length == 0)
        {
            _rotacao = null;
            _motor = null;
            return;
        }

        _rotacao = RegraRotacao.Verificar(_todos, _serie, _vDiametro, _vCubo, _vRpm);
        _motor = _vFrame.Length == 0
            ? null
            : RegraMotor.Verificar(_limites, _frames, _serie, _vCubo, _vPadrao, _vFrame);
    }

    /// <summary>
    /// A própria matriz é o editor: número na célula cria/atualiza a combinação,
    /// célula apagada tira a combinação da tabela.
    /// </summary>
    private void Editar(string diametro, string cubo, string texto)
    {
        var existente = Achar(diametro, cubo);
        texto = texto.Trim();

        if (texto.Length == 0)
        {
            if (existente is not null)
            {
                Repo.Apagar(existente.Id);
                _msg = $"{_serie} {diametro} / {cubo}: combinação removida.";
            }
        }
        else if (int.TryParse(texto, out var rpm) && rpm > 0)
        {
            Repo.Salvar(new Equipamento
            {
                Serie = _serie, Diametro = diametro, Cubo = cubo, RpmMax = rpm,
            });
            _msg = $"{_serie} {diametro} / {cubo}: máx. {rpm} rpm.";
        }
        else
        {
            _msg = $"\"{texto}\" não é uma rotação válida.";
        }

        Recarregar();
        Verificar();
    }

    private void DefinirLimite(string cubo, string padrao, string frame)
    {
        var existente = _limites.FirstOrDefault(l =>
            l.Serie == _serie && l.Cubo == cubo && l.Padrao == padrao);

        if (frame.Length == 0)
        {
            if (existente is not null)
            {
                Limites.Apagar(existente.Id);
                _msg = $"{_serie} · cubo {cubo} · {padrao}: limite de motor removido.";
            }
        }
        else
        {
            Limites.Salvar(new LimiteMotor
            {
                Serie = _serie, Cubo = cubo, Padrao = padrao, Frame = frame,
            });
            _msg = $"{_serie} · cubo {cubo} · {padrao}: motor máximo {frame}.";
        }

        Recarregar();
        Verificar();
    }

    private static string EstiloRotacao(RegraRotacao.Situacao s) => s switch
    {
        RegraRotacao.Situacao.Ok => "aviso aviso-ok",
        RegraRotacao.Situacao.AcimaDaRotacao => "aviso aviso-alerta",
        _ => "aviso aviso-erro",
    };

    private static string IconeRotacao(RegraRotacao.Situacao s) => s switch
    {
        RegraRotacao.Situacao.Ok => "✓",
        RegraRotacao.Situacao.AcimaDaRotacao => "⚠",
        _ => "✕",
    };

    private static string EstiloMotor(RegraMotor.Situacao s) => s switch
    {
        RegraMotor.Situacao.Ok => "aviso aviso-ok",
        RegraMotor.Situacao.AcimaDoLimite => "aviso aviso-alerta",
        RegraMotor.Situacao.SemLimite => "aviso aviso-neutro",
        _ => "aviso aviso-erro",
    };

    private static string IconeMotor(RegraMotor.Situacao s) => s switch
    {
        RegraMotor.Situacao.Ok => "✓",
        RegraMotor.Situacao.AcimaDoLimite => "⚠",
        RegraMotor.Situacao.SemLimite => "•",
        _ => "✕",
    };
}
