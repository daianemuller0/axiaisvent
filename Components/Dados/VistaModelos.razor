@inject EquipamentoRepository Repo
@inject MotorRepository Motores
@inject LimiteMotorRepository Limites
@inject ItemModeloRepository Itens

<p class="subtitle">
    Os equipamentos e a relação <strong>ventilador × cubo</strong>. VAX e Joy ficam na
    <strong>mesma lista</strong>: cada linha diz na coluna <em>Série</em> de qual linha de
    produto ela é. O modelo é a linha inteira — <strong>série, ventilador, cubo, FB/HB e
    nº de estágios</strong> —, então o mesmo par pode aparecer duas vezes se o FB/HB ou o
    estagiamento for outro: são dois modelos, com código e preço próprios.
</p>

<!-- ---------- verificador ---------- -->
<div class="panel" style="margin-bottom:16px">
    <div class="toolbar" style="margin-bottom:0; flex-wrap:wrap">
        <strong>Verificar combinação</strong>

        <label style="display:flex; align-items:center; gap:6px">
            <span class="subtitle" style="margin:0">Ventilador</span>
            <select class="cell" @bind="_vVentilador" @bind:after="TrocarVentilador">
                @foreach (var g in _diametros.GroupBy(i => i.Serie))
                {
                    <optgroup label="@g.Key">
                        @foreach (var d in g)
                        {
                            <option value="@d.Id">@d.Rotulo</option>
                        }
                    </optgroup>
                }
            </select>
        </label>

        <label style="display:flex; align-items:center; gap:6px">
            <span class="subtitle" style="margin:0">Cubo</span>
            <select class="cell" @bind="_vCubo" @bind:after="Verificar">
                @foreach (var c in CubosDaSerieVerificada)
                {
                    <option value="@c.Id">@c.Rotulo</option>
                }
            </select>
            <span class="subtitle" style="margin:0">da série @SerieVerificada</span>
        </label>

        <label style="display:flex; align-items:center; gap:6px">
            <span class="subtitle" style="margin:0">Rotação</span>
            <input class="cell" style="width:105px" type="number" min="0"
                   @bind="_vRpm" @bind:event="oninput" @bind:after="Verificar" />
            <span class="subtitle" style="margin:0">rpm</span>
        </label>

        <label style="display:flex; align-items:center; gap:6px">
            <span class="subtitle" style="margin:0">Motor</span>
            <select class="cell" @bind="_vPadrao" @bind:after="TrocarPadrao">
                @foreach (var p in MotorRepository.Padroes)
                {
                    <option value="@p">@p</option>
                }
            </select>
            <select class="cell" @bind="_vFrame" @bind:after="Verificar">
                <option value="">—</option>
                @foreach (var f in FramesDoPadrao)
                {
                    <option value="@f">@f</option>
                }
            </select>
        </label>
    </div>

    @if (_rotacao is not null)
    {
        <div class="@EstiloRotacao(_rotacao.Situacao)" style="margin-top:14px">
            @IconeRotacao(_rotacao.Situacao) @_rotacao.Mensagem
        </div>
    }
    @if (_motor is not null)
    {
        <div class="@EstiloMotor(_motor.Situacao)" style="margin-top:10px">
            @IconeMotor(_motor.Situacao) @_motor.Mensagem
        </div>
    }
</div>

<div class="toolbar" style="flex-wrap:wrap">
    <span class="subtitle" style="margin:0">
        @_todos.Count combinação(ões) · @_diametros.Count ventilador(es) · @_cubos.Count cubo(s)
    </span>
    <span style="flex:1"></span>
    @if (_msg is not null)
    {
        <span class="saved-flag">@_msg</span>
    }
</div>

<!-- ---------- a lista cruzada: código e preço ---------- -->
<h3 style="margin:26px 0 6px">Equipamentos — código e preço</h3>
<p class="subtitle">
    Uma lista só, <strong>cruzando ventilador e cubo</strong>: cada linha é uma célula amarela
    da matriz, ou seja, um equipamento de verdade. É por isso que o código e o preço estão
    aqui e não em duas listas soltas — o 3000 no cubo 1800 e o 3000 no cubo 2100 são dois
    equipamentos diferentes.
</p>

<div class="toolbar" style="flex-wrap:wrap">
    <strong>Nova combinação</strong>
    <select class="cell" style="max-width:88px" value="@_combSerie"
            @onchange="e => TrocarSerieNova(e.Value?.ToString() ?? string.Empty)">
        @foreach (var x in _series)
        {
            <option value="@x" selected="@(x == _combSerie)">@x</option>
        }
    </select>
    <input class="cell" style="width:140px" list="ventiladores-da-serie" placeholder="ventilador"
           value="@_combVentilador" @onchange="e => _combVentilador = e.Value?.ToString() ?? string.Empty" />
    <span class="subtitle" style="margin:0">no cubo</span>
    <input class="cell" style="width:160px" list="cubos-da-serie" placeholder="cubo"
           value="@_combCubo" @onchange="e => _combCubo = e.Value?.ToString() ?? string.Empty" />

    @* os rótulos que a série escolhida já tem, para escolher clicando;
       digitar um que não existe cria o cadastro dele na hora *@
    <datalist id="ventiladores-da-serie">
        @foreach (var d in _diametros.Where(i => i.Serie == _combSerie))
        {
            <option value="@d.Rotulo"></option>
        }
    </datalist>
    <datalist id="cubos-da-serie">
        @foreach (var c in _cubos.Where(i => i.Serie == _combSerie))
        {
            <option value="@c.Rotulo"></option>
        }
    </datalist>
    <input class="cell" style="width:90px" placeholder="FB/HB"
           value="@_combFbHb" @onchange="e => _combFbHb = e.Value?.ToString() ?? string.Empty" />
    <select class="cell" style="width:110px" value="@_combEstagios"
            @onchange="e => _combEstagios = e.Value?.ToString() ?? string.Empty">
        <option value="" selected="@(_combEstagios.Length == 0)">estágios</option>
        @foreach (var n in Equipamento.Estagiamentos)
        {
            <option value="@n" selected="@(n == _combEstagios)">@n</option>
        }
    </select>
    <input class="cell" style="width:100px" type="number" min="1" placeholder="rpm" @bind="_combRpm" />
    <button class="btn-primary" @onclick="IncluirCombinacao">+ Incluir</button>

    <span style="flex:1"></span>
    <input class="cell" style="width:190px" placeholder="filtrar…" value="@_filtro"
           @oninput="e => Filtrar(e.Value?.ToString() ?? string.Empty)" />
    @Limpeza(AlvoListaCruzada)
    <ExcelDaTabela Nome="equipamentos"
                   Exportar="@(() => DadosExcel.ExportarModelos(_todos, _itens))"
                   Importar="SubirModelos"
                   Importou="DepoisDeImportar" />
</div>

@foreach (var padrao in MotorRepository.Padroes)
{
    <datalist id="@("escada-" + padrao)">
        @foreach (var f in MotorRepository.Escada(_motores, padrao))
        {
            <option value="@f"></option>
        }
    </datalist>
}

@*
    A lista sai por páginas. Com a tabela inteira no HTML, 98 linhas × 13 colunas
    davam mais de mil campos numa página só — o navegador levava quase um segundo
    para montar aquilo, e piorava a cada linha nova.

    (O componente Virtualize seria o caminho natural, mas dentro de <table> ele
    não recorta: o espaçador precisa ser um <tr>, e um <tr> não segura a altura
    que ele calcula. Paginar é previsível e funciona em qualquer navegador.)
*@
<div class="toolbar" style="flex-wrap:wrap">
    <span class="subtitle" style="margin:0">
        @(Combinacoes().Count == 0 ? "nenhuma linha" : $"mostrando {Primeira + 1}–{Ultima} de {Combinacoes().Count}")
    </span>
    <button class="btn-link" disabled="@(_pagina == 0)" @onclick="() => _pagina--">◀</button>
    <button class="btn-link" disabled="@(Ultima >= Combinacoes().Count)" @onclick="() => _pagina++">▶</button>
    <select class="cell" style="max-width:130px" value="@_porPagina"
            @onchange="e => TrocarTamanho(e.Value?.ToString() ?? string.Empty)">
        <option value="30" selected="@(_porPagina == 30)">30 por página</option>
        <option value="60" selected="@(_porPagina == 60)">60 por página</option>
        <option value="0" selected="@(_porPagina == 0)">todas</option>
    </select>
</div>

<div class="panel" style="padding:0; overflow-x:auto">
    <table class="grid" style="min-width:1780px">
        <thead>
            <tr>
                <th class="nowrap" style="width:90px">Série</th>
                <th class="nowrap" style="min-width:120px">Fan Diameter</th>
                <th class="nowrap" style="min-width:140px">Fan Hub Diameter</th>
                <th class="nowrap" style="width:100px">FB/HB</th>
                <th class="nowrap" style="width:120px">Nº de estágios</th>
                <th class="nowrap" style="width:130px">Rotação máx (rpm)</th>
                <th class="nowrap" style="width:150px">Frame máx IEC</th>
                <th class="nowrap" style="width:150px">Frame máx NEMA</th>
                <th class="nowrap" style="width:130px">Código</th>
                <th class="nowrap" style="width:120px">Preço USD</th>
                <th class="nowrap" style="width:120px">Preço CLP</th>
                <th class="nowrap" style="width:120px">Preço R$</th>
                <th class="nowrap" style="width:90px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in DaPagina())
            {
                var eq = e;
                <tr @key="eq.Id">
                    <td class="nowrap"><span class="val-count">@eq.Serie</span></td>
                    <td class="nowrap"><strong>@eq.Diametro</strong></td>
                    <td class="nowrap"><strong>@eq.Cubo</strong></td>
                    @* a chave carrega o contador de recusas: quando a gravação
                       é recusada, o valor renderizado não muda e o Blazor não
                       reescreveria o campo — a tela ficaria mostrando o que foi
                       digitado e não o que está gravado. Mudando a chave, o
                       campo é recriado com o valor de verdade. *@
                    <td>
                        <input class="cell" style="max-width:90px" placeholder="—" value="@eq.FbHb"
                               @key="@($"{eq.Id}|fb|{_recusas}")"
                               @onchange="a => DefinirFbHb(eq, a.Value?.ToString() ?? string.Empty)" />
                    </td>
                    <td>
                        <select class="cell" style="max-width:110px" value="@eq.Estagios"
                                @key="@($"{eq.Id}|est|{_recusas}")"
                                @onchange="a => DefinirEstagios(eq, a.Value?.ToString() ?? string.Empty)">
                            <option value="" selected="@(eq.Estagios.Length == 0)">—</option>
                            @foreach (var n in Equipamento.Estagiamentos)
                            {
                                <option value="@n" selected="@(n == eq.Estagios)">@n</option>
                            }
                        </select>
                    </td>
                    <td>
                        <input class="cell" style="max-width:130px; text-align:right"
                               value="@eq.RpmMax"
                               @onchange="a => DefinirRpm(eq, a.Value?.ToString() ?? string.Empty)" />
                    </td>
                    <td>@FrameMax(eq, "IEC")</td>
                    <td>@FrameMax(eq, "NEMA")</td>
                    <td>
                        <input class="cell" style="max-width:110px" placeholder="—" value="@eq.Codigo"
                               @onchange="a => DefinirCodigo(eq, a.Value?.ToString() ?? string.Empty)" />
                    </td>
                    <td>@PrecoDe(eq, Moeda.Usd)</td>
                    <td>@PrecoDe(eq, Moeda.Clp)</td>
                    <td>@PrecoDe(eq, Moeda.Brl)</td>
                    <td class="nowrap center">
                        @if (_apagarComb == eq.Id)
                        {
                            <button class="btn-link" @onclick="() => ApagarCombinacao(eq)">Sim</button>
                            <button class="btn-link" @onclick="@(() => _apagarComb = null)">Não</button>
                        }
                        else
                        {
                            <button class="btn-link" title="Apagar a combinação"
                                    @onclick="@(() => _apagarComb = eq.Id)">✕</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p class="subtitle" style="margin-top:12px">
    A ordem é a do cadastro de ventiladores e, dentro dele, a dos cubos — a mesma da matriz.
    Apagar aqui é o mesmo que apagar o número da célula lá em cima.
</p>

@code {
    private List<Equipamento> _todos = new();
    private List<Motor> _motores = new();
    private List<LimiteMotor> _limites = new();
    private List<ItemModelo> _itens = new();

    /// <summary>A combinação que está sendo montada na barra "Nova combinação".</summary>
    private string _combSerie = ItemModelo.Series[0];
    private string _combVentilador = "";
    private string _combCubo = "";
    private string _combFbHb = "";
    private string _combEstagios = "";
    private int _combRpm = 1800;
    /// <summary>Filtro de texto da lista cruzada.</summary>
    private string _filtro = "";
    /// <summary>Página da lista cruzada (0 = a primeira) e quantas linhas por página.</summary>
    private int _pagina;
    private int _porPagina = 30;
    /// <summary>Id da combinação aguardando confirmação para ser apagada.</summary>
    private string? _apagarComb;

    /// <summary>As séries que aparecem na coluna Série (VAX, Joy e o que mais houver).</summary>
    private List<string> _series = new();

    /// <summary>A lista mandante, das duas séries juntas e na ordem gravada.</summary>
    private List<ItemModelo> _diametros = new();
    private List<ItemModelo> _cubos = new();

    private string _vVentilador = "";
    private string _vCubo = "";
    private int _vRpm = 1800;
    private string _vPadrao = "IEC";
    private string _vFrame = "";

    private RegraRotacao.Resultado? _rotacao;
    private RegraMotor.Resultado? _motor;
    private string? _msg;

    /// <summary>Quantas gravações já foram recusadas — ver o @key dos campos de identidade.</summary>
    private int _recusas;

    protected override void OnInitialized()
    {
        // as tabelas de fábrica são carregadas na abertura do sistema
        // (BackendHost), não a cada desenho de tela
        Recarregar();

        _vVentilador = _diametros.FirstOrDefault()?.Id ?? "";
        _vCubo = CubosDaSerieVerificada.FirstOrDefault()?.Id ?? "";
        Verificar();
    }

    private void Recarregar()
    {
        _todos = Repo.Todos();
        _motores = Motores.Todos();
        _limites = Limites.Todos();

        _itens = Itens.Todos();

        _series = ItemModelo.Series
            .Concat(_itens.Select(i => i.Serie))
            .Concat(_todos.Select(e => e.Serie))
            .Where(s => s.Length > 0)
            .Distinct()
            .OrderBy(ItemModelo.OrdemDaSerie)
            .ThenBy(s => s)
            .ToList();

        // as linhas e as colunas da matriz saem da LISTA, não do que a matriz
        // tem — é o que permite um ventilador novo, ainda sem nenhuma
        // combinação, já aparecer para ser preenchido
        _diametros = _itens.Where(i => i.Tipo == ItemModelo.TipoVentilador).ToList();
        _cubos = _itens.Where(i => i.Tipo == ItemModelo.TipoCubo).ToList();

        AjustarNovaCombinacao();
    }

    // ---------- o verificador ----------

    private ItemModelo? VentiladorVerificado =>
        _diametros.FirstOrDefault(i => i.Id == _vVentilador) ?? _diametros.FirstOrDefault();

    /// <summary>A série sai do ventilador escolhido — não há mais seletor de série.</summary>
    private string SerieVerificada => VentiladorVerificado?.Serie ?? _series.FirstOrDefault() ?? "";

    private List<ItemModelo> CubosDaSerieVerificada =>
        _cubos.Where(c => c.Serie == SerieVerificada).ToList();

    /// <summary>As carcaças do padrão, na ordem da lista de motores.</summary>
    private List<string> FramesDoPadrao => MotorRepository.Escada(_motores, _vPadrao);

    /// <summary>
    /// Trocar de ventilador pode trocar de série, e aí os cubos oferecidos são
    /// outros: o que estava escolhido não vale mais.
    /// </summary>
    private void TrocarVentilador()
    {
        var cubos = CubosDaSerieVerificada;
        if (cubos.All(c => c.Id != _vCubo)) _vCubo = cubos.FirstOrDefault()?.Id ?? "";
        Verificar();
    }

    private void TrocarPadrao()
    {
        // trocar IEC ↔ NEMA muda a lista de frames: o escolhido antes não vale mais
        _vFrame = "";
        Verificar();
    }

    private void Verificar()
    {
        var vent = VentiladorVerificado;
        var cubo = _cubos.FirstOrDefault(c => c.Id == _vCubo);

        if (vent is null || cubo is null || cubo.Serie != vent.Serie)
        {
            _rotacao = null;
            _motor = null;
            return;
        }

        _rotacao = RegraRotacao.Verificar(_todos, vent.Serie, vent.Rotulo, cubo.Rotulo, _vRpm);
        // o frame máximo da própria combinação, quando houver, manda sobre o do cubo
        // o par pode ter mais de um modelo (FB/HB, estagiamento); o verificador
        // pergunta só por ventilador e cubo, então vale o primeiro frame máximo
        // que algum deles declarar
        var frameDoPar = Do(vent.Serie, vent.Rotulo, cubo.Rotulo)
            .Select(e => e.FrameMaximo(_vPadrao))
            .FirstOrDefault(f => f.Length > 0) ?? "";

        _motor = _vFrame.Length == 0
            ? null
            : RegraMotor.Verificar(_limites, _motores, vent.Serie, cubo.Rotulo, _vPadrao,
                _vFrame, frameDoPar);
    }

    // ---------- a matriz ----------

    /// <summary>Os modelos de um par ventilador × cubo — podem ser vários.</summary>
    private IEnumerable<Equipamento> Do(string serie, string diametro, string cubo) => _todos
        .Where(e => e.Serie == serie && e.Diametro == diametro && e.Cubo == cubo);

    /// <summary>
    /// O modelo com esta identidade — os cinco campos da tabela de referência.
    /// </summary>
    private Equipamento? Achar(string serie, string diametro, string cubo,
                               string fbHb, string estagios) => _todos
        .FirstOrDefault(e => e.Serie == serie && e.Diametro == diametro && e.Cubo == cubo
                          && e.FbHb == fbHb && e.Estagios == estagios);

    // ---------- limpar uma lista ----------

    /// <summary>
    /// Uma lista que pode ser esvaziada: quantos registros tem hoje, o que a
    /// limpeza leva junto (o texto da confirmação) e como limpar.
    /// </summary>
    private sealed record Alvo(string Chave, Func<int> Quantos, string Explica, Action Limpar);

    /// <summary>Chave do alvo aguardando confirmação; nulo = ninguém perguntou nada.</summary>
    private string? _limpando;

    private Alvo AlvoCombinacoes => new(
        "combinacoes", () => _todos.Count,
        "combinação(ões) da matriz — o cadastro de ventiladores e de cubos fica de pé",
        () => Repo.Limpar());

    /// <summary>
    /// Limpar a lista cruzada é limpar as combinações — são a mesma coisa. Com
    /// um filtro escrito, apaga só o que ele está mostrando: é o que permite
    /// tirar uma série, ou um cubo, sem mexer no resto.
    /// </summary>
    private Alvo AlvoListaCruzada => _filtro.Trim().Length == 0
        ? new("lista", () => _todos.Count,
            "combinação(ões) — a lista inteira; o cadastro de ventiladores e de cubos fica de pé",
            () => Repo.Limpar())
        : new("lista", () => Combinacoes().Count,
            $"combinação(ões) — só as que o filtro \"{_filtro.Trim()}\" está mostrando",
            () => { foreach (var e in Combinacoes()) Repo.Apagar(e.Id); });

    /// <summary>O botão 🗑 Limpar de uma lista, com a confirmação no lugar dele.</summary>
    private RenderFragment Limpeza(Alvo alvo) => @<text>
        @if (_limpando == alvo.Chave)
        {
            <span class="aviso aviso-alerta" style="margin:0; padding:5px 9px">
                Apagar @alvo.Quantos() @alvo.Explica?
            </span>
            <button class="btn-link" @onclick="() => ExecutarLimpeza(alvo)">Sim, limpar</button>
            <button class="btn-link" @onclick="@(() => _limpando = null)">Cancelar</button>
        }
        else
        {
            <button class="btn-link" title="Esvaziar esta lista" disabled="@(alvo.Quantos() == 0)"
                    @onclick="@(() => _limpando = alvo.Chave)">🗑 Limpar</button>
        }
    </text>;

    private void ExecutarLimpeza(Alvo alvo)
    {
        var quantos = alvo.Quantos();
        alvo.Limpar();
        _limpando = null;

        Recarregar();
        if (_diametros.All(d => d.Id != _vVentilador))
            _vVentilador = _diametros.FirstOrDefault()?.Id ?? "";
        TrocarVentilador();

        _msg = $"Limpo: {quantos} {alvo.Explica}.";
    }

    /// <summary>
    /// A rotação máxima daquele modelo. Texto vazio tira o modelo da lista —
    /// é como a equipe apaga uma linha digitando.
    /// </summary>
    private void DefinirRpm(Equipamento eq, string texto)
    {
        texto = texto.Trim();

        if (texto.Length == 0)
        {
            Repo.Apagar(eq.Id);
            _msg = $"{eq.Rotulo}: modelo removido.";
        }
        else if (int.TryParse(texto, out var rpm) && rpm > 0)
        {
            eq.RpmMax = rpm;
            Repo.Salvar(eq);
            _msg = $"{eq.Rotulo}: máx. {rpm} rpm.";
        }
        else
        {
            _msg = $"\"{texto}\" não é uma rotação válida.";
        }

        Recarregar();
        Verificar();
    }

    // ---------- a lista cruzada ----------

    /// <summary>
    /// As combinações na ordem da tela: a do cadastro de ventiladores e, dentro
    /// dele, a dos cubos. É a mesma leitura da matriz, linha por linha.
    /// </summary>
    private List<Equipamento> Combinacoes()
    {
        int Pos(string serie, string tipo, string rotulo) =>
            _itens.FirstOrDefault(i => i.Serie == serie && i.Tipo == tipo && i.Rotulo == rotulo)
                ?.Ordem ?? int.MaxValue;

        var filtro = _filtro.Trim();

        return _todos
            .Where(e => filtro.Length == 0 || Casa(e, filtro))
            .OrderBy(e => Pos(e.Serie, ItemModelo.TipoVentilador, e.Diametro))
            .ThenBy(e => Pos(e.Serie, ItemModelo.TipoCubo, e.Cubo))
            // o mesmo par pode ter mais de um modelo: FB/HB e estagiamento
            // desempatam, para as linhas não trocarem de lugar a cada leitura
            .ThenBy(e => e.FbHb, StringComparer.OrdinalIgnoreCase)
            .ThenBy(e => e.Estagios, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    /// <summary>
    /// A página que realmente dá para mostrar. Filtrar ou apagar encurta a
    /// lista, e a página guardada pode ter ficado depois do fim — o número
    /// mostrado e as linhas mostradas têm de sair do mesmo cálculo, senão a
    /// tela diz "31–1 de 1".
    /// </summary>
    private int PaginaValida(int total) => _porPagina == 0
        ? 0
        : Math.Clamp(_pagina, 0, Math.Max(0, (total - 1) / _porPagina));

    private int Primeira => PaginaValida(Combinacoes().Count) * _porPagina;

    private int Ultima => _porPagina == 0
        ? Combinacoes().Count
        : Math.Min(Primeira + _porPagina, Combinacoes().Count);

    /// <summary>As linhas que a página atual mostra.</summary>
    private List<Equipamento> DaPagina()
    {
        var todas = Combinacoes();
        return _porPagina == 0 ? todas : todas.Skip(Primeira).Take(_porPagina).ToList();
    }

    private void TrocarTamanho(string texto)
    {
        _porPagina = int.TryParse(texto, out var n) ? n : 30;
        _pagina = 0;
    }

    /// <summary>Filtrar volta para a primeira página — senão some tudo da tela.</summary>
    private void Filtrar(string texto)
    {
        _filtro = texto;
        _pagina = 0;
    }

    private static bool Casa(Equipamento e, string filtro) =>
        new[] { e.Serie, e.Diametro, e.Cubo, e.Codigo, e.FbHb, e.Estagios, e.RpmMax.ToString() }
            .Any(t => t.Contains(filtro, StringComparison.OrdinalIgnoreCase));

    private void TrocarSerieNova(string serie)
    {
        _combSerie = serie;
        // os ventiladores e os cubos oferecidos são os daquela série: o que
        // estava escolhido não vale mais
        AjustarNovaCombinacao();
    }

    /// <summary>Deixa os seletores da nova combinação apontando para algo que existe.</summary>
    private void AjustarNovaCombinacao()
    {
        var vents = _diametros.Where(i => i.Serie == _combSerie).Select(i => i.Rotulo).ToList();
        var cubos = _cubos.Where(i => i.Serie == _combSerie).Select(i => i.Rotulo).ToList();

        if (!vents.Contains(_combVentilador)) _combVentilador = vents.FirstOrDefault() ?? "";
        if (!cubos.Contains(_combCubo)) _combCubo = cubos.FirstOrDefault() ?? "";
    }

    private void IncluirCombinacao()
    {
        var vent = _combVentilador.Trim();
        var cubo = _combCubo.Trim();

        if (vent.Length == 0 || cubo.Length == 0)
        {
            _msg = "Digite o ventilador e o cubo — ou escolha na listinha do campo.";
            return;
        }

        var fbHb = _combFbHb.Trim();

        if (Achar(_combSerie, vent, cubo, fbHb, _combEstagios) is not null)
        {
            _msg = $"{_combSerie} {vent} / {cubo} com esse FB/HB e estagiamento já está na lista.";
            return;
        }

        if (_combRpm <= 0)
        {
            _msg = "A rotação máxima precisa ser maior que zero.";
            return;
        }

        // rótulo digitado que ainda não existe entra no cadastro agora: é o que
        // permite criar um equipamento sem passar por outra tela
        var novos = GarantirRotulo(ItemModelo.TipoVentilador, vent)
                  + GarantirRotulo(ItemModelo.TipoCubo, cubo);

        Repo.Salvar(new Equipamento
        {
            Serie = _combSerie, Diametro = vent, Cubo = cubo,
            FbHb = fbHb, Estagios = _combEstagios,
            RpmMax = _combRpm,
        });
        _msg = $"{_combSerie} {vent} / {cubo}: modelo incluído.";

        Recarregar();
        Verificar();

        if (novos > 0)
            _msg += novos == 1 ? " Um rótulo novo entrou no cadastro." : " Dois rótulos novos entraram no cadastro.";
    }

    /// <summary>
    /// Garante que o rótulo existe no cadastro da série escolhida. Devolve 1 se
    /// precisou criar.
    /// </summary>
    private int GarantirRotulo(string tipo, string rotulo)
    {
        var lista = _itens.Where(i => i.Tipo == tipo).ToList();
        if (lista.Any(i => i.Serie == _combSerie &&
                           i.Rotulo.Equals(rotulo, StringComparison.OrdinalIgnoreCase)))
        {
            return 0;
        }

        Itens.Salvar(new ItemModelo
        {
            Serie = _combSerie, Tipo = tipo, Rotulo = rotulo,
            Ordem = lista.Count == 0 ? 1 : lista.Max(i => i.Ordem) + 1,
        });
        return 1;
    }

    private void DefinirCodigo(Equipamento eq, string texto)
    {
        var codigo = texto.Trim();
        if (codigo == eq.Codigo) return;

        eq.Codigo = codigo;
        Repo.Salvar(eq);
        _msg = $"{eq.Serie} {eq.Diametro} / {eq.Cubo}: " +
               (codigo.Length > 0 ? $"código {codigo}" : "sem código");
    }

    /// <summary>As três moedas em que a equipe cadastra preço.</summary>
    private enum Moeda { Usd, Clp, Brl }

    private static string Rotulo(Moeda m) => m switch
    {
        Moeda.Usd => "USD", Moeda.Clp => "CLP", _ => "R$",
    };

    private static string ValorDe(Equipamento eq, Moeda m) => m switch
    {
        Moeda.Usd => eq.PrecoUsd, Moeda.Clp => eq.PrecoClp, _ => eq.Preco,
    };

    /// <summary>Um dos três campos de preço da linha.</summary>
    private RenderFragment PrecoDe(Equipamento eq, Moeda moeda) => @<text>
        <input class="cell" style="max-width:100px; text-align:right" placeholder="—"
               value="@ValorDe(eq, moeda)"
               @onchange="a => DefinirPreco(eq, moeda, a.Value?.ToString() ?? string.Empty)" />
    </text>;

    private void DefinirPreco(Equipamento eq, Moeda moeda, string texto)
    {
        var preco = texto.Trim();
        if (preco == ValorDe(eq, moeda)) return;

        if (preco.Length > 0 && DadosExcel.Numero(preco) is null)
        {
            _msg = $"\"{preco}\" não parece um preço. Use 1234,56 ou 1234.56.";
            Recarregar();   // devolve o campo ao valor gravado
            return;
        }

        switch (moeda)
        {
            case Moeda.Usd: eq.PrecoUsd = preco; break;
            case Moeda.Clp: eq.PrecoClp = preco; break;
            default: eq.Preco = preco; break;
        }
        Repo.Salvar(eq);

        _msg = $"{eq.Serie} {eq.Diametro} / {eq.Cubo}: " +
               (preco.Length > 0 ? $"{Rotulo(moeda)} {preco}" : $"{Rotulo(moeda)} apagado");
    }

    /// <summary>
    /// O frame máximo desta combinação, num padrão. Em branco vale o limite
    /// mais grosso, o da tabela <em>Motor máximo por cubo</em>.
    ///
    /// É um campo com <c>list</c>, não um <c>select</c>: com 98 linhas na tela,
    /// dois selects por linha repetiam a escada inteira 196 vezes — quase quatro
    /// mil elementos só de opção, que o Blazor tinha de montar e comparar a cada
    /// desenho. O <c>datalist</c> aparece uma vez só e todas as linhas apontam
    /// para ele; para quem usa, continua abrindo a mesma lista ao clicar.
    /// </summary>
    private RenderFragment FrameMax(Equipamento eq, string padrao) => @<text>
        <input class="cell" style="max-width:130px" list="@("escada-" + padrao)"
               placeholder="do cubo" value="@eq.FrameMaximo(padrao)"
               @onchange="a => DefinirFrameMax(eq, padrao, a.Value?.ToString() ?? string.Empty)" />
    </text>;

    private void DefinirFrameMax(Equipamento eq, string padrao, string frame)
    {
        frame = frame.Trim();
        var nema = padrao.Equals("NEMA", StringComparison.OrdinalIgnoreCase);
        if (frame == (nema ? eq.FrameMaxNema : eq.FrameMaxIec)) return;

        if (nema) eq.FrameMaxNema = frame; else eq.FrameMaxIec = frame;
        Repo.Salvar(eq);

        _msg = $"{eq.Serie} {eq.Diametro} / {eq.Cubo}: motor máximo {padrao} " +
               (frame.Length > 0 ? frame : "= o do cubo");
    }

    /// <summary>FB/HB é texto livre por enquanto — a equipe ainda vai dizer os valores.</summary>
    private void DefinirFbHb(Equipamento eq, string texto)
    {
        var valor = texto.Trim();
        if (valor == eq.FbHb) return;

        Rechavear(eq, valor, eq.Estagios,
            valor.Length > 0 ? $"FB/HB {valor}" : "FB/HB apagado");
    }

    private void DefinirEstagios(Equipamento eq, string texto)
    {
        var valor = texto.Trim();
        if (valor == eq.Estagios) return;

        Rechavear(eq, eq.FbHb, valor,
            valor.Length > 0 ? $"{valor} estágio(s)" : "estágios em branco");
    }

    /// <summary>
    /// FB/HB e nº de estágios fazem parte da identidade do modelo — mexer neles
    /// não é editar um campo, é virar outro modelo. Então a linha é regravada
    /// com a chave nova e a antiga sai.
    /// </summary>
    private void Rechavear(Equipamento eq, string fbHb, string estagios, string oQueMudou)
    {
        if (Achar(eq.Serie, eq.Diametro, eq.Cubo, fbHb, estagios) is not null)
        {
            _msg = $"{eq.Serie} {eq.Diametro} / {eq.Cubo} já tem um modelo com esse " +
                    "FB/HB e estagiamento — dois modelos iguais não podem existir.";
            _recusas++;
            Recarregar();
            return;
        }

        var idAntigo = eq.Id;
        eq.FbHb = fbHb;
        eq.Estagios = estagios;

        Repo.Regravar(idAntigo, eq);

        _msg = $"{eq.Serie} {eq.Diametro} / {eq.Cubo}: {oQueMudou}";
        Recarregar();
    }

    private void ApagarCombinacao(Equipamento eq)
    {
        Repo.Apagar(eq.Id);
        _apagarComb = null;
        _msg = $"{eq.Serie} {eq.Diametro} / {eq.Cubo}: combinação removida.";
        Recarregar();
        Verificar();
    }

    // ---------- Excel de cada tabela ----------

    private string SubirModelos(Stream fluxo)
    {
        var (linhas, avisos) = DadosExcel.ImportarModelos(fluxo, Repo);
        return Resumo(linhas, "equipamento(s)", avisos);
    }

    private static string Resumo(int linhas, string oQue, List<string> avisos)
    {
        var texto = linhas > 0 ? $"{linhas} {oQue} gravado(s)." : "Nada foi gravado.";
        return avisos.Count > 0 ? texto + " " + string.Join(" ", avisos) : texto;
    }

    /// <summary>Depois de subir uma planilha, relê tudo e mostra o resumo.</summary>
    private void DepoisDeImportar(string resumo)
    {
        // a planilha pode ter trazido combinação com rótulo que ainda não
        // existe na lista — é o único momento em que semear faz diferença
        Itens.SemearDaMatriz(Repo.Todos());
        Itens.NormalizarOrdem();

        Recarregar();
        if (_diametros.All(d => d.Id != _vVentilador))
            _vVentilador = _diametros.FirstOrDefault()?.Id ?? "";
        TrocarVentilador();
        _msg = resumo;
    }

    // ---------- aparência dos avisos ----------

    private static string EstiloRotacao(RegraRotacao.Situacao s) => s switch
    {
        RegraRotacao.Situacao.Ok => "aviso aviso-ok",
        RegraRotacao.Situacao.AcimaDaRotacao => "aviso aviso-alerta",
        _ => "aviso aviso-erro",
    };

    private static string IconeRotacao(RegraRotacao.Situacao s) => s switch
    {
        RegraRotacao.Situacao.Ok => "✓",
        RegraRotacao.Situacao.AcimaDaRotacao => "⚠",
        _ => "✕",
    };

    private static string EstiloMotor(RegraMotor.Situacao s) => s switch
    {
        RegraMotor.Situacao.Ok => "aviso aviso-ok",
        RegraMotor.Situacao.AcimaDoLimite => "aviso aviso-alerta",
        RegraMotor.Situacao.SemLimite => "aviso aviso-neutro",
        _ => "aviso aviso-erro",
    };

    private static string IconeMotor(RegraMotor.Situacao s) => s switch
    {
        RegraMotor.Situacao.Ok => "✓",
        RegraMotor.Situacao.AcimaDoLimite => "⚠",
        RegraMotor.Situacao.SemLimite => "•",
        _ => "✕",
    };
}
