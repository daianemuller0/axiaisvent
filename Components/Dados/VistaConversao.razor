@inject ConversaoRepository Repo
@inject EquipamentoRepository Equipamentos
@inject MotorRepository Motores
@inject CaracteristicaRepository Caracteristicas
@inject PrecoReferenciaRepository Referencias

<p class="subtitle">
    Converte o custo em <strong>peso chileno (CLP)</strong> para <strong>dólar</strong>
    (o real está fora de uso por enquanto). Digite a taxa do dia e aplique: o USD de cada item de
    <em>Modelos</em>, <em>Motores</em>, <em>Características</em> e das tabelas de custo por
    referência são recalculados a partir do CLP, e as propostas já passam a usar os valores novos.
    Item sem custo em CLP não é tocado.
</p>

<div class="panel" style="margin-bottom:16px">
    <div class="toolbar" style="margin-bottom:0; flex-wrap:wrap">
        <strong>Taxas</strong>

        <label style="display:flex; align-items:center; gap:6px">
            <span>1 USD =</span>
            <input class="cell" style="width:110px" inputmode="decimal" placeholder="ex.: 950"
                   value="@_clpPorUsd" @oninput="DigitouUsd" />
            <span>CLP</span>
        </label>

        @if (Moedas.UsaReal)
        {
        <label style="display:flex; align-items:center; gap:6px">
            <span>1 R$ =</span>
            <input class="cell" style="width:110px" inputmode="decimal" placeholder="ex.: 180"
                   value="@_clpPorBrl" @oninput="DigitouBrl" />
            <span>CLP</span>
        </label>
        }

        <button class="btn-ghost" @onclick="SalvarTaxas">Salvar taxas</button>

        @if (_atualizadaEm is not null)
        {
            <span class="subtitle" style="margin:0">taxas gravadas em @_atualizadaEm</span>
        }
    </div>

    <p class="subtitle" style="margin:10px 0 0">
        @if (ExemploUsd is not null || (Moedas.UsaReal && ExemploBrl is not null))
        {
            <span>Conferência: 1.000.000 CLP =</span>
            @if (ExemploUsd is not null)
            {
                <strong> USD @ExemploUsd</strong>
            }
            @if (Moedas.UsaReal && ExemploBrl is not null)
            {
                <strong> · R$ @ExemploBrl</strong>
            }
        }
        else
        {
            <span>Informe a taxa. Pode usar vírgula ou ponto (950,5 ou 950.5).</span>
        }
    </p>
</div>

<div class="panel" style="margin-bottom:16px">
    <div class="toolbar" style="margin-bottom:0; flex-wrap:wrap">
        <strong>Aplicar a todos os itens</strong>

        <label style="display:flex; align-items:center; gap:6px">
            <input type="checkbox" checked="@_somenteVazios"
                   @onchange="e => MudouOpcao((bool?)e.Value ?? false)" />
            <span>só preencher o que está vazio</span>
        </label>

        @if (_previa is null)
        {
            <button class="btn-primary" disabled="@(!TemTaxa)" @onclick="Prever">Ver o que muda</button>
        }
        else
        {
            <button class="btn-ghost" @onclick="Cancelar">Cancelar</button>
        }
    </div>

    <p class="subtitle" style="margin:10px 0 0">
        Por padrão o USD já preenchido é <strong>substituído</strong> pelo valor
        convertido — é o que faz a taxa nova subir para tudo. Marque a opção acima para
        preservar o que já foi digitado à mão.
    </p>

    @if (_previa is not null)
    {
        @if (_previa.Total == 0)
        {
            <div class="aviso aviso-alerta" style="margin-top:12px">
                Nada a atualizar: @(_previa.ComClp == 0 ? "nenhum item tem custo em CLP." : "os valores já estão de acordo com as taxas.")
            </div>
        }
        else
        {
            <div class="aviso aviso-alerta" style="margin-top:12px">
                ⚠ Vão ser atualizados <strong>@_previa.Total</strong> custo(s):
                @_previa.Modelos modelo(s), @_previa.Motores motor(es),
                @_previa.Caracteristicas subitem(ns) de características e
                @_previa.Referencias linha(s) de custo por referência.
                <strong>Não dá para desfazer</strong> — mas basta digitar a taxa certa e aplicar de novo.
            </div>
            <div class="toolbar" style="margin:12px 0 0">
                <button class="btn-primary" @onclick="Aplicar">Sim, aplicar a todos</button>
                <button class="btn-ghost" @onclick="Cancelar">Cancelar</button>
            </div>
        }
    }
</div>

@if (_msg is not null)
{
    <div class="@(_erro ? "aviso aviso-erro" : "aviso aviso-ok")" style="margin-bottom:14px">@_msg</div>
}

@code {
    private string _clpPorUsd = "";
    private string _clpPorBrl = "";
    private string? _atualizadaEm;
    private bool _somenteVazios;

    /// <summary>A prévia que a pessoa está avaliando. Nula = nada a confirmar.</summary>
    private ResumoConversao? _previa;

    private string? _msg;
    private bool _erro;

    protected override void OnInitialized()
    {
        var t = Repo.Ler();
        _clpPorUsd = t.ClpPorUsd;
        _clpPorBrl = t.ClpPorBrl;
        _atualizadaEm = Formatar(t.AtualizadaEm);
    }

    private bool TemTaxa =>
        ConversaoRepository.Taxa(_clpPorUsd) is not null ||
        (Moedas.UsaReal && ConversaoRepository.Taxa(_clpPorBrl) is not null);

    private string? ExemploUsd => ConversaoRepository.Taxa(_clpPorUsd) is { } t
        ? Math.Round(1_000_000m / t, 2).ToString("N2", Pt)
        : null;

    private string? ExemploBrl => ConversaoRepository.Taxa(_clpPorBrl) is { } t
        ? Math.Round(1_000_000m / t, 2).ToString("N2", Pt)
        : null;

    private static readonly System.Globalization.CultureInfo Pt = new("pt-BR");

    private static string? Formatar(string iso) =>
        DateTime.TryParse(iso, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d)
            ? d.ToString("dd/MM/yyyy HH:mm", Pt)
            : null;

    private TaxasDeConversao Taxas() => new()
    {
        ClpPorUsd = _clpPorUsd.Trim(), ClpPorBrl = _clpPorBrl.Trim(),
    };

    /// <summary>Mexer na taxa invalida a prévia: ela foi calculada com outro número.</summary>
    private void DigitouUsd(ChangeEventArgs e)
    {
        _clpPorUsd = e.Value?.ToString() ?? "";
        _previa = null;
        _msg = null;
    }

    private void DigitouBrl(ChangeEventArgs e)
    {
        _clpPorBrl = e.Value?.ToString() ?? "";
        _previa = null;
        _msg = null;
    }

    private void MudouOpcao(bool valor)
    {
        _somenteVazios = valor;
        _previa = null;
    }

    private bool TaxasValidas()
    {
        // digitou algo, mas não deu para ler como número positivo: avisa em vez de ignorar calado
        if (_clpPorUsd.Trim().Length > 0 && ConversaoRepository.Taxa(_clpPorUsd) is null)
        {
            Aviso("A taxa do dólar não é um número maior que zero.", erro: true);
            return false;
        }
        if (Moedas.UsaReal && _clpPorBrl.Trim().Length > 0 && ConversaoRepository.Taxa(_clpPorBrl) is null)
        {
            Aviso("A taxa do real não é um número maior que zero.", erro: true);
            return false;
        }
        return true;
    }

    private void SalvarTaxas()
    {
        if (!TaxasValidas()) return;

        var t = Taxas();
        Repo.Salvar(t);
        _atualizadaEm = Formatar(t.AtualizadaEm);
        Aviso("Taxas gravadas. Para atualizar os custos, use “Ver o que muda”.");
    }

    private void Prever()
    {
        _msg = null;
        if (!TaxasValidas()) return;

        _previa = Repo.Aplicar(Taxas(), _somenteVazios, gravar: false,
            Equipamentos, Motores, Caracteristicas, Referencias);
    }

    private void Cancelar() => _previa = null;

    private void Aplicar()
    {
        if (!TaxasValidas()) return;

        var t = Taxas();
        Repo.Salvar(t);
        _atualizadaEm = Formatar(t.AtualizadaEm);

        var feito = Repo.Aplicar(t, _somenteVazios, gravar: true,
            Equipamentos, Motores, Caracteristicas, Referencias);

        _previa = null;
        Aviso($"Taxas aplicadas: {feito.Total} custo(s) atualizado(s) — " +
              $"{feito.Modelos} modelo(s), {feito.Motores} motor(es), " +
              $"{feito.Caracteristicas} subitem(ns) e {feito.Referencias} linha(s) por referência.");
    }

    private void Aviso(string texto, bool erro = false)
    {
        _msg = texto;
        _erro = erro;
    }
}
