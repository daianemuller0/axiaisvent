@inject CaracteristicaRepository Repo

<p class="subtitle">
    As listas de características do equipamento. Cada item tem um <strong>código</strong> —
    juntando os códigos escolhidos em cada lista monta-se o código do equipamento, e é por
    isso que a ordem dos grupos e dos itens importa.
</p>

<!-- ---------- subir em massa ---------- -->
<div class="panel" style="margin-bottom:16px">
    <div class="toolbar" style="margin-bottom:0; flex-wrap:wrap">
        <strong>Subir em massa</strong>
        <InputFile OnChange="Importar" accept=".xlsx,.xlsm,.csv,.txt" class="cell" />

        <label style="display:flex; align-items:center; gap:6px">
            <input type="radio" name="modoImp" checked="@(_modo == Modo.Atualizar)"
                   @onchange="@(() => _modo = Modo.Atualizar)" />
            <span>atualizar e acrescentar</span>
        </label>
        <label style="display:flex; align-items:center; gap:6px">
            <input type="radio" name="modoImp" checked="@(_modo == Modo.Substituir)"
                   @onchange="@(() => _modo = Modo.Substituir)" />
            <span>substituir as listas</span>
        </label>

        @if (_lendo)
        {
            <span class="saved-flag">lendo o arquivo…</span>
        }
    </div>
    <p class="subtitle" style="margin:10px 0 0">
        Arquivo <strong>.xlsx</strong>, <strong>.xlsm</strong> ou <strong>.csv</strong> com as
        colunas <strong>Grupo</strong>, <strong>Valor</strong> e <strong>Código</strong>
        (código opcional). Em <em>atualizar e acrescentar</em>, item que já existe tem só o
        código atualizado e item novo entra no fim do grupo — é o modo de subir os códigos
        depois, sem refazer as listas.
    </p>
</div>

@if (_msg is not null)
{
    <div class="@(_erro ? "aviso aviso-erro" : "aviso aviso-ok")" style="margin-bottom:14px">@_msg</div>
}

<!-- ---------- incluir item ---------- -->
<div class="panel" style="margin-bottom:16px">
    <div class="toolbar" style="margin-bottom:0; flex-wrap:wrap">
        <strong>Incluir item</strong>

        <select class="cell" @bind="_novoGrupo">
            @foreach (var g in _grupos)
            {
                <option value="@g">@g</option>
            }
        </select>

        <input class="cell" style="min-width:230px" placeholder="Valor (ex.: Com TRENÓ)"
               @bind="_novoValor" @bind:event="oninput" @onkeydown="TeclaIncluir" />
        <input class="cell" style="width:130px" placeholder="Código"
               @bind="_novoCodigo" @bind:event="oninput" @onkeydown="TeclaIncluir" />

        <button class="btn-primary" @onclick="Incluir" disabled="@(_novoValor.Trim().Length == 0)">
            + Incluir
        </button>
    </div>
</div>

<!-- ---------- as listas ---------- -->
<div class="tabs">
    <button class="tab @(_grupoFiltro == "" ? "active" : "")" @onclick="@(() => _grupoFiltro = "")">
        Todas <span class="tab-badge">@_todas.Count</span>
    </button>
    @foreach (var g in _grupos)
    {
        var grupo = g;
        <button class="tab @(_grupoFiltro == grupo ? "active" : "")" @onclick="@(() => _grupoFiltro = grupo)">
            @grupo <span class="tab-badge">@_todas.Count(c => c.Grupo == grupo)</span>
        </button>
    }
</div>

<div class="toolbar" style="flex-wrap:wrap">
    <span class="subtitle" style="margin:0">
        @_todas.Count item(ns) em @_grupos.Count lista(s) · @_todas.Count(c => c.Codigo.Length > 0) com código
    </span>
    <span style="flex:1"></span>
    <input class="cell" style="min-width:240px" placeholder="Procurar valor ou código…"
           @bind="_busca" @bind:event="oninput" />
</div>

@foreach (var grupo in _grupos.Where(g => _grupoFiltro.Length == 0 || g == _grupoFiltro))
{
    var itens = Filtrados(grupo);
    if (itens.Count == 0) { continue; }

    <h3 style="margin:20px 0 8px">@grupo <span class="val-count">@itens.Count</span></h3>
    <div class="panel" style="padding:0; overflow-x:auto">
        <table class="grid">
            <thead>
                <tr>
                    <th class="nowrap" style="width:70px">Ordem</th>
                    <th class="nowrap">Valor</th>
                    <th class="nowrap" style="width:160px">Código</th>
                    <th class="nowrap" style="width:130px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in itens)
                {
                    var item = c;
                    <tr @key="item.Id">
                        <td class="center nowrap">@Posicao(item)</td>
                        <td>
                            <input class="cell" value="@item.Valor"
                                   @onchange="e => Renomear(item, e.Value?.ToString() ?? string.Empty)" />
                        </td>
                        <td>
                            <input class="cell" style="max-width:140px" value="@item.Codigo" placeholder="—"
                                   @onchange="e => DefinirCodigo(item, e.Value?.ToString() ?? string.Empty)" />
                        </td>
                        <td class="nowrap center">
                            <button class="btn-link" title="Subir" @onclick="() => Mover(item, -1)">↑</button>
                            <button class="btn-link" title="Descer" @onclick="() => Mover(item, 1)">↓</button>
                            <button class="btn-link" title="Apagar" @onclick="() => Apagar(item)">✕</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private enum Modo { Atualizar, Substituir }

    private const long TamanhoMaximo = 20L * 1024 * 1024;

    private List<Caracteristica> _todas = new();
    private List<string> _grupos = new();

    private Modo _modo = Modo.Atualizar;
    private string _busca = "";
    /// <summary>Lista em foco; vazio mostra todas.</summary>
    private string _grupoFiltro = "";
    private bool _lendo;

    private string _novoGrupo = "";
    private string _novoValor = "";
    private string _novoCodigo = "";

    private string? _msg;
    private bool _erro;

    protected override void OnInitialized()
    {
        Repo.SemearSeVazio();
        Recarregar();
        _novoGrupo = _grupos.FirstOrDefault() ?? "";
    }

    private void Recarregar()
    {
        _todas = Repo.Todas();
        _grupos = _todas.Select(c => c.Grupo).Distinct()
            .OrderBy(CaracteristicasSeed.PosicaoDoGrupo).ThenBy(g => g).ToList();
    }

    private List<Caracteristica> DoGrupo(string grupo) =>
        _todas.Where(c => c.Grupo == grupo).OrderBy(c => c.Ordem).ToList();

    private List<Caracteristica> Filtrados(string grupo)
    {
        var itens = DoGrupo(grupo);
        if (_busca.Trim().Length == 0) return itens;

        var busca = _busca.Trim();
        return itens.Where(c =>
            c.Valor.Contains(busca, StringComparison.OrdinalIgnoreCase) ||
            c.Codigo.Contains(busca, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    /// <summary>O número na tela é a posição na lista, não o campo Ordem gravado.</summary>
    private int Posicao(Caracteristica item) =>
        DoGrupo(item.Grupo).FindIndex(c => c.Id == item.Id) + 1;

    // ---------- importação ----------

    private async Task Importar(InputFileChangeEventArgs e)
    {
        var arquivo = e.File;
        _msg = null;
        _erro = false;

        if (!PlanilhaIO.ExtensaoAceita(arquivo.Name))
        {
            Aviso($"\"{arquivo.Name}\" não é um arquivo aceito. Use .xlsx, .xlsm ou .csv.", erro: true);
            return;
        }

        _lendo = true;
        try
        {
            using var memoria = new MemoryStream();
            await arquivo.OpenReadStream(TamanhoMaximo).CopyToAsync(memoria);
            memoria.Position = 0;

            var lido = PlanilhaIO.Ler(memoria, arquivo.Name);

            var iGrupo = Coluna(lido.Colunas, "grupo", "lista");
            var iValor = Coluna(lido.Colunas, "valor", "item", "descrição", "descricao");
            var iCodigo = Coluna(lido.Colunas, "código", "codigo", "cod");

            if (iGrupo < 0 || iValor < 0)
            {
                Aviso("O arquivo precisa ter as colunas \"Grupo\" e \"Valor\" no cabeçalho. " +
                      $"Encontrei: {string.Join(", ", lido.Colunas)}.", erro: true);
                return;
            }

            if (_modo == Modo.Substituir)
            {
                foreach (var atual in _todas) Repo.Apagar(atual.Id);
                _todas = new List<Caracteristica>();
            }

            int novos = 0, atualizados = 0, ignorados = 0;
            var porGrupo = _todas.GroupBy(c => c.Grupo)
                .ToDictionary(g => g.Key, g => g.Max(c => c.Ordem));

            foreach (var linha in lido.Linhas)
            {
                var grupo = linha.Valor(iGrupo).Trim();
                var valor = linha.Valor(iValor).Trim();
                var codigo = iCodigo >= 0 ? linha.Valor(iCodigo).Trim() : "";

                if (grupo.Length == 0 || valor.Length == 0) { ignorados++; continue; }

                var existente = _todas.FirstOrDefault(c =>
                    c.Grupo == grupo && c.Valor.Equals(valor, StringComparison.OrdinalIgnoreCase));

                if (existente is not null)
                {
                    // já existe: a importação só traz o código (é o caso de subir
                    // os códigos depois, sem refazer as listas)
                    if (codigo.Length > 0 && codigo != existente.Codigo)
                    {
                        existente.Codigo = codigo;
                        Repo.Salvar(existente);
                        atualizados++;
                    }
                    continue;
                }

                var ordem = porGrupo.TryGetValue(grupo, out var ultima) ? ultima + 1 : 1;
                porGrupo[grupo] = ordem;

                var novo = new Caracteristica
                {
                    Grupo = grupo, Valor = valor, Codigo = codigo, Ordem = ordem,
                };
                Repo.Salvar(novo);
                _todas.Add(novo);
                novos++;
            }

            Recarregar();
            if (!_grupos.Contains(_novoGrupo)) _novoGrupo = _grupos.FirstOrDefault() ?? "";
            if (_grupoFiltro.Length > 0 && !_grupos.Contains(_grupoFiltro)) _grupoFiltro = "";

            var resumo = $"\"{arquivo.Name}\": {novos} item(ns) novo(s), {atualizados} código(s) atualizado(s)";
            if (ignorados > 0) resumo += $", {ignorados} linha(s) ignorada(s) por falta de grupo ou valor";
            Aviso(resumo + ".");
        }
        catch (Exception ex)
        {
            Aviso("Não consegui ler o arquivo: " + ex.Message, erro: true);
        }
        finally
        {
            _lendo = false;
        }
    }

    /// <summary>Acha a coluna pelo cabeçalho, aceitando alguns sinônimos.</summary>
    private static int Coluna(List<string> colunas, params string[] nomes)
    {
        for (var i = 0; i < colunas.Count; i++)
        {
            var c = colunas[i].Trim();
            if (nomes.Any(n => c.Equals(n, StringComparison.OrdinalIgnoreCase))) return i;
        }
        return -1;
    }

    // ---------- edição ----------

    private void Incluir()
    {
        var valor = _novoValor.Trim();
        if (valor.Length == 0 || _novoGrupo.Length == 0) return;

        if (_todas.Any(c => c.Grupo == _novoGrupo &&
                            c.Valor.Equals(valor, StringComparison.OrdinalIgnoreCase)))
        {
            Aviso($"\"{valor}\" já existe na lista {_novoGrupo}.", erro: true);
            return;
        }

        var doGrupo = DoGrupo(_novoGrupo);
        Repo.Salvar(new Caracteristica
        {
            Grupo = _novoGrupo,
            Valor = valor,
            Codigo = _novoCodigo.Trim(),
            Ordem = doGrupo.Count == 0 ? 1 : doGrupo[^1].Ordem + 1,
        });

        Recarregar();
        _novoValor = "";
        _novoCodigo = "";
        Aviso($"\"{valor}\" incluído no fim da lista {_novoGrupo}.");
    }

    private void TeclaIncluir(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Incluir();
    }

    /// <summary>O valor faz parte do id, então renomear é apagar e regravar.</summary>
    private void Renomear(Caracteristica item, string texto)
    {
        var valor = texto.Trim();
        if (valor.Length == 0 || valor == item.Valor) return;

        if (_todas.Any(c => c.Grupo == item.Grupo && c.Id != item.Id &&
                            c.Valor.Equals(valor, StringComparison.OrdinalIgnoreCase)))
        {
            Aviso($"\"{valor}\" já existe na lista {item.Grupo}.", erro: true);
            Recarregar();
            return;
        }

        var antigo = item.Valor;
        Repo.Apagar(item.Id);
        Repo.Salvar(new Caracteristica
        {
            Grupo = item.Grupo, Valor = valor, Codigo = item.Codigo, Ordem = item.Ordem,
        });

        Recarregar();
        Aviso($"\"{antigo}\" passou a se chamar \"{valor}\".");
    }

    private void DefinirCodigo(Caracteristica item, string texto)
    {
        var codigo = texto.Trim();
        if (codigo == item.Codigo) return;

        item.Codigo = codigo;
        Repo.Salvar(item);
        Recarregar();
        Aviso(codigo.Length == 0
            ? $"Código de \"{item.Valor}\" apagado."
            : $"\"{item.Valor}\": código {codigo}.");
    }

    private void Apagar(Caracteristica item)
    {
        Repo.Apagar(item.Id);
        Recarregar();
        Aviso($"\"{item.Valor}\" apagado da lista {item.Grupo}.");
    }

    private void Mover(Caracteristica item, int direcao)
    {
        var lista = DoGrupo(item.Grupo);
        var i = lista.FindIndex(c => c.Id == item.Id);
        var j = i + direcao;
        if (i < 0 || j < 0 || j >= lista.Count) return;

        var vizinho = lista[j];
        (item.Ordem, vizinho.Ordem) = (vizinho.Ordem, item.Ordem);
        Repo.Salvar(item);
        Repo.Salvar(vizinho);

        Recarregar();
        _msg = null;
    }

    private void Aviso(string texto, bool erro = false)
    {
        _msg = texto;
        _erro = erro;
    }
}
