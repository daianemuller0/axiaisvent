@inject CaracteristicaRepository Repo
@inject PrecoEquipamentoRepository Precos
@inject EquipamentoRepository Equipamentos

<p class="subtitle">
    As características do equipamento. Cada <strong>item</strong> é uma lista (Solidez,
    Base, PARTIDORES…) e cada <strong>subitem</strong> é uma opção dela, com seu
    <strong>código</strong> — juntando os códigos escolhidos em cada item monta-se o código
    do equipamento, e é por isso que a ordem dos itens e dos subitens importa.
</p>

@if (_msg is not null)
{
    <div class="@(_erro ? "aviso aviso-erro" : "aviso aviso-ok")" style="margin-bottom:14px">@_msg</div>
}

<!-- ---------- incluir item (lista nova) ---------- -->
<div class="panel" style="margin-bottom:16px">
    <div class="toolbar" style="margin-bottom:0; flex-wrap:wrap">
        <strong>Novo item</strong>
        <input class="cell" style="min-width:260px" placeholder="Nome do item (ex.: Revestimento)"
               @bind="_novoItem" @bind:event="oninput" @onkeydown="TeclaNovoItem" />
        <button class="btn-primary" @onclick="IncluirItem" disabled="@(_novoItem.Trim().Length == 0)">
            + Criar item
        </button>
        <span class="subtitle" style="margin:0">
            entra no fim da lista de itens, vazio — depois é só acrescentar os subitens
        </span>
    </div>
</div>

<!-- ---------- incluir subitem ---------- -->
<div class="panel" style="margin-bottom:16px">
    <div class="toolbar" style="margin-bottom:0; flex-wrap:wrap">
        <strong>Novo subitem</strong>

        <select class="cell" @bind="_novoGrupo">
            @foreach (var g in _grupos)
            {
                <option value="@g">@g</option>
            }
        </select>

        <input class="cell" style="min-width:230px" placeholder="Valor (ex.: Com TRENÓ)"
               @bind="_novoValor" @bind:event="oninput" @onkeydown="TeclaIncluir" />
        <input class="cell" style="width:130px" placeholder="Código"
               @bind="_novoCodigo" @bind:event="oninput" @onkeydown="TeclaIncluir" />

        <button class="btn-primary" @onclick="Incluir"
                disabled="@(_novoValor.Trim().Length == 0 || _grupos.Count == 0)">
            + Incluir
        </button>
    </div>
</div>

<!-- ---------- as listas ---------- -->
<div class="tabs">
    <button class="tab @(_grupoFiltro == "" ? "active" : "")" @onclick="@(() => _grupoFiltro = "")">
        Todos <span class="tab-badge">@_grupos.Count</span>
    </button>
    @foreach (var g in _grupos)
    {
        var grupo = g;
        <button class="tab @(_grupoFiltro == grupo ? "active" : "")" @onclick="@(() => _grupoFiltro = grupo)">
            @grupo <span class="tab-badge">@_todas.Count(c => c.Grupo == grupo)</span>
        </button>
    }
</div>

<div class="toolbar" style="flex-wrap:wrap">
    <span class="subtitle" style="margin:0">
        @_grupos.Count item(ns) · @_todas.Count subitem(ns) ·
        @_todas.Count(c => c.Codigo.Length > 0) com código ·
        @_todas.Count(c => c.Preco.Length > 0) com preço
    </span>
    @if (_limparTudo)
    {
        <span class="aviso aviso-alerta" style="margin:0; padding:5px 9px">
            Apagar os @_grupos.Count item(ns) e os @_todas.Count subitem(ns)?
        </span>
        <button class="btn-link" @onclick="LimparTudo">Sim, limpar</button>
        <button class="btn-link" @onclick="@(() => _limparTudo = false)">Cancelar</button>
    }
    else
    {
        <button class="btn-link" title="Esvaziar a aba inteira" disabled="@(_grupos.Count == 0)"
                @onclick="@(() => _limparTudo = true)">🗑 Limpar tudo</button>
    }
    <ExcelDaTabela Nome="caracteristicas"
                   Exportar="@(() => DadosExcel.ExportarCaracteristicas(Repo.Grupos(), _todas))"
                   Importar="Subir"
                   Importou="DepoisDeImportar" />
    <span style="flex:1"></span>
    <input class="cell" style="min-width:240px" placeholder="Procurar valor ou código…"
           @bind="_busca" @bind:event="oninput" />
</div>

@foreach (var g in _grupos.Where(g => _grupoFiltro.Length == 0 || g == _grupoFiltro))
{
    var grupo = g;
    var itens = Filtrados(grupo);
    var total = _todas.Count(c => c.Grupo == grupo);

    // com busca ativa, some a lista que não tem nenhum subitem casando
    if (_busca.Trim().Length > 0 && itens.Count == 0) { continue; }

    <div class="toolbar" style="margin:22px 0 8px; flex-wrap:wrap">
        <input class="cell" style="font-weight:600; min-width:280px" value="@grupo"
               @onchange="e => RenomearItem(grupo, e.Value?.ToString() ?? string.Empty)" />
        <span class="val-count">@total subitem(ns)</span>
        <button class="btn-link" title="Subir o item" @onclick="() => MoverItem(grupo, -1)">↑</button>
        <button class="btn-link" title="Descer o item" @onclick="() => MoverItem(grupo, 1)">↓</button>

        @if (_limparItem == grupo)
        {
            <span class="aviso aviso-alerta" style="padding:6px 10px">
                Apagar os @total subitem(ns) de "@grupo"? O item continua, vazio.
            </span>
            <button class="btn-link" @onclick="() => LimparItem(grupo)">Sim, limpar</button>
            <button class="btn-link" @onclick="@(() => _limparItem = null)">Cancelar</button>
        }
        else if (_apagarItem == grupo)
        {
            <span class="aviso aviso-alerta" style="padding:6px 10px">
                Apagar o item "@grupo" e os @total subitem(ns)?
            </span>
            <button class="btn-link" @onclick="() => ApagarItem(grupo)">Sim, apagar</button>
            <button class="btn-link" @onclick="@(() => _apagarItem = null)">Cancelar</button>
        }
        else
        {
            <button class="btn-link" title="Apagar os subitens e deixar o item vazio"
                    disabled="@(total == 0)"
                    @onclick="@(() => _limparItem = grupo)">🗑 Limpar</button>
            <button class="btn-link" title="Apagar o item inteiro"
                    @onclick="@(() => _apagarItem = grupo)">✕ item</button>
        }
    </div>

    @if (total == 0)
    {
        <div class="panel empty" style="padding:20px">
            Item ainda sem subitens — inclua acima, escolhendo "@grupo".
        </div>
    }
    <div class="panel" style="padding:0; overflow-x:auto; @(total == 0 ? "display:none" : "")">
        <table class="grid">
            <thead>
                <tr>
                    <th class="nowrap" style="width:70px">Ordem</th>
                    <th class="nowrap">Valor</th>
                    <th class="nowrap" style="width:160px">Código</th>
                    <th class="nowrap" style="width:120px">Preço USD</th>
                    <th class="nowrap" style="width:120px">Preço CLP</th>
                    <th class="nowrap" style="width:120px">Preço R$</th>
                    <th class="nowrap" style="width:190px">Por equipamento</th>
                    <th class="nowrap" style="width:130px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in itens)
                {
                    var item = c;
                    <tr @key="item.Id">
                        <td class="center nowrap">@Posicao(item)</td>
                        <td>
                            <input class="cell" value="@item.Valor"
                                   @onchange="e => Renomear(item, e.Value?.ToString() ?? string.Empty)" />
                        </td>
                        <td>
                            <input class="cell" style="max-width:140px" value="@item.Codigo" placeholder="—"
                                   @onchange="e => DefinirCodigo(item, e.Value?.ToString() ?? string.Empty)" />
                        </td>
                        <td>@Preco(item, Moeda.Usd)</td>
                        <td>@Preco(item, Moeda.Clp)</td>
                        <td>@Preco(item, Moeda.Brl)</td>
                        <td class="nowrap">@PorEquipamento(item)</td>
                        <td class="nowrap center">
                            <button class="btn-link" title="Subir" @onclick="() => Mover(item, -1)">↑</button>
                            <button class="btn-link" title="Descer" @onclick="() => Mover(item, 1)">↓</button>
                            <button class="btn-link" title="Apagar" @onclick="() => Apagar(item)">✕</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ---------- preço por equipamento da opção aberta ---------- *@
    @if (itens.FirstOrDefault(i => i.Id == _abertoPara) is { } opcao)
    {
        var equipamentos = EquipamentosFiltrados();

        <div class="panel" style="margin-top:10px; border-left:3px solid var(--azul, #0b3d6b)">
            <div class="toolbar" style="flex-wrap:wrap">
                <strong>@opcao.Grupo › @opcao.Valor — preço por equipamento</strong>
                <span class="val-count">@ComPrecoProprio(opcao) com preço próprio</span>

                <input class="cell" style="width:180px" placeholder="filtrar equipamento…"
                       value="@_buscaEquip"
                       @oninput="e => FiltrarEquipamentos(e.Value?.ToString() ?? string.Empty)" />

                <span class="subtitle" style="margin:0">
                    @(equipamentos.Count == 0 ? "nenhum" : $"{PrimeiraLinha + 1}–{UltimaLinha(equipamentos.Count)} de {equipamentos.Count}")
                </span>
                <button class="btn-link" disabled="@(_paginaEquip == 0)" @onclick="() => _paginaEquip--">◀</button>
                <button class="btn-link" disabled="@(UltimaLinha(equipamentos.Count) >= equipamentos.Count)"
                        @onclick="() => _paginaEquip++">▶</button>

                <span style="flex:1"></span>
                <ExcelDaTabela Nome="@($"precos-{opcao.Valor}")"
                               Exportar="@(() => DadosExcel.ExportarPrecosPorEquipamento(Precos.Todos(), _equipamentos))"
                               Importar="SubirPrecos"
                               Importou="DepoisDeImportar" />
                <button class="btn-link" @onclick="@(() => _abertoPara = null)">fechar</button>
            </div>

            <p class="subtitle" style="margin:0 0 10px">
                Linha em branco usa o preço da própria opção (@(Resumo(opcao))). Preencha só
                os equipamentos em que o tamanho muda o valor.
            </p>

            <div class="panel" style="padding:0; overflow-x:auto">
                <table class="grid">
                    <thead>
                        <tr>
                            <th class="nowrap" style="width:90px">Série</th>
                            <th class="nowrap">Fan Diameter</th>
                            <th class="nowrap">Fan Hub Diameter</th>
                            <th class="nowrap" style="width:80px">FB/HB</th>
                            <th class="nowrap" style="width:80px">Estágios</th>
                            <th class="nowrap" style="width:130px">Preço USD</th>
                            <th class="nowrap" style="width:130px">Preço CLP</th>
                            <th class="nowrap" style="width:130px">Preço R$</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in equipamentos.Skip(PrimeiraLinha).Take(PorPaginaEquip))
                        {
                            var eq = e;
                            <tr @key="@(opcao.Id + "|" + eq.Id)">
                                <td class="nowrap"><span class="val-count">@eq.Serie</span></td>
                                <td class="nowrap"><strong>@eq.Diametro</strong></td>
                                <td class="nowrap"><strong>@eq.Cubo</strong></td>
                                <td class="nowrap">@(eq.FbHb.Length > 0 ? eq.FbHb : "—")</td>
                                <td class="nowrap">@(eq.Estagios.Length > 0 ? eq.Estagios : "—")</td>
                                <td>@PrecoDoEquipamento(opcao, eq, Moeda.Usd)</td>
                                <td>@PrecoDoEquipamento(opcao, eq, Moeda.Clp)</td>
                                <td>@PrecoDoEquipamento(opcao, eq, Moeda.Brl)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private List<Caracteristica> _todas = new();
    private List<string> _grupos = new();

    private string _busca = "";

    // ---------- preço por equipamento ----------
    private List<Equipamento> _equipamentos = new();
    private Dictionary<string, PrecoEquipamento> _precos = new();
    /// <summary>Id da opção cujo painel de preços está aberto; nulo = nenhum.</summary>
    private string? _abertoPara;
    private string _buscaEquip = "";
    private int _paginaEquip;
    private const int PorPaginaEquip = 20;

    /// <summary>Lista em foco; vazio mostra todas.</summary>
    private string _grupoFiltro = "";

    private string _novoItem = "";
    private string _novoGrupo = "";
    private string _novoValor = "";
    private string _novoCodigo = "";

    /// <summary>Item aguardando confirmação para ser apagado.</summary>
    private string? _apagarItem;
    /// <summary>Item aguardando confirmação para ser esvaziado (sem apagar o item).</summary>
    private string? _limparItem;
    /// <summary>Verdadeiro enquanto o "Limpar tudo" espera confirmação.</summary>
    private bool _limparTudo;

    private string? _msg;
    private bool _erro;

    protected override void OnInitialized()
    {
        // a tabela de fábrica é carregada na abertura do sistema (BackendHost)
        Recarregar();
        _novoGrupo = _grupos.FirstOrDefault() ?? "";
    }

    private void Recarregar()
    {
        _todas = Repo.Todas();
        // a lista de itens vem da entidade própria: assim um item recém-criado,
        // ainda sem nenhum subitem, também aparece
        _grupos = Repo.Grupos().Select(g => g.Nome).ToList();

        // rede de segurança: subitem cujo item sumiu ainda assim é mostrado
        foreach (var g in _todas.Select(c => c.Grupo).Distinct())
            if (!_grupos.Contains(g)) _grupos.Add(g);
    }

    private List<Caracteristica> DoGrupo(string grupo) =>
        _todas.Where(c => c.Grupo == grupo).OrderBy(c => c.Ordem).ToList();

    private List<Caracteristica> Filtrados(string grupo)
    {
        var itens = DoGrupo(grupo);
        if (_busca.Trim().Length == 0) return itens;

        var busca = _busca.Trim();
        return itens.Where(c =>
            c.Valor.Contains(busca, StringComparison.OrdinalIgnoreCase) ||
            c.Codigo.Contains(busca, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    /// <summary>O número na tela é a posição na lista, não o campo Ordem gravado.</summary>
    private int Posicao(Caracteristica item) =>
        DoGrupo(item.Grupo).FindIndex(c => c.Id == item.Id) + 1;

    // ---------- itens (as listas) ----------

    private void IncluirItem()
    {
        var nome = _novoItem.Trim();
        if (nome.Length == 0) return;

        if (_grupos.Any(g => g.Equals(nome, StringComparison.OrdinalIgnoreCase)))
        {
            Aviso($"O item \"{nome}\" já existe.", erro: true);
            return;
        }

        Repo.GarantirGrupo(nome);
        Recarregar();
        _novoGrupo = nome;
        _novoItem = "";
        Aviso($"Item \"{nome}\" criado. Agora inclua os subitens dele.");
    }

    private void TeclaNovoItem(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") IncluirItem();
    }

    private void RenomearItem(string de, string texto)
    {
        var para = texto.Trim();
        if (para.Length == 0 || para == de) { Recarregar(); return; }

        if (_grupos.Any(g => g != de && g.Equals(para, StringComparison.OrdinalIgnoreCase)))
        {
            Aviso($"O item \"{para}\" já existe.", erro: true);
            Recarregar();
            return;
        }

        Repo.RenomearGrupo(de, para);
        Recarregar();
        if (_grupoFiltro == de) _grupoFiltro = para;
        if (_novoGrupo == de) _novoGrupo = para;
        Aviso($"Item \"{de}\" passou a se chamar \"{para}\" — os subitens foram junto.");
    }

    private void ApagarItem(string nome)
    {
        var quantos = _todas.Count(c => c.Grupo == nome);
        Repo.ApagarGrupo(nome);
        _apagarItem = null;

        Recarregar();
        if (_grupoFiltro == nome) _grupoFiltro = "";
        if (_novoGrupo == nome) _novoGrupo = _grupos.FirstOrDefault() ?? "";
        Aviso($"Item \"{nome}\" apagado, com {quantos} subitem(ns).");
    }

    /// <summary>
    /// Esvazia UM item: apaga os subitens e deixa a lista de pé, pronta para
    /// receber os da equipe. O repositório grava junto a marca de "os de fábrica
    /// já foram carregados", senão a próxima abertura os traria de volta.
    /// </summary>
    private void LimparItem(string nome)
    {
        var quantos = _todas.Count(c => c.Grupo == nome);
        Repo.LimparGrupo(nome);
        _limparItem = null;

        Recarregar();
        Aviso($"Item \"{nome}\" esvaziado: {quantos} subitem(ns) apagado(s). A lista continua lá.");
    }

    /// <summary>Apaga todas as listas e todos os subitens da aba.</summary>
    private void LimparTudo()
    {
        var itens = _grupos.Count;
        var subitens = _todas.Count;

        Repo.Limpar();
        _limparTudo = false;

        Recarregar();
        _grupoFiltro = "";
        _novoGrupo = "";
        Aviso($"Limpo: {itens} item(ns) e {subitens} subitem(ns).");
    }

    /// <summary>Troca o item de lugar com o vizinho e regrava as duas ordens.</summary>
    private void MoverItem(string nome, int direcao)
    {
        var grupos = Repo.Grupos();
        var i = grupos.FindIndex(g => g.Nome == nome);
        var j = i + direcao;
        if (i < 0 || j < 0 || j >= grupos.Count) return;

        var atual = grupos[i];
        var vizinho = grupos[j];
        (atual.Ordem, vizinho.Ordem) = (vizinho.Ordem, atual.Ordem);
        Repo.SalvarGrupo(atual);
        Repo.SalvarGrupo(vizinho);

        Recarregar();
        _msg = null;
    }

    // ---------- subitens ----------

    private void Incluir()
    {
        var valor = _novoValor.Trim();
        if (valor.Length == 0 || _novoGrupo.Length == 0) return;

        if (_todas.Any(c => c.Grupo == _novoGrupo &&
                            c.Valor.Equals(valor, StringComparison.OrdinalIgnoreCase)))
        {
            Aviso($"\"{valor}\" já existe na lista {_novoGrupo}.", erro: true);
            return;
        }

        Repo.GarantirGrupo(_novoGrupo);

        var doGrupo = DoGrupo(_novoGrupo);
        Repo.Salvar(new Caracteristica
        {
            Grupo = _novoGrupo,
            Valor = valor,
            Codigo = _novoCodigo.Trim(),
            Ordem = doGrupo.Count == 0 ? 1 : doGrupo[^1].Ordem + 1,
        });

        Recarregar();
        _novoValor = "";
        _novoCodigo = "";
        Aviso($"\"{valor}\" incluído no fim da lista {_novoGrupo}.");
    }

    private void TeclaIncluir(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Incluir();
    }

    /// <summary>O valor faz parte do id, então renomear é apagar e regravar.</summary>
    private void Renomear(Caracteristica item, string texto)
    {
        var valor = texto.Trim();
        if (valor.Length == 0 || valor == item.Valor) return;

        if (_todas.Any(c => c.Grupo == item.Grupo && c.Id != item.Id &&
                            c.Valor.Equals(valor, StringComparison.OrdinalIgnoreCase)))
        {
            Aviso($"\"{valor}\" já existe na lista {item.Grupo}.", erro: true);
            Recarregar();
            return;
        }

        var antigo = item.Valor;
        Repo.Apagar(item.Id);
        Repo.Salvar(new Caracteristica
        {
            Grupo = item.Grupo, Valor = valor, Codigo = item.Codigo,
            Preco = item.Preco, Ordem = item.Ordem,
        });

        Recarregar();
        Aviso($"\"{antigo}\" passou a se chamar \"{valor}\".");
    }

    private void DefinirCodigo(Caracteristica item, string texto)
    {
        var codigo = texto.Trim();
        if (codigo == item.Codigo) return;

        item.Codigo = codigo;
        Repo.Salvar(item);
        Recarregar();
        Aviso(codigo.Length == 0
            ? $"Código de \"{item.Valor}\" apagado."
            : $"\"{item.Valor}\": código {codigo}.");
    }

    /// <summary>As três moedas em que a equipe cadastra preço.</summary>
    private enum Moeda { Usd, Clp, Brl }

    private static string Rotulo(Moeda m) => m switch
    {
        Moeda.Usd => "USD", Moeda.Clp => "CLP", _ => "R$",
    };

    private static string ValorDe(Caracteristica c, Moeda m) => m switch
    {
        Moeda.Usd => c.PrecoUsd, Moeda.Clp => c.PrecoClp, _ => c.Preco,
    };

    private RenderFragment Preco(Caracteristica item, Moeda moeda) => @<text>
        <input class="cell" style="max-width:100px; text-align:right" placeholder="—"
               value="@ValorDe(item, moeda)"
               @onchange="e => DefinirPreco(item, moeda, e.Value?.ToString() ?? string.Empty)" />
    </text>;

    private void DefinirPreco(Caracteristica item, Moeda moeda, string texto)
    {
        var preco = texto.Trim();
        if (preco == ValorDe(item, moeda)) return;

        if (preco.Length > 0 && DadosExcel.Numero(preco) is null)
        {
            Aviso($"\"{preco}\" não parece um preço. Use 1234,56 ou 1234.56.", erro: true);
            Recarregar();
            return;
        }

        switch (moeda)
        {
            case Moeda.Usd: item.PrecoUsd = preco; break;
            case Moeda.Clp: item.PrecoClp = preco; break;
            default: item.Preco = preco; break;
        }
        Repo.Salvar(item);

        Aviso(preco.Length == 0
            ? $"\"{item.Valor}\": {Rotulo(moeda)} apagado."
            : $"\"{item.Valor}\": {Rotulo(moeda)} {preco}.");
    }

    private void Apagar(Caracteristica item)
    {
        Repo.Apagar(item.Id);
        Recarregar();
        Aviso($"\"{item.Valor}\" apagado da lista {item.Grupo}.");
    }

    private void Mover(Caracteristica item, int direcao)
    {
        var lista = DoGrupo(item.Grupo);
        var i = lista.FindIndex(c => c.Id == item.Id);
        var j = i + direcao;
        if (i < 0 || j < 0 || j >= lista.Count) return;

        var vizinho = lista[j];
        (item.Ordem, vizinho.Ordem) = (vizinho.Ordem, item.Ordem);
        Repo.Salvar(item);
        Repo.Salvar(vizinho);

        Recarregar();
        _msg = null;
    }

    // ---------- Excel desta tabela ----------

    private string Subir(Stream fluxo)
    {
        var (linhas, avisos) = DadosExcel.ImportarCaracteristicas(fluxo, Repo);
        var texto = linhas > 0 ? $"{linhas} subitem(ns) gravado(s)." : "Nada foi gravado.";
        return avisos.Count > 0 ? texto + " " + string.Join(" ", avisos) : texto;
    }

    private void DepoisDeImportar(string resumo)
    {
        Recarregar();
        if (_abertoPara is not null &&
            _todas.FirstOrDefault(c => c.Id == _abertoPara) is { } opcao)
        {
            _equipamentos = Equipamentos.Todos();
            _precos = Precos.Da(opcao.Grupo, opcao.Valor);
        }
        Aviso(resumo);
    }

    // ---------- preço por equipamento ----------

    /// <summary>
    /// O botão que abre a lista de equipamentos da opção. Mostra quantos já têm
    /// preço próprio, para dar para ver de relance onde há exceção cadastrada.
    /// </summary>
    private RenderFragment PorEquipamento(Caracteristica item) => @<text>
        @if (_abertoPara == item.Id)
        {
            <button class="btn-link" @onclick="@(() => _abertoPara = null)">▾ fechar</button>
        }
        else
        {
            <button class="btn-link" title="Preço diferente por equipamento"
                    @onclick="() => AbrirPrecos(item)">
                ▸ por equipamento
                @if (ComPrecoProprio(item) is var n && n > 0)
                {
                    <span class="val-count">@n</span>
                }
            </button>
        }
    </text>;

    private void AbrirPrecos(Caracteristica item)
    {
        _abertoPara = item.Id;
        _buscaEquip = "";
        _paginaEquip = 0;
        _equipamentos = Equipamentos.Todos();
        _precos = Precos.Da(item.Grupo, item.Valor);
    }

    private int ComPrecoProprio(Caracteristica item) => _abertoPara == item.Id
        ? _precos.Count
        : Precos.Todos().Count(p => p.Grupo == item.Grupo && p.Valor == item.Valor);

    private string Resumo(Caracteristica item)
    {
        var partes = new List<string>();
        if (item.PrecoUsd.Length > 0) partes.Add("USD " + item.PrecoUsd);
        if (item.PrecoClp.Length > 0) partes.Add("CLP " + item.PrecoClp);
        if (item.Preco.Length > 0) partes.Add("R$ " + item.Preco);
        return partes.Count == 0 ? "que também está em branco" : string.Join(" · ", partes);
    }

    private List<Equipamento> EquipamentosFiltrados()
    {
        var busca = _buscaEquip.Trim();
        if (busca.Length == 0) return _equipamentos;

        return _equipamentos
            .Where(e => new[] { e.Serie, e.Diametro, e.Cubo }
                .Any(t => t.Contains(busca, StringComparison.OrdinalIgnoreCase)))
            .ToList();
    }

    private void FiltrarEquipamentos(string texto)
    {
        _buscaEquip = texto;
        _paginaEquip = 0;
    }

    private int PrimeiraLinha => _paginaEquip * PorPaginaEquip;

    private int UltimaLinha(int total) => Math.Min(PrimeiraLinha + PorPaginaEquip, total);

    private static string ValorDe(PrecoEquipamento? p, Moeda m) => p is null ? "" : m switch
    {
        Moeda.Usd => p.PrecoUsd, Moeda.Clp => p.PrecoClp, _ => p.Preco,
    };

    /// <summary>Um dos três campos de preço de um equipamento, dentro da opção.</summary>
    private RenderFragment PrecoDoEquipamento(Caracteristica opcao, Equipamento eq, Moeda moeda) => @<text>
        @{
            _precos.TryGetValue(eq.Id, out var atual);
        }
        <input class="cell" style="max-width:110px; text-align:right" placeholder="—"
               value="@ValorDe(atual, moeda)"
               @onchange="a => DefinirPrecoDoEquipamento(opcao, eq, moeda, a.Value?.ToString() ?? string.Empty)" />
    </text>;

    private void DefinirPrecoDoEquipamento(Caracteristica opcao, Equipamento eq, Moeda moeda, string texto)
    {
        var preco = texto.Trim();
        _precos.TryGetValue(eq.Id, out var atual);

        if (preco == ValorDe(atual, moeda)) return;

        if (preco.Length > 0 && DadosExcel.Numero(preco) is null)
        {
            Aviso($"\"{preco}\" não parece um preço. Use 1234,56 ou 1234.56.", erro: true);
            return;
        }

        var linha = atual ?? new PrecoEquipamento
        {
            Grupo = opcao.Grupo, Valor = opcao.Valor, Equipamento = eq.Id,
        };

        switch (moeda)
        {
            case Moeda.Usd: linha.PrecoUsd = preco; break;
            case Moeda.Clp: linha.PrecoClp = preco; break;
            default: linha.Preco = preco; break;
        }

        Precos.Salvar(linha);

        // a linha some do cadastro quando fica sem nenhum preço: é o mesmo que
        // não ter exceção, e deixar um registro vazio só atrapalharia a contagem
        if (linha.Vazio) _precos.Remove(eq.Id);
        else _precos[eq.Id] = linha;

        Aviso(preco.Length == 0
            ? $"{eq.Rotulo}: volta a usar o preço de \"{opcao.Valor}\"."
            : $"{eq.Rotulo} · {opcao.Valor}: {Rotulo(moeda)} {preco}.");
    }

    private string SubirPrecos(Stream fluxo)
    {
        var (linhas, avisos) = DadosExcel.ImportarPrecosPorEquipamento(fluxo, Precos, _equipamentos);
        var texto = linhas > 0 ? $"{linhas} preço(s) por equipamento gravado(s)." : "Nada foi gravado.";
        return avisos.Count > 0 ? texto + " " + string.Join(" ", avisos) : texto;
    }

    private void Aviso(string texto, bool erro = false)
    {
        _msg = texto;
        _erro = erro;
    }
}
