@inject CaracteristicaRepository Repo

<p class="subtitle">
    As características do equipamento. Cada <strong>item</strong> é uma lista (Solidez,
    Base, PARTIDORES…) e cada <strong>subitem</strong> é uma opção dela, com seu
    <strong>código</strong> — juntando os códigos escolhidos em cada item monta-se o código
    do equipamento, e é por isso que a ordem dos itens e dos subitens importa.
</p>

@if (_msg is not null)
{
    <div class="@(_erro ? "aviso aviso-erro" : "aviso aviso-ok")" style="margin-bottom:14px">@_msg</div>
}

<!-- ---------- incluir item (lista nova) ---------- -->
<div class="panel" style="margin-bottom:16px">
    <div class="toolbar" style="margin-bottom:0; flex-wrap:wrap">
        <strong>Novo item</strong>
        <input class="cell" style="min-width:260px" placeholder="Nome do item (ex.: Revestimento)"
               @bind="_novoItem" @bind:event="oninput" @onkeydown="TeclaNovoItem" />
        <button class="btn-primary" @onclick="IncluirItem" disabled="@(_novoItem.Trim().Length == 0)">
            + Criar item
        </button>
        <span class="subtitle" style="margin:0">
            entra no fim da lista de itens, vazio — depois é só acrescentar os subitens
        </span>
    </div>
</div>

<!-- ---------- incluir subitem ---------- -->
<div class="panel" style="margin-bottom:16px">
    <div class="toolbar" style="margin-bottom:0; flex-wrap:wrap">
        <strong>Novo subitem</strong>

        <select class="cell" @bind="_novoGrupo">
            @foreach (var g in _grupos)
            {
                <option value="@g">@g</option>
            }
        </select>

        <input class="cell" style="min-width:230px" placeholder="Valor (ex.: Com TRENÓ)"
               @bind="_novoValor" @bind:event="oninput" @onkeydown="TeclaIncluir" />
        <input class="cell" style="width:130px" placeholder="Código"
               @bind="_novoCodigo" @bind:event="oninput" @onkeydown="TeclaIncluir" />

        <button class="btn-primary" @onclick="Incluir"
                disabled="@(_novoValor.Trim().Length == 0 || _grupos.Count == 0)">
            + Incluir
        </button>
    </div>
</div>

<!-- ---------- as listas ---------- -->
<div class="tabs">
    <button class="tab @(_grupoFiltro == "" ? "active" : "")" @onclick="@(() => _grupoFiltro = "")">
        Todos <span class="tab-badge">@_grupos.Count</span>
    </button>
    @foreach (var g in _grupos)
    {
        var grupo = g;
        <button class="tab @(_grupoFiltro == grupo ? "active" : "")" @onclick="@(() => _grupoFiltro = grupo)">
            @grupo <span class="tab-badge">@_todas.Count(c => c.Grupo == grupo)</span>
        </button>
    }
</div>

<div class="toolbar" style="flex-wrap:wrap">
    <span class="subtitle" style="margin:0">
        @_grupos.Count item(ns) · @_todas.Count subitem(ns) ·
        @_todas.Count(c => c.Codigo.Length > 0) com código ·
        @_todas.Count(c => c.Preco.Length > 0) com preço
    </span>
    <span style="flex:1"></span>
    <input class="cell" style="min-width:240px" placeholder="Procurar valor ou código…"
           @bind="_busca" @bind:event="oninput" />
</div>

@foreach (var g in _grupos.Where(g => _grupoFiltro.Length == 0 || g == _grupoFiltro))
{
    var grupo = g;
    var itens = Filtrados(grupo);
    var total = _todas.Count(c => c.Grupo == grupo);

    // com busca ativa, some a lista que não tem nenhum subitem casando
    if (_busca.Trim().Length > 0 && itens.Count == 0) { continue; }

    <div class="toolbar" style="margin:22px 0 8px; flex-wrap:wrap">
        <input class="cell" style="font-weight:600; min-width:280px" value="@grupo"
               @onchange="e => RenomearItem(grupo, e.Value?.ToString() ?? string.Empty)" />
        <span class="val-count">@total subitem(ns)</span>
        <button class="btn-link" title="Subir o item" @onclick="() => MoverItem(grupo, -1)">↑</button>
        <button class="btn-link" title="Descer o item" @onclick="() => MoverItem(grupo, 1)">↓</button>

        @if (_apagarItem == grupo)
        {
            <span class="aviso aviso-alerta" style="padding:6px 10px">
                Apagar o item "@grupo" e os @total subitem(ns)?
            </span>
            <button class="btn-link" @onclick="() => ApagarItem(grupo)">Sim, apagar</button>
            <button class="btn-link" @onclick="@(() => _apagarItem = null)">Cancelar</button>
        }
        else
        {
            <button class="btn-link" title="Apagar o item inteiro"
                    @onclick="@(() => _apagarItem = grupo)">✕ item</button>
        }
    </div>

    @if (total == 0)
    {
        <div class="panel empty" style="padding:20px">
            Item ainda sem subitens — inclua acima, escolhendo "@grupo".
        </div>
    }
    <div class="panel" style="padding:0; overflow-x:auto; @(total == 0 ? "display:none" : "")">
        <table class="grid">
            <thead>
                <tr>
                    <th class="nowrap" style="width:70px">Ordem</th>
                    <th class="nowrap">Valor</th>
                    <th class="nowrap" style="width:160px">Código</th>
                    <th class="nowrap" style="width:160px">Preço</th>
                    <th class="nowrap" style="width:130px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in itens)
                {
                    var item = c;
                    <tr @key="item.Id">
                        <td class="center nowrap">@Posicao(item)</td>
                        <td>
                            <input class="cell" value="@item.Valor"
                                   @onchange="e => Renomear(item, e.Value?.ToString() ?? string.Empty)" />
                        </td>
                        <td>
                            <input class="cell" style="max-width:140px" value="@item.Codigo" placeholder="—"
                                   @onchange="e => DefinirCodigo(item, e.Value?.ToString() ?? string.Empty)" />
                        </td>
                        <td>
                            <input class="cell" style="max-width:140px; text-align:right" value="@item.Preco"
                                   placeholder="—"
                                   @onchange="e => DefinirPreco(item, e.Value?.ToString() ?? string.Empty)" />
                        </td>
                        <td class="nowrap center">
                            <button class="btn-link" title="Subir" @onclick="() => Mover(item, -1)">↑</button>
                            <button class="btn-link" title="Descer" @onclick="() => Mover(item, 1)">↓</button>
                            <button class="btn-link" title="Apagar" @onclick="() => Apagar(item)">✕</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Caracteristica> _todas = new();
    private List<string> _grupos = new();

    private string _busca = "";
    /// <summary>Lista em foco; vazio mostra todas.</summary>
    private string _grupoFiltro = "";

    private string _novoItem = "";
    private string _novoGrupo = "";
    private string _novoValor = "";
    private string _novoCodigo = "";

    /// <summary>Item aguardando confirmação para ser apagado.</summary>
    private string? _apagarItem;

    private string? _msg;
    private bool _erro;

    protected override void OnInitialized()
    {
        Repo.SemearSeVazio();
        Recarregar();
        _novoGrupo = _grupos.FirstOrDefault() ?? "";
    }

    private void Recarregar()
    {
        _todas = Repo.Todas();
        // a lista de itens vem da entidade própria: assim um item recém-criado,
        // ainda sem nenhum subitem, também aparece
        _grupos = Repo.Grupos().Select(g => g.Nome).ToList();

        // rede de segurança: subitem cujo item sumiu ainda assim é mostrado
        foreach (var g in _todas.Select(c => c.Grupo).Distinct())
            if (!_grupos.Contains(g)) _grupos.Add(g);
    }

    private List<Caracteristica> DoGrupo(string grupo) =>
        _todas.Where(c => c.Grupo == grupo).OrderBy(c => c.Ordem).ToList();

    private List<Caracteristica> Filtrados(string grupo)
    {
        var itens = DoGrupo(grupo);
        if (_busca.Trim().Length == 0) return itens;

        var busca = _busca.Trim();
        return itens.Where(c =>
            c.Valor.Contains(busca, StringComparison.OrdinalIgnoreCase) ||
            c.Codigo.Contains(busca, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    /// <summary>O número na tela é a posição na lista, não o campo Ordem gravado.</summary>
    private int Posicao(Caracteristica item) =>
        DoGrupo(item.Grupo).FindIndex(c => c.Id == item.Id) + 1;

    // ---------- itens (as listas) ----------

    private void IncluirItem()
    {
        var nome = _novoItem.Trim();
        if (nome.Length == 0) return;

        if (_grupos.Any(g => g.Equals(nome, StringComparison.OrdinalIgnoreCase)))
        {
            Aviso($"O item \"{nome}\" já existe.", erro: true);
            return;
        }

        Repo.GarantirGrupo(nome);
        Recarregar();
        _novoGrupo = nome;
        _novoItem = "";
        Aviso($"Item \"{nome}\" criado. Agora inclua os subitens dele.");
    }

    private void TeclaNovoItem(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") IncluirItem();
    }

    private void RenomearItem(string de, string texto)
    {
        var para = texto.Trim();
        if (para.Length == 0 || para == de) { Recarregar(); return; }

        if (_grupos.Any(g => g != de && g.Equals(para, StringComparison.OrdinalIgnoreCase)))
        {
            Aviso($"O item \"{para}\" já existe.", erro: true);
            Recarregar();
            return;
        }

        Repo.RenomearGrupo(de, para);
        Recarregar();
        if (_grupoFiltro == de) _grupoFiltro = para;
        if (_novoGrupo == de) _novoGrupo = para;
        Aviso($"Item \"{de}\" passou a se chamar \"{para}\" — os subitens foram junto.");
    }

    private void ApagarItem(string nome)
    {
        var quantos = _todas.Count(c => c.Grupo == nome);
        Repo.ApagarGrupo(nome);
        _apagarItem = null;

        Recarregar();
        if (_grupoFiltro == nome) _grupoFiltro = "";
        if (_novoGrupo == nome) _novoGrupo = _grupos.FirstOrDefault() ?? "";
        Aviso($"Item \"{nome}\" apagado, com {quantos} subitem(ns).");
    }

    /// <summary>Troca o item de lugar com o vizinho e regrava as duas ordens.</summary>
    private void MoverItem(string nome, int direcao)
    {
        var grupos = Repo.Grupos();
        var i = grupos.FindIndex(g => g.Nome == nome);
        var j = i + direcao;
        if (i < 0 || j < 0 || j >= grupos.Count) return;

        var atual = grupos[i];
        var vizinho = grupos[j];
        (atual.Ordem, vizinho.Ordem) = (vizinho.Ordem, atual.Ordem);
        Repo.SalvarGrupo(atual);
        Repo.SalvarGrupo(vizinho);

        Recarregar();
        _msg = null;
    }

    // ---------- subitens ----------

    private void Incluir()
    {
        var valor = _novoValor.Trim();
        if (valor.Length == 0 || _novoGrupo.Length == 0) return;

        if (_todas.Any(c => c.Grupo == _novoGrupo &&
                            c.Valor.Equals(valor, StringComparison.OrdinalIgnoreCase)))
        {
            Aviso($"\"{valor}\" já existe na lista {_novoGrupo}.", erro: true);
            return;
        }

        Repo.GarantirGrupo(_novoGrupo);

        var doGrupo = DoGrupo(_novoGrupo);
        Repo.Salvar(new Caracteristica
        {
            Grupo = _novoGrupo,
            Valor = valor,
            Codigo = _novoCodigo.Trim(),
            Ordem = doGrupo.Count == 0 ? 1 : doGrupo[^1].Ordem + 1,
        });

        Recarregar();
        _novoValor = "";
        _novoCodigo = "";
        Aviso($"\"{valor}\" incluído no fim da lista {_novoGrupo}.");
    }

    private void TeclaIncluir(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Incluir();
    }

    /// <summary>O valor faz parte do id, então renomear é apagar e regravar.</summary>
    private void Renomear(Caracteristica item, string texto)
    {
        var valor = texto.Trim();
        if (valor.Length == 0 || valor == item.Valor) return;

        if (_todas.Any(c => c.Grupo == item.Grupo && c.Id != item.Id &&
                            c.Valor.Equals(valor, StringComparison.OrdinalIgnoreCase)))
        {
            Aviso($"\"{valor}\" já existe na lista {item.Grupo}.", erro: true);
            Recarregar();
            return;
        }

        var antigo = item.Valor;
        Repo.Apagar(item.Id);
        Repo.Salvar(new Caracteristica
        {
            Grupo = item.Grupo, Valor = valor, Codigo = item.Codigo,
            Preco = item.Preco, Ordem = item.Ordem,
        });

        Recarregar();
        Aviso($"\"{antigo}\" passou a se chamar \"{valor}\".");
    }

    private void DefinirCodigo(Caracteristica item, string texto)
    {
        var codigo = texto.Trim();
        if (codigo == item.Codigo) return;

        item.Codigo = codigo;
        Repo.Salvar(item);
        Recarregar();
        Aviso(codigo.Length == 0
            ? $"Código de \"{item.Valor}\" apagado."
            : $"\"{item.Valor}\": código {codigo}.");
    }

    private void DefinirPreco(Caracteristica item, string texto)
    {
        var preco = texto.Trim();
        if (preco == item.Preco) return;

        if (preco.Length > 0 && DadosExcel.Numero(preco) is null)
        {
            Aviso($"\"{preco}\" não parece um preço. Use 1234,56 ou 1234.56.", erro: true);
            Recarregar();
            return;
        }

        item.Preco = preco;
        Repo.Salvar(item);
        Recarregar();
        Aviso(preco.Length == 0
            ? $"Preço de \"{item.Valor}\" apagado."
            : $"\"{item.Valor}\": preço {preco}.");
    }

    private void Apagar(Caracteristica item)
    {
        Repo.Apagar(item.Id);
        Recarregar();
        Aviso($"\"{item.Valor}\" apagado da lista {item.Grupo}.");
    }

    private void Mover(Caracteristica item, int direcao)
    {
        var lista = DoGrupo(item.Grupo);
        var i = lista.FindIndex(c => c.Id == item.Id);
        var j = i + direcao;
        if (i < 0 || j < 0 || j >= lista.Count) return;

        var vizinho = lista[j];
        (item.Ordem, vizinho.Ordem) = (vizinho.Ordem, item.Ordem);
        Repo.Salvar(item);
        Repo.Salvar(vizinho);

        Recarregar();
        _msg = null;
    }

    private void Aviso(string texto, bool erro = false)
    {
        _msg = texto;
        _erro = erro;
    }
}
