@inject MotorRepository Repo

<p class="subtitle">
    O catálogo de motores: fabricante, potência, frequência, tensão, rotação, polos, flange,
    padrão, <strong>frame</strong> (a carcaça) e observações. A ordem da lista, dentro de cada padrão, é a
    <strong>ordem de tamanho</strong> das carcaças — é ela que diz se um motor passa do
    máximo que cabe no cubo.
</p>

<div class="tabs">
    <button class="tab @(_filtro == "" ? "active" : "")" @onclick="@(() => _filtro = "")">
        Todos <span class="tab-badge">@_todos.Count</span>
    </button>
    @foreach (var p in MotorRepository.Padroes)
    {
        var padrao = p;
        <button class="tab @(_filtro == padrao ? "active" : "")" @onclick="@(() => _filtro = padrao)">
            @padrao <span class="tab-badge">@_todos.Count(m => m.Padrao == padrao)</span>
        </button>
    }
</div>

<!-- ---------- incluir motor ---------- -->
<div class="panel" style="margin-bottom:16px">
    <div class="toolbar" style="margin-bottom:0; flex-wrap:wrap">
        <strong>Incluir motor</strong>

        <select class="cell" @bind="_novoPadrao">
            @foreach (var p in MotorRepository.Padroes)
            {
                <option value="@p">@p</option>
            }
        </select>

        <button class="btn-primary" @onclick="Incluir">+ Incluir</button>
        <span class="subtitle" style="margin:0">
            entra em branco no fim da lista @_novoPadrao — preencha as colunas na própria linha
        </span>

        <span style="flex:1"></span>

        <input class="cell" style="width:200px" placeholder="filtrar…" value="@_busca"
               @oninput="e => _busca = e.Value?.ToString() ?? string.Empty" />

        @if (_limpando)
        {
            <span class="aviso aviso-alerta" style="margin:0; padding:5px 9px">
                Apagar @Mostrados.Count motor(es)@(_filtro.Length == 0 ? "" : " do padrão " + _filtro)@(_busca.Trim().Length == 0 ? "" : " que o filtro mostra")?
            </span>
            <button class="btn-link" @onclick="Limpar">Sim, limpar</button>
            <button class="btn-link" @onclick="@(() => _limpando = false)">Cancelar</button>
        }
        else
        {
            <button class="btn-link" title="Esvaziar a lista mostrada" disabled="@(Mostrados.Count == 0)"
                    @onclick="@(() => _limpando = true)">
                🗑 Limpar @(_filtro.Length == 0 ? "tudo" : _filtro)
            </button>
        }
    </div>
</div>

@if (_msg is not null)
{
    <div class="@(_erro ? "aviso aviso-erro" : "aviso aviso-ok")" style="margin-bottom:14px">@_msg</div>
}

<div class="panel" style="padding:0; overflow-x:auto">
    <!-- min-width: sem ele a tabela encolhe para caber no painel e as colunas
         cortam o texto ("< 112M" virava "< 1"); com ele, o painel rola -->
    <table class="grid" style="min-width:1860px">
        <thead>
            <tr>
                <th class="nowrap" style="width:64px">Ordem</th>
                <th class="nowrap" style="min-width:150px">Fabricante</th>
                <th class="nowrap" style="width:110px">Potência CV</th>
                <th class="nowrap" style="width:110px">Frequência</th>
                <th class="nowrap" style="width:130px">Tensão</th>
                <th class="nowrap" style="width:105px">Rotação</th>
                <th class="nowrap" style="width:95px">Nº Polos</th>
                <th class="nowrap" style="width:130px">Tipo de Flange</th>
                <th class="nowrap" style="width:105px">IEC/NEMA</th>
                <th class="nowrap" style="width:150px">Frame</th>
                <th class="nowrap" style="width:130px">Código</th>
                <th class="nowrap" style="width:130px">Preço</th>
                <th class="nowrap" style="min-width:230px">Observações</th>
                <th class="nowrap" style="width:110px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Mostrados)
            {
                var motor = m;
                <tr @key="motor.Id">
                    <td class="nowrap center"><span class="val-count">@Posicao(motor)</span></td>
                    <td>@Campo(motor, motor.Fabricante, (x, v) => x.Fabricante = v, "—", 150)</td>
                    <td>@Campo(motor, motor.PotenciaCv, (x, v) => x.PotenciaCv = v, "—", 90, direita: true)</td>
                    <td>@Campo(motor, motor.Frequencia, (x, v) => x.Frequencia = v, "Hz", 90, direita: true)</td>
                    <td>@Campo(motor, motor.Tensao, (x, v) => x.Tensao = v, "V", 110)</td>
                    <td>@Campo(motor, motor.Rotacao, (x, v) => x.Rotacao = v, Rpm(motor), 85, direita: true)</td>
                    <td>@Campo(motor, motor.Polos, (x, v) => x.Polos = v, "—", 75, direita: true)</td>
                    <td>@Campo(motor, motor.Flange, (x, v) => x.Flange = v, "—", 110)</td>
                    <td>
                        <select class="cell" style="max-width:88px" value="@motor.Padrao"
                                @onchange="e => TrocarPadrao(motor, e.Value?.ToString() ?? string.Empty)">
                            @foreach (var p in MotorRepository.Padroes)
                            {
                                <option value="@p" selected="@(p == motor.Padrao)">@p</option>
                            }
                        </select>
                    </td>
                    <td>@Campo(motor, motor.Frame, (x, v) => x.Frame = v, "carcaça", 130, negrito: true)</td>
                    <td>@Campo(motor, motor.Codigo, (x, v) => x.Codigo = v, "—", 110)</td>
                    <td>@Preco(motor)</td>
                    <td>@Campo(motor, motor.Observacoes, (x, v) => x.Observacoes = v, "—", 230)</td>
                    <td class="nowrap center">
                        <button class="btn-link" title="Subir (carcaça menor)" @onclick="() => Mover(motor, -1)">↑</button>
                        <button class="btn-link" title="Descer (carcaça maior)" @onclick="() => Mover(motor, 1)">↓</button>
                        @if (_apagar == motor.Id)
                        {
                            <button class="btn-link" @onclick="() => Apagar(motor)">Sim</button>
                            <button class="btn-link" @onclick="@(() => _apagar = null)">Não</button>
                        }
                        else
                        {
                            <button class="btn-link" title="Apagar o motor"
                                    @onclick="@(() => _apagar = motor.Id)">✕</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p class="subtitle" style="margin-top:12px">
    As setas mudam o motor de lugar na lista do seu padrão, e é essa ordem que forma a
    <strong>escada de tamanho das carcaças</strong>: vários motores podem dividir o mesmo
    frame, e a carcaça vale pela primeira vez que aparece. Um motor IEC nunca troca de
    posição com um NEMA — são duas escadas independentes. A rotação mostra, em cinza, o
    valor síncrono de polos + frequência; é só uma sugestão, quem manda é o que for digitado.
</p>

@code {
    private List<Motor> _todos = new();
    private string _filtro = "";
    private string _busca = "";
    /// <summary>Verdadeiro enquanto a limpeza espera confirmação.</summary>
    private bool _limpando;
    /// <summary>Id do motor aguardando confirmação para ser apagado.</summary>
    private string? _apagar;

    private string _novoPadrao = "IEC";

    private string? _msg;
    private bool _erro;

    protected override void OnInitialized()
    {
        Repo.SemearSeVazio();
        _todos = Repo.Todos();
    }

    /// <summary>O que está na tela: a aba do padrão, depois o texto do filtro.</summary>
    private List<Motor> Mostrados
    {
        get
        {
            var lista = _filtro.Length == 0 ? _todos : _todos.Where(m => m.Padrao == _filtro);

            var busca = _busca.Trim();
            if (busca.Length > 0)
                lista = lista.Where(m => Casa(m, busca));

            return lista.ToList();
        }
    }

    private static bool Casa(Motor m, string busca) =>
        new[] { m.Fabricante, m.PotenciaCv, m.Frequencia, m.Tensao, m.Rotacao, m.Polos,
                m.Flange, m.Padrao, m.Frame, m.Codigo, m.Observacoes }
            .Any(t => t.Contains(busca, StringComparison.OrdinalIgnoreCase));

    private List<Motor> DoPadrao(string padrao) =>
        _todos.Where(m => m.Padrao == padrao).OrderBy(m => m.Ordem).ToList();

    /// <summary>
    /// O número que aparece na tela é a POSIÇÃO dentro do padrão, não o campo
    /// Ordem gravado — esse é só chave de ordenação e fica com buracos quando um
    /// motor é apagado.
    /// </summary>
    private int Posicao(Motor motor) =>
        DoPadrao(motor.Padrao).FindIndex(m => m.Id == motor.Id) + 1;

    /// <summary>
    /// A rotação síncrona de polos + frequência (120 · Hz / polos), só como
    /// sugestão no campo vazio. O motor real fica abaixo disso (escorregamento),
    /// por isso não é gravado sozinho — é dica, não resposta.
    /// </summary>
    private static string Rpm(Motor m)
    {
        if (!int.TryParse(m.Polos, out var polos) || polos <= 0) return "rpm";
        if (!int.TryParse(m.Frequencia, out var hz) || hz <= 0) return "rpm";
        return (120 * hz / polos).ToString();
    }

    // ---------- editar ----------

    /// <summary>
    /// Um campo de texto do motor. Todos funcionam igual — grava no cadastro ao
    /// sair do campo —, então vale escrever uma vez e reusar nas dez colunas.
    /// </summary>
    private RenderFragment Campo(Motor motor, string valor, Action<Motor, string> guardar,
        string vazio, int largura, bool direita = false, bool negrito = false) => @<text>
        <input class="cell" placeholder="@vazio"
               style="max-width:@(largura)px; @(direita ? "text-align:right;" : "") @(negrito ? "font-weight:600;" : "")"
               value="@valor"
               @onchange="e => Definir(motor, guardar, e.Value?.ToString() ?? string.Empty)" />
    </text>;

    private void Definir(Motor motor, Action<Motor, string> guardar, string texto)
    {
        guardar(motor, texto.Trim());
        Repo.Salvar(motor);
        _todos = Repo.Todos();
        Aviso($"{motor.Descricao}: gravado.");
    }

    /// <summary>
    /// O preço tem validação própria: número que não dá para ler é recusado,
    /// porque um preço errado é pior do que um preço em branco.
    /// </summary>
    private RenderFragment Preco(Motor motor) => @<text>
        <input class="cell" placeholder="—" style="max-width:110px; text-align:right"
               value="@motor.Preco"
               @onchange="e => DefinirPreco(motor, e.Value?.ToString() ?? string.Empty)" />
    </text>;

    private void DefinirPreco(Motor motor, string texto)
    {
        var preco = texto.Trim();
        if (preco.Length > 0 && DadosExcel.Numero(preco) is null)
        {
            _todos = Repo.Todos();   // devolve o campo ao valor gravado
            Aviso($"\"{preco}\" não parece um preço. Use 1234,56 ou 1234.56.", erro: true);
            return;
        }

        motor.Preco = preco;
        Repo.Salvar(motor);
        _todos = Repo.Todos();
        Aviso(preco.Length == 0
            ? $"Preço de {motor.Descricao} apagado."
            : $"{motor.Descricao}: preço {preco}.");
    }

    /// <summary>
    /// Trocar de padrão é trocar de escada: o motor vai para o fim da lista do
    /// padrão novo, porque a posição que ele tinha não quer dizer nada lá.
    /// </summary>
    private void TrocarPadrao(Motor motor, string padrao)
    {
        if (padrao.Length == 0 || padrao == motor.Padrao) return;

        var destino = DoPadrao(padrao);
        var antigo = motor.Padrao;

        motor.Padrao = padrao;
        motor.Ordem = destino.Count == 0 ? 1 : destino[^1].Ordem + 1;
        Repo.Salvar(motor);

        _todos = Repo.Todos();
        Aviso($"{motor.Descricao}: {antigo} → {padrao}, no fim da lista.");
    }

    private void Incluir()
    {
        var ultimos = DoPadrao(_novoPadrao);
        Repo.Salvar(new Motor
        {
            Padrao = _novoPadrao,
            Ordem = ultimos.Count == 0 ? 1 : ultimos[^1].Ordem + 1,
        });

        _todos = Repo.Todos();
        _filtro = _novoPadrao;   // para a linha nova aparecer mesmo com outra aba aberta
        _busca = "";
        Aviso($"Linha em branco no fim da lista {_novoPadrao} — preencha as colunas nela.");
    }

    private void Apagar(Motor motor)
    {
        Repo.Apagar(motor.Id);
        _apagar = null;
        _todos = Repo.Todos();
        Aviso($"Motor {motor.Descricao} ({motor.Padrao}) apagado.");
    }

    /// <summary>Troca o motor de lugar com o vizinho do mesmo padrão.</summary>
    private void Mover(Motor motor, int direcao)
    {
        var lista = DoPadrao(motor.Padrao);
        var i = lista.FindIndex(m => m.Id == motor.Id);
        var j = i + direcao;
        if (i < 0 || j < 0 || j >= lista.Count) return;

        var atual = lista[i];
        var vizinho = lista[j];
        (atual.Ordem, vizinho.Ordem) = (vizinho.Ordem, atual.Ordem);
        Repo.Salvar(atual);
        Repo.Salvar(vizinho);

        _todos = Repo.Todos();
        _msg = null;
    }

    /// <summary>
    /// Esvazia a lista que está sendo mostrada: com uma aba de padrão ativa,
    /// só aquele padrão; em "Todos", o catálogo inteiro. O repositório grava
    /// junto a marca de "a de fábrica já foi carregada", senão a próxima
    /// abertura traria as 34 carcaças de volta.
    /// </summary>
    private void Limpar()
    {
        var mostrados = Mostrados;
        var quantos = mostrados.Count;
        var onde = _filtro.Length == 0 ? "" : " do padrão " + _filtro;

        // o filtro de texto também conta: limpa o que está à vista, nada mais
        if (_busca.Trim().Length > 0) Repo.LimparEstes(mostrados.Select(m => m.Id));
        else if (_filtro.Length == 0) Repo.Limpar();
        else Repo.LimparPadrao(_filtro);

        _limpando = false;
        _todos = Repo.Todos();
        Aviso($"Limpo: {quantos} motor(es){onde}.");
    }

    private void Aviso(string texto, bool erro = false)
    {
        _msg = texto;
        _erro = erro;
    }
}
