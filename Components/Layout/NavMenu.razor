@implements IDisposable
@inject NavigationManager Nav
@inject BrandingRepository Branding

<aside class="sidebar no-print">
    @if (_logo is not null)
    {
        <div class="brand logo">
            <span class="brand-img"><img src="@_logo" alt="Logo" /></span>
        </div>
    }
    else
    {
        <div class="brand">
            <div class="brand-mark">H</div>
            <div>
                <div class="brand-name">Howden</div>
                <div class="brand-sub">Ventiladores Axiais</div>
            </div>
        </div>
    }

    <nav class="nav">
        <div class="nav-section">Proposta</div>
        <NavLink class="nav-item" href="/axiais/documento">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <span>Proposta</span>
        </NavLink>
        <NavLink class="nav-item" href="/axiais/proposta">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            <span>Pricing e Custos</span>
        </NavLink>

        <div class="nav-section">Banco de Dados</div>
        <NavLink class="nav-item" href="/axiais/propostas">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="m22 2-7 20-4-9-9-4Z"/></svg>
            <span>Propostas Enviadas</span>
        </NavLink>
        <NavLink class="nav-item" href="/axiais/representantes">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span>Representantes</span>
        </NavLink>
        <NavLink class="nav-item" href="/axiais/configuracoes">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
            <span>E-mails e Padrões</span>
        </NavLink>
        <NavLink class="nav-item" href="/axiais/vendedores">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a7 7 0 0 1 14 0v1"/><path d="m17 10 2 2 4-4"/></svg>
            <span>Vendedores</span>
        </NavLink>
        <NavLink class="nav-item" href="/axiais/parametros">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/></svg>
            <span>Tabela de Custos</span>
        </NavLink>
        <NavLink class="nav-item" href="/axiais/marca">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
            <span>Identidade Visual</span>
        </NavLink>
        <NavLink class="nav-item" href="/axiais/faturamento">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
            <span>Dados de Faturamento</span>
        </NavLink>
    </nav>

    <div class="sidebar-footer">
        <div class="version">Ventiladores Axiais · beta</div>
    </div>
</aside>

@code {
    private string? _logo;

    protected override void OnInitialized()
    {
        _logo = Branding.GetLogoSistema();
        Nav.LocationChanged += OnChanged;
    }
    private void OnChanged(object? s, LocationChangedEventArgs e) => StateHasChanged();
    public void Dispose() => Nav.LocationChanged -= OnChanged;
}
