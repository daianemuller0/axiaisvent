@implements IDisposable
@inject NavigationManager Nav
@inject BrandingRepository Branding

<aside class="sidebar no-print">
    @if (_logo is not null)
    {
        <div class="brand logo">
            <span class="brand-img"><img src="@_logo" alt="Logo" /></span>
        </div>
    }
    else
    {
        <div class="brand">
            <div class="brand-mark">H</div>
            <div>
                <div class="brand-name">Howden</div>
                <div class="brand-sub">Ventiladores Axiais</div>
            </div>
        </div>
    }

    <nav class="nav">
        <div class="nav-section">Comercial</div>
        <NavLink class="nav-item" href="/axiais/proposta">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <span>Proposta</span>
        </NavLink>
        <NavLink class="nav-item" href="/axiais/propostas">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
            <span>Base de Dados</span>
        </NavLink>

        <div class="nav-section">Tabelas</div>
        <NavLink class="nav-item" href="/axiais/base">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
            <span>Base</span>
        </NavLink>
        <NavLink class="nav-item" href="/axiais/marca">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
            <span>Identidade Visual</span>
        </NavLink>
    </nav>

    <div class="sidebar-footer">
        <div class="version">Ventiladores Axiais · beta</div>
    </div>
</aside>

@code {
    private string? _logo;

    protected override void OnInitialized()
    {
        _logo = Branding.GetLogoSistema();
        Nav.LocationChanged += OnChanged;
        BrandingRepository.Mudou += OnLogoMudou;
    }

    private void OnChanged(object? s, LocationChangedEventArgs e) => StateHasChanged();

    // outra pessoa (ou esta, na tela Identidade Visual) trocou o logo
    private void OnLogoMudou() => _ = InvokeAsync(() =>
    {
        _logo = Branding.GetLogoSistema();
        StateHasChanged();
    });

    public void Dispose()
    {
        Nav.LocationChanged -= OnChanged;
        BrandingRepository.Mudou -= OnLogoMudou;
    }
}
