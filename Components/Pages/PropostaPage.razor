    /// deixa de ser automático.
    /// </summary>
    private RenderFragment CampoDoFiltro(ItemProposta item, (string Rotulo, Func<Motor, string> Valor) campo) => @<text>
        @{
            var rotulo = campo.Rotulo;
            var opcoes = OpcoesDoCampo(item, campo);
            var valor = item.FiltroMotor.GetValueOrDefault(rotulo, "");
            var automatico = item.FiltroAuto.Contains(rotulo) && valor.Length > 0;
            var dica = automatico ? "preenchido pelo sistema (seleção ou histórico); mude à vontade" : null;
        }
        <label class="@(automatico ? "motor-campo-auto" : "")" title="@dica">
            @rotulo
            <select class="cell" value="@valor"
                    @onchange="e => FiltrarMotorAMao(item, rotulo, e.Value?.ToString() ?? string.Empty)">
                <option value="">— todos (@opcoes.Count) —</option>
                @foreach (var o in opcoes)
                {
                    <option value="@o" selected="@(o == valor)">@o</option>
                }
            </select>
        </label>
    </text>;

    /// <summary>
    /// O frame escolhido cabe no equipamento? A regra já existe para a guia
    /// Dados — aqui ela só avisa, nunca impede: quem monta a proposta pode
    /// saber de uma exceção que o cadastro não tem.
    /// </summary>
    private string? AvisoDoMotor(ItemProposta item)
    {
        var motor = MotorDe(item);
        if (motor is null || ModeloDe(item) is not { } modelo) return null;
        if (motor.Frame.Length == 0 || motor.Padrao.Length == 0) return null;

        var resultado = RegraMotor.Verificar(_limites, _motores, modelo.Serie, modelo.Cubo,
            motor.Padrao, motor.Frame, modelo.FrameMaximo(motor.Padrao));

        return resultado.Situacao == RegraMotor.Situacao.AcimaDoLimite
            ? resultado.Mensagem
            : null;
    }

