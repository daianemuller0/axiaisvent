    /// peças que nenhuma lista do cadastro escolhe — câmara anti-stall, mancal
    /// monobloco, acoplamento elástico — e as que vocês tiraram do rascunho.
    /// </summary>
    private List<string> ForaDoCatalogo(ItemProposta item)
    {
        var textos = EscopoTextos;

        var postas = EscopoDaHowden.Efetivo(item, _custo, _proposta.Moeda, textos)
            .Select(Textos.Simples)
            .ToHashSet();

        // por começo de linha, e não por igualdade: a linha do motor sai com o
        // motor escolhido grudado ("Motor elétrico — WEG 250M 150 CV"), e por
        // igualdade ela voltaria a aparecer como peça faltando
        return EscopoDaHowden.Ordem
            .Where(c => !postas.Any(p => p.StartsWith(Textos.Simples(textos.Catalogo[c]),
                StringComparison.Ordinal)))
            .ToList();
    }

