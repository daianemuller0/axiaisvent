</div>

<div class="panel contato-cartao">
    <h2 class="cli-titulo">Contatos Howden (no documento)</h2>
    <p class="subtitle ajuda" style="margin:-6px 0 12px">
        Até dois, do quadro da proposta. @ListasDaProposta.DiretorDeVendas.Nome
        (@ListasDaProposta.DiretorDeVendas.Cargo) sai sempre, junto com o contato
        do representante — nenhum dos dois precisa ser escolhido aqui.
    </p>

    @ContatoNoCartao(1)

    @if (_mostrarContato2 || _proposta.Contato2Nome.Trim().Length > 0)
    {
        <div class="contato-segundo">
            @ContatoNoCartao(2)
        </div>
    }
    else
    {
        <button class="btn-link contato-mais" @onclick="AcrescentarContato2">+ segundo contato (opcional)</button>
    }
</div>

}
@if (_etapa == 3)
{
@* a faixa do equipamento fica presa logo abaixo das etapas: trocar de
   equipamento ou de aba não pede mais rolar até o alto do painel. O ponto
   âmbar diz que o equipamento tem pendência (antes eram dois números, "2×" e
   "2", que se confundiam) *@
<div class="equip-barra" role="navigation" aria-label="Equipamentos da proposta">
    <div class="equip-chips">
        @for (var i = 0; i < _proposta.Itens.Count; i++)
        {
            var indice = i;
            var item = _proposta.Itens[indice];
            var faltamNoItem = pendencias.Count(p => p.Item == indice);
            var ativo = PosicaoValida == indice;
            <button class="equip-chip @(ativo ? "ativo" : "")" aria-current="@(ativo ? "true" : null)"
                    title="@TituloDoChip(item)"
                    @onclick="() => AbrirEquipamento(indice)">
                <span class="equip-chip-num">Equip. @(indice + 1)</span>
                <span class="equip-chip-modelo">· @ModeloCurto(item)</span>
                <span class="equip-chip-qtd">· @item.Quantos un.</span>
                @if (faltamNoItem > 0)
                {
                    var quantas = Plural(faltamNoItem, "pendência", "pendências");
                    <span class="ponto-pendente" title="@quantas" role="img" aria-label="@quantas"></span>
                }
            </button>
        }
    </div>
    <button id="f-equipamento-novo" class="equip-chip novo" @onclick="Acrescentar">+ equipamento</button>
    @if (_proposta.Itens.Count > 0)
    {
        var aberto = _proposta.Itens[PosicaoValida];
        var opcionaisDoAberto = _custo.Opcionais(aberto, _proposta.Moeda).Count;
        <div class="equip-abas" role="group" aria-label="Abas do equipamento @(PosicaoValida + 1)">
            <button class="sub-aba @(_abaItem == "escopo" ? "ativa" : "")" aria-current="@(_abaItem == "escopo" ? "true" : null)"
                    @onclick='() => TrocarAba("escopo")'>Escopo</button>
            <button class="sub-aba @(_abaItem == "opcionais" ? "ativa" : "")" aria-current="@(_abaItem == "opcionais" ? "true" : null)"
                    @onclick='() => TrocarAba("opcionais")'>
                Opcionais@(opcionaisDoAberto > 0 ? $" ({opcionaisDoAberto})" : "")
            </button>
            <button class="sub-aba @(_abaItem == "tecnica" ? "ativa" : "")" aria-current="@(_abaItem == "tecnica" ? "true" : null)"
                    @onclick='() => TrocarAba("tecnica")'>
                Técnica
                @if (aberto.Tecnicos.Count > 0 && aberto.Curvas.Count > 0)
                {
                    <span class="etapa-ok" title="seleção e curva"><Icone Nome="ok" /></span>
                }
            </button>
        </div>
    }
</div>

@* o começo do conteúdo do equipamento: é para cá que a tela volta ao trocar
   de equipamento ou de aba com a tela rolada (ver AbrirEquipamento) *@
<div id="equip-conteudo">
    @if (_abaItem == "escopo")
    {
<div class="panel" style="margin-bottom:14px">

    @* a moeda manda em todos os custos da proposta, mas é aqui, no escopo,
       que os custos aparecem *@
    <div class="toolbar moeda-do-custo">
        <strong>Moeda do custo</strong>
        <div class="seg" role="group" aria-label="Moeda do custo">
            @foreach (var m in Moedas.Todas)
            {
                var moeda = m;
                <button class="@(_proposta.Moeda == moeda ? "on" : "")" aria-pressed="@(_proposta.Moeda == moeda ? "true" : "false")"
                        @onclick="() => _proposta.MoedaCodigo = moeda.Codigo()">@moeda.Rotulo()</button>
            }
        </div>
        <span class="subtitle ajuda" style="margin:0">manda em todos os custos</span>
    </div>

    <p class="subtitle ajuda" style="margin:0 0 12px">
        O custo de cada linha vem do cadastro e <strong>dá para trocar na própria linha</strong>:
        serve para o que ainda não tem custo cadastrado e para quando a proposta pede um valor
        diferente. O que você digita vale <strong>só nesta proposta</strong> — o cadastro não
        muda — e o <strong>↺</strong> ao lado volta ao custo do cadastro.
    </p>


    @if (_proposta.Itens.Count == 0)
    {
        <div class="panel empty" style="padding:18px">
            Nenhum equipamento ainda. Suba a folha de dados — cada coluna com número na linha
            31 vira um equipamento — ou clique em <strong>+ equipamento</strong>.
        </div>
    }
    else
    {
        var atual = _proposta.Itens[PosicaoValida];
        var modelo = ModeloDe(atual);
        // antes do filtro: com mais de quatro candidatos, a sugestão já põe o diâmetro nele
        var sugestaoDoModelo = ModelosDaSelecao(atual);

        <div class="toolbar" style="flex-wrap:wrap">
            <label style="display:flex; align-items:center; gap:6px">
                <strong>Quantidade</strong>
                <input class="cell num" style="width:90px" type="number" min="1"
                       value="@atual.Quantidade"
                       @onchange="e => atual.Quantidade = e.Value?.ToString() ?? string.Empty" />
            </label>

            <strong style="margin-left:10px">Modelo</strong>
            <input class="cell" style="width:110px" placeholder="filtrar…"
                   title="Digite parte do modelo (ex.: 54, VAX 1800) para encurtar a lista"
                   value="@FiltroDoModelo(atual)"
                   @oninput="e => _filtroModelo[atual] = e.Value?.ToString() ?? string.Empty" />
            <select id="f-modelo" class="cell" style="min-width:340px" value="@atual.EquipamentoId"
                    @onchange="e => EscolherNaLista(atual, e.Value?.ToString() ?? string.Empty)">
                <option value="">— escolher o equipamento —</option>
                @foreach (var serie in ModelosDoFiltro(atual).GroupBy(x => x.Serie))
                {
                    <optgroup label="@RotuloDaSerie(serie.Key, serie)">
                        @foreach (var eq in serie)
                        {
                            <option value="@eq.Id" selected="@(eq.Id == atual.EquipamentoId)">@RotuloDoModelo(eq)</option>
                        }
                    </optgroup>
                }
            </select>

            @if (ModeloDe(atual) is { } escolhidoAgora && PrecoDoEquipamento(escolhidoAgora) is null
                 && !EhManual(atual, "equipamento"))
            {
                <span class="subtitle texto-alerta">
                    este modelo não tem custo em @_proposta.Moeda.Rotulo() — ponha à mão abaixo
                </span>
            }
            else
            {
                <span class="subtitle ajuda" style="margin:0">preencher manual</span>
            }

            @* o rótulo e o controle juntos: quebrando a linha, o "Tipo" ficava sozinho no fim de uma e o Padrão/Especial na outra *@
            <span style="display:inline-flex; align-items:center; gap:8px; margin-left:10px">
                <strong>Tipo</strong>
                <span class="seg" role="group" aria-label="Tipo">
                    <button class="@(atual.Especial ? "" : "on")" aria-pressed="@(atual.Especial ? "false" : "true")"
                            @onclick="() => atual.Especial = false">Padrão</button>
                    <button class="@(atual.Especial ? "on" : "")" aria-pressed="@(atual.Especial ? "true" : "false")"
                            @onclick="() => atual.Especial = true">Especial</button>
                </span>
                <span class="subtitle ajuda" style="margin:0">a 2ª letra do código</span>
            </span>

            <span style="flex:1"></span>
            <button class="btn-link" @onclick="DuplicarEquipamento"
                    title="Um equipamento igual a este logo depois dele — sem a seleção e a curva">duplicar equipamento</button>
            @if (_apagandoItem == PosicaoValida)
            {
                <span class="aviso aviso-alerta" style="margin:0; padding:5px 9px">
                    Remover o equipamento @(PosicaoValida + 1) da proposta?
                </span>
                <button class="btn-link" @onclick="Remover">Sim, remover</button>
                <button class="btn-link" @onclick="@(() => _apagandoItem = null)">Cancelar</button>
            }
            else
            {
                <button class="btn-link" @onclick="@(() => _apagandoItem = PosicaoValida)">Remover</button>
            }
        </div>

        @* o modelo pela seleção (item 14): até quatro botões no lugar do selo
           "seleção: …". O primeiro só ganha destaque quando casa diâmetro, cubo
           e série; o sistema nunca escolhe sozinho *@
        @if (sugestaoDoModelo is { } sugestao)
        {
            <div class="modelo-pela-selecao" role="group" aria-label="Modelos pela seleção">
                <span class="nota">Pela seleção <strong>@sugestao.Lido.Texto</strong>:</span>
                @for (var b = 0; b < sugestao.Botoes.Count; b++)
                {
                    var eq = sugestao.Botoes[b];
                    var primeiro = b == 0;
                    <button class="btn-ghost modelo-sugerido @(primeiro && sugestao.Casou ? "casa" : "")"
                            title="@(primeiro && sugestao.Casou ? "Casa com a seleção: diâmetro, cubo e série" : "Mesmo diâmetro da seleção")"
                            @onclick="() => EscolherPelaSelecao(atual, eq, primeiro)">@RotuloDoBotao(eq)</button>
                }
                @if (sugestao.Restantes > 0)
                {
                    <span class="nota">+@sugestao.Restantes na lista</span>
                }
                @if (!sugestao.Casou)
                {
                    <span class="nota texto-alerta">@SemCasamento(sugestao)</span>
                }
            </div>
        }
        else if (modelo is not null && atual.Tecnicos.TryGetValue("serie", out var serieDaSelecao) && serieDaSelecao.Valor.Trim().Length > 0)
        {
            <div class="modelo-pela-selecao so-nota">
                <span class="nota" title="O modelo como está escrito no relatório de seleção">seleção: @serieDaSelecao.Valor</span>
                @if (DiferencaDaSelecao(atual) is { } difere)
                {
                    <span class="nota texto-alerta modelo-difere">@difere</span>
                }
            </div>
        }

        <div id="f-montagem" class="toolbar" style="flex-wrap:wrap">
            <strong style="min-width:210px">@Campo("Arranjo / Instalação", "linha 40")</strong>
            <div class="seg" role="group" aria-label="Arranjo / Instalação">
                @foreach (var a in ListasDaProposta.Arranjos)
                {
                    var arranjo = a;
                    <button class="@(atual.Arranjo == arranjo ? "on" : "")" aria-pressed="@(atual.Arranjo == arranjo ? "true" : "false")"
                            @onclick="() => atual.Arranjo = arranjo">@arranjo</button>
                }
            </div>

            @* a montagem se junta ao arranjo na proposta técnica:
               "Horizontal ao piso, arranjo 4" *@
            <strong style="margin-left:14px">@Campo("Montagem")</strong>
            <div class="seg" role="group" aria-label="Montagem">
                @foreach (var m in new[] { "Horizontal", "Vertical" })
                {
                    var montagem = m;
                    <button class="@(Textos.Igual(atual.Montagem, montagem) ? "on" : "")"
                            aria-pressed="@(Textos.Igual(atual.Montagem, montagem) ? "true" : "false")"
                            @onclick="() => atual.Montagem = montagem">@montagem</button>
                }
            </div>

            @if (DadosDoVentilador.Montagem(atual) is { Length: > 0 } linhaDaMontagem)
            {
                <span class="val-count">@linhaDaMontagem</span>
            }
        </div>

        <div class="toolbar" style="flex-wrap:wrap">
            <strong style="min-width:210px">@Campo("Aplicação")</strong>
            @* as aplicações desta proposta e do MESMO cliente (item 17): nada vem
               de outro cliente, e nada é preenchido sozinho *@
            <input id="f-aplicacao" class="cell" style="flex:1; max-width:520px"
                   placeholder="onde o ventilador vai trabalhar" list="aplicacoes-usadas"
                   value="@atual.Aplicacao"
                   @onchange="e => atual.Aplicacao = e.Value?.ToString() ?? string.Empty" />
            <datalist id="aplicacoes-usadas">
                @foreach (var usada in AplicacoesUsadas(atual))
                {
                    <option value="@usada"></option>
                }
            </datalist>
            @if (AplicacaoDeOutro(atual) is { } igual)
            {
                <button class="btn-link aplicacao-igual" title="Copiar: @igual.Texto"
                        @onclick="() => atual.Aplicacao = igual.Texto">igual ao equip. @(igual.Indice + 1): @igual.Texto</button>
            }
        </div>

        @if (modelo is not null)
        {
            <div class="panel" style="padding:0; overflow-x:auto; margin-bottom:14px">
                <table class="grid">
                    <thead>
                        <tr>
                            <th class="nowrap">Série</th>
                            <th class="nowrap">Diâmetro</th>
                            <th class="nowrap">Cubo</th>
                            <th class="nowrap">FB/HB</th>
                            <th class="nowrap">Nº de estágios</th>
                            <th class="nowrap">Código</th>
                            <th class="nowrap right">Custo @_proposta.Moeda.Rotulo()</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="nowrap"><span class="val-count">@modelo.Serie</span></td>
                            <td class="nowrap"><strong>@modelo.Diametro</strong></td>
                            <td class="nowrap"><strong>@modelo.Cubo</strong></td>
                            <td class="nowrap">@(modelo.FbHb.Length > 0 ? modelo.FbHb : "—")</td>
                            <td class="nowrap">@(modelo.Estagios.Length > 0 ? modelo.Estagios : "—")</td>
                            <td class="nowrap">@(modelo.Codigo.Length > 0 ? modelo.Codigo : "—")</td>
                            <td class="right">@Preco(atual, "equipamento", PrecoDoModelo(atual))</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="panel empty" style="padding:16px; margin-bottom:14px">
                Escolha o modelo: é ele que diz o diâmetro, e é pelo diâmetro que os
                preços de base, cone, silenciador, difusor, conexão a manga e damper são
                puxados.
            </div>
        }

        <div class="toolbar" style="flex-wrap:wrap; border-top:1px solid var(--border);
                                    padding-top:12px">
            <strong style="min-width:210px">Código do equipamento</strong>
            <span class="val-count" style="font-size:14px; letter-spacing:.5px">@CodigoDe(atual)</span>

            @if (CodigoDoEquipamento.SemCodigo(atual, _custo, _proposta.Moeda)
                 is { Count: > 0 } semCodigo)
            {
                <span class="subtitle texto-alerta">
                    sem código no cadastro: @string.Join(", ", semCodigo) — cada um vira um
                    <strong>?</strong>
                </span>
            }
            else
            {
                <span class="subtitle ajuda" style="margin:0">
                    sai na proposta comercial e na técnica
                </span>
            }
        </div>

        @* a linha Escopo padrão diz de onde o escopo veio (item 15) e o que o
           "Sem" em lote vai marcar (item 13); os dois desfazer moram AQUI, não
           só no aviso *@
        @if (modelo is not null)
        {
            var padraoDaSerie = PadraoDaSerie(modelo.Serie);
            var trazido = EscopoTrazido(atual);
            var loteSem = SemParaDesfazer(atual);
            var emBranco = SemEmBranco(atual);
            <div id="f-escopo-padrao" class="toolbar escopo-padrao">
                <strong class="escopo-rotulo">Escopo padrão</strong>
                <div class="escopo-padrao-corpo">
                    <span class="escopo-de-onde">
                    @if (trazido is not null)
                    {
                        var opcionaisDaOrigem = OpcionaisDaOrigem(trazido);
                        <span class="escopo-trazido">@TextoDoEscopoTrazido(trazido)</span>
                        <button class="btn-link" aria-label="Desfazer o escopo trazido"
                                @onclick="() => DesfazerEscopo(atual)">desfazer</button>
                        @if (trazido.Ignoradas.Count > 0)
                        {
                            <span class="nota texto-alerta" title="@string.Join("; ", trazido.Ignoradas)">
                                @Plural(trazido.Ignoradas.Count, "linha ignorada", "linhas ignoradas"): a opção saiu do cadastro
                            </span>
                        }
                        @if (opcionaisDaOrigem.Count > 0)
                        {
                            <button class="btn-link oferta-opcionais" @onclick="() => TrazerOpcionais(atual)">
                                @TextoDaOferta(trazido, opcionaisDaOrigem)
                            </button>
                        }
                    }
                    else if (padraoDaSerie is not null)
                    {
                        <button class="btn-ghost" @onclick="() => AplicarPadrao(atual, modelo.Serie)">
                            Aplicar o padrão da série @modelo.Serie
                        </button>
                        <span class="nota">
                            guardado por @padraoDaSerie.GuardadoPor em @DataCurta(padraoDaSerie.GuardadoEm)
                        </span>
                    }
                    else
                    {
                        <span class="nota">a série @modelo.Serie ainda não tem escopo padrão</span>
                    }
                    </span>
                    <button class="btn-link guardar-padrao" @onclick="() => GuardarPadrao(atual, modelo.Serie)"
                            title="O próximo equipamento desta série já nasce com este escopo">
                        guardar este escopo como padrão da série
                    </button>

                    @* o Sem em lote numa linha só dele, com o desfazer ao lado do que fez *@
                    @if (loteSem is not null)
                    {
                        <span class="escopo-lote">
                            <span class="nota" title="@string.Join(", ", loteSem.Grupos.Select(Exibir))">
                                Sem marcado em @Plural(loteSem.Grupos.Count, "lista", "listas")
                            </span>
                            <button class="btn-link" aria-label="Desfazer o Sem em lote"
                                    @onclick="() => DesfazerSemEmLote(atual)">desfazer</button>
                        </span>
                    }
                    else if (emBranco.Count > 0)
                    {
                        <span class="escopo-lote">
                            <button class="btn-ghost sem-em-lote" title="Marca Sem em: @string.Join(", ", emBranco.Select(Exibir))"
                                    @onclick="() => MarcarSemNasEmBranco(atual)"><span>@TextoDoSemEmLote(emBranco)</span></button>
                        </span>
                    }
                </div>
            </div>
        }

        @* cada lista numa grade de 4 colunas (item 13): rótulo | Sem/Com | a
           opção e de onde vem o custo | o custo — o campo fica sempre na mesma
           coluna. A lista sem escolha ganha o ponto âmbar e "a decidir": antes
           ela parecia "Sem" *@
        @foreach (var lista in _listas)
        {
            var grupo = lista;
            var opcoes = _porGrupo.GetValueOrDefault(grupo, new());
            if (opcoes.Count == 0) { continue; }

            var comOpcoes = opcoes.Where(o => !FamiliaDePreco.EhAusencia(o.Valor)).ToList();
            var escolhida = atual.Escolhas.GetValueOrDefault(grupo, "");
            var temItem = escolhida.Length > 0 && !FamiliaDePreco.EhAusencia(escolhida);
            var aDecidir = escolhida.Length == 0;
            var chaveDoCusto = $"lista:{grupo}";
            var linha = aDecidir ? null : Resolver(atual, grupo, escolhida);

            <div id="@AlvoDaLista(grupo)" class="toolbar escopo-linha @(aDecidir ? "a-decidir" : "")">
                <strong class="escopo-rotulo">
                    @if (aDecidir)
                    {
                        <span class="ponto-pendente" aria-hidden="true"></span>
                    }
                    @Campo(Exibir(grupo), LinhaDaPlanilha(grupo))
                </strong>

                @* o mesmo controle do motor, do partidor e da instrumentação logo
                   abaixo: Com ligado em azul, Sem ligado em cinza *@
                <div class="seg" role="group" aria-label="@Exibir(grupo)">
                    <button class="sem @(escolhida.Length > 0 && !temItem ? "on" : "")"
                            aria-pressed="@(escolhida.Length > 0 && !temItem ? "true" : "false")"
                            @onclick="() => MarcarSem(atual, grupo)">Sem</button>
                    <button class="@(temItem ? "on" : "")" aria-pressed="@(temItem ? "true" : "false")"
                            @onclick="() => MarcarCom(atual, grupo)">Com</button>
                </div>

                <div class="escopo-escolha">
                    @if (temItem && comOpcoes.Count > 1)
                    {
                        <select class="cell" value="@escolhida" aria-label="Opção de @Exibir(grupo)"
                                @onchange="e => atual.Escolhas[grupo] = e.Value?.ToString() ?? string.Empty">
                            @foreach (var o in comOpcoes)
                            {
                                <option value="@o.Valor" selected="@(o.Valor == escolhida)">@o.Valor</option>
                            }
                        </select>
                    }
                    else if (temItem && !SoDizCom(escolhida))
                    {
                        <span class="escopo-opcao">@escolhida</span>
                    }

                    @if (aDecidir)
                    {
                        <span class="nota texto-alerta">a decidir</span>
                    }
                    else if (linha is not null)
                    {
                        var origemDaLinha = OrigemDaLinha(atual, chaveDoCusto, linha.Codigo, linha.Origem);
                        <span class="nota escopo-origem" title="@origemDaLinha">@origemDaLinha</span>
                    }
                </div>

                <div class="escopo-custo">
                    @* o "Sem" custa nada: sem campo, a não ser que tenha custo (do
                       cadastro ou à mão), para dar para ler e voltar *@
                    @if (linha is not null && (temItem || Efetivo(atual, chaveDoCusto, linha.Valor) is not null))
                    {
                        @Preco(atual, chaveDoCusto, linha.Valor)
                    }
                </div>
            </div>
        }

        <!-- ---------- parte elétrica: motor, partidor e instrumentação ---------- -->
        <div class="toolbar" style="flex-wrap:wrap; border-top:2px solid var(--border); padding-top:14px; margin-top:14px">
            <h3 style="margin:0; font-size:14px">Parte elétrica</h3>
            <span class="subtitle ajuda" style="margin:0">
                o motor elétrico, o partidor e a instrumentação — cada um com o seu flag
            </span>
        </div>

        @* motor, partidor e instrumentação na mesma grade das listas: o custo
           do motor sobe para a 4ª coluna da linha dele, alinhado com os outros *@
        <div class="toolbar escopo-linha">
            <strong class="escopo-rotulo">@Campo("Motor elétrico")</strong>
            <div class="seg" role="group" aria-label="Motor elétrico">
                <button class="sem @(atual.ComMotor ? "" : "on")" aria-pressed="@(atual.ComMotor ? "false" : "true")"
                        @onclick="() => atual.ComMotor = false">Sem</button>
                <button class="@(atual.ComMotor ? "on" : "")" aria-pressed="@(atual.ComMotor ? "true" : "false")"
                        @onclick="() => LigarMotor(atual)">Com</button>
            </div>

            <div class="escopo-escolha">
                @if (!atual.ComMotor)
                {
                    <span class="nota ajuda">
                        o catálogo de motores, já filtrado pela série
                        @(modelo is null ? "do modelo" : $"\"{modelo.Serie}\"") — motor marcado como
                        "as duas" serve às duas linhas
                    </span>
                }
                else if (MotorDe(atual) is { } motorDaLinha)
                {
                    @if (PrecoDoMotor(motorDaLinha) is null && !EhManual(atual, "motor"))
                    {
                        <span class="nota texto-alerta escopo-origem">
                            @(motorDaLinha.Codigo.Length > 0 ? $"código {motorDaLinha.Codigo}" : "sem código") ·
                            este motor não tem custo em @_proposta.Moeda.Rotulo() — ponha à mão ao lado
                        </span>
                    }
                    else
                    {
                        var origemDoMotor = OrigemDaLinha(atual, "motor", motorDaLinha.Codigo, "catálogo de motores");
                        <span class="nota escopo-origem" title="@origemDoMotor">@origemDoMotor</span>
                    }
                }
                else
                {
                    <span class="nota escopo-origem" title="escolha o motor abaixo — aí vêm o código e o custo; o custo também dá para pôr à mão">
                        sem motor ainda — escolha abaixo
                    </span>
                }
            </div>

            <div class="escopo-custo">
                @if (atual.ComMotor)
                {
                    @Preco(atual, "motor", PrecoDoMotor(atual))
                }
            </div>
        </div>

        @if (atual.ComMotor)
        {
            @* item 16: com o motor definido, as nove listas recolhem num cartão;
               sem ele, a sugestão da seleção numa linha, três filtros à vista e
               os candidatos em linhas clicáveis *@
            var motorDefinido = MotorDe(atual);
            var pedeMais = SelecaoPedeMais(atual);

            @if (motorDefinido is not null && !_filtrosAbertos.Contains(atual))
            {
                <div id="f-motor" class="motor-cartao">
                    <div class="motor-cartao-linha">
                        <strong>@ResumoDoMotor(motorDefinido)</strong>
                        <span class="motor-cartao-extra">
                            @(motorDefinido.Codigo.Length > 0 ? $"código {motorDefinido.Codigo}" : "sem código")
                            · @CustoNoCartao(atual, motorDefinido)
                        </span>
                    </div>
                    <div class="motor-cartao-porque">
                        <span class="nota">@PorQueDoMotor(atual)</span>
                        <button class="btn-link motor-trocar" @onclick="() => TrocarMotor(atual)">trocar</button>
                    </div>
                    @if (pedeMais is not null)
                    {
                        <div class="motor-pede-mais">
                            <span class="nota texto-alerta"><Icone Nome="alerta" /> @pedeMais</span>
                            @if (atual.FiltroAuto.Count > 0 && FiltroSoAuto(atual))
                            {
                                <button class="btn-link" @onclick="() => RefazerMotor(atual)">refazer</button>
                            }
                            else
                            {
                                <button class="btn-link" @onclick="() => TrocarMotor(atual)">trocar</button>
                            }
                        </div>
                    }
                    @if (motorDefinido.Observacoes.Length > 0)
                    {
                        <p class="nota" style="margin:4px 0 0"><strong>Observação:</strong> @motorDefinido.Observacoes</p>
                    }
                    @if (AvisoDoMotor(atual) is { } avisoDoCartao)
                    {
                        <div class="aviso aviso-alerta" style="margin-top:8px">@avisoDoCartao</div>
                    }
                </div>
            }
            else
            {
                var candidatos = Candidatos(atual);
                var sugestaoDoMotor = SugestaoDoMotor(atual);
                var doPais = SugestaoDoMotorPeloPais(atual);
                var escondidosEmUso = FiltrosEscondidosEmUso(atual);

                <div id="f-motor" class="panel motor-filtros">
                    @if (modelo is null)
                    {
                        <p class="nota" style="margin:0 0 10px">
                            sem modelo, o catálogo mostra os motores das duas linhas — escolha o modelo e o motor fecha pela seleção
                        </p>
                    }
                    else if (sugestaoDoMotor is not null)
                    {
                        <div class="motor-sugestao">
                            <span class="nota">@sugestaoDoMotor.Texto</span>
                            @if (NenhumChegaAPotencia(atual))
                            {
                                <span class="nota texto-alerta">nenhum motor da série @modelo.Serie chega a @sugestaoDoMotor.CvMinimo.ToString("N0", Br) CV no catálogo</span>
                            }
                            else if (!SugestaoAplicada(atual))
                            {
                                <button class="btn-link" @onclick="() => AplicarSugestaoAoFiltro(atual)">aplicar ao filtro</button>
                            }
                        </div>
                    }
                    @if (pedeMais is not null)
                    {
                        <div class="motor-pede-mais">
                            <span class="nota texto-alerta"><Icone Nome="alerta" /> @pedeMais</span>
                        </div>
                    }
                    @if (doPais is not null)
                    {
                        <div class="motor-do-pais">
                            <button class="btn-ghost" @onclick="() => UsarSugestaoDoPais(atual, doPais)">@doPais.Texto</button>
                            <span class="nota">cliente sem motor em proposta anterior</span>
                        </div>
                    }

                    <div class="form3 motor-campos">
                        @foreach (var campo in EscopoProposta.CamposDoMotor.Where(c => FiltrosAVista.Contains(c.Rotulo)))
                        {
                            @CampoDoFiltro(atual, campo)
                        }
                    </div>

                    <div class="motor-mais">
                        <button class="btn-link" aria-expanded="@(_maisFiltros.Contains(atual) ? "true" : "false")"
                                @onclick="() => AlternarMaisFiltros(atual)">
                            @(_maisFiltros.Contains(atual) ? "Menos filtros" : $"Mais filtros ({EscopoProposta.CamposDoMotor.Length - FiltrosAVista.Length})")
                        </button>
                        @if (!_maisFiltros.Contains(atual) && escondidosEmUso.Length > 0)
                        {
                            <span class="nota">em uso: @escondidosEmUso</span>
                        }
                    </div>
                    @if (_maisFiltros.Contains(atual))
                    {
                        <div class="form3 motor-campos">
                            @foreach (var campo in EscopoProposta.CamposDoMotor.Where(c => !FiltrosAVista.Contains(c.Rotulo)))
                            {
                                @CampoDoFiltro(atual, campo)
                            }
                        </div>
                    }

                    <div class="motor-conta">
                        <span class="val-count">@Plural(candidatos.Count, "motor atende", "motores atendem")</span>
                        <span class="nota">@MotoresComPreco(candidatos) com custo em @_proposta.Moeda.Rotulo()</span>
                        <span style="flex:1"></span>
                        @if (atual.FiltroMotor.Values.Any(v => v.Length > 0) || atual.MotorId.Length > 0)
                        {
                            <button class="btn-link" @onclick="() => LimparFiltroDoMotor(atual)">limpar filtro</button>
                        }
                        @if (motorDefinido is not null)
                        {
                            <button class="btn-link" @onclick="() => _filtrosAbertos.Remove(atual)">voltar ao resumo</button>
                        }
                    </div>

                    @if (candidatos.Count is > 0 and <= CandidatosEmLinhas)
                    {
                        <div class="motor-candidatos" role="group" aria-label="Motores que atendem">
                            @foreach (var m in candidatos)
                            {
                                var candidato = m;
                                var escolhido = motorDefinido?.Id == candidato.Id;
                                <button class="motor-candidato @(escolhido ? "on" : "")"
                                        aria-pressed="@(escolhido ? "true" : "false")"
                                        @onclick="() => EscolherMotor(atual, candidato)">
                                    <span class="motor-candidato-desc" title="@TituloDoCandidato(candidato)">@ResumoDoMotor(candidato)</span>
                                    <span class="motor-candidato-cod">@(candidato.Codigo.Length > 0 ? candidato.Codigo : "sem código")</span>
                                    <span class="motor-candidato-custo">@CustoDoMotor(candidato)</span>
                                </button>
                            }
                        </div>
                    }
                    else if (candidatos.Count > CandidatosEmLinhas)
                    {
                        <p class="nota" style="margin:8px 0 0">aperte o filtro até sobrarem @CandidatosEmLinhas ou menos — aí eles aparecem aqui para escolher</p>
                    }
                    else
                    {
                        <p class="nota texto-alerta" style="margin:8px 0 0">nenhum motor atende a este filtro — limpe o filtro ou mude um campo</p>
                    }

                    @if (motorDefinido is { Observacoes.Length: > 0 })
                    {
                        <p class="nota" style="margin:8px 0 0"><strong>Observação:</strong> @motorDefinido.Observacoes</p>
                    }

                    @if (AvisoDoMotor(atual) is { } aviso)
                    {
                        <div class="aviso aviso-alerta" style="margin-top:10px">@aviso</div>
                    }
                </div>
            }
        }

        <!-- partidor: o preço vem da potência do motor -->
        <div class="toolbar escopo-linha">
            <strong class="escopo-rotulo">@Exibir(ListaDosPartidores)</strong>
            <div class="seg" role="group" aria-label="@Exibir(ListaDosPartidores)">
                <button class="sem @(atual.ComPartidor ? "" : "on")" aria-pressed="@(atual.ComPartidor ? "false" : "true")"
                        @onclick="() => atual.ComPartidor = false">Sem</button>
                <button class="@(atual.ComPartidor ? "on" : "")" aria-pressed="@(atual.ComPartidor ? "true" : "false")"
                        @onclick="() => LigarPartidor(atual)">Com</button>
            </div>

            @{ var linhaDoPartidor = atual.ComPartidor ? LinhaDoPartidor(atual) : null; }
            <div class="escopo-escolha">
                @if (atual.ComPartidor)
                {
                    <select id="f-partidor" class="cell" value="@atual.Partidor" aria-label="Partidor"
                            @onchange="e => atual.Partidor = e.Value?.ToString() ?? string.Empty">
                        <option value="">— escolher —</option>
                        @foreach (var o in OpcoesReais(ListaDosPartidores))
                        {
                            <option value="@o.Valor" selected="@(o.Valor == atual.Partidor)">@o.Valor</option>
                        }
                    </select>

                    @if (linhaDoPartidor is not null)
                    {
                        var origemDoPartidor = OrigemDaLinha(atual, "partidor", linhaDoPartidor.Codigo, linhaDoPartidor.Origem);
                        <span class="nota escopo-origem" title="@origemDoPartidor">@origemDoPartidor</span>
                    }
                }
            </div>

            <div class="escopo-custo">
                @if (linhaDoPartidor is not null)
                {
                    @Preco(atual, "partidor", linhaDoPartidor.Valor)
                }
            </div>
        </div>

        <!-- instrumentação: pode ser mais de uma -->
        <div class="toolbar escopo-linha">
            <strong class="escopo-rotulo">@Exibir(ListaDaInstrumentacao)</strong>
            <div class="seg" role="group" aria-label="@Exibir(ListaDaInstrumentacao)">
                <button class="sem @(atual.ComInstrumentacao ? "" : "on")" aria-pressed="@(atual.ComInstrumentacao ? "false" : "true")"
                        @onclick="() => DesligarInstrumentacao(atual)">Sem</button>
                <button class="@(atual.ComInstrumentacao ? "on" : "")" aria-pressed="@(atual.ComInstrumentacao ? "true" : "false")"
                        @onclick="() => atual.ComInstrumentacao = true">Com</button>
            </div>
            <div class="escopo-escolha">
                @if (atual.ComInstrumentacao)
                {
                    <span class="nota">marque uma ou mais abaixo</span>
                }
            </div>
            <div class="escopo-custo"></div>
        </div>

        @* cada instrumentação numa linha da mesma grade: a caixa e o nome nas
           duas primeiras colunas, a origem na 3ª e o custo na 4ª *@
        @if (atual.ComInstrumentacao)
        {
            <div class="escopo-instrumentos">
                @foreach (var o in OpcoesReais(ListaDaInstrumentacao))
                {
                    var opcao = o;
                    var marcada = atual.Instrumentacao.Contains(opcao.Valor);
                    var linha = Resolver(atual, opcao.Grupo, opcao.Valor);
                    var chaveDoInstrumento = $"instr:{opcao.Valor}";

                    <div class="escopo-linha escopo-sub">
                        <label class="escopo-marca">
                            <input type="checkbox" checked="@marcada"
                                   @onchange="e => MarcarInstrumentacao(atual, opcao.Valor, (bool)(e.Value ?? false))" />
                            <span>@opcao.Valor</span>
                        </label>
                        <div class="escopo-escolha">
                            @if (marcada)
                            {
                                var origemDoInstrumento = OrigemDaLinha(atual, chaveDoInstrumento, linha.Codigo, linha.Origem);
                                <span class="nota escopo-origem" title="@origemDoInstrumento">@origemDoInstrumento</span>
                            }
                            else
                            {
                                <span class="nota escopo-origem">
                                    @(linha.Codigo.Length > 0 ? $"código {linha.Codigo}" : "sem código")
                                    ·
                                    @(linha.Valor is null ? linha.Origem : Dinheiro(linha.Valor))
                                </span>
                            }
                        </div>
                        <div class="escopo-custo">
                            @if (marcada)
                            {
                                @Preco(atual, chaveDoInstrumento, linha.Valor)
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

    }
    @if (_abaItem == "opcionais")
    {
    @* a aba Opcionais (item 18): um seletor só, com uma lista por grupo, e a
       tabela do que foi escolhido como lista principal. A conta é a de antes:
       o custo vem de CustoDaProposta.Opcionais e o preço de PrecoDoOpcional *@
<div class="panel opc-painel">
    <div class="opc-cabeca">
        <h2>Opcionais</h2>
        <span class="subtitle ajuda">o que o cliente pode comprar ou não — fora do preço fechado</span>
        <span class="opc-espaco"></span>
        @if (TotalDosOpcionais is { } totalOpc && totalOpc > 0m)
        {
            @* é preço ao cliente (custo × fator), na moeda de venda, como a coluna da tabela *@
            <span class="val-count">@DinheiroVenda(totalOpc) em opcionais</span>
        }
    </div>

        @if (_proposta.Itens.Count == 0)
        {
            <div class="panel empty" style="padding:16px; margin-top:14px">
                Escolha os equipamentos no escopo — os opcionais são por equipamento.
            </div>
        }
        else
        {
            var indice = PosicaoValida;
            var item = _proposta.Itens[indice];
            var opcionais = _custo.Opcionais(item, _proposta.Moeda);
            var grupos = GruposParaAdicionar(item);

            <p class="subtitle ajuda opc-ajuda">
                São as mesmas listas do escopo, menos o modelo: o equipamento sai completo e a
                peça fica <strong>como opcional</strong>, para o cliente decidir. Eles
                <strong>não entram no preço fechado</strong> nem no código — o preço de cada um é
                o custo vezes o fator da proposta
                (<strong>@FatorDaProposta.ToString("N4", new System.Globalization.CultureInfo("pt-BR"))</strong>),
                que é a mesma margem, comissão e imposto do que já está fechado.
            </p>

            <div class="opc-equip">
                <div class="opc-equip-cabeca">
                    <strong>Equip. @(indice + 1)</strong>
                    <span class="opc-modelo">· @(ModeloDe(item) is { } m ? m.Rotulo : "sem modelo escolhido") · @item.Quantos un.</span>
                    <span class="opc-espaco"></span>
                    @if (opcionais.Count > 0)
                    {
                        <span class="val-count">@Plural(opcionais.Count, "opcional", "opcionais")</span>
                    }
                </div>

                <div class="opc-adicionar-linha">
                    @if (grupos.Count > 0)
                    {
                        @* volta ao vazio depois de cada escolha (o @key sobe em AdicionarOpcional) *@
                        <select class="cell opc-adicionar" @key="_adicionarOpcional" aria-label="Adicionar opcional"
                                @onchange="e => AdicionarOpcional(item, e.Value?.ToString() ?? string.Empty)">
                            <option value="">+ Adicionar opcional…</option>
                            @foreach (var (rotulo, opcoes) in grupos)
                            {
                                <optgroup label="@rotulo">
                                    @foreach (var o in opcoes)
                                    {
                                        <option value="@o.Valor">@o.Texto</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    }
                    else
                    {
                        <span class="nota">todas as listas já têm opcional — troque a variante na linha</span>
                    }
                </div>

                @if (opcionais.Count == 0)
                {
                    <div class="opc-vazio">Nenhum opcional — use <strong>+ Adicionar opcional</strong></div>
                }
                else
                {
                    <table class="grid opc-tabela">
                        <colgroup>
                            <col />
                            <col class="col-qtd" />
                            <col class="col-custo" />
                            <col class="col-preco" />
                            <col class="col-tirar" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Opcional e variante</th>
                                <th class="right">Qtd.</th>
                                <th class="right">Custo unit. @_proposta.Moeda.Rotulo()</th>
                                @* o valor da coluna é o preço AO CLIENTE (custo × fator, vezes a
                                   quantidade), na moeda de venda *@
                                <th class="right">Preço ao cliente (@_proposta.MoedaVenda.Rotulo())</th>
                                <th><span class="opc-escondido">Remover</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in opcionais)
                            {
                                var linha = l;
                                var unitario = _custo.CustoDoOpcional(item, linha);
                                var variantes = VariantesDoOpcional(item, linha);
                                var semCusto = Efetivo(item, linha.Chave, linha.Valor) is null;
                                var notaExtra = NotaExtraDoOpcional(item, linha.Chave);
                                <tr>
                                    <td>
                                        <div class="opc-nome" title="sai no documento como: @linha.Nome(EscopoTextos)">
                                            <strong>@NomeDoOpcional(linha)</strong>
                                            @if (notaExtra is { Length: > 0 })
                                            {
                                                <span class="nota">· @notaExtra</span>
                                            }
                                        </div>
                                        @if (variantes.Count > 0)
                                        {
                                            var atual = linha.Chave == "opc:motor" ? item.MotorOpcionalId : linha.Opcao;
                                            <select class="cell opc-variante" aria-label="Variante de @NomeDoOpcional(linha)"
                                                    @onchange="e => TrocarVariante(item, linha, e.Value?.ToString() ?? string.Empty)">
                                                @foreach (var (valor, texto) in variantes)
                                                {
                                                    <option value="@valor" selected="@(valor == atual)">@texto</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <div class="opc-fixa">@VarianteFixa(item, linha)</div>
                                        }
                                        @if (semCusto)
                                        {
                                            @* o porquê de não ter custo ("escolha o motor: o custo vem da
                                               potência dele"), em âmbar: é o que diz o que fazer *@
                                            <span class="nota texto-alerta opc-origem opc-sem-custo">@(linha.Origem.Length > 0 ? linha.Origem : "sem custo no cadastro") — digite o custo ao lado</span>
                                        }
                                        else
                                        {
                                            <span class="nota opc-origem" title="@linha.Origem">@(EhManual(item, linha.Chave) ? "custo à mão" : linha.Origem)</span>
                                        }
                                    </td>
                                    <td class="right">@item.Quantos</td>
                                    <td class="col-custo">@Preco(item, linha.Chave, linha.Valor)</td>
                                    <td class="right opc-preco"><strong>@DinheiroVenda(PrecoDoOpcional(unitario * item.Quantos))</strong></td>
                                    <td class="right">
                                        <button class="btn-link opc-remover" @onclick="() => RemoverOpcional(item, linha)">Remover</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
</div>

    }
    @if (_abaItem == "tecnica")
    {
    @* a aba Técnica numa tela (item 08): à esquerda a tabela do documento, com
       a seleção conferida por exceção, a parte elétrica e o alcance; à direita
       os arquivos — a seleção, a área de soltar e as curvas em miniatura *@
    @if (_proposta.Itens.Count == 0)
    {
<div class="panel" style="margin-bottom:14px">
    <div class="panel empty" style="padding:16px">
        Escolha os equipamentos no escopo — é deles que sai a proposta técnica.
    </div>
</div>
    }
    else
    {
        var indice = PosicaoValida;
        var item = _proposta.Itens[indice];
        var modelo = ModeloDe(item);
        var linhasDoVentilador = DadosDoVentilador.De(item, modelo, MotorDe(item), TextosDaProposta.Do(Idioma), CodigoDe(item));
        var abertas = LinhasAbertasDaSelecao(item, indice);
        var editando = _editandoSelecao.Contains(item);
        var comArquivo = item.ArquivoDaSelecao.Trim().Length > 0;
        var lidos = LidosDaSelecao(item);
        var faltouFora = FaltouForaDaTabela(indice);
        var eletrica = DadosEletricos.De(item, _custo, _proposta.Moeda, EletricaTextos);
        var soOMetodo = SoOMetodoDePartida(item);
        // a partida direta é o caso comum (o "Com" do partidor já começa nela):
        // a nota só informa e o bloco fica recolhido. Abre sozinho só o partidor
        // que não casa com quadro nenhum, que é o que pede uma conferida
        var partidaDireta = soOMetodo.Length > 0
            && DadosEletricos.Tipo(DadosEletricos.Partidor(item, _custo, _proposta.Moeda)) == DadosEletricos.TipoDePartidor.Dol;
        var blocoDaSelecao = false;
<div class="panel tec-painel">
    <div class="tec-cabeca">
        <h2>Equipamento @(indice + 1) · @(modelo?.Rotulo ?? "sem modelo escolhido")</h2>
        @if (modelo is null)
        {
            <button class="btn-link" @onclick='() => IrAoEscopo(indice, "f-modelo")'>escolher no Escopo</button>
        }
        <span class="subtitle ajuda">o que sai na proposta técnica deste equipamento</span>
    </div>

    <div class="tec-grade">
        <div class="tec-esq">
            @* ----- DATOS DEL VENTILADOR, como sai no documento ----- *@
            <section class="tec-bloco tec-dados">
                <h3 class="tec-titulo">@TextosDaProposta.Do(Idioma).DadosDoVentilador <span class="nota">como sai no documento</span></h3>
                <table class="grid tec-tabela">
                    <tbody>
                        @foreach (var linha in linhasDoVentilador)
                        {
                            var chave = linha.Chave;

                            @* as 7 linhas da seleção, juntas no lugar da primeira: o
                               resumo e, abertas, só as que faltam (ou todas no "editar") *@
                            if (DadosDoVentilador.DaSelecao.Contains(chave))
                            {
                                if (blocoDaSelecao) { continue; }
                                blocoDaSelecao = true;

                                <tr class="tec-resumo @(comArquivo && lidos < DadosDoVentilador.DaSelecao.Length ? "incompleto" : "")">
                                    <td colspan="3">
                                        <div class="tec-resumo-topo">
                                            <strong>Seleção</strong>
                                            @if (comArquivo)
                                            {
                                                <span class="tec-resumo-arquivo" title="@item.ArquivoDaSelecao">@item.ArquivoDaSelecao</span>
                                                <span class="val-count @(lidos == DadosDoVentilador.DaSelecao.Length ? "tec-ok" : "tec-alerta")">@lidos de @DadosDoVentilador.DaSelecao.Length lidos</span>
                                            }
                                            else
                                            {
                                                <span class="nota">sem arquivo · digite abaixo ou solte o relatório em Seleção</span>
                                            }
                                            <span class="tec-espaco"></span>
                                            <button class="btn-link" aria-expanded="@(editando ? "true" : "false")"
                                                    @onclick="() => AlternarEdicaoDaSelecao(item)">@(editando ? "fechar" : "editar")</button>
                                        </div>
                                        @if (comArquivo && ResumoDaSelecao(item) is { Length: > 0 } resumo)
                                        {
                                            <div class="tec-resumo-valores">@resumo</div>
                                        }
                                        @if (SerieEPa(item) is { Length: > 0 } serieEPa)
                                        {
                                            <div class="nota">@serieEPa</div>
                                        }
                                        @if (faltouFora.Count > 0)
                                        {
                                            <div class="nota texto-alerta">O arquivo não trouxe: @string.Join(", ", faltouFora.Select(f => f.ToLowerInvariant())) — editar para digitar.</div>
                                        }
                                        @if (editando)
                                        {
                                            var pressaoTipo = item.Tecnicos.GetValueOrDefault("pressaoTipo", new DadoTecnico("", "")).Valor;
                                            <div class="tec-extra">
                                                <label>Série / modelo
                                                    <input class="cell" value="@item.Tecnicos.GetValueOrDefault("serie", new DadoTecnico("", "")).Valor"
                                                           @onchange='e => MudarTecnico(item, "serie", e.Value?.ToString() ?? string.Empty, "")' />
                                                </label>
                                                <label>Tipo de pá
                                                    <input class="cell" value="@item.Tecnicos.GetValueOrDefault("pa", new DadoTecnico("", "")).Valor"
                                                           @onchange='e => MudarTecnico(item, "pa", e.Value?.ToString() ?? string.Empty, "")' />
                                                </label>
                                                <label>Pressão
                                                    <select class="cell" value="@pressaoTipo"
                                                            @onchange='e => MudarTecnico(item, "pressaoTipo", e.Value?.ToString() ?? string.Empty, "")'>
                                                        <option value="">não diz</option>
                                                        <option value="@SelecaoTecnica.Total">total</option>
                                                        <option value="@SelecaoTecnica.Estatica">estática</option>
                                                        @if (pressaoTipo.Length > 0 && pressaoTipo != SelecaoTecnica.Total && pressaoTipo != SelecaoTecnica.Estatica)
                                                        {
                                                            <option value="@pressaoTipo">@pressaoTipo</option>
                                                        }
                                                    </select>
                                                </label>
                                            </div>
                                        }
                                    </td>
                                </tr>

                                @foreach (var sel in linhasDoVentilador.Where(l => DadosDoVentilador.DaSelecao.Contains(l.Chave) && abertas.Contains(l.Chave)))
                                {
                                    var chaveSel = sel.Chave;
                                    var dado = item.Tecnicos.GetValueOrDefault(chaveSel, new DadoTecnico("", ""));
                                    var falta = dado.Valor.Trim().Length == 0;
                                    <tr class="tec-aberta @(falta ? "tec-falta" : "")">
                                        <td class="tec-rotulo">@sel.Rotulo</td>
                                        <td colspan="2">
                                            <div class="tec-par">
                                                <input class="cell" value="@dado.Valor" aria-label="@sel.Rotulo"
                                                       placeholder="@(falta ? (comArquivo ? "não veio no arquivo" : "digitar") : "")"
                                                       @onchange="e => MudarDadoDaSelecao(item, chaveSel, e.Value?.ToString() ?? string.Empty, dado.Unidade)" />
                                                <input class="cell tec-unid" value="@dado.Unidade" aria-label="Unidade de @sel.Rotulo"
                                                       placeholder="@(UnidadePadrao(chaveSel) is { Length: > 0 } u ? u : "unid.")"
                                                       @onchange="e => MudarTecnico(item, chaveSel, dado.Valor, e.Value?.ToString() ?? string.Empty)" />
                                            </div>
                                        </td>
                                    </tr>
                                }
                                continue;
                            }

                            @* diâmetro, altitude e ruído: digitados aqui (item 09) *@
                            if (chave == "diametro")
                            {
                                <tr class="tec-aberta @(item.DiametroMm.Trim().Length == 0 ? "tec-falta" : "")">
                                    <td class="tec-rotulo"><label for="f-diametro">@linha.Rotulo</label></td>
                                    <td colspan="2">
                                        <div class="tec-campo">
                                            <input id="f-diametro" class="cell num" inputmode="decimal" value="@item.DiametroMm"
                                                   @onchange="e => MudarDiametro(item, e.Value?.ToString() ?? string.Empty)" />
                                            <span class="tec-unidade">mm</span>
                                            @if (_diametroLembrado.TryGetValue(item, out var deOndeDiametro))
                                            {
                                                <span class="nota tec-lembrado">@deOndeDiametro</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                continue;
                            }
                            if (chave == "altitude")
                            {
                                var outrosComOutra = _altitudeEditada == item ? OutrosComOutraAltitude(item) : new List<int>();
                                <tr class="tec-aberta @(item.AltitudeMsnm.Trim().Length == 0 ? "tec-falta" : "")">
                                    <td class="tec-rotulo"><label for="f-altitude">@linha.Rotulo</label></td>
                                    <td colspan="2">
                                        <div class="tec-campo">
                                            <input id="f-altitude" class="cell num" inputmode="decimal" value="@item.AltitudeMsnm"
                                                   @onchange="e => MudarAltitude(item, e.Value?.ToString() ?? string.Empty)" />
                                            <span class="tec-unidade">m.s.n.m.</span>
                                            @if (_altitudeLembrada.TryGetValue(item, out var deOndeAltitude))
                                            {
                                                <span class="nota tec-lembrado">@deOndeAltitude</span>
                                            }
                                            @if (outrosComOutra.Count > 0)
                                            {
                                                <button class="btn-link" @onclick="() => AplicarAltitudeAosOutros(item, indice)">
                                                    @(outrosComOutra.Count == 1 ? $"aplicar também ao equip. {outrosComOutra[0] + 1}" : $"aplicar aos outros {outrosComOutra.Count}")
                                                </button>
                                            }
                                        </div>
                                        @if (item.AltitudeMsnm.Trim().Length == 0 && AltitudeDoCliente() is { } doCliente)
                                        {
                                            <div class="nota">
                                                altitude da @doCliente.Numero: @doCliente.Valor ·
                                                <button class="btn-link" @onclick="() => UsarAltitudeDoCliente(item, doCliente.Valor, doCliente.Numero)">usar</button>
                                            </div>
                                        }
                                        @if (AltitudeAlta(item) && eletrica.Count > 0)
                                        {
                                            <div class="nota texto-alerta">acima dos 2.000 m dos dados elétricos — confira o motor com a engenharia</div>
                                        }
                                    </td>
                                </tr>
                                continue;
                            }
                            if (chave == "ruido")
                            {
                                <tr class="tec-aberta @(item.RuidoDb.Trim().Length == 0 ? "tec-falta" : "")">
                                    <td class="tec-rotulo"><label for="f-ruido">@linha.Rotulo</label></td>
                                    <td colspan="2">
                                        <div class="tec-campo">
                                            <input id="f-ruido" class="cell num" inputmode="decimal" value="@item.RuidoDb"
                                                   @onchange="e => MudarRuido(item, e.Value?.ToString() ?? string.Empty)" />
                                            <span class="tec-unidade">dB(A) a 1 m</span>
                                        </div>
                                    </td>
                                </tr>
                                continue;
                            }

                            @* o resto vem do escopo (ou é fixo do modelo): só leitura, com a origem *@
                            var irPara = chave switch
                            {
                                "modelo" => "f-modelo",
                                "aplicacao" => "f-aplicacao",
                                "montagem" => "f-montagem",
                                "motor" when item.ComMotor => "f-motor",
                                _ => "",
                            };
                            <tr>
                                <td class="tec-rotulo">@linha.Rotulo</td>
                                <td class="tec-valor">
                                    @if (!linha.Falta)
                                    {
                                        <strong>@linha.Valor</strong>
                                    }
                                    else if (irPara.Length > 0)
                                    {
                                        <button class="btn-link" title="Em branco no documento" @onclick="() => IrAoEscopo(indice, irPara)">preencher no Escopo</button>
                                    }
                                    else if (chave == "motor")
                                    {
                                        <span class="subtitle">sem motor no escopo</span>
                                    }
                                    else
                                    {
                                        <span class="subtitle">em branco</span>
                                    }
                                </td>
                                <td class="tec-origem">
                                    @if (linha.Origem.Length > 0)
                                    {
                                        <span class="val-count">@linha.Origem</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (AvisoDePotencia(item) is { } potenciaAcima)
                {
                    <div class="aviso aviso-alerta tec-aviso">
                        <Icone Nome="alerta" />
                        <span>@potenciaAcima</span>
                        <button class="btn-link" @onclick='() => IrAoEscopo(indice, "f-motor")'>ver o motor</button>
                    </div>
                }
            </section>

            @* ----- parte elétrica: texto fixo do modelo, recolhido ----- *@
            <details class="tec-bloco tec-recolhido tec-eletrica" open="@(soOMetodo.Length > 0 && !partidaDireta)">
                <summary>
                    <strong>@EletricaTextos.Secao.ToUpperInvariant()</strong>
                    <span class="nota">@(eletrica.Count > 0 ? ResumoEletrico(eletrica) : "não sai neste equipamento")@(partidaDireta ? " · partida direta, sem quadro próprio" : "")</span>
                </summary>
                <div class="tec-recolhido-corpo">
                    <p class="nota ajuda" style="margin:0 0 8px">sai depois da curva, em página própria</p>
                    @if (eletrica.Count > 0)
                    {
                        @foreach (var quadro in eletrica)
                        {
                            <table class="grid tec-quadro">
                                <thead><tr><th>@quadro.Titulo</th></tr></thead>
                                <tbody>
                                    @foreach (var linhaEletrica in quadro.Linhas)
                                    {
                                        <tr><td>@linhaEletrica</td></tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                    else
                    {
                        <p class="subtitle" style="margin:0">@SemParteEletrica(item)</p>
                    }

                    @if (soOMetodo.Length > 0)
                    {
                        <p class="nota @(partidaDireta ? "" : "texto-alerta")" style="margin:8px 0 0">@soOMetodo</p>
                    }
                </div>
            </details>

            @* ----- alcance de fornecimento ----- *@
            @{
                var rascunhoEscopo = EscopoDaHowden.Rascunho(item, _custo, _proposta.Moeda, EscopoTextos);
                var escopoDoItem = item.EscopoIncluso.Trim().Length > 0 ? item.EscopoIncluso : rascunhoEscopo;
                var excluidas = item.EscopoExcluido.Split('\n', StringSplitOptions.RemoveEmptyEntries).Length;
            }
            <section class="tec-bloco tec-alcance">
                <div class="tec-titulo-linha">
                    <h3 class="tec-titulo">@EscopoTextos.Incluso</h3>
                    <span class="nota ajuda">uma linha por item — é o que sai na lista</span>
                    <span class="tec-espaco"></span>
                    @if (item.EscopoIncluso.Trim().Length > 0)
                    {
                        <button class="btn-link" title="Voltar ao rascunho do sistema"
                                @onclick="() => VoltarEscopo(indice)"><Icone Nome="desfazer" Classe="ico-p" /> voltar ao rascunho</button>
                    }
                </div>

                <textarea class="cell tec-texto" rows="@(escopoDoItem.Split('\n').Length + 1)"
                          aria-label="@EscopoTextos.Incluso"
                          value="@escopoDoItem"
                          @onchange="e => MudarEscopoIncluso(indice, e.Value?.ToString() ?? string.Empty)"></textarea>

                <div class="tec-juntar">
                    @if (ForaDoCatalogo(item) is { Count: > 0 } faltamNoEscopo)
                    {
                        <select class="cell" @key="_juntarAoAlcance" aria-label="Juntar uma peça do catálogo ao alcance"
                                @onchange="e => JuntarPeloSeletor(indice, e.Value?.ToString() ?? string.Empty)">
                            <option value="">+ juntar ao alcance…</option>
                            @foreach (var peca in faltamNoEscopo)
                            {
                                <option value="@peca">@EscopoTextos.Catalogo[peca]</option>
                            }
                        </select>
                    }
                    @foreach (var juntada in item.EscopoExtra.ToList())
                    {
                        var daLista = juntada;
                        var nomeDaPeca = EscopoTextos.Catalogo.GetValueOrDefault(daLista, daLista);
                        <span class="tec-juntada">
                            @nomeDaPeca
                            <button class="btn-link btn-icone" title="Tirar do alcance" aria-label="Tirar do alcance: @nomeDaPeca"
                                    @onclick="() => TirarDoEscopo(indice, daLista)"><Icone Nome="fechar" Classe="ico-p" /></button>
                        </span>
                    }
                </div>

                <details class="tec-recolhido tec-excluido" open="@(excluidas > 0)">
                    <summary>
                        <strong>@EscopoTextos.Excluido</strong>
                        <span class="nota">@(excluidas > 0 ? Plural(excluidas, "linha", "linhas") : "em branco, a seção não sai")</span>
                    </summary>
                    <div class="tec-recolhido-corpo">
                        <textarea class="cell tec-texto" rows="3" placeholder="o que o cliente pediu e não vai — uma linha por item"
                                  aria-label="@EscopoTextos.Excluido"
                                  value="@item.EscopoExcluido"
                                  @onchange="e => MudarEscopoExcluido(indice, e.Value?.ToString() ?? string.Empty)"></textarea>
                    </div>
                </details>

                <p class="nota ajuda" style="margin:8px 0 0">
                    A documentação, os comentários e as normas são iguais em toda proposta e saem
                    sozinhos; o texto do ventilador sai pela série do equipamento
                    (@(SerieDoItem(item) is { Length: > 0 } serie ? serie : "sem modelo escolhido")).
                </p>
            </section>
        </div>

        <div class="tec-dir">
            @* ----- seleção: o arquivo e a área de soltar (item 19, parte 3) ----- *@
            <section id="f-selecao" class="tec-bloco tec-arquivos">
                <h3 class="tec-titulo">Seleção</h3>
                @if (comArquivo)
                {
                    <div class="tec-arquivo">
                        <Icone Nome="lista" />
                        <span class="tec-arquivo-nome" title="@item.ArquivoDaSelecao">@item.ArquivoDaSelecao</span>
                        <button class="btn-link" @onclick="() => TirarSelecao(indice)">Remover</button>
                    </div>
                }
                else
                {
                    <p class="tec-vazio texto-alerta"><Icone Nome="alerta" /> Nenhuma seleção neste equipamento.</p>
                }

                @* tudo o que cair aqui vai para o equipamento aberto: nenhum
                   nasce, o aberto não muda e a folha de dados é recusada *@
                <label class="dropzone baixa">
                    <Icone Nome="subir" />
                    <span class="tec-solte">
                        <strong>@(_lendo ? "Lendo os arquivos…" : "Solte aqui a seleção e as curvas")</strong>
                        <span>ou clique · .txt .docx .pdf .png · vão para o equip. @(indice + 1)</span>
                    </span>
                    <InputFile OnChange="@(e => SoltarNaTecnica(e, indice))" multiple accept=".txt,.docx,.pdf,.png,.jpg,.jpeg" />
                </label>
                @if (_ignoradosNaTecnica is { } ignorados && ReferenceEquals(ignorados.Item, item))
                {
                    <div class="tec-ignorados" role="status">
                        <div class="tec-ignorados-topo">
                            <strong>@Plural(ignorados.Arquivos.Count, "arquivo ficou de fora", "arquivos ficaram de fora")</strong>
                            <span class="tec-espaco"></span>
                            <button class="btn-link btn-icone" title="Fechar" aria-label="Fechar a lista dos arquivos de fora"
                                    @onclick="() => _ignoradosNaTecnica = null"><Icone Nome="fechar" Classe="ico-p" /></button>
                        </div>
                        @foreach (var (arquivo, motivo) in ignorados.Arquivos)
                        {
                            <div class="tec-ignorado"><span class="tec-arquivo-nome" title="@arquivo">@arquivo</span> <span class="nota">@motivo</span></div>
                        }
                    </div>
                }
            </section>

            @* ----- curvas em miniatura: o clique abre a imagem inteira num
               <dialog> da própria página (no WebView2 uma aba nova seria uma
               janela solta, sem menu) ----- *@
            <section id="f-curva" class="tec-bloco tec-curvas">
                <h3 class="tec-titulo">
                    Curvas de performance
                    @if (item.Curvas.Count > 0)
                    {
                        <span class="val-count">@item.Curvas.Count</span>
                    }
                </h3>
                @if (item.Curvas.Count == 0)
                {
                    <p class="tec-vazio texto-alerta"><Icone Nome="alerta" /> Falta a curva: solte o PDF ou a imagem na área acima.</p>
                }
                else
                {
                    @for (var c = 0; c < item.Curvas.Count; c++)
                    {
                        var posicao = c;
                        var curva = item.Curvas[posicao];
                        var endereco = $"/axiais/anexo/{_proposta.Id}/{curva.Imagem}";
                        <figure class="curva-mini">
                            <button type="button" class="curva-mini-img" data-curva-inteira="@endereco" data-nome="@curva.Nome"
                                    title="Ver a curva inteira" aria-label="Ver a curva @(posicao + 1) inteira">
                                <img src="@endereco" alt="Curva @(posicao + 1) do item @(indice + 1)" loading="lazy" />
                            </button>
                            <figcaption>
                                <span class="curva-mini-nome" title="@curva.Nome">@curva.Nome</span>
                                <span class="nota">@TamanhoDaCurva(curva)</span>
                                <span class="tec-espaco"></span>
                                <button class="btn-link" @onclick="() => TirarCurva(indice, posicao)">Remover</button>
                            </figcaption>
                        </figure>
                    }
                    <p class="nota ajuda" style="margin:0">
                        @(item.Curvas.Count == 1 ? "é esta imagem que vai para a proposta técnica" : "são estas imagens que vão para a proposta técnica")
                    </p>
                }
            </section>
        </div>
    </div>

    <dialog id="dialogo-curva" class="curva-dialogo" aria-label="Curva de performance">
        <div class="curva-dialogo-corpo">
            <div class="curva-dialogo-topo">
                <strong class="curva-dialogo-nome"></strong>
                <span class="tec-espaco"></span>
                <span class="nota">Esc fecha</span>
                <button type="button" class="btn-link btn-icone" data-fechar-dialogo="1" title="Fechar" aria-label="Fechar">
                    <Icone Nome="fechar" />
                </button>
            </div>
            <img alt="" />
        </div>
    </dialog>
</div>
    }
    }
</div>
}
@if (_etapa == 4)
{
    @* item 10: as entradas numa faixa no alto, uma linha por equipamento com as
       linhas de custo recolhidas e a memória de cálculo recolhida. A conta é a
       mesma (Pricing, CalculoPricing): só muda o que a tela mostra e onde *@
    var pricing = pricingAtual;
    var foraRisco = Math.Abs(Risco - CalculoPricing.RiscoAdicionalPadrao) > 0.00001m;
    var foraNegoc = Math.Abs(Negociacao - CalculoPricing.MargemNegociacaoPadrao) > 0.00001m;
    // sem custo a conta dá margem zero: não é a margem pedida que está fora,
    // é o custo que falta (o painel faz o mesmo)
    var foraMargem = Total > 0m && MargemForaDoPadrao(pricing);
    var converte = Cambio.Converte(_proposta);
    var moedaCusto = _proposta.Moeda;
    var moedaVenda = _proposta.MoedaVenda;
    var oferta = OfertaDaTaxa();

<div class="panel preco-entradas">
    <div class="preco-cabeca">
        <h2>Pricing</h2>
        <span class="subtitle ajuda">margem, comissões e impostos — a mesma conta da aba PRICING da planilha</span>
        @* à direita também quando a ajuda empurra o par para a linha de baixo *@
        <span class="preco-modo">
            <span class="preco-rotulo">Calcular preço</span>
            <span class="seg" role="group" aria-label="Calcular preço">
                <button class="@(PelaMargem ? "on" : "")" aria-pressed="@(PelaMargem ? "true" : "false")"
                        @onclick="@(() => _proposta.ModoDoPreco = "margem")">pela margem</button>
                <button class="@(PelaMargem ? "" : "on")" aria-pressed="@(PelaMargem ? "false" : "true")"
                        @onclick="@(() => _proposta.ModoDoPreco = "preco")">pelo preço</button>
            </span>
        </span>
    </div>

    @* cada entrada com o selo dela: o "fora do padrão" fica junto do campo que pede a aprovação *@
    <div class="preco-faixa">
        @if (PelaMargem)
        {
            <div class="preco-campo">
                <label class="preco-rotulo" for="f-margem" title="célula D54 do pricing">Margem pedida</label>
                <span class="preco-entrada">
                    <input id="f-margem" class="cell num" value="@_proposta.MargemAlvo"
                           @onchange="e => _proposta.MargemAlvo = e.Value?.ToString() ?? string.Empty" />
                    <span class="preco-unid">%</span>
                </span>
                @SeloDoPadrao(foraMargem, Pct(CalculoPricing.MargemAlvoPadrao))
            </div>
        }
        else
        {
            <div class="preco-campo preco-campo-meta">
                <label class="preco-rotulo" for="f-preco-meta">Preço-meta <span class="nota">em @moedaCusto.Rotulo()</span></label>
                <span class="preco-entrada">
                    <input id="f-preco-meta" class="cell num" placeholder="quanto o cliente aceita"
                           value="@_proposta.PrecoMeta"
                           @onchange="e => _proposta.PrecoMeta = e.Value?.ToString() ?? string.Empty" />
                </span>
                <span class="preco-resultado">margem <strong class="@(foraMargem ? "texto-vermelho" : "")">@Pct(pricing.Margem)</strong></span>
                @SeloDoPadrao(foraMargem, Pct(CalculoPricing.MargemAlvoPadrao))
            </div>
        }
        <div class="preco-campo">
            <label class="preco-rotulo" for="f-risco" title="célula D36 do pricing">Risco adicional</label>
            <span class="preco-entrada">
                <input id="f-risco" class="cell num" value="@_proposta.RiscoAdicional"
                       @onchange="e => _proposta.RiscoAdicional = e.Value?.ToString() ?? string.Empty" />
                <span class="preco-unid">%</span>
            </span>
            @SeloDoPadrao(foraRisco, Pct(CalculoPricing.RiscoAdicionalPadrao))
        </div>
        <div class="preco-campo">
            <label class="preco-rotulo" for="f-negociacao" title="célula D46 do pricing">Margem de negociação</label>
            <span class="preco-entrada">
                <input id="f-negociacao" class="cell num" value="@_proposta.MargemNegociacao"
                       @onchange="e => _proposta.MargemNegociacao = e.Value?.ToString() ?? string.Empty" />
                <span class="preco-unid">%</span>
            </span>
            @SeloDoPadrao(foraNegoc, Pct(CalculoPricing.MargemNegociacaoPadrao))
        </div>
    </div>

    @* a moeda do preço e a taxa: antes uma caixa laranja de alerta; converter é o
       caso normal da exportação, e a caixa agora é neutra. Na mesma moeda, a
       taxa nem aparece *@
    <div class="aviso aviso-info preco-cambio">
        <div class="toolbar preco-cambio-linha">
            <strong>Preço ao cliente em</strong>
            <div id="f-moeda-venda" class="seg" role="group" aria-label="Moeda do preço ao cliente">
                @foreach (var m in Moedas.DePreco)
                {
                    var moeda = m;
                    <button class="@(moedaVenda == moeda ? "on" : "")" aria-pressed="@(moedaVenda == moeda ? "true" : "false")"
                            @onclick="() => EscolherMoedaVenda(moeda)">@moeda.Rotulo()</button>
                }
            </div>
            @if (converte)
            {
                <span class="preco-par">
                    <label class="preco-rotulo" for="f-taxa">Taxa</label>
                    <select class="cell preco-sentido" value="@_proposta.CambioDirecao" aria-label="Sentido da taxa"
                            @onchange='e => _proposta.CambioDirecao = e.Value?.ToString() ?? "VendaEmCusto"'>
                        <option value="VendaEmCusto">1 @moedaVenda.Rotulo() em @moedaCusto.Rotulo()</option>
                        <option value="CustoEmVenda">1 @moedaCusto.Rotulo() em @moedaVenda.Rotulo()</option>
                    </select>
                    <span>=</span>
                    <input id="f-taxa" class="cell num preco-taxa" placeholder="0,00" value="@_proposta.TaxaCambio"
                           @onchange="e => MudarTaxa(e.Value?.ToString() ?? string.Empty)" />
                </span>
                <span class="preco-par">
                    <label class="preco-rotulo" for="f-seguranca" title="tirada da taxa: se a moeda cair até este tanto, o valor no custo não perde">Segurança</label>
                    <input id="f-seguranca" class="cell num preco-seguranca" placeholder="0" value="@_proposta.SegurancaCambioPct"
                           @onchange="e => _proposta.SegurancaCambioPct = e.Value?.ToString() ?? string.Empty" />
                    <span class="preco-unid">%</span>
                </span>
            }
            else
            {
                <span class="nota">custo e preço em @moedaCusto.Rotulo(): sem conversão</span>
            }
        </div>

        @if (converte)
        {
            @if (_taxaDoDia)
            {
                @* é a última taxa gravada na aba Conversão, não a do dia: a data diz de quando *@
                <span class="@(TaxaVelha ? "taxa-origem velha" : "taxa-origem")">
                    taxa da aba Conversão@(TaxaAtualizadaEm is { } atualizada ? $", atualizada em {atualizada:dd/MM/yyyy}" : "")@(TaxaVelha ? " — confira se ainda vale" : "")
                </span>
            }
            @if (Cambio.Normalizada(_proposta) > 0m)
            {
                var taxaBase = Cambio.Normalizada(_proposta);
                <div class="preco-confira">
                    Confira: <strong>1 @moedaVenda.Rotulo() = @moedaCusto.Rotulo() @taxaBase.ToString("N4", Br)</strong>
                    · 1 @moedaCusto.Rotulo() = @moedaVenda.Rotulo() @((1m / taxaBase).ToString("N6", Br))
                </div>
                @if (Cambio.Seguranca(_proposta) > 0m)
                {
                    <div class="nota ajuda">
                        convertendo por @moedaCusto.Rotulo() @Cambio.Efetivo(_proposta).ToString("N4", Br) por @moedaVenda.Rotulo() —
                        se a moeda cair até @Cambio.Seguranca(_proposta).ToString("0.##", Br)%, o valor em @moedaCusto.Rotulo() não perde
                    </div>
                }
            }
            else
            {
                <div class="preco-falta-taxa">
                    <Icone Nome="alerta" /> Informe a taxa de conversão — sem ela o preço sai como se já estivesse em @moedaVenda.Rotulo().
                </div>
            }
            @if (oferta is not null)
            {
                @* a cópia e a revisão continuam com a taxa da original: a da aba
                   Conversão é oferecida, e só entra com o clique *@
                <div class="preco-oferta">
                    <span>@oferta.Texto</span>
                    <button class="btn-link" @onclick="UsarTaxaDaConversao">usar esta</button>
                </div>
            }
        }
    </div>

    @foreach (var aviso in pricing.Avisos)
    {
        <div class="aviso aviso-alerta" style="margin-top:8px">@aviso</div>
    }
</div>

<div class="panel preco-custos">
    <div class="preco-cabeca">
        <h2>Custo por equipamento</h2>
        <span class="subtitle ajuda">em @moedaCusto.Rotulo() · o custo vem do cadastro; digite por cima para corrigir</span>
    </div>

    @foreach (var (item, indice) in _proposta.Itens.Select((x, i) => (x, i)))
    {
        var doItem = item;
        var doIndice = indice;
        var modelo = ModeloDe(doItem);
        var semCusto = SemCustoNaTabela(doItem);
        var aberta = VerLinhas(doItem, semCusto.Count);
        var codigo = CodigoDe(doItem);

        <div class="preco-equip @(aberta ? "aberta" : "")">
            <div class="preco-equip-linha">
                <span class="preco-equip-nome" title="@($"{(modelo?.Rotulo ?? "sem modelo")} · {codigo}")">
                    <strong>Equip. @(indice + 1)</strong>
                    <span class="preco-sep"> · </span>
                    @if (modelo is null)
                    {
                        <button class="btn-link texto-alerta preco-falta" @onclick="() => EscolherModeloDoPreco(doIndice)">modelo não escolhido</button>
                    }
                    else
                    {
                        <span>@modelo.Rotulo</span>
                    }
                    @if (codigo.Length > 0)
                    {
                        <span class="preco-sep"> · </span>
                        <span class="mono preco-codigo">@codigo</span>
                    }
                </span>
                @if (semCusto.Count > 0)
                {
                    <button class="btn-link texto-alerta preco-falta" @onclick="() => IrAoCustoQueFalta(doIndice, semCusto)">
                        @Plural(semCusto.Count, "linha sem custo", "linhas sem custo")
                    </button>
                }
                <span class="preco-conta">@ContaDoEquipamento(doItem)</span>
                <button class="btn-link preco-ver" aria-expanded="@(aberta ? "true" : "false")"
                        @onclick="() => AlternarLinhas(doItem, semCusto.Count)">
                    <Icone Nome="seta" Classe="preco-seta" /> @(aberta ? "fechar linhas" : "ver linhas")
                </button>
            </div>

            @if (aberta)
            {
                @* largura fixa por coluna: o custo fica sempre à vista, sem rolagem
                   lateral, a 1366 e a 1440 com o menu do app aberto ou recolhido *@
                <table class="grid tabela-custo">
                    <colgroup>
                        <col class="col-item" />
                        <col />
                        <col class="col-codigo" />
                        <col class="col-custo" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Escolha</th>
                            <th>Código</th>
                            <th class="right">Unitário @moedaCusto.Rotulo()</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (modelo is not null)
                        {
                            <tr>
                                <td><strong>Equipamento</strong></td>
                                <td>
                                    @modelo.Rotulo
                                    <span class="nota preco-origem" title="lista cruzada de equipamentos">@OrigemDoCusto(doItem, "equipamento", "lista cruzada de equipamentos")</span>
                                </td>
                                <td>@(modelo.Codigo.Length > 0 ? modelo.Codigo : "—")</td>
                                <td class="col-custo">@Preco(doItem, "equipamento", PrecoDoModelo(doItem))</td>
                            </tr>
                        }
                        @foreach (var linha in Itens(doItem))
                        {
                            var chave = $"lista:{linha.Lista}";
                            <tr>
                                <td>@Exibir(linha.Lista)</td>
                                <td>
                                    @linha.Opcao
                                    <span class="nota preco-origem" title="@linha.Origem">@OrigemDoCusto(doItem, chave, linha.Origem)</span>
                                </td>
                                <td>@(linha.Codigo.Length > 0 ? linha.Codigo : "—")</td>
                                <td class="col-custo">@Preco(doItem, chave, linha.Valor)</td>
                            </tr>
                        }
                        @if (doItem.ComMotor)
                        {
                            var motor = MotorDe(doItem);
                            var origemDoMotor = motor is null
                                ? "aperte o filtro até sobrar um motor"
                                : motor.Observacoes.Length > 0 ? motor.Observacoes : "catálogo de motores";
                            <tr>
                                <td><strong>Motor elétrico</strong></td>
                                <td>
                                    @(motor is null ? "motor ainda não definido" : motor.Descricao)
                                    <span class="nota preco-origem" title="@origemDoMotor">@OrigemDoCusto(doItem, "motor", origemDoMotor)</span>
                                </td>
                                <td>@(motor is null || motor.Codigo.Length == 0 ? "—" : motor.Codigo)</td>
                                <td class="col-custo">@Preco(doItem, "motor", PrecoDoMotor(doItem))</td>
                            </tr>
                        }
                        @if (doItem.ComPartidor && LinhaDoPartidor(doItem) is { } partidor)
                        {
                            <tr>
                                <td>@Exibir(ListaDosPartidores)</td>
                                <td>
                                    @(doItem.Partidor.Length > 0 ? doItem.Partidor : "não escolhido")
                                    <span class="nota preco-origem" title="@partidor.Origem">@OrigemDoCusto(doItem, "partidor", partidor.Origem)</span>
                                </td>
                                <td>@(partidor.Codigo.Length > 0 ? partidor.Codigo : "—")</td>
                                <td class="col-custo">@Preco(doItem, "partidor", partidor.Valor)</td>
                            </tr>
                        }
                        @foreach (var nome in doItem.ComInstrumentacao ? doItem.Instrumentacao : new List<string>())
                        {
                            var linha = Resolver(doItem, ListaDaInstrumentacao, nome);
                            var chave = $"instr:{nome}";
                            <tr>
                                <td>@Exibir(ListaDaInstrumentacao)</td>
                                <td>
                                    @nome
                                    <span class="nota preco-origem" title="@linha.Origem">@OrigemDoCusto(doItem, chave, linha.Origem)</span>
                                </td>
                                <td>@(linha.Codigo.Length > 0 ? linha.Codigo : "—")</td>
                                <td class="col-custo">@Preco(doItem, chave, linha.Valor)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="right">
                                @(doItem.Quantos > 1 ? $"Subtotal ({doItem.Quantos} × unitário)" : "Subtotal")
                            </td>
                            <td class="right"><strong>@Dinheiro(SubtotalDe(doItem))</strong></td>
                        </tr>
                    </tfoot>
                </table>
            }
        </div>
    }

    <div class="preco-total">
        @{
            var faltaCusto = _proposta.Itens.Any(i => SemCustoNaTabela(i).Count > 0);
        }
        <span class="nota">
            @if (faltaCusto)
            {
                <span>conta só as linhas que têm custo</span>
            }
            <span class="ajuda">@(faltaCusto ? " · " : "")vai para a célula E33 do pricing</span>
        </span>
        <strong>Custo total</strong>
        <span class="preco-total-valor">@Dinheiro(Total)</span>
    </div>
</div>

    var memoriaAberta = MemoriaAberta(pricing);
<div class="panel preco-memoria-painel">
    @* a memória fica fechada: quem confere célula a célula abre; abre sozinha
       quando a proposta pede aprovação ou falta a taxa *@
    <details class="preco-memoria" open="@memoriaAberta">
        <summary @onclick="() => AlternarMemoria(pricing)" @onclick:preventDefault="true">
            <span class="preco-memoria-titulo">Memória de cálculo — célula a célula</span>
            <span class="nota">
                venda líquida @Dinheiro(pricing.VendaLiquida) · margem @Pct(pricing.Margem)@(converte ? $" · ao cliente {DinheiroVenda(Cambio.ParaVenda(_proposta, pricing.PrecoComImpostos))}" : "")
            </span>
        </summary>

        <table class="grid tabela-memoria">
            <colgroup>
                <col />
                <col class="col-celula" />
                <col class="col-valor" />
                <col class="col-pct" />
            </colgroup>
            <thead>
                <tr>
                    <th>Linha do pricing</th>
                    <th>Célula</th>
                    <th class="right">Valor</th>
                    <th class="right">%</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Custo total</strong></td>
                    <td><span class="subtitle">E33</span></td>
                    <td class="right">@Dinheiro(pricing.CustoTotal)</td>
                    <td class="right">—</td>
                </tr>
                <tr>
                    <td>Risco adicional</td>
                    <td><span class="subtitle">D36 · E36</span></td>
                    <td class="right">@Dinheiro(pricing.Risco)</td>
                    <td class="right">@Pct(Risco)</td>
                </tr>
                <tr>
                    <td><strong>Custo com riscos</strong></td>
                    <td><span class="subtitle">E38</span></td>
                    <td class="right">@Dinheiro(pricing.CustoComRiscos)</td>
                    <td class="right">—</td>
                </tr>
                <tr>
                    <td>Markup</td>
                    <td><span class="subtitle">E40</span></td>
                    <td class="right">@pricing.Markup.ToString("N4", Br)</td>
                    <td class="right">—</td>
                </tr>
                <tr>
                    <td>Venda pura</td>
                    <td><span class="subtitle">E41</span></td>
                    <td class="right">@Dinheiro(pricing.VendaPura)</td>
                    <td class="right">—</td>
                </tr>
                <tr>
                    <td>Comissões</td>
                    <td><span class="subtitle">D45</span></td>
                    <td class="right">@Dinheiro(pricing.VendaLiquida * pricing.Comissoes)</td>
                    <td class="right">@Pct(pricing.Comissoes)</td>
                </tr>
                <tr>
                    <td>Negociação, PM/SACH, garantia e portal</td>
                    <td><span class="subtitle">D46 · D47 · D48 · D49</span></td>
                    <td class="right">@Dinheiro(pricing.VendaLiquida * (pricing.PercentuaisDeVenda - pricing.Comissoes))</td>
                    <td class="right">@Pct(pricing.PercentuaisDeVenda - pricing.Comissoes)</td>
                </tr>
                <tr>
                    <td><strong>Venda líquida (sem impostos)</strong></td>
                    <td><span class="subtitle">E51</span></td>
                    <td class="right"><strong>@Dinheiro(pricing.VendaLiquida)</strong></td>
                    <td class="right">—</td>
                </tr>
                <tr>
                    <td>Margem do projeto</td>
                    <td><span class="subtitle">D54</span></td>
                    <td class="right">@Dinheiro(pricing.VendaLiquida * pricing.Margem)</td>
                    <td class="right"><strong class="@(foraMargem ? "texto-vermelho" : "")">@Pct(pricing.Margem)</strong></td>
                </tr>
                @if (pricing.PrecoComImpostos != pricing.VendaLiquida)
                {
                    <tr>
                        <td>PIS</td>
                        <td><span class="subtitle">E60</span></td>
                        <td class="right">@Dinheiro(pricing.ValorPis)</td>
                        <td class="right">@Pct(CalculoPricing.Pis)</td>
                    </tr>
                    <tr>
                        <td>COFINS</td>
                        <td><span class="subtitle">E61</span></td>
                        <td class="right">@Dinheiro(pricing.ValorCofins)</td>
                        <td class="right">@Pct(CalculoPricing.Cofins)</td>
                    </tr>
                    <tr>
                        <td>ICMS</td>
                        <td><span class="subtitle">E62</span></td>
                        <td class="right">@Dinheiro(pricing.ValorIcms)</td>
                        <td class="right">
                            @Pct(CalculoPricing.IcmsDoEstado(EstadoDoPricing,
                                ListasDaProposta.CodigoDaBu(_proposta.Bu)) ?? 0m)
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td>Impostos</td>
                        <td><span class="subtitle">E60 · E61 · E62</span></td>
                        <td class="right">—</td>
                        <td class="right">—</td>
                    </tr>
                    @* a nota não cabia na coluna %: ganha a linha dela *@
                    <tr class="preco-nota-impostos">
                        <td colspan="4">
                            <span class="nota">
                                @(EhBrasil
                                    ? "destino fora do Brasil: a planilha zera ICMS, PIS e COFINS"
                                    : $"venda fora do Brasil ({_proposta.Pais}): sem ICMS, PIS nem COFINS")
                            </span>
                        </td>
                    </tr>
                }
                <tr>
                    <td><strong>@(converte ? $"Preço com impostos ({moedaCusto.Rotulo()}, antes da conversão)" : "Preço ao cliente")</strong></td>
                    <td><span class="subtitle">S76</span></td>
                    <td class="right"><strong>@Dinheiro(pricing.PrecoComImpostos)</strong></td>
                    <td class="right">—</td>
                </tr>
                @if (converte)
                {
                    <tr class="preco-convertido">
                        <td><strong>Venda líquida em @moedaVenda.Rotulo()</strong></td>
                        <td><span class="subtitle">convertida</span></td>
                        <td class="right"><strong>@DinheiroVenda(Cambio.ParaVenda(_proposta, pricing.VendaLiquida))</strong></td>
                        <td class="right">—</td>
                    </tr>
                    <tr>
                        <td><strong>Preço com impostos em @moedaVenda.Rotulo()</strong></td>
                        <td><span class="subtitle">convertido</span></td>
                        <td class="right"><strong>@DinheiroVenda(Cambio.ParaVenda(_proposta, pricing.PrecoComImpostos))</strong></td>
                        <td class="right">—</td>
                    </tr>
                }
            </tbody>
        </table>

        <p class="nota ajuda preco-memoria-nota">
            O sistema escreve todas as entradas do preço — inclusive BU (E8), segmento (J3) e estado (J6) —,
            então o pricing gerado (Gerar tudo, ou a seta dele) calcula a mesma venda líquida desta prévia;
            só as células de entrada são preenchidas (@string.Join(", ", PricingExcel.Mapa.Take(6).Select(m => m.Celula))…).
        </p>
    </details>
</div>

}
@if (_etapa == 5)
{
@* item 11: um só Gerar tudo (o mesmo do painel), as pendências numa linha — a
   lista está no painel, ao lado — e, depois de um Gerar tudo sem falha, o
   "Marcar como enviada" no caminho *@
<div class="panel docs-topo">
    <div class="docs-topo-linha">
        @GerarTudoDividido("docs")
        @if (pendencias.Count == 0)
        {
            <span class="docs-estado ok"><Icone Nome="ok" /> Nada pendente: os documentos saem completos</span>
        }
        else
        {
            <span class="docs-estado alerta">
                <Icone Nome="alerta" /> @Plural(pendencias.Count, "pendência", "pendências") — ver no painel
            </span>
        }
        <span class="docs-espaco"></span>
        @if (OferecerMarcarEnviada)
        {
            <button class="btn-ghost docs-enviada" @onclick="MarcarEnviadaDosDocumentos"
                    title="Os documentos foram gerados sem falha: registre que a proposta saiu para o cliente">
                <Icone Nome="enviar" /> Marcar como enviada
            </button>
        }
    </div>
    <p class="nota ajuda docs-topo-ajuda">
        Gerar tudo salva a proposta e baixa a comercial, a técnica e o pricing de uma vez; a seta ao lado gera um documento só.
        @if (pendencias.Count > 0)
        {
            <span>Com pendência, os documentos saem mesmo assim, com esses campos em branco.</span>
        }
    </p>
</div>
@* "Mudou desde a rev 00": compara com a revisão anterior do mesmo número; sem diferença, não desenha nada *@
<MudancasDaRevisao Atual="_proposta" Gravadas="_gravadas" />
<div class="panel docs-comercial">
    <div class="docs-cabeca">
        <h2>Proposta comercial</h2>
        <span class="nota">
            sai em <strong>@_proposta.Idioma</strong>
            <button class="btn-link docs-idioma" @onclick="TrocarIdiomaDosDocumentos">trocar</button>
            · com o preço de venda, não o custo
        </span>
    </div>

    @if (_proposta.Itens.Count == 0)
    {
        <div class="panel empty" style="padding:16px; margin-top:12px">
            Escolha ao menos um equipamento no escopo — a proposta comercial é a lista deles.
        </div>
    }
    else
    {
        <p class="nota ajuda docs-ajuda">
            Cada equipamento vira um item da tabela de preço. A lista do que ele inclui é a mesma do
            alcance da proposta técnica — mexeu lá, muda aqui. Dá para corrigir o texto na mão; a partir
            daí ele para de acompanhar a técnica, e o rascunho volta a juntar as duas.
        </p>

        @for (var i = 0; i < _proposta.Itens.Count; i++)
        {
            var indice = i;
            var item = _proposta.Itens[indice];
            var editado = item.Descricao.Trim().Length > 0;
            var editando = EditandoDescricao(indice);
            var (titulo, inclui) = DescricaoDoCartao(item);
            var precoDeVenda = PrecoDeVenda(indice);
            // linha sem custo: o preço do cartão (e o do documento) é só o das que têm
            var faltaCusto = ModeloDe(item) is not null ? SemCustoNaTabela(item) : new List<string>();
            var rascunho = editando ? EscopoEmTexto.Texto(item, _custo, _proposta.Moeda, TextosDaProposta.Do(Idioma)) : "";

            <div class="docs-equip @(editando ? "editando" : "")">
                <div class="docs-equip-cabeca">
                    <strong>Equipamento @(indice + 1)</strong>
                    <span class="docs-equip-num">
                        · @item.Quantos un. ·
                        @if (precoDeVenda > 0m)
                        {
                            <span class="@(faltaCusto.Count > 0 ? "texto-alerta" : "")">@DinheiroVenda(precoDeVenda)</span>
                        }
                        else
                        {
                            <span class="texto-alerta">sem preço</span>
                        }
                    </span>
                    <span class="docs-espaco"></span>
                    <button class="btn-link docs-editar" aria-expanded="@(editando ? "true" : "false")"
                            @onclick="() => AlternarDescricao(indice)">@(editando ? "fechar texto" : "editar texto")</button>
                </div>

                <div class="docs-equip-titulo">@titulo</div>

                @if (ModeloDe(item) is null)
                {
                    <div class="docs-falta texto-alerta">
                        <Icone Nome="alerta" Classe="ico-p" /> modelo não escolhido
                        <button class="btn-link" @onclick="@(() => IrAoEscopoDoCartao(indice, "f-modelo"))">escolher no Escopo</button>
                    </div>
                }
                @if (faltaCusto.Count > 0)
                {
                    <div class="docs-falta texto-alerta docs-falta-custo">
                        <Icone Nome="alerta" Classe="ico-p" /> @Plural(faltaCusto.Count, "linha sem custo", "linhas sem custo")@(precoDeVenda > 0m ? ": o preço sai incompleto" : "")
                        <button class="btn-link" @onclick="@(() => CompletarCustoNoPreco(indice, faltaCusto))">completar no Preço</button>
                    </div>
                }
                @* o título da comercial tira horizontal ou vertical do ARRANJO (e não
                   da montagem): sem ele, sai "horizontal, instalado ao piso" *@
                @if (!editado && item.Arranjo.Trim().Length == 0)
                {
                    <div class="docs-falta texto-alerta">
                        <Icone Nome="alerta" Classe="ico-p" /> arranjo não definido: o título sai horizontal, instalado ao piso
                        <button class="btn-link" @onclick="@(() => IrAoEscopoDoCartao(indice, "f-montagem"))">definir no Escopo</button>
                    </div>
                }

                <div class="docs-equip-pe">
                    @if (editado)
                    {
                        <span class="texto-alerta">texto editado à mão — não acompanha a técnica</span>
                        <span class="docs-sep">·</span>
                        <button class="btn-link docs-rascunho" title="Voltar ao rascunho do sistema, que acompanha a técnica"
                                @onclick="() => VoltarDescricao(indice)"><Icone Nome="desfazer" Classe="ico-p" /> rascunho</button>
                    }
                    else if (inclui.Count > 0)
                    {
                        <span>@PalavraDoInclui: @Plural(inclui.Count, "item", "itens") — igual ao alcance da técnica</span>
                    }
                    else
                    {
                        <span>sem a lista do que inclui: nada escolhido no escopo</span>
                    }
                </div>

                @if (editando)
                {
                    <textarea class="cell docs-texto" rows="@((editado ? item.Descricao : rascunho).Split('\n').Length + 1)"
                              aria-label="@($"Texto do equipamento {indice + 1} na proposta comercial")"
                              value="@(editado ? item.Descricao : rascunho)"
                              @onchange="e => MudarDescricao(indice, e.Value?.ToString() ?? string.Empty)"></textarea>
                }
            </div>
        }
    }
</div>

@* o custo previsto é de outra hora (o pedido fechado): uma linha que abre o
   pedido do projeto e do pedido; o id fica, o IrParaCustoPrevisto rola até ele *@
<div class="panel docs-custo-previsto" id="custo-previsto">
    @if (!_pedindoCustoPrevisto)
    {
        <div class="docs-cp-linha">
            <strong>Custo previsto</strong>
            <span class="nota">planilha de suprimentos, uma linha por item de cada equipamento</span>
            <span class="docs-espaco"></span>
            <button class="btn-link" @onclick="PedirCustoPrevisto">gerar…</button>
        </div>
    }
    else
    {
        <div class="docs-cp-linha">
            <strong>Custo previsto</strong>
            <span class="nota">planilha de suprimentos</span>
        </div>
        <div class="toolbar docs-cp-form">
            <label class="docs-cp-campo">Número do projeto
                <input class="cell" placeholder="ex.: NB0982" value="@_cpProjeto"
                       @oninput="e => _cpProjeto = e.Value?.ToString() ?? string.Empty" />
            </label>
            <label class="docs-cp-campo">Número do pedido
                <input class="cell" value="@_cpPedido"
                       @oninput="e => _cpPedido = e.Value?.ToString() ?? string.Empty" />
            </label>
            <button class="btn-primary" @onclick="GerarCustoPrevisto"><Icone Nome="baixar" /> Gerar</button>
            <button class="btn-ghost" @onclick="@(() => _pedindoCustoPrevisto = false)">Cancelar</button>
        </div>
        <p class="nota" style="margin:8px 0 0">
            O arquivo sai como <strong>@(CustoPrevistoExcel.NomeDoArquivo(_cpProjeto.Trim().Length > 0 ? _cpProjeto : "PROJETO"))</strong>.
            Cada equipamento leva o número do projeto com o dele atrás
            (@CustoPrevistoExcel.CodigoDaLinha(_cpProjeto.Trim().Length > 0 ? _cpProjeto : "PROJETO", 0),
            @CustoPrevistoExcel.CodigoDaLinha(_cpProjeto.Trim().Length > 0 ? _cpProjeto : "PROJETO", 1)…).
            Os valores saem na moeda do custo (@_proposta.Moeda.Rotulo()), indicada em cada célula.
        </p>
    }
</div>


}
@* o aviso fica no pé da coluna do meio, por cima do conteúdo e nunca do painel:
   o sucesso some sozinho em 6 s; a consequência e o erro ficam até alguém
   fechar (ver Aviso). Vem antes do rodapé: no fim da página ele para logo
   acima dos botões Voltar e Continuar, em vez de cobri-los *@
<div class="aviso-pe-area" aria-live="polite">
    @if (_msg is not null)
    {
        <div class="aviso-pe @(_erro ? "erro" : _avisoFica ? "consequencia" : "ok")" role="@(_erro ? "alert" : "status")">
            <span class="aviso-pe-texto">@_msg</span>
            @if (MostraAbrirPasta)
            {
                <button class="btn-ghost aviso-pe-acao" @onclick="AbrirPastaDoAviso"><Icone Nome="pasta" /> Abrir pasta</button>
            }
            @if (_avisoAcao is { } acaoDoAviso)
            {
                <button class="btn-ghost aviso-pe-acao" @onclick="FazerAcaoDoAviso">@acaoDoAviso.Rotulo</button>
            }
            <button class="btn-link btn-icone aviso-pe-fechar" title="Fechar o aviso" aria-label="Fechar o aviso"
                    @onclick="FecharAviso"><Icone Nome="fechar" /></button>
        </div>
    }
</div>

<div class="etapa-rodape">
    @if (_etapa == 3 && _proposta.Itens.Count > 0)
    {
        @* a etapa Equipamentos anda por dentro: Escopo → (Opcionais) → Técnica
           de cada equipamento. Antes, de qualquer aba, o botão ia direto ao
           Preço e pulava a Técnica e o equipamento 2. Só o último passo grava *@
        var anterior = PassoAnterior();
        var proximo = ProximoPasso();

        if (anterior is not null)
        {
            <button class="btn-ghost" @onclick="() => IrAoPasso(anterior)">← @RotuloDoPasso(anterior)</button>
        }
        else
        {
            <button class="btn-ghost" @onclick="() => IrParaEtapa(2)">← @NomeDaEtapa(2)</button>
        }
        <span style="flex:1"></span>
        @if (!OpcionaisNoCaminho && _abaItem != "opcionais")
        {
            <button class="btn-link" @onclick='() => TrocarAba("opcionais")'
                    title="Os opcionais do equipamento @(PosicaoValida + 1)">Opcionais</button>
        }
        @if (proximo is not null)
        {
            <button class="btn-link" @onclick="() => IrParaEtapa(4)">ir para Preço</button>
            <button class="btn-primary" @onclick="() => IrAoPasso(proximo)">Continuar: @RotuloDoPasso(proximo)</button>
        }
        else
        {
            <button class="btn-primary" @onclick="SalvarEContinuar">Salvar e continuar → @NomeDaEtapa(4)</button>
        }
    }
    else
    {
    @if (_etapa > 1)
    {
        <button class="btn-ghost" @onclick="() => IrParaEtapa(_etapa - 1)">← @NomeDaEtapa(_etapa - 1)</button>
    }
    <span style="flex:1"></span>
    @if (_etapa == 1)
    {
        <button class="btn-primary" @onclick="() => IrParaEtapa(2)">Continuar → @NomeDaEtapa(2)</button>
    }
    else if (_etapa < 5)
    {
        <button class="btn-primary" @onclick="SalvarEContinuar">Salvar e continuar → @NomeDaEtapa(_etapa + 1)</button>
    }
    else
    {
        <button class="btn-accent" disabled="@_gerandoTudo" @onclick="GerarTudo"><Icone Nome="baixar" /> Gerar tudo</button>
    }
    }
</div>

</div>
<aside class="prop-side" aria-label="Resumo da proposta">
    @{
        var comImpostos = pricingAtual.PrecoComImpostos != pricingAtual.VendaLiquida;
    }
    <div class="side-total">
        <div class="kpi-label" style="color:#cfe3f7">
            Venda líquida@(Cambio.Converte(_proposta) ? $" em {_proposta.MoedaVenda.Rotulo()}" : "")
        </div>
        @if (Total > 0m)
        {
            <div class="side-total-value">@DinheiroVenda(Cambio.ParaVenda(_proposta, pricingAtual.VendaLiquida))</div>
            @if (!comImpostos)
            {
                <div class="side-total-nota">sem impostos (exportação)</div>
            }
        }
        else
        {
            <div class="side-total-vazio">Sem custo ainda</div>
        }
    </div>

    @* o Salvar diz se há o que gravar: azul com alteração, discreto ("Salvo") sem *@
    @if (TemAlteracao || NovaRevisaoPendente)
    {
        <button class="btn-primary btn-block btn-salvar" @onclick="() => Salvar(explicito: true)"
                title="Grava a proposta (Ctrl+S)">
            <Icone Nome="salvar" /> Salvar <span class="atalho">Ctrl+S</span>
        </button>
    }
    else if (_proposta.Id.Length > 0)
    {
        <button class="btn-ghost btn-block btn-salvar salvo" @onclick="() => Salvar(explicito: true)"
                title="Nada mudou desde a última gravação" aria-label="Salvo — nada mudou desde a última gravação">
            <Icone Nome="ok" /> Salvo
        </button>
    }
    else
    {
        <button class="btn-ghost btn-block btn-salvar" @onclick="() => Salvar(explicito: true)"
                title="Grava a proposta (Ctrl+S)">
            <Icone Nome="salvar" /> Salvar <span class="atalho">Ctrl+S</span>
        </button>
    }

    @GerarTudoDividido("lado")

    <div class="panel side-numeros">
        <div class="side-item"><span>Custo total</span><strong>@(Total > 0m ? Dinheiro(Total) : "—")</strong></div>
        <div class="side-item">
            <span>Margem</span>
            <strong class="@(Total > 0m && MargemForaDoPadrao(pricingAtual) ? "texto-vermelho" : "")">
                @(Total > 0m ? Pct(pricingAtual.Margem) : "—")
            </strong>
        </div>
        @* igual à venda líquida (exportação), a linha só repetia o número de cima *@
        @if (Total > 0m && comImpostos)
        {
            <div class="side-item">
                <span>Preço com impostos</span>
                <strong>@DinheiroVenda(Cambio.ParaVenda(_proposta, pricingAtual.PrecoComImpostos))</strong>
            </div>
        }
        @* "Equipamentos 3" somava unidades: 2 linhas com 1 e 2 unidades pareciam 3 equipamentos *@
        <div class="side-item">
            <span>Equipamentos</span>
            <strong>@ItensEUnidades</strong>
        </div>
    </div>
    @if (Total > 0m && PrecisaAprovacao(pricingAtual))
    {
        <div class="aviso aviso-erro" style="font-size:12.5px">
            Margem, risco ou negociação fora do padrão: solicitar aprovação de pricing.
        </div>
    }
    @if (pendencias.Count > 0)
    {
        @* por lugar — a proposta e cada equipamento —, para caber num notebook de
           768 px: um grupo com uma só aparece direto; com mais, "Equip. 2 · 3"
           abre a lista dele. O do equipamento aberto na etapa 3 já vem aberto *@
        <div class="pendencias-lado">
            <strong>Pendências (@pendencias.Count)</strong>
            @foreach (var (lugar, itemDoLugar, doLugar) in PorLugar(pendencias))
            {
                if (doLugar.Count == 1)
                {
                    var unica = doLugar[0];
                    <button class="pendencia" @onclick="() => IrPara(unica)">@unica.Texto →</button>
                    continue;
                }

                <details class="pend-grupo" open="@(_etapa == 3 && itemDoLugar >= 0 && itemDoLugar == PosicaoValida)">
                    <summary>@lugar · @doLugar.Count</summary>
                    @foreach (var p in doLugar)
                    {
                        var alvo = p;
                        <button class="pendencia" @onclick="() => IrPara(alvo)">@SemOEquipamento(p) →</button>
                    }
                </details>
            }
        </div>
    }
    else
    {
        <div class="side-ok">Nada pendente para os documentos.</div>
    }
    @if (avisosDoPainel.Count > 0)
    {
        @* o que sai em branco mas não impede de gerar: fechado, fora da conta *@
        <details class="avisos-lado">
            <summary>Avisos (@avisosDoPainel.Count)</summary>
            <span class="nota">saem em branco nos documentos, mas não impedem de gerar</span>
            @foreach (var a in avisosDoPainel)
            {
                var alvo = a;
                <button class="pendencia" @onclick="() => IrPara(alvo)">@a.Texto →</button>
            }
        </details>
    }
</aside>

</div>
</div>

@code {
    private Proposta _proposta = Nascer();
    private List<Proposta> _gravadas = new();

    // ---------- rascunho no navegador ----------
    //
    // O que está preenchido vive na memória do servidor; recarregar a página
    // (ou perder a conexão por mais tempo que o servidor guarda a sessão) o
    // apagava. Por isso a proposta em andamento é copiada para o navegador a
    // cada alteração, e volta quando a página abre — enquanto não for gravada
    // (Salvar), que é quando o rascunho deixa de ser necessário.

    /// <summary>A proposta como está gravada (ou como nasceu): o que NÃO é rascunho.</summary>
    private string _baseSalva = "";

    /// <summary>O último rascunho escrito no navegador, para não reescrever o mesmo.</summary>
    private string _ultimoRascunho = "";

    /// <summary>Com que chave o rascunho foi escrito (o id da proposta, ou "novo").</summary>
    private string _chaveRascunho = "";

    /// <summary>Só depois de tentar recuperar o rascunho é que se pode escrever um: antes, a tela em branco o apagaria.</summary>
    private bool _rascunhoPronto;

    private string Foto() => System.Text.Json.JsonSerializer.Serialize(_proposta);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // o aviso acabou de aparecer: este é o lugar dele (ver TirarConsequenciaDeOutroLugar)
        if (_msg is not null && _lugarDoAviso is null) _lugarDoAviso = LugarAtual;

        if (firstRender)
        {
            // a saída pelo próprio servidor (botão Propostas) passa pela guarda de
            // alteração não salva; os links do menu, pelo appGuarda
            _guardaDeSaida = Navegacao.RegisterLocationChangingHandler(AoSairDaTela);

            await LigarAtalhos();
            await LigarPastaDaProposta();

            try
            {
                await RecuperarRascunho();
            }
            catch (Exception)
            {
                // rascunho é uma rede de segurança: nunca derruba a tela
            }

            _rascunhoPronto = true;
            return;
        }

        TickCronometro();
        await Rolar();
        await LigarMenus();

        try
        {
            if (_rascunhoPronto) await GuardarRascunho();
        }
        catch (Exception)
        {
            // rascunho é uma rede de segurança: nunca derruba a tela
        }
    }

    private async Task RecuperarRascunho()
    {
        // a rota manda: /axiais/proposta/{id} só recupera o rascunho DAQUELA
        // proposta; sem id, vale o último que a pessoa estava editando
        var chave = !string.IsNullOrWhiteSpace(Id)
            ? Id!
            : await JS.InvokeAsync<string?>("appRascunho.ler", "ultima") ?? "novo";

        var texto = await JS.InvokeAsync<string?>("appRascunho.ler", chave);
        if (string.IsNullOrEmpty(texto)) return;

        var recuperada = System.Text.Json.JsonSerializer.Deserialize<Proposta>(texto);
        if (recuperada is null) return;

        // uma proposta que já está no banco só é "recuperada" se o rascunho for
        // diferente do que está gravado — e se ela foi apagada, o rascunho some
        if (recuperada.Id.Length > 0)
        {
            var gravada = Repo.Achar(recuperada.Id);
            if (gravada is null)
            {
                await JS.InvokeVoidAsync("appRascunho.limpar", chave);
                return;
            }

            _baseSalva = System.Text.Json.JsonSerializer.Serialize(gravada);
            _revisaoAberta = gravada.Revisao;

            if (_baseSalva == texto) return;
        }
        else
        {
            _baseSalva = Foto();
        }

        _proposta = recuperada;
        _anexosATirar.Clear();
        _ultimoRascunho = texto;
        _chaveRascunho = chave;
        if (recuperada.Id.Length > 0) _origem = "aberta";
        AjustarEscolhasLivres();

        _etapa = 2;
        Aviso("Recuperei o que você estava preenchendo e ainda não tinha gravado. " +
              "Grave com Salvar — ou descarte com + Nova.", fica: true);
        // quem desenhou foi a tela, ao abrir: o cronômetro não conta
        _desenhoDoSistema = true;
        StateHasChanged();
    }

    private async Task GuardarRascunho()
    {
        var atual = Foto();
        var chave = _proposta.Id.Length > 0 ? _proposta.Id : "novo";

        // a chave mudou (a proposta nova ganhou id ao ser gravada): o rascunho
        // da chave antiga não vale mais
        if (_chaveRascunho.Length > 0 && _chaveRascunho != chave)
        {
            await JS.InvokeVoidAsync("appRascunho.limpar", _chaveRascunho);
            _ultimoRascunho = "";
        }

        // igual ao que está gravado: não há o que guardar
        if (atual == _baseSalva)
        {
            if (_ultimoRascunho.Length > 0 || _chaveRascunho.Length > 0)
            {
                await JS.InvokeVoidAsync("appRascunho.limpar", chave);
                _ultimoRascunho = "";
            }

            _chaveRascunho = chave;
            return;
        }

        if (atual == _ultimoRascunho && _chaveRascunho == chave) return;

        await JS.InvokeVoidAsync("appRascunho.gravar", chave, atual);
        await JS.InvokeVoidAsync("appRascunho.gravar", "ultima", chave);
        _ultimoRascunho = atual;
        _chaveRascunho = chave;
    }

    /// <summary>
    /// A revisão que a proposta tinha quando foi aberta (ou gravada pela última
    /// vez). Se a pessoa muda o número da revisão e grava, não é a mesma proposta
    /// que se atualiza: é uma NOVA revisão, e a anterior fica como estava.
    /// </summary>
    private string _revisaoAberta = "";

    private List<Equipamento> _equipamentos = new();
    private List<Motor> _motores = new();
    private List<LimiteMotor> _limites = new();

    /// <summary>A conta da proposta — a mesma que a lista de propostas usa.</summary>
    private CustoDaProposta _custo = default!;
    private List<string> _listas = new();
    private Dictionary<string, List<Caracteristica>> _porGrupo = new();
    private List<Caracteristica> _caracteristicas = new();
    private List<PrecoReferencia> _precos = new();

    /// <summary>Qual equipamento da proposta está aberto nas abas do escopo.</summary>
    private int _aberto;

    private string? _msg;
    private bool _erro;
    private bool _apagando;
    private int? _apagandoItem;
    private bool _lendo;

    // o que a última leitura da folha de dados trouxe, e o que ela não traz
    private List<string> _daPlanilha = new();
    private List<string> _avisos = new();

    /// <summary>
    /// O que o relatório de seleção não trouxe, por equipamento. É por
    /// equipamento porque cada um tem o seu arquivo — o aviso de um não pode
    /// aparecer embaixo do outro.
    /// </summary>
    private Dictionary<int, List<string>> _faltouNaSelecao = new();

    // ---------- entrega e pagamento ----------
    private List<CondicaoPagamento> _condicoes = new();
    private bool _cadastrandoPagamento;
    private string _novaCondicao = "";

    /// <summary>
    /// Marcas de "não é nenhuma das opções, é o que eu digitei": o
    /// &lt;select&gt; precisa de um value para a opção livre, e ele não pode
    /// ser igual a nenhuma condição cadastrada nem a nenhum incoterm.
    /// </summary>
    private const string OutroPagamento = "(outra condição de pagamento)";
    private const string OutroIncoterm = "(outro incoterm)";

    private bool _pagamentoLivre;
    private bool _incotermLivre;

    /// <summary>
    /// Como chamar o lugar que falta: CIF pede um porto, DAP e DDP pedem o
    /// lugar de entrega. O que se digita é só o nome — "Puerto de" e
    /// "UBICACIÓN de" já vêm na frase do modelo.
    /// </summary>
    private string RotuloDoDestino =>
        Textos.Igual(_proposta.Incoterm, "CIF") ? "Porto de destino" : "Local de destino";

    private string ExemploDoDestino =>
        Textos.Igual(_proposta.Incoterm, "CIF")
            ? "Ex.: Valparaíso (CHILE) — sem repetir \"Puerto de\""
            : "Ex.: Antofagasta (CHILE) — sem repetir \"UBICACIÓN de\"";

    /// <summary>O incoterm escolhido pede que alguém diga o lugar (CIF, DAP, DDP)?</summary>
    private bool PedeDestino => ListasDaProposta.Incoterms
        .Any(i => Textos.Igual(i.Codigo, _proposta.Incoterm) && i.Destino);

    /// <summary>Id na rota: /axiais/proposta/{id} abre aquela proposta direto.</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>
    /// A rota manda. Como a mesma página atende /axiais/proposta e
    /// /axiais/proposta/{id}, isto roda também quando a lista navega para cá.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Id) || Id == _proposta.Id) return;

        if (Repo.Achar(Id) is { } achada)
        {
            _proposta = achada;
            _revisaoAberta = achada.Revisao;
            _anexosATirar.Clear();
            _baseSalva = Foto();
            AjustarEscolhasLivres();
            _aberto = 0;
            _abaItem = "escopo";
            _sugestaoCliente = null;
            ZerarCronometro();
            _origem = "aberta";
            _etapa = 2;
            Aviso($"Proposta {achada.Numero} aberta.");
        }
        else
        {
            Aviso("Essa proposta não está mais no banco.", erro: true);
        }
    }

    /// <summary>
    /// Uma proposta em branco, já com o que dá para adivinhar: hoje, o ano
    /// corrente e a primeira opção de cada lista de cabeçalho.
    /// </summary>
    private static Proposta Nascer() => new()
    {
        Data = DateTime.Now.ToString("yyyy-MM-dd"),
        Ano = DateTime.Now.Year.ToString(),
        Fase = ListasDaProposta.Fases[0],
        Bu = ListasDaProposta.Bus[0].Codigo,
        Produto = ListasDaProposta.Produtos[0],
        MarketSegment = ListasDaProposta.Segmentos[0],
    };

    /// <summary>
    /// Relê só a lista de propostas gravadas e o que sai dela: os clientes
    /// conhecidos e o próximo número. Depois de gravar é só isso que muda —
    /// remontar cadastros, a conta e as listas a cada gravação era trabalho
    /// jogado fora. A gravação acabou de invalidar "propostas", então a leitura
    /// vai ao disco e traz também o que os colegas gravaram na pasta.
    /// </summary>
    private void AtualizarGravadas()
    {
        _gravadas = Repo.Todas();
        MontarClientes();
        _proximoNumero = Repo.ProximoNumero(_proposta.Ano);
    }

    private void Recarregar()
    {
        AtualizarGravadas();
        _padroes = EscoposPadrao.Todos();
        _condicoes = Pagamentos.Todas();
        _equipamentos = Equipamentos.Todos();
        _motores = Motores.Todos();
        _limites = Limites.Todos();
        _precos = Precos.Todos();

        _caracteristicas = Caracteristicas.Todas();
        _porGrupo = _caracteristicas.GroupBy(c => c.Grupo).ToDictionary(g => g.Key, g => g.ToList());

        _custo = new CustoDaProposta(_equipamentos, _motores, _caracteristicas,
            Caracteristicas.Grupos(), _precos);

        // o escopo do ventilador mostra as listas na ordem do cadastro, menos as
        // que se precificam pelo motor — o partidor entra quando a proposta
        // escolher o motor, e não o ventilador
        _listas = Caracteristicas.Grupos()
            .OrderBy(g => g.Ordem)
            .Select(g => g.Nome)
            .Where(nome => !EhDaParteEletrica(nome))
            .ToList();

        // o partidor e a instrumentação são da parte elétrica, e não do escopo
        // do ventilador: o preço do partidor vem da potência do motor, e a
        // instrumentação aceita mais de uma escolha
        ListaDosPartidores = Caracteristicas.Grupos()
            .Select(g => g.Nome)
            .FirstOrDefault(n => Textos.Simples(n).Contains("partidor")) ?? "PARTIDORES";

        ListaDaInstrumentacao = Caracteristicas.Grupos()
            .Select(g => g.Nome)
            .FirstOrDefault(n => Textos.Simples(n).Contains("instrumenta")) ?? "INSTRUMENTAÇÃO";
    }

    // ---------- de onde cada campo vem ----------

    /// <summary>
    /// O rótulo de um campo com a origem dele: a célula da folha de dados,
    /// quando a planilha traz; "preencher manual" quando não traz. É o que
    /// evita mandar proposta pela metade achando que a planilha cuidou de tudo.
    /// </summary>
    private RenderFragment Campo(string nome, string? origem = null) => @<text>
        @nome
        @if (origem is null)
        {
            <span class="subtitle ajuda" style="font-weight:400; margin-left:6px">preencher manual</span>
        }
        else
        {
            <span class="val-count ajuda" style="margin-left:6px" title="Vem da folha de dados">@origem</span>
        }
    </text>;

    /// <summary>A linha da folha de dados que preenche uma lista, se houver.</summary>
    private static string? LinhaDaPlanilha(string lista) => FolhaDeDados.ListasDaPlanilha
        .Where(l => Textos.Simples(lista).Contains(l.Palavra))
        .Select(l => $"linha {l.Linha}")
        .FirstOrDefault();

    // ---------- o escopo ----------

    /// <summary>Os nomes das listas que moram na parte elétrica, neste banco.</summary>
    private string ListaDosPartidores = "PARTIDORES";
    private string ListaDaInstrumentacao = "INSTRUMENTAÇÃO";

    private static bool EhDaParteEletrica(string lista) => CustoDaProposta.EhDaParteEletrica(lista);

    private List<Caracteristica> OpcoesReais(string lista) => _custo.OpcoesReais(lista);

    private int PosicaoValida =>
        _proposta.Itens.Count == 0 ? 0 : Math.Clamp(_aberto, 0, _proposta.Itens.Count - 1);

    private Equipamento? ModeloDe(ItemProposta item) => _custo.Modelo(item);

    private decimal? PrecoDoModelo(ItemProposta item) => _custo.PrecoDoModelo(item, _proposta.Moeda);

    private ItemDoEscopo Resolver(ItemProposta item, string grupo, string valor) =>
        _custo.Resolver(item, grupo, valor, _proposta.Moeda);

    private List<ItemDoEscopo> Itens(ItemProposta item) => _custo.Itens(item, _proposta.Moeda);

    // ---------- preço puxado, com a mão por cima ----------

    private List<(string Chave, decimal? Puxado)> LinhasDePreco(ItemProposta item) =>
        _custo.LinhasDePreco(item, _proposta.Moeda);

    /// <summary>
    /// O preço que vale: o digitado à mão, quando houver; o do cadastro, quando
    /// não. É a regra geral da proposta — puxa, mas sempre dá para corrigir.
    /// </summary>
    private static decimal? Efetivo(ItemProposta item, string chave, decimal? puxado) =>
        CustoDaProposta.Efetivo(item, chave, puxado);

    private bool EhManual(ItemProposta item, string chave) =>
        item.PrecosManuais.TryGetValue(chave, out var t) && t.Trim().Length > 0;

    /// <summary>
    /// O fim de uma linha da lista de seleção: o código, de onde veio o preço e
    /// o preço — editável.
    ///
    /// A tela da seleção mostrava o preço só para ler, e quem quisesse mexer
    /// tinha de descer até o resumo. Agora é no mesmo lugar em que se escolhe:
    /// o cadastro puxa, e quem está montando a proposta corrige ali.
    /// </summary>
    private RenderFragment PrecoNaLista(ItemProposta item, string chave, string codigo,
        decimal? puxado, string origem) => @<text>
        <span style="flex:1"></span>

        @* a explicação e o campo ficam num grupo só: numa linha de escopo com
           flex-wrap, o campo sozinho cai para a linha de baixo assim que o
           texto da origem cresce, e some de perto da opção a que pertence *@
        <div style="display:flex; align-items:center; gap:8px; flex:0 1 auto; min-width:0">
            <span class="subtitle" title="@origem"
                  style="margin:0; text-align:right; white-space:nowrap; overflow:hidden;
                         text-overflow:ellipsis">
                @(codigo.Length > 0 ? $"código {codigo}" : "sem código")
                ·
                @(EhManual(item, chave) ? "custo à mão" : origem)
            </span>
            @Preco(item, chave, puxado)
        </div>
    </text>;

    /// <summary>O campo de preço de uma linha: puxado, editável, e com volta.</summary>
    private RenderFragment Preco(ItemProposta item, string chave, decimal? puxado) => @<text>
        <div style="display:flex; align-items:center; gap:6px; justify-content:flex-end">
            @* o índice do equipamento no id: a etapa Preço mostra as linhas de
               todos, e a pendência de custo leva a este campo (item 06) *@
            <input id="@AlvoDoCusto(_proposta.Itens.IndexOf(item), chave)" class="cell num" style="max-width:150px" placeholder="—"
                   value="@TextoDoPreco(item, chave, puxado)"
                   @onchange="e => DefinirPrecoManual(item, chave, e.Value?.ToString() ?? string.Empty, puxado)" />
            @if (EhManual(item, chave))
            {
                <button class="btn-link btn-icone" title="Voltar ao custo do cadastro" aria-label="Voltar ao custo do cadastro"
                        @onclick="() => item.PrecosManuais.Remove(chave)"><Icone Nome="desfazer" /></button>
            }
        </div>
        @{
            // a dica só de leitura do último custo à mão (item 22, num arquivo à parte); sem ela, nada
            string? dica = null;
            DicaDoCusto(item, chave, puxado, ref dica);
        }
        @if (dica is { Length: > 0 })
        {
            <span class="nota dica-do-custo">@dica</span>
        }
    </text>;

    /// <summary>
    /// O texto do campo de custo: o digitado à mão, como foi digitado; o do
    /// cadastro com separador de milhar e até duas casas (um CLP inteiro sai
    /// "30.500.000"). Nunca o N0 dos valores de leitura — ver
    /// <see cref="Exibicao.NoCampo"/>.
    /// </summary>
    private static string TextoDoPreco(ItemProposta item, string chave, decimal? puxado)
    {
        if (item.PrecosManuais.TryGetValue(chave, out var texto) && texto.Trim().Length > 0)
            return texto;

        return Exibicao.NoCampo(puxado);
    }

    private void DefinirPrecoManual(ItemProposta item, string chave, string texto, decimal? puxado)
    {
        var valor = texto.Trim();

        // apagar o campo é voltar ao cadastro, não zerar o preço
        if (valor.Length == 0)
        {
            item.PrecosManuais.Remove(chave);
            return;
        }

        if (DadosExcel.Numero(valor) is not { } numero)
        {
            Aviso($"\"{valor}\" não parece um preço. Use 1234,56 ou 1234.56.", erro: true);
            return;
        }

        // digitar o mesmo número que o cadastro já dava não é uma exceção —
        // comparado em duas casas, que é o que o campo mostra
        if (Exibicao.MesmoValor(numero, puxado))
        {
            item.PrecosManuais.Remove(chave);
            return;
        }

        item.PrecosManuais[chave] = valor;
    }

