        _proposta.Itens[indice].EscopoExcluido = texto.Trim();

    /// <summary>
    /// As linhas do catálogo que não estão na lista deste equipamento. São as
    /// peças que nenhuma lista do cadastro escolhe — câmara anti-stall, mancal
    /// monobloco, acoplamento elástico — e as que vocês tiraram do rascunho.
    /// </summary>
    private List<string> ForaDoCatalogo(ItemProposta item)
    {
        var textos = EscopoTextos;

        var postas = EscopoDaHowden.Efetivo(item, _custo, _proposta.Moeda, textos)
            .Select(Textos.Simples)
            .ToHashSet();

        return EscopoDaHowden.Ordem
            .Where(c => !postas.Contains(Textos.Simples(textos.Catalogo[c])))
            .ToList();
    }

    /// <summary>
    /// Junta uma peça do catálogo à lista.
    ///
    /// Guarda a CHAVE, e não o texto, para a linha sair na língua do documento.
    /// Se vocês já escreveram a lista à mão, aí é o texto que vale e a peça vai
    /// no fim dele — não dá para mandar a chave para dentro de um texto livre.
    /// </summary>
    private void JuntarAoEscopo(int indice, string chave)
    {
        var item = _proposta.Itens[indice];

        if (item.EscopoIncluso.Trim().Length > 0)
        {
            item.EscopoIncluso = item.EscopoIncluso.TrimEnd()
                + "\n- " + EscopoTextos.Catalogo[chave];
            return;
        }

        if (!item.EscopoExtra.Contains(chave)) item.EscopoExtra.Add(chave);
    }

    private void TirarDoEscopo(int indice, string chave) =>
        _proposta.Itens[indice].EscopoExtra.Remove(chave);

    /// <summary>
    /// O que o documento vai deixar em branco. Não impede de gerar — muita
    /// proposta sai para conferência antes de estar fechada —, mas ninguém
    /// deveria descobrir no PDF que faltava a condição de pagamento.
    /// </summary>
    private List<string> FaltamParaProposta
    {
        get
        {
            var faltam = new List<string>();

            if (_proposta.Cliente.Trim().Length == 0) faltam.Add("Cliente");
            if (_proposta.AosCuidados.Trim().Length == 0) faltam.Add("Aos cuidados de");
            if (_proposta.Cidade.Trim().Length == 0) faltam.Add("Cidade");
            if (_proposta.CondicaoPagamento.Trim().Length == 0) faltam.Add("Condição de pagamento");
            if (_proposta.Incoterm.Trim().Length == 0) faltam.Add("Entrega (incoterm)");
            if (_proposta.Armado.Trim().Length == 0) faltam.Add("Armado ou desarmado");
            if (_proposta.ContatoNome.Trim().Length == 0) faltam.Add("Contato Howden");

            return faltam;
        }
    }

    private async Task GerarProposta()
    {
        if (_proposta.Itens.Count == 0)
        {
            Aviso("A proposta ainda não tem equipamento nenhum.", erro: true);
            return;
        }

        try
        {
            var modelo = Path.Combine(Ambiente.ContentRootPath, PropostaWord.CaminhoDoModelo);

            if (!File.Exists(modelo))
            {
                Aviso($"O modelo da proposta não está em {PropostaWord.CaminhoDoModelo}.", erro: true);
                return;
            }

            var bytes = PropostaWord.Gerar(_proposta, _custo, modelo);

            await JS.InvokeVoidAsync("appDownload",
                PropostaWord.NomeDoArquivo(_proposta),
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                Convert.ToBase64String(bytes));

            Aviso($"Proposta gerada: {PropostaWord.NomeDoArquivo(_proposta)}.");
        }
        catch (Exception ex)
        {
            Aviso($"Não consegui gerar a proposta: {ex.Message}", erro: true);
        }
    }

    private async Task GerarTecnica()
    {
        if (_proposta.Itens.Count == 0)
        {
            Aviso("A proposta ainda não tem equipamento nenhum.", erro: true);
            return;
        }

        try
        {
            var modelo = Path.Combine(Ambiente.ContentRootPath, PropostaWord.CaminhoDoModelo);

            if (!File.Exists(modelo))
            {
                Aviso($"O modelo da proposta não está em {PropostaWord.CaminhoDoModelo}.", erro: true);
                return;
            }

            var bytes = PropostaTecnicaWord.Gerar(_proposta, _custo, modelo, LerCurva);

            await JS.InvokeVoidAsync("appDownload",
                PropostaTecnicaWord.NomeDoArquivo(_proposta),
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                Convert.ToBase64String(bytes));

            Aviso($"Proposta técnica gerada: {PropostaTecnicaWord.NomeDoArquivo(_proposta)}.");
        }
        catch (Exception ex)
        {
            Aviso($"Não consegui gerar a proposta técnica: {ex.Message}", erro: true);
        }
    }

    /// <summary>A curva lida da pasta de anexos, para entrar no documento.</summary>
    private ImagemDaCurva? LerCurva(CurvaAnexada curva)
    {
        var caminho = Anexos.Caminho(_proposta.Id, curva.Imagem);
        if (caminho is null) return null;

        return new ImagemDaCurva(File.ReadAllBytes(caminho), Path.GetExtension(caminho));
    }

    private async Task GerarPricing()
    {
        var modelo = Path.Combine(Ambiente.ContentRootPath, PricingExcel.CaminhoDoModelo);

        if (!File.Exists(modelo))
        {
            Aviso($"A planilha modelo não está em {PricingExcel.CaminhoDoModelo}.", erro: true);
            return;
        }

        try
        {
            var bytes = PricingExcel.Gerar(_proposta, Total, Pricing(), modelo);

            await JS.InvokeVoidAsync("appDownload",
                PricingExcel.NomeDoArquivo(_proposta),
                "application/vnd.ms-excel.sheet.macroEnabled.12",
                Convert.ToBase64String(bytes));

            Aviso($"Pricing gerado: {PricingExcel.NomeDoArquivo(_proposta)}.");
        }
        catch (Exception ex)
        {
            Aviso($"Não consegui gerar o pricing: {ex.Message}", erro: true);
        }
    }

    /// <summary>
    /// A escolha de um dos contatos do quadro. Os campos continuam editáveis
    /// depois: a lista é atalho, não trava.
    /// </summary>
    private void EscolherContato(string nome, int qual)
    {
        if (ListasDaProposta.Contato(nome) is not { } c)
        {
            // "— nenhum —" limpa o contato, que é como se tira o segundo
            if (nome.Length > 0) return;
            if (qual == 1) (_proposta.ContatoNome, _proposta.ContatoCargo, _proposta.ContatoArea,
                            _proposta.ContatoEmail, _proposta.ContatoTelefones) = ("", "", "", "", "");
            else (_proposta.Contato2Nome, _proposta.Contato2Cargo, _proposta.Contato2Area,
                  _proposta.Contato2Email, _proposta.Contato2Telefones) = ("", "", "", "", "");
            return;
        }

        if (qual == 1)
        {
            _proposta.ContatoNome = c.Nome;
            _proposta.ContatoCargo = c.Cargo;
            _proposta.ContatoArea = c.Area;
            _proposta.ContatoEmail = c.Email;
            _proposta.ContatoTelefones = c.Telefones;
        }
        else
        {
            _proposta.Contato2Nome = c.Nome;
            _proposta.Contato2Cargo = c.Cargo;
            _proposta.Contato2Area = c.Area;
            _proposta.Contato2Email = c.Email;
            _proposta.Contato2Telefones = c.Telefones;
        }
    }

    /// <summary>O seletor de um contato do quadro, igual nos dois.</summary>
    private RenderFragment Contato(string rotulo, string escolhido, Action<string> escolher) => @<text>
        <div class="toolbar" style="margin-bottom:12px">
            <label style="display:flex; flex-direction:column; gap:5px; font-size:12.5px; color:var(--muted)">
                @rotulo
                <select class="cell" style="min-width:340px" value="@escolhido"
                        @onchange="e => escolher(e.Value?.ToString() ?? string.Empty)">
                    <option value="">— nenhum —</option>
                    @foreach (var c in ListasDaProposta.Contatos)
                    {
                        <option value="@c.Nome" selected="@(Textos.Igual(c.Nome, escolhido))">
                            @c.Nome — @(c.Area.Length > 0 ? c.Area : c.Cargo)
                        </option>
                    }
                </select>
            </label>
        </div>
    </text>;

    // ---------- entrega e pagamento ----------

    private void EscolherPagamento(string valor)
    {
        _pagamentoLivre = valor == OutroPagamento;
        if (!_pagamentoLivre) _proposta.CondicaoPagamento = valor;
    }

    private void EscolherIncoterm(string valor)
    {
        _incotermLivre = valor == OutroIncoterm;
        if (_incotermLivre) return;

        _proposta.Incoterm = valor;
        // trocar para um incoterm que já diz o lugar apaga o destino digitado,
        // para ele não reaparecer se a equipe voltar para CIF
        if (!PedeDestino) _proposta.IncotermDestino = "";
    }

    /// <summary>
    /// Qual dos dois campos de texto livre abrir ao abrir a proposta: o que
    /// está gravado não está na lista, então foi digitado.
    /// </summary>
    private void AjustarEscolhasLivres()
    {
        _pagamentoLivre = _proposta.CondicaoPagamento.Length > 0
            && !_condicoes.Any(c => Textos.Igual(c.Texto, _proposta.CondicaoPagamento));

        _incotermLivre = _proposta.Incoterm.Length > 0
            && !ListasDaProposta.Incoterms.Any(i => Textos.Igual(i.Codigo, _proposta.Incoterm));
    }

    private void AdicionarCondicao()
    {
        var texto = _novaCondicao.Trim();
        if (texto.Length == 0) return;

        // repetida não entra: a lista é para escolher, e duas linhas iguais só
        // deixam a escolha ambígua
        if (_condicoes.FirstOrDefault(c => Textos.Igual(c.Texto, texto)) is { } jaTem)
        {
            _novaCondicao = "";
            _proposta.CondicaoPagamento = jaTem.Texto;
            _pagamentoLivre = false;
            Aviso("Essa condição já estava cadastrada.");
            return;
        }

        Pagamentos.Salvar(new CondicaoPagamento { Texto = texto });
        _novaCondicao = "";
        _condicoes = Pagamentos.Todas();
    }

    private void RenomearCondicao(CondicaoPagamento c, string texto)
    {
        if (texto.Trim().Length == 0) return;

        var antigo = c.Texto;
        c.Texto = texto.Trim();
        Pagamentos.Salvar(c);
        _condicoes = Pagamentos.Todas();

        // a proposta aberta guarda o TEXTO, não o id: corrigir a condição no
        // cadastro tem de corrigir a proposta que estava com ela
        if (Textos.Igual(_proposta.CondicaoPagamento, antigo)) _proposta.CondicaoPagamento = c.Texto;
    }

    private void ApagarCondicao(CondicaoPagamento c)
    {
        Pagamentos.Apagar(c.Id);
        _condicoes = Pagamentos.Todas();
        AjustarEscolhasLivres();
    }

    // ---------- seleção do ventilador ----------

    /// <summary>
    /// Lê o relatório de seleção e põe os dados no equipamento aberto.
    ///
    /// Vale por equipamento, e não pela proposta: cada ventilador tem a sua
    /// seleção, e é por isso que o botão fica dentro da aba dele.
    /// </summary>
    private async Task SubirSelecao(InputFileChangeEventArgs e, int indice)
    {
        _faltouNaSelecao.Remove(indice);

        try
        {
            var extensao = Path.GetExtension(e.File.Name).ToLowerInvariant();

            if (extensao == ".doc")
            {
                Aviso("O Word antigo (.doc) não abre aqui — salve como .docx e suba de novo.",
                    erro: true);
                return;
            }

            await using var fluxo = e.File.OpenReadStream(10 * 1024 * 1024);
            using var memoria = new MemoryStream();
            await fluxo.CopyToAsync(memoria);
            memoria.Position = 0;

            // a seleção do VAX vem em Word, e a do Joy em texto puro; do Word
            // o que interessa é o texto, que é o mesmo relatório
            var texto = extensao == ".docx"
                ? TextoDoWord.Ler(memoria)
                : new StreamReader(memoria).ReadToEnd();

            var resultado = SelecaoTecnica.Ler(texto);

            if (resultado.Dados.Count == 0)
            {
                Aviso("Não reconheci esse arquivo como um relatório de seleção.", erro: true);
                return;
            }

            var item = _proposta.Itens[indice];
            foreach (var (chave, dado) in resultado.Dados) item.Tecnicos[chave] = dado;
            item.ArquivoDaSelecao = e.File.Name;

            if (resultado.NaoAchados.Count > 0) _faltouNaSelecao[indice] = resultado.NaoAchados;

            var curvas = extensao == ".docx" ? await CurvasDoWord(memoria, indice) : 0;

            Aviso($"Seleção lida: {resultado.Dados.Count} dado(s) do equipamento {indice + 1}"
                + curvas switch
                {
                    0 => ".",
                    1 => ", e a curva veio junto.",
                    _ => $", e as {curvas} curvas vieram juntas.",
                });
        }
        catch (Exception ex)
        {
            Aviso($"Não consegui ler a seleção: {ex.Message}", erro: true);
        }
    }

    /// <summary>
    /// Desfaz a leitura da seleção — para quando o arquivo subiu errado.
    ///
    /// Apaga os dados junto com o nome do arquivo: subir o certo por cima não
    /// bastaria, porque um campo que só existia no arquivo errado ficaria lá,
    /// parecendo ter vindo do novo.
    /// </summary>
    private void TirarSelecao(int indice)
    {
        var item = _proposta.Itens[indice];

        item.Tecnicos.Clear();
        item.ArquivoDaSelecao = "";
        _faltouNaSelecao.Remove(indice);
    }

    /// <summary>
    /// Traz a curva de dentro do Word da seleção, que é onde ela vem no VAX.
    ///
    /// Só entra quando o equipamento ainda não tem curva: quem anexou uma à
    /// mão escolheu aquela, e subir a seleção depois não pode trocá-la sem
    /// avisar.
    /// </summary>
    private async Task<int> CurvasDoWord(MemoryStream docx, int indice)
    {
        var item = _proposta.Itens[indice];
        if (item.Curvas.Count > 0) return 0;

        docx.Position = 0;
        var figuras = ImagemDoWord.Curvas(docx);
        if (figuras.Count == 0) return 0;

        if (_proposta.Id.Trim().Length == 0) _proposta.Id = Guid.NewGuid().ToString("n");

        for (var i = 0; i < figuras.Count; i++)
        {
            using var imagem = new MemoryStream(figuras[i].Bytes);
            var arquivo = await Anexos.Guardar(_proposta.Id, imagem, "curva" + figuras[i].Extensao);

            item.Curvas.Add(new CurvaAnexada
            {
                Arquivo = arquivo,
                Nome = $"curva {i + 1} da seleção",
                // já é imagem: não há PDF para desenhar
                Imagem = arquivo,
            });
        }

        return figuras.Count;
    }

    private static void MudarTecnico(ItemProposta item, string chave, string valor, string unidade)
    {
        if (valor.Trim().Length == 0 && unidade.Trim().Length == 0)
        {
            item.Tecnicos.Remove(chave);
            return;
        }

        item.Tecnicos[chave] = new DadoTecnico(valor.Trim(), unidade.Trim());
    }

    /// <summary>
    /// Guarda a curva de performance do equipamento.
    ///
    /// O arquivo vai para a pasta de anexos, e a proposta guarda só o nome —
    /// ver <see cref="Anexos"/>. Como o anexo é gravado na hora, a proposta
    /// precisa de um id antes: sem ele, a curva não teria pasta onde morar.
    /// </summary>
    private async Task SubirCurva(InputFileChangeEventArgs e, int indice)
    {
        try
        {
            if (_proposta.Id.Trim().Length == 0) _proposta.Id = Guid.NewGuid().ToString("n");

            var item = _proposta.Itens[indice];

            await using var fluxo = e.File.OpenReadStream(20 * 1024 * 1024);
            using var memoria = new MemoryStream();
            await fluxo.CopyToAsync(memoria);

            memoria.Position = 0;
            var curva = new CurvaAnexada
            {
                Arquivo = await Anexos.Guardar(_proposta.Id, memoria, e.File.Name),
                Nome = e.File.Name,
            };

            // a curva é um desenho, e é como imagem que ela vai para a
            // proposta: o PDF vira PNG aqui, já aparado, e a tela mostra
            // exatamente o que vai ser colado no documento
            if (Path.GetExtension(e.File.Name).Equals(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                var png = CurvaEmImagem.De(memoria.ToArray());
                using var imagem = new MemoryStream(png);
                curva.Imagem = await Anexos.Guardar(_proposta.Id, imagem, "curva.png");
            }
            else
            {
                curva.Imagem = curva.Arquivo;
            }

            item.Curvas.Add(curva);
            Aviso($"Curva anexada ao equipamento {indice + 1}.");
        }
        catch (Exception ex)
        {
            Aviso($"Não consegui anexar a curva: {ex.Message}", erro: true);
        }
    }

    private void TirarCurva(int indice, int posicao)
    {
        var item = _proposta.Itens[indice];
        if (posicao < 0 || posicao >= item.Curvas.Count) return;

        Apagar(item.Curvas[posicao]);
        item.Curvas.RemoveAt(posicao);
    }

    /// <summary>Apaga os arquivos de uma curva: o original e a imagem dele.</summary>
    private void Apagar(CurvaAnexada curva)
    {
        if (curva.Arquivo.Length > 0) Anexos.Apagar(_proposta.Id, curva.Arquivo);

        if (curva.Imagem.Length > 0 && curva.Imagem != curva.Arquivo)
            Anexos.Apagar(_proposta.Id, curva.Imagem);
    }

    private string TamanhoDaCurva(CurvaAnexada curva)
    {
        var bytes = Anexos.Tamanho(_proposta.Id, curva.Arquivo);
        if (bytes <= 0) return "arquivo não encontrado";

        return bytes < 1024 * 1024
            ? $"{bytes / 1024d:N0} KB"
            : $"{bytes / (1024d * 1024d):N1} MB";
    }

    /// <summary>Os equipamentos que ainda não têm curva, para o aviso do rodapé.</summary>
    private List<string> SemCurvas => _proposta.Itens
        .Select((item, i) => (item, i))
        .Where(x => x.item.Curvas.Count == 0)
        .Select(x => $"item {(x.i + 1):D2}")
        .ToList();

    // ---------- folha de dados ----------

    private async Task SubirFolha(InputFileChangeEventArgs e)
    {
        _lendo = true;
        _avisos = new();
        _daPlanilha = new();

        try
        {
            await using var fluxo = new MemoryStream();
            await e.File.OpenReadStream(20 * 1024 * 1024).CopyToAsync(fluxo);
            fluxo.Position = 0;

            var resultado = FolhaDeDados.Ler(fluxo, _proposta, _caracteristicas, _equipamentos);

            _avisos = resultado.Avisos;
            _daPlanilha = resultado.Preenchidos;

            _aberto = 0;
            Aviso(resultado.Equipamentos > 0
                ? $"Folha lida: {resultado.Equipamentos} equipamento(s) no escopo."
                : "Folha lida, mas nenhuma coluna da linha 31 tinha quantidade.",
                erro: resultado.Equipamentos == 0);
        }
        catch (Exception ex)
        {
            Aviso($"Não consegui ler a planilha: {ex.Message}", erro: true);
        }
        finally
        {
            _lendo = false;
        }
    }

    // ---------- gravar / abrir ----------

    private void Salvar()
    {
        Repo.Salvar(_proposta);
        Recarregar();
        Aviso($"Proposta {_proposta.Numero} gravada.");
    }

    private void Nova()
    {
        _proposta = Nascer();
        AjustarEscolhasLivres();
        _aberto = 0;
        _apagando = false;
        _apagandoItem = null;
        _daPlanilha = new();
        _avisos = new();
        Aviso("Proposta nova — o número é gerado ao gravar.");
    }

    private void Abrir(string id)
    {
        _apagando = false;
        _apagandoItem = null;

        if (id.Length == 0)
        {
            Nova();
            return;
        }

        var achada = Repo.Achar(id);
        if (achada is null)
        {
            Aviso("Essa proposta não está mais no banco.", erro: true);
            return;
        }

        _proposta = achada;
        AjustarEscolhasLivres();
        _aberto = 0;
        Aviso($"Proposta {achada.Numero} aberta.");
    }

    /// <summary>
    /// Registra que a proposta saiu para o cliente. A data de envio é o que
    /// separa rascunho de histórico — e é por ela que a lista ordena.
    /// </summary>
    private void MarcarEnviada()
    {
        _proposta.EnviadaEm = DateTime.Now.ToString("yyyy-MM-dd");
        Repo.Salvar(_proposta);

        Recarregar();
        Aviso($"Proposta {_proposta.Numero} marcada como enviada em {DataCurta(_proposta.EnviadaEm)}.");
    }

    private void DesmarcarEnviada()
    {
        _proposta.EnviadaEm = "";
        Repo.Salvar(_proposta);

        Recarregar();
        Aviso($"Proposta {_proposta.Numero} voltou para \"em elaboração\".");
    }

    private static string DataCurta(string texto) =>
        DateTime.TryParse(texto, out var data) ? data.ToString("dd/MM/yyyy") : texto;

    private void Apagar()
    {
        var numero = _proposta.Numero;
        Repo.Apagar(_proposta.Id);
        _apagando = false;

        Nova();
        Recarregar();
        Aviso($"Proposta {numero} apagada.");
    }

    private void Aviso(string texto, bool erro = false)
    {
        _msg = texto;
        _erro = erro;
    }
}
