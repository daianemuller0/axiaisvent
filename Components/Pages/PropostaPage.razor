@page "/axiais/proposta"
@page "/axiais/proposta/{Id?}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject PropostaRepository Repo
@inject EquipamentoRepository Equipamentos
@inject CaracteristicaRepository Caracteristicas
@inject PrecoReferenciaRepository Precos
@inject IJSRuntime JS
@inject IWebHostEnvironment Ambiente
@inject NavigationManager Navegacao
@inject MotorRepository Motores
@inject LimiteMotorRepository Limites
@inject CondicaoPagamentoRepository Pagamentos
@inject Anexos Anexos
@{
    // calculadas uma vez por desenho: a barra de etapas, o painel do lado e a
    // etapa Documentos olham as mesmas listas. Os avisos (SoAviso) ficam fora
    // de toda contagem: só o grupo recolhido do painel os mostra
    var todasAsPendencias = Pendencias();
    var pendencias = todasAsPendencias.Where(p => !p.SoAviso).ToList();
    var avisosDoPainel = todasAsPendencias.Where(p => p.SoAviso).ToList();
    var pricingAtual = Pricing();
}
<div class="proposta @(_compacto ? "compacto" : "")">

@* o topo diz QUAL proposta é e em que pé está; as ações que se usam pouco
   (duplicar, marcar como enviada, ajuda, apagar) ficam no menu Mais *@
<div class="page-head prop-head">
    <div class="prop-titulo">
        <div class="prop-titulo-linha">
            <h1>@(_proposta.Id.Length > 0 ? _proposta.Numero : "Proposta nova")</h1>
            @if (_proposta.Id.Length > 0)
            {
                <span class="prop-chip">rev @_proposta.Revisao.Trim()</span>
                @if (_proposta.Enviada)
                {
                    @* o chip desfaz, como antes: um "enviada" marcado por engano volta com um clique *@
                    <button class="prop-chip chip-enviada" @onclick="DesmarcarEnviada"
                            title="Clique para voltar a em elaboração">Enviada em @DiaEMes(_proposta.EnviadaEm)</button>
                }
                else
                {
                    <span class="prop-chip chip-elaboracao">Em elaboração</span>
                }
            }
            else
            {
                <span class="nota">o número é gerado ao salvar</span>
            }
        </div>
        <p class="subtitle prop-sub" title="@ClienteEProjeto">@ClienteEProjeto</p>
    </div>
    <div class="page-actions">
        @if (_apagando && _proposta.Id.Length > 0)
        {
            <AuthorizeView Roles="adm,admin">
                <span class="aviso aviso-alerta" style="margin:0; padding:5px 9px">
                    Apagar a proposta @_proposta.Numero (rev @_proposta.Revisao)?
                </span>
                <button class="btn-link texto-perigo" @onclick="Apagar">Sim, apagar</button>
                <button class="btn-link" @onclick="@(() => _apagando = false)">Cancelar</button>
            </AuthorizeView>
        }
        else
        {
            <button class="btn-ghost" @onclick="@(() => Navegacao.NavigateTo("/axiais/propostas"))">
                <Icone Nome="lista" /> Propostas
            </button>
            <button class="btn-ghost" @onclick="NovaEmBranco">+ Nova</button>
            <div class="menu-dono">
                <button id="botao-mais" class="btn-ghost" aria-haspopup="menu"
                        aria-expanded="@(_menuAberto ? "true" : "false")" aria-controls="menu-mais"
                        @onclick="AlternarMenu">
                    <Icone Nome="mais" /> Mais
                </button>
                @if (_menuAberto)
                {
                    <div class="menu-pop" id="menu-mais" role="menu" aria-label="Mais ações da proposta">
                        @if (_proposta.Id.Length > 0)
                        {
                            <button role="menuitem" tabindex="-1" @onclick="() => DoMenu(Duplicar)"
                                    title="Uma proposta nova a partir desta: cliente, condições e equipamentos copiados">
                                <Icone Nome="copiar" /> Duplicar proposta
                            </button>
                            @if (PodeNovaRevisao)
                            {
                                @* item 21: a revisão nova do mesmo número, que o Salvar grava como outra proposta *@
                                <button role="menuitem" tabindex="-1" class="sem-icone" @onclick="() => DoMenu(NovaRevisao)"
                                        title="A próxima revisão desta proposta: o que mudar daqui em diante vai para ela, e a anterior fica como está">
                                    Nova revisão (rev @ProximaRevisao())
                                </button>
                            }
                            @if (!_proposta.Enviada)
                            {
                                <button role="menuitem" tabindex="-1" @onclick="() => DoMenu(MarcarEnviada)"
                                        title="Registrar no histórico que foi enviada ao cliente">
                                    <Icone Nome="enviar" /> Marcar como enviada
                                </button>
                            }
                        }
                        <button role="menuitem" tabindex="-1" @onclick="() => DoMenu(AlternarAjuda)"
                                title="Mostra ou esconde os textos que explicam cada campo">
                            <Icone Nome="ajuda" /> @(_compacto ? "Mostrar ajuda" : "Esconder ajuda")
                        </button>
                        @if (_proposta.Id.Length > 0)
                        {
                            <AuthorizeView Roles="adm,admin">
                                <div class="menu-sep" role="separator"></div>
                                <button role="menuitem" tabindex="-1" class="perigo"
                                        @onclick="() => DoMenu(() => _apagando = true)">Apagar proposta</button>
                            </AuthorizeView>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (_depoisDeConfirmar is not null)
{
    @* no alto, fixa: a ação pedida espera a resposta *@
    <div class="aviso aviso-alerta guarda-barra" role="alertdialog" aria-label="Alterações não salvas">
        <span>@TextoDaGuarda</span>
        <span style="flex:1"></span>
        <button class="btn-primary" @onclick="GuardaSalvar"><Icone Nome="salvar" /> Salvar</button>
        @if (_proposta.Enviada && PodeNovaRevisao)
        {
            @* enviada: o que mudou pode virar a próxima revisão, sem mexer na que o cliente recebeu (item 21) *@
            <button class="btn-ghost" @onclick="GuardaNovaRevisao"
                    title="Grava o que mudou como a próxima revisão; a enviada fica como o cliente recebeu">Nova revisão (rev @ProximaRevisao())</button>
        }
        <button class="btn-ghost" @onclick="GuardaDescartar">Descartar</button>
        <button class="btn-link" @onclick="FecharGuarda">Cancelar</button>
    </div>
}

@* o selo de cada etapa diz a verdade: o visto só com conteúdo e nada pendente;
   uma etapa ainda não começada fica sem selo *@
<nav class="etapas-barra" aria-label="Etapas da proposta">
    @foreach (var (numero, nome) in Etapas)
    {
        var n = numero;
        var faltam = pendencias.Count(p => p.Etapa == n);
        var selo = SeloDaEtapa(n, faltam, pendencias.Count);
        <button class="etapa-btn @(_etapa == n ? "ativa" : "")" aria-current="@(_etapa == n ? "step" : null)"
                @onclick="() => IrParaEtapa(n)">
            <span class="etapa-num">@n</span>
            <span>@nome</span>
            @if (selo == Selo.Pendente)
            {
                <span class="tab-badge warn" title="@Plural(faltam, "pendência nesta etapa", "pendências nesta etapa")">@faltam</span>
            }
            else if (selo == Selo.Ok)
            {
                <span class="etapa-ok" title="nada pendente"><Icone Nome="ok" /></span>
            }
        </button>
    }
    <span style="flex:1"></span>
    <span class="etapa-cron" title="Tempo de trabalho nesta proposta — pausas de mais de 3 minutos não contam">
        <Icone Nome="relogio" /> @TempoNaTela
    </span>
</nav>

<div class="prop-etapas">
<div class="etapa-corpo">
@if (_etapa == 1)
{
@* importar à esquerda (é o começo mais comum), as recentes à direita e
   "começar em branco" como link sob a área de soltar (item 19) *@
<div class="panel comecar" style="margin-bottom:14px">
    <p class="subtitle ajuda" style="margin:0 0 12px">
        Três jeitos de começar: importando os arquivos da proposta de uma vez, a partir de uma
        proposta gravada (abrir ou copiar), ou em branco, já com os seus padrões.
    </p>
    <div class="comecar-grid">
        <div class="comecar-box comecar-importar">
            <strong>Importar arquivos</strong>
            @* o InputFile fica esticado por cima da área, invisível: clicar ou
               soltar arquivos nela dá no mesmo OnChange, e o "Choose Files" do
               navegador (em inglês) não aparece *@
            <label class="dropzone comecar-soltar">
                <Icone Nome="subir" />
                <strong>Arraste aqui a folha de dados, as seleções e as curvas</strong>
                <span>ou clique para escolher · .xlsx .txt .docx .pdf .png</span>
                <InputFile OnChange="@(e => ImportarArquivos(e))" multiple
                           accept=".xlsx,.xlsm,.txt,.docx,.pdf,.png,.jpg,.jpeg"
                           title="Arraste os arquivos aqui ou clique para escolher" />
            </label>
            <div class="comecar-branco">
                ou <button class="btn-link" @onclick="NovaEContinuar"
                           title="Já com os seus padrões: preparada por, contato Howden, BU, validade e prazo da sua última proposta">começar em branco</button>
                <span class="nota">· já com os seus padrões</span>
            </div>
            @if (_lendo)
            {
                <span class="saved-flag">lendo os arquivos…</span>
            }
            @if (MostraImportados)
            {
                <div class="importados">
                    <div class="importados-titulo">
                        Onde cada arquivo entrou
                        @if (_importados.Any(x => IndiceDoImportado(x) >= 0) && _proposta.Itens.Count > 1)
                        {
                            <span class="nota">· troque o equipamento se precisar</span>
                        }
                    </div>
                    @foreach (var importado in _importados)
                    {
                        var x = importado;
                        var onde = IndiceDoImportado(x);
                        <div class="importado">
                            <span class="mono importado-nome" title="@x.Arquivo">@x.Arquivo</span>
                            <span class="importado-seta" aria-hidden="true">→</span>
                            <span class="importado-destino">
                                @if (onde >= 0)
                                {
                                    <span>@(x.Tipo == TipoDoImportado.Selecao ? "seleção do" : "curva do")</span>
                                    @if (_proposta.Itens.Count > 1)
                                    {
                                        <select class="cell destino-equip" aria-label="@($"Equipamento de {x.Arquivo}")"
                                                @onchange="e => MudarDestino(x, e)">
                                            @for (var i = 0; i < _proposta.Itens.Count; i++)
                                            {
                                                <option value="@i" selected="@(i == onde)">@OpcaoDoDestino(x, i)</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <span>equip. 1</span>
                                    }
                                    @if (x.Tipo == TipoDoImportado.Selecao && x.Curvas.Count > 0)
                                    {
                                        <span class="nota">com @Plural(x.Curvas.Count, "curva", "curvas")</span>
                                    }
                                    @if (x.Substituiu)
                                    {
                                        <span class="nota">no lugar da anterior</span>
                                    }
                                }
                                else
                                {
                                    <span class="@(x.Ignorado ? "texto-alerta" : "")">@x.Destino</span>
                                }
                            </span>
                        </div>
                    }
                </div>
            }
            @if (_daPlanilha.Count > 0)
            {
                <div class="aviso aviso-ok" style="margin:0">
                    <strong>Veio da planilha:</strong> @string.Join(" · ", _daPlanilha)
                </div>
            }

            @* aviso só quando há mesmo o que resolver: o que a folha não traz já está
               escrito no rótulo de cada campo, não precisa de lista a cada importação *@
            @foreach (var aviso in _avisos)
            {
                <div class="aviso aviso-alerta" style="margin:0">@aviso</div>
            }

            <p class="subtitle ajuda" style="margin:0">
                <strong>D4</strong> número da proposta · <strong>D6</strong> cliente ·
                <strong>D13</strong> aos cuidados de · <strong>D14</strong> e-mail ·
                <strong>D15</strong> telefone. Da <strong>linha 31</strong> sai a quantidade de cada
                equipamento — coluna com número é equipamento, coluna com "preencher" não é — e de
                cada coluna saem a <strong>linha 40</strong> (arranjo), a <strong>42</strong>
                (difusor), a <strong>44</strong> (damper mariposa) e a <strong>51</strong>
                (contrarrecuo ou freio). O resto é preenchido aqui na tela.
            </p>
        </div>
        <div class="comecar-box comecar-recentes">
            <strong>Abrir ou copiar uma proposta</strong>
            <input class="cell" placeholder="Buscar por cliente, número ou projeto"
                   value="@_buscaGravadas"
                   @oninput="e => _buscaGravadas = e.Value?.ToString() ?? string.Empty" />
            <div class="lista-gravadas">
                @foreach (var g in GravadasDaBusca())
                {
                    var id = g.Id;
                    @* a linha inteira abre; copiar é o botão do ícone, ao lado *@
                    <div class="linha @(g.Id == _proposta.Id ? "aberta" : "")">
                        <button class="linha-abrir" @onclick="() => AbrirGravada(id)"
                                title="@($"Abrir a {g.Numero} rev {g.Revisao.Trim()}")">
                            <span class="numero">@g.Numero</span>
                            <span class="prop-chip">rev @g.Revisao.Trim()</span>
                            <span class="data">@DataDaRecente(g)</span>
                            <span class="cliente">@(g.Cliente.Length > 0 ? g.Cliente : "sem cliente")@(g.Projeto.Length > 0 ? " · " + g.Projeto : "")</span>
                        </button>
                        <button class="btn-link btn-icone linha-copiar" @onclick="() => DuplicarGravada(id)"
                                title="Copiar como nova: uma proposta nova com o cliente, as condições e os equipamentos desta"
                                aria-label="@($"Copiar a {g.Numero} como nova")"><Icone Nome="copiar" /></button>
                    </div>
                }
                @if (_gravadas.Count == 0)
                {
                    <span class="subtitle" style="margin:0">Nenhuma proposta gravada ainda.</span>
                }
                else if (!GravadasDaBusca().Any())
                {
                    <span class="subtitle" style="margin:0">Nenhuma proposta com esse texto.</span>
                }
            </div>
        </div>
    </div>
</div>

}
@if (_etapa == 2)
{
    @* a etapa em três cartões (item 12): primeiro o que se digita (o cliente e o
       que é desta proposta), depois as condições em resumo, com o que muda o
       preço na frente, e os contatos Howden para ler. O que veio lembrado fica
       em verde até ser editado (ou confirmado, nas condições) *@
    SincronizarCondicoes();
    var projetosDoCliente = ProjetosDoCliente();
<div class="panel cli-cartao">
    <h2 class="cli-titulo">Cliente</h2>
    <div class="form3">
        <label>@Campo("Cliente", "D6 · pricing E3")
            <input id="f-cliente" class="cell" placeholder="Empresa cliente" list="clientes-gravados"
                   value="@_proposta.Cliente"
                   @onchange="e => MudarCliente(e.Value?.ToString() ?? string.Empty)" />
            <datalist id="clientes-gravados">
                @foreach (var c in _clientes)
                {
                    <option value="@c.Nome">@Plural(c.Propostas, "proposta", "propostas")</option>
                }
            </datalist></label>
        <label>@Campo("Aos cuidados de", "D13")
            <input id="f-aos-cuidados" class="@CelulaDoCliente("contato")" title="@TituloDoLembrado("contato")"
                   placeholder="Nome do contato"
                   @bind="_proposta.AosCuidados" @bind:after='() => Editou("contato")' /></label>
        <label>@Campo("E-mail", "D14")
            <input class="@CelulaDoCliente("e-mail")" title="@TituloDoLembrado("e-mail")" placeholder="contato@@empresa.com"
                   @bind="_proposta.Email" @bind:after='() => Editou("e-mail")' /></label>
        <label>@Campo("Telefone", "D15")
            <input class="@CelulaDoCliente("telefone")" title="@TituloDoLembrado("telefone")" placeholder="+55 …"
                   @bind="_proposta.Telefone" @bind:after='() => Editou("telefone")' /></label>
        @* a cidade e a referência do cliente existem por causa da proposta:
           saem no cabeçalho de todas as páginas, como "Ciudad" e "Su referencia" *@
        <label>@Campo("Cidade")
            <input id="f-cidade" class="@CelulaDoCliente("cidade")" title="@TituloDoLembrado("cidade")"
                   placeholder="Cidade do cliente"
                   @bind="_proposta.Cidade" @bind:after='() => Editou("cidade")' /></label>
        @* país e UF numa célula só: no Brasil a UF entra ao lado, sem empurrar
           um campo sozinho para uma linha nova *@
        <div class="cli-pais @(EhBrasil ? "com-uf" : "")">
            <label>@Campo("País")
                <select class="@CelulaDoCliente("país")" title="@TituloDoLembrado("país")"
                        @bind="_proposta.Pais" @bind:after='() => Editou("país")'>
                    @foreach (var x in ListasDaProposta.Paises)
                    {
                        <option value="@x">@x</option>
                    }
                </select>
                @if (!EhBrasil)
                {
                    @* fora do Brasil o estado nem é escolha: o país vai para o J6 do
                       pricing. Um campo travado mostrando "Chile" em "Estado / UF"
                       parecia erro; a nota diz o que acontece *@
                    <span class="nota">pricing J6: @EstadoDoPricing · fora do Brasil, sem ICMS, PIS nem COFINS</span>
                }
            </label>
            @* o estado é a chave do ICMS no pricing (J6), então só vale o que a
               planilha aceita — digitar "São Paulo" não acharia a alíquota *@
            @if (EhBrasil)
            {
                <label class="cli-uf">@Campo("Estado / UF", "pricing J6")
                    <select id="f-uf" class="@CelulaDoCliente("estado")" title="@TituloDoLembrado("estado")"
                            @bind="_proposta.Estado" @bind:after='() => Editou("estado")'>
                        <option value="">—</option>
                        @foreach (var uf in ListasDaProposta.Estados.Where(u => u.Length == 2))
                        {
                            <option value="@uf">@uf</option>
                        }
                    </select>
                </label>
            }
        </div>
    </div>

    @* o que é desta proposta, e não do cliente: o Tab vem do País direto para cá *@
    <div class="cli-desta">
        <div class="cli-desta-titulo">Desta proposta</div>
        <div class="form3">
            <label>@Campo("Referência do cliente")
                <input id="f-referencia" class="cell" placeholder="O número que o cliente deu" @bind="_proposta.ReferenciaCliente" /></label>
            <label>@Campo("Projeto")
                <input id="f-projeto" class="cell" list="projetos-do-cliente"
                       placeholder="@(projetosDoCliente.Count > 0 ? "Digite ou escolha da lista" : "")"
                       @bind="_proposta.Projeto" @bind:after="MudouProjeto" />
                <datalist id="projetos-do-cliente">
                    @foreach (var projeto in projetosDoCliente)
                    {
                        <option value="@projeto"></option>
                    }
                </datalist></label>
            @* a data é guardada como texto (aaaa-mm-dd), que é o formato do próprio
               campo — por isso value/onchange em vez de @@bind com DateTime *@
            <label>@Campo("Data de fechamento")
                <input id="f-fechamento" class="cell" type="date" value="@_proposta.DataFechamento"
                       @onchange="e => _proposta.DataFechamento = e.Value?.ToString() ?? string.Empty" /></label>
        </div>
    </div>

    @if (_sugestaoCliente is { } sugestao)
    {
        var numeroDoCliente = sugestao.Cliente.Ultima.Numero;
        if (sugestao.Aplicada && _ultimosTrazidos == 0 && LembradosDa(numeroDoCliente) == 0)
        {
            <div class="lembranca-cliente cli-lembrou">
                <span>Nada a trazer da @numeroDoCliente: os campos já estão iguais aos dela.</span>
            </div>
        }
        else if (sugestao.Aplicada)
        {
            @* o desfazer mora na linha, e não só no aviso que some *@
            <div class="lembranca-cliente cli-lembrou">
                <span>
                    @(LembradosDa(numeroDoCliente) > 0 ? "Campos em verde vieram da" : "Trazido da")
                    <strong>@numeroDoCliente</strong>
                </span>
                <span class="cli-sep">·</span>
                <button class="btn-link cli-desfazer" @onclick="DesfazerCliente">
                    <Icone Nome="desfazer" /> desfazer
                </button>
            </div>
        }
        else
        {
            <div class="lembranca-cliente cli-oferta">
                <span>@sugestao.Texto</span>
                <button class="btn-ghost" @onclick="AplicarCliente">Usar contato e condições</button>
            </div>
        }
    }
</div>

<div class="panel cond-cartao @(_editandoCondicoes ? "editando" : "")">
    <div class="cond-cabeca">
        <h2>Condições</h2>
        @if (_editandoCondicoes)
        {
            <span class="nota ajuda">o que sai no cabeçalho e nas condições do documento</span>
            <span class="cond-espaco"></span>
            <button class="btn-ghost cond-botao" @onclick="FecharCondicoes">fechar edição</button>
        }
        else
        {
            <span class="nota ajuda">clique num pedaço para editar só ele</span>
            <span class="cond-espaco"></span>
            <button class="btn-ghost cond-botao" @onclick="AbrirCondicoes">editar condições</button>
        }
    </div>

    @if (!_editandoCondicoes)
    {
        var chips = ChipsDasCondicoes();
        var texto = TextoDasCondicoes();
        var verdes = chips.Concat(texto).Where(PedacoLembrado).ToList();

        <div class="cond-resumo">
        @* o que muda preço e impostos vem primeiro, cada um num chip: num
           resumo corrido ele se perderia no meio do resto *@
        <div class="cond-chips" aria-label="O que muda o preço e os impostos">
            @foreach (var chip in chips)
            {
                var pedaco = chip;
                <button class="cond-chip @(PedacoLembrado(pedaco) ? "lembrado" : "") @(pedaco.Falta ? "falta" : "")"
                        title="@(pedaco.Titulo.Length > 0 ? pedaco.Titulo : null)"
                        @onclick="() => IrAoPedaco(pedaco)">
                    <span class="cond-chip-rotulo">@pedaco.Rotulo</span>
                    <span class="cond-chip-valor">@pedaco.Valor</span>
                </button>
            }
        </div>

        @if (verdes.Count > 0)
        {
            <div class="cond-confirmar">
                <span class="cond-confirmar-texto">Em verde: veio @OrigemDosVerdes(verdes). Confira antes de seguir.</span>
                <button class="btn-ghost cond-botao btn-confirmar" @onclick="ConfirmarCondicoes">
                    <Icone Nome="ok" /> confirmar
                </button>
            </div>
        }

        <p class="cond-texto">
            @* o separador vai colado no pedaço de antes: a linha quebra depois
               do "·", e nenhuma linha começa com ele *@
            @for (var i = 0; i < texto.Count; i++)
            {
                var pedaco = texto[i];
                var ultimo = i == texto.Count - 1;
                <span class="cond-item"><button class="cond-pedaco @(PedacoLembrado(pedaco) ? "lembrado" : "") @(pedaco.Falta ? "falta" : "")"
                        title="@(pedaco.Titulo.Length > 0 ? pedaco.Titulo : pedaco.Rotulo)"
