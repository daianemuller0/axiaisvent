@page "/axiais/proposta"
@page "/axiais/proposta/{Id?}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject PropostaRepository Repo
@inject EquipamentoRepository Equipamentos
@inject CaracteristicaRepository Caracteristicas
@inject PrecoReferenciaRepository Precos
@inject IJSRuntime JS
@inject IWebHostEnvironment Ambiente
@inject NavigationManager Navegacao
@inject MotorRepository Motores
@inject LimiteMotorRepository Limites
@inject CondicaoPagamentoRepository Pagamentos
@inject Anexos Anexos

<div class="page-head">
    <div>
        <h1>Proposta</h1>
        <p class="subtitle">
            O cabeçalho do documento, o cliente e o escopo do ventilador. O preço e o código
            de cada item saem do cadastro da guia <strong>Dados</strong> — a proposta guarda a
            escolha, e o valor é lido na hora.
        </p>
    </div>
    <div class="page-actions">
        <button class="btn-ghost" @onclick="@(() => Navegacao.NavigateTo("/axiais/propostas"))">
            ☰ Propostas
        </button>
        <button class="btn-ghost" @onclick="Nova">+ Nova</button>

        @if (_proposta.Id.Length > 0 && !_proposta.Enviada)
        {
            <button class="btn-ghost" @onclick="MarcarEnviada" title="Registrar no histórico que foi enviada ao cliente">
                ✈ Marcar como enviada
            </button>
        }
        else if (_proposta.Enviada)
        {
            <span class="val-count" title="Clique para desfazer" style="cursor:pointer"
                  @onclick="DesmarcarEnviada">enviada em @DataCurta(_proposta.EnviadaEm)</span>
        }

        <button class="btn-primary" @onclick="Salvar">💾 Salvar</button>
    </div>
</div>

@if (_msg is not null)
{
    <div class="@(_erro ? "aviso aviso-erro" : "aviso aviso-ok")" style="margin-bottom:14px">@_msg</div>
}

<!-- ---------- propostas gravadas ---------- -->
<div class="panel" style="margin-bottom:18px">
    <div class="toolbar" style="margin-bottom:0; flex-wrap:wrap">
        <strong>Propostas</strong>
        <select class="cell" style="min-width:320px" value="@_proposta.Id"
                @onchange="e => Abrir(e.Value?.ToString() ?? string.Empty)">
            <option value="">— nova proposta —</option>
            @foreach (var p in _gravadas)
            {
                <option value="@p.Id" selected="@(p.Id == _proposta.Id)">@p.Titulo</option>
            }
        </select>
        <span class="subtitle" style="margin:0">@_gravadas.Count gravada(s)</span>

        @if (_proposta.Id.Length > 0)
        {
            @if (_apagando)
            {
                <span class="aviso aviso-alerta" style="margin:0; padding:5px 9px">
                    Apagar a proposta @_proposta.Numero?
                </span>
                <button class="btn-link" @onclick="Apagar">Sim, apagar</button>
                <button class="btn-link" @onclick="@(() => _apagando = false)">Cancelar</button>
            }
            else
            {
                <button class="btn-link" @onclick="@(() => _apagando = true)">✕ apagar</button>
            }
        }
    </div>
</div>

<!-- ---------- folha de dados ---------- -->
<div class="panel" style="margin-bottom:18px">
    <div class="toolbar" style="margin-bottom:0; flex-wrap:wrap">
        <strong>Folha de dados (Excel)</strong>
        <InputFile OnChange="SubirFolha" accept=".xlsx,.xlsm" class="cell" />
        @if (_lendo)
        {
            <span class="saved-flag">lendo a planilha…</span>
        }
        <span class="subtitle" style="margin:0">
            preenche o que a planilha traz e cria um equipamento por coluna
        </span>
    </div>

    <p class="subtitle" style="margin:10px 0 0">
        <strong>D4</strong> número da proposta · <strong>D6</strong> cliente ·
        <strong>D13</strong> aos cuidados de · <strong>D14</strong> e-mail ·
        <strong>D15</strong> telefone. Da <strong>linha 31</strong> sai a quantidade de cada
        equipamento — coluna com número é equipamento, coluna com "preencher" não é — e de
        cada coluna saem a <strong>linha 40</strong> (arranjo), a <strong>42</strong>
        (difusor), a <strong>44</strong> (damper mariposa) e a <strong>51</strong>
        (contrarrecuo ou freio). O resto é preenchido aqui na tela.
    </p>

    @if (_daPlanilha.Count > 0)
    {
        <div class="aviso aviso-ok" style="margin-top:12px">
            <strong>Veio da planilha:</strong> @string.Join(" · ", _daPlanilha)
        </div>
    }

    @* aviso só quando há mesmo o que resolver: o que a folha não traz já está
       escrito no rótulo de cada campo, não precisa de lista a cada importação *@
    @foreach (var aviso in _avisos)
    {
        <div class="aviso aviso-alerta" style="margin-top:8px">@aviso</div>
    }
</div>

<!-- ---------- cliente ---------- -->
<div class="panel" style="margin-bottom:18px">
    <h2 style="margin:0 0 14px; font-size:15px">Cliente</h2>
    <div class="form3">
        <label>@Campo("Cliente", "D6 · pricing E3")
            <input class="cell" placeholder="Empresa cliente" @bind="_proposta.Cliente" /></label>
        <label>@Campo("Aos cuidados de", "D13")
            <input class="cell" placeholder="Nome do contato" @bind="_proposta.AosCuidados" /></label>
        <label>@Campo("País")
            <select class="cell" @bind="_proposta.Pais">
                @foreach (var x in ListasDaProposta.Paises)
                {
                    <option value="@x">@x</option>
                }
            </select></label>

        <label>@Campo("E-mail", "D14")
            <input class="cell" placeholder="contato@@empresa.com" @bind="_proposta.Email" /></label>
        <label>@Campo("Telefone", "D15")
            <input class="cell" placeholder="+55 …" @bind="_proposta.Telefone" /></label>
        @* a cidade e a referência do cliente existem por causa da proposta:
           saem no cabeçalho de todas as páginas, como "Ciudad" e "Su referencia" *@
        <label>@Campo("Cidade")
            <input class="cell" placeholder="Cidade do cliente" @bind="_proposta.Cidade" /></label>
        <label>@Campo("Referência do cliente")
            <input class="cell" placeholder="O número que o cliente deu" @bind="_proposta.ReferenciaCliente" /></label>

        <label>@Campo("Projeto")
            <input class="cell" @bind="_proposta.Projeto" /></label>

        @* a data é guardada como texto (aaaa-mm-dd), que é o formato do próprio
           campo — por isso value/onchange em vez de @@bind com DateTime *@
        <label>@Campo("Data")
            <input class="cell" type="date" value="@_proposta.Data"
                   @onchange="e => _proposta.Data = e.Value?.ToString() ?? string.Empty" /></label>
        <label>@Campo("Data de fechamento")
            <input class="cell" type="date" value="@_proposta.DataFechamento"
                   @onchange="e => _proposta.DataFechamento = e.Value?.ToString() ?? string.Empty" /></label>
        <label>@Campo("Fase da proposta")
            <select class="cell" @bind="_proposta.Fase">
                @foreach (var x in ListasDaProposta.Fases)
                {
                    <option value="@x">@x</option>
                }
            </select></label>

        <label>@Campo("Preparada por", "pricing E9")
            <input class="cell" @bind="_proposta.PreparadaPor" /></label>
        @* o estado é a chave do ICMS no pricing (J6), então só vale o que a
           planilha aceita — digitar "São Paulo" não acharia a alíquota. Fora do
           Brasil ele nem é escolha: o país já decide *@
        <label>@Campo("Estado / UF", "pricing J6")
            @if (EhBrasil)
            {
                <select class="cell" @bind="_proposta.Estado">
                    <option value="">— escolher —</option>
                    @foreach (var uf in ListasDaProposta.Estados.Where(u => u.Length == 2))
                    {
                        <option value="@uf">@uf</option>
                    }
                </select>
            }
            else
            {
                <input class="cell" disabled value="@EstadoDoPricing" />
                <span class="subtitle">vem do país — sem ICMS, PIS nem COFINS</span>
            }
        </label>
        <label>@Campo("Validade (dias)")
            <input class="cell num" type="number" min="0" @bind="_proposta.ValidadeDias" /></label>

        <label>@Campo("Prazo de entrega (dias)")
            <input class="cell num" type="number" min="0" @bind="_proposta.PrazoEntregaDias" /></label>
    </div>
</div>

<!-- ---------- cabeçalho ---------- -->
<div class="panel" style="margin-bottom:18px">
    <h2 style="margin:0 0 14px; font-size:15px">Cabeçalho</h2>
    <div class="form3">
        <label>@Campo("Ano")
            <input class="cell num" @bind="_proposta.Ano" /></label>
        <label>@Campo("Número da proposta", "D4 · pricing E6")
            <input class="cell" placeholder="@($"Ex.: {Repo.ProximoNumero(_proposta.Ano)} (gera sozinho se vazio)")"
                   @bind="_proposta.Numero" /></label>
        <label>@Campo("Revisão", "pricing E7")
            <input class="cell" @bind="_proposta.Revisao" /></label>

        <label>@Campo("BU (empresa emissora)", "pricing E8")
            <select class="cell" value="@ListasDaProposta.CodigoDaBu(_proposta.Bu)"
                    @onchange="e => _proposta.Bu = e.Value?.ToString() ?? string.Empty">
                @foreach (var (codigo, rotulo) in ListasDaProposta.Bus)
                {
                    <option value="@codigo"
                            selected="@(codigo == ListasDaProposta.CodigoDaBu(_proposta.Bu))">@rotulo</option>
                }
            </select></label>
        <label>@Campo("Idioma da proposta")
            <select class="cell" @bind="_proposta.Idioma">
                @foreach (var x in ListasDaProposta.Idiomas)
                {
                    <option value="@x">@x</option>
                }
            </select></label>
        <label>@Campo("Venda para", "pricing J4")
            <select class="cell" @bind="_proposta.VendaPara">
                @foreach (var x in ListasDaProposta.VendaPara)
                {
                    <option value="@x">@x</option>
                }
            </select></label>

        <label>@Campo("Destino", "pricing J5")
            <select class="cell" @bind="_proposta.Destino">
                @foreach (var x in ListasDaProposta.Destinos)
                {
                    <option value="@x">@x</option>
                }
            </select></label>
        <label>@Campo("País")
            <select class="cell" @bind="_proposta.PaisDestino">
                @foreach (var x in ListasDaProposta.Paises)
                {
                    <option value="@x">@x</option>
                }
            </select></label>
        <label>@Campo("Categoria")
            <select class="cell" @bind="_proposta.Categoria">
                @foreach (var x in ListasDaProposta.Categorias)
                {
                    <option value="@x">@x</option>
                }
            </select></label>

        <label>@Campo("Product")
            <select class="cell" @bind="_proposta.Produto">
                @foreach (var x in ListasDaProposta.Produtos)
                {
                    <option value="@x">@x</option>
                }
            </select></label>
        <label>@Campo("Market Segments")
            <select class="cell" @bind="_proposta.MarketSegment">
                @foreach (var x in ListasDaProposta.Segmentos)
                {
                    <option value="@x">@x</option>
                }
            </select></label>
        <label>@Campo("Portal", "pricing P4")
            <select class="cell" @bind="_proposta.Portal">
                @foreach (var x in ListasDaProposta.Portais)
                {
                    <option value="@x">@x</option>
                }
            </select></label>

        @* o contato do representante não aparece aqui de propósito: ele é
           guardado com a proposta e sai no documento *@
        <label>@Campo("Representante", "pricing P5")
            <select class="cell" value="@_proposta.Representante"
                    @onchange="e => EscolherRepresentante(e.Value?.ToString() ?? string.Empty)">
                <option value="">— escolher —</option>
                @foreach (var grupo in ListasDaProposta.Representantes.GroupBy(r => r.Grupo))
                {
                    <optgroup label="@grupo.Key">
                        @foreach (var r in grupo)
                        {
                            <option value="@r.Nome" selected="@(r.Nome == _proposta.Representante)">@r.Nome</option>
                        }
                    </optgroup>
                }
            </select></label>

        <label>@Campo("Representante 2", "pricing P6")
            <select class="cell" value="@_proposta.Representante2"
                    @onchange="e => EscolherRepresentante2(e.Value?.ToString() ?? string.Empty)">
                <option value="">— nenhum —</option>
                @foreach (var grupo in ListasDaProposta.Representantes.GroupBy(r => r.Grupo))
                {
                    <optgroup label="@grupo.Key">
                        @foreach (var r in grupo)
                        {
                            <option value="@r.Nome" selected="@(r.Nome == _proposta.Representante2)">@r.Nome</option>
                        }
                    </optgroup>
                }
            </select></label>

        <label>@Campo("Fiança / Seguro Garantia", "pricing P3")
            <select class="cell" @bind="_proposta.Fianca">
                <option value="Não">Não</option>
                <option value="Sim">Sim</option>
            </select></label>

        @* o regime do cliente só existe no Brasil; fora dele fica "Sem
           benefício", e a equipe ainda pode trocar se precisar *@
        <label>@Campo("Benefícios", "pricing J9")
            <select class="cell" @bind="_proposta.Beneficio">
                @foreach (var x in ListasDaProposta.Beneficios)
                {
                    <option value="@x">@x</option>
                }
            </select>
            @if (!EhBrasil)
            {
                <span class="subtitle">país fora do Brasil — o padrão é "Sem benefício"</span>
            }
        </label>
    </div>

    @* entrega e pagamento saem inteiros na proposta comercial: o pagamento na
       sua seção, o incoterm com a descrição do lugar e, logo abaixo dele, a
       frase de armado ou desarmado *@
    <div style="margin-top:18px; padding-top:16px; border-top:1px solid var(--linha, #e6e8ec)">
        <h3 style="margin:0 0 12px; font-size:13.5px; letter-spacing:.02em">Entrega e pagamento</h3>

        <div class="form3">
            <label>@Campo("Condição de pagamento")
                <select class="cell" value="@(_pagamentoLivre ? OutroPagamento : _proposta.CondicaoPagamento)"
                        @onchange="e => EscolherPagamento(e.Value?.ToString() ?? string.Empty)">
                    <option value="">— escolher —</option>
                    @foreach (var c in _condicoes)
                    {
                        <option value="@c.Texto" selected="@(!_pagamentoLivre && c.Texto == _proposta.CondicaoPagamento)">
                            @c.Texto
                        </option>
                    }
                    <option value="@OutroPagamento" selected="@_pagamentoLivre">— outra (digitar) —</option>
                </select></label>

            <label>@Campo("Entrega (Incoterm 2020)")
                <select class="cell" value="@(_incotermLivre ? OutroIncoterm : _proposta.Incoterm)"
                        @onchange="e => EscolherIncoterm(e.Value?.ToString() ?? string.Empty)">
                    <option value="">— escolher —</option>
                    @foreach (var i in ListasDaProposta.Incoterms)
                    {
                        <option value="@i.Codigo" selected="@(!_incotermLivre && i.Codigo == _proposta.Incoterm)">
                            @i.Codigo
                        </option>
                    }
                    <option value="@OutroIncoterm" selected="@_incotermLivre">— outro (digitar) —</option>
                </select></label>

            <label>@Campo("Entrega do equipamento")
                <select class="cell" @bind="_proposta.Armado">
                    <option value="">— escolher —</option>
                    @foreach (var (codigo, _) in ListasDaProposta.Armados)
                    {
                        <option value="@codigo">@codigo</option>
                    }
                </select></label>
        </div>

        @if (_pagamentoLivre)
        {
            <label style="display:block; margin-top:12px">@Campo("Condição de pagamento (texto livre)")
                <textarea class="cell" rows="2" style="width:100%"
                          @bind="_proposta.CondicaoPagamento"></textarea></label>
        }

        @if (_incotermLivre)
        {
            <label style="display:block; margin-top:12px">@Campo("Entrega (texto livre)")
                <input class="cell" style="width:100%" @bind="_proposta.Incoterm" /></label>
        }
        else if (PedeDestino)
        {
            @* CIF, DAP e DDP não dizem onde: o modelo deixa "Puerto de DESTINO
               (PAÍS DE DESTINO)" para alguém preencher. O rótulo diz o que
               falta — só o lugar, porque o "Puerto de" já está na frase *@
            <label style="display:block; margin-top:12px">@Campo(RotuloDoDestino)
                <input class="cell" style="width:100%"
                       placeholder="@ExemploDoDestino" @bind="_proposta.IncotermDestino" /></label>
        }

        @if (_proposta.Incoterm.Length > 0 || _proposta.Armado.Length > 0)
        {
            <div class="panel" style="margin:12px 0 0; padding:12px; background:var(--fundo2, #f7f8fa)">
                <div class="subtitle" style="margin-bottom:6px">Como vai sair na proposta</div>
                @if (_proposta.Incoterm.Length > 0)
                {
                    <div style="font-size:12.5px">@ListasDaProposta.LinhaDoIncoterm(_proposta.Incoterm, _proposta.IncotermDestino)</div>
                }
                @if (ListasDaProposta.TextoDoArmado(_proposta.Armado) is { Length: > 0 } armado)
                {
                    <div style="font-size:12.5px; margin-top:6px">• @armado</div>
                }
            </div>
        }

        @* o cadastro de condições fica aqui, e não numa tela à parte, porque é
           aqui que a equipe descobre que falta uma *@
        <div style="margin-top:12px">
            <button class="btn-ghost" @onclick="() => _cadastrandoPagamento = !_cadastrandoPagamento">
                @(_cadastrandoPagamento ? "Fechar cadastro" : "Cadastrar condições de pagamento")
            </button>
        </div>

        @if (_cadastrandoPagamento)
        {
            <div class="panel" style="margin:12px 0 0; padding:14px">
                @foreach (var c in _condicoes)
                {
                    <div class="toolbar" style="margin-bottom:8px">
                        <input class="cell" style="flex:1" value="@c.Texto"
                               @onchange="e => RenomearCondicao(c, e.Value?.ToString() ?? string.Empty)" />
                        <button class="btn-ghost" title="Apagar"
                                @onclick="() => ApagarCondicao(c)">✕</button>
                    </div>
                }
                <div class="toolbar">
                    <input class="cell" style="flex:1" placeholder="Nova condição de pagamento"
                           @bind="_novaCondicao" @bind:event="oninput" />
                    <button class="btn" @onclick="AdicionarCondicao">+ linha</button>
                </div>
            </div>
        }
    </div>

    @if (_proposta.Representante.Length > 0 || _proposta.Representante2.Length > 0)
    {
        <p class="subtitle" style="margin:10px 0 0">
            Contato dos representantes guardado com a proposta (não aparece aqui, sai no
            documento). Comissão no pricing:
            <strong>@Pct(CalculoPricing.Comissoes(_proposta.Representante, _proposta.Representante2))</strong>
            — já com PPR, ELG e provisões.
        </p>
    }
</div>

<!-- ---------- contatos no documento ---------- -->
<div class="panel" style="margin-bottom:18px">
    <h2 style="margin:0 0 4px; font-size:15px">Contatos Howden (no documento)</h2>
    <p class="subtitle" style="margin:0 0 14px">
        Até dois, do quadro da proposta. @ListasDaProposta.DiretorDeVendas.Nome
        (@ListasDaProposta.DiretorDeVendas.Cargo) sai sempre, junto com o contato
        do representante — nenhum dos dois precisa ser escolhido aqui.
    </p>

    @Contato("Contato 1", _proposta.ContatoNome, n => EscolherContato(n, 1))
    <div class="form3">
        <label>@Campo("Nome")<input class="cell" @bind="_proposta.ContatoNome" /></label>
        <label>@Campo("Cargo")<input class="cell" @bind="_proposta.ContatoCargo" /></label>
        <label>@Campo("Área")<input class="cell" @bind="_proposta.ContatoArea" /></label>
        <label>@Campo("E-mail")<input class="cell" @bind="_proposta.ContatoEmail" /></label>
        <label>@Campo("Telefones")<input class="cell" @bind="_proposta.ContatoTelefones" /></label>
    </div>

    <div style="margin-top:18px; padding-top:16px; border-top:1px solid var(--linha, #e6e8ec)">
        @Contato("Contato 2 (opcional)", _proposta.Contato2Nome, n => EscolherContato(n, 2))
        <div class="form3">
            <label>@Campo("Nome")<input class="cell" @bind="_proposta.Contato2Nome" /></label>
            <label>@Campo("Cargo")<input class="cell" @bind="_proposta.Contato2Cargo" /></label>
            <label>@Campo("Área")<input class="cell" @bind="_proposta.Contato2Area" /></label>
            <label>@Campo("E-mail")<input class="cell" @bind="_proposta.Contato2Email" /></label>
            <label>@Campo("Telefones")<input class="cell" @bind="_proposta.Contato2Telefones" /></label>
        </div>
    </div>
</div>

<!-- ---------- escopo do ventilador ---------- -->
<div class="panel" style="margin-bottom:18px">
    <div class="toolbar" style="flex-wrap:wrap">
        <h2 style="margin:0; font-size:15px">Escopo do ventilador</h2>
        <span style="flex:1"></span>
        <strong>Moeda</strong>
        @foreach (var m in Moedas.Todas)
        {
            var moeda = m;
            <button class="@(_proposta.Moeda == moeda ? "btn-primary" : "btn-ghost")"
                    @onclick="() => _proposta.MoedaCodigo = moeda.Codigo()">@moeda.Rotulo()</button>
        }
        <span class="subtitle" style="margin:0">manda em todos os preços</span>
    </div>

    <p class="subtitle" style="margin:12px 0 0">
        O preço de cada linha vem do cadastro e <strong>dá para trocar na própria linha</strong>:
        serve para o que ainda não tem preço cadastrado e para quando a proposta pede um valor
        diferente. O que você digita vale <strong>só nesta proposta</strong> — o cadastro não
        muda — e o <strong>↺</strong> ao lado volta ao preço do cadastro.
    </p>

    <div class="tabs">
        @for (var i = 0; i < _proposta.Itens.Count; i++)
        {
            var indice = i;
            var item = _proposta.Itens[indice];
            <button class="tab @(_aberto == indice ? "active" : "")" @onclick="() => _aberto = indice">
                Equipamento @(indice + 1)
                <span class="tab-badge">@item.Quantos</span>
                @if (item.Coluna.Length > 0)
                {
                    <span class="subtitle" style="margin-left:6px">col. @item.Coluna</span>
                }
            </button>
        }
        <button class="tab" @onclick="Acrescentar">+ equipamento</button>
    </div>

    @if (_proposta.Itens.Count == 0)
    {
        <div class="panel empty" style="padding:18px">
            Nenhum equipamento ainda. Suba a folha de dados — cada coluna com número na linha
            31 vira um equipamento — ou clique em <strong>+ equipamento</strong>.
        </div>
    }
    else
    {
        var atual = _proposta.Itens[PosicaoValida];
        var modelo = ModeloDe(atual);

        <div class="toolbar" style="flex-wrap:wrap">
            <label style="display:flex; align-items:center; gap:6px">
                <strong>Quantidade</strong>
                <input class="cell num" style="width:90px" type="number" min="1"
                       value="@atual.Quantidade"
                       @onchange="e => atual.Quantidade = e.Value?.ToString() ?? string.Empty" />
            </label>

            <strong style="margin-left:10px">Modelo</strong>
            <select class="cell" style="min-width:380px" value="@atual.EquipamentoId"
                    @onchange="e => TrocarModelo(atual, e.Value?.ToString() ?? string.Empty)">
                <option value="">— escolher o equipamento —</option>
                @foreach (var serie in _equipamentos.GroupBy(x => x.Serie))
                {
                    <optgroup label="@RotuloDaSerie(serie.Key, serie)">
                        @foreach (var eq in serie)
                        {
                            <option value="@eq.Id" selected="@(eq.Id == atual.EquipamentoId)">@RotuloDoModelo(eq)</option>
                        }
                    </optgroup>
                }
            </select>

            @if (ModeloDe(atual) is { } escolhidoAgora && PrecoDoEquipamento(escolhidoAgora) is null
                 && !EhManual(atual, "equipamento"))
            {
                <span class="subtitle" style="margin:0; color:#c98a00">
                    este modelo não tem preço em @_proposta.Moeda.Rotulo() — ponha à mão abaixo
                </span>
            }
            else
            {
                <span class="subtitle" style="margin:0">preencher manual</span>
            }

            <span style="flex:1"></span>
            @if (_apagandoItem == PosicaoValida)
            {
                <span class="aviso aviso-alerta" style="margin:0; padding:5px 9px">
                    Tirar o equipamento @(PosicaoValida + 1) da proposta?
                </span>
                <button class="btn-link" @onclick="Remover">Sim, tirar</button>
                <button class="btn-link" @onclick="@(() => _apagandoItem = null)">Cancelar</button>
            }
            else
            {
                <button class="btn-link" @onclick="@(() => _apagandoItem = PosicaoValida)">✕ tirar</button>
            }
        </div>

        <div class="toolbar" style="flex-wrap:wrap">
            <strong style="min-width:210px">@Campo("Arranjo / Instalação", "linha 40")</strong>
            @foreach (var a in ListasDaProposta.Arranjos)
            {
                var arranjo = a;
                <button class="@(atual.Arranjo == arranjo ? "btn-primary" : "btn-ghost")"
                        @onclick="() => atual.Arranjo = arranjo">@arranjo</button>
            }

            @* a montagem se junta ao arranjo na proposta técnica:
               "Horizontal ao piso, arranjo 4" *@
            <strong style="margin-left:14px">@Campo("Montagem")</strong>
            @foreach (var m in new[] { "Horizontal", "Vertical" })
            {
                var montagem = m;
                <button class="@(Textos.Igual(atual.Montagem, montagem) ? "btn-primary" : "btn-ghost")"
                        @onclick="() => atual.Montagem = montagem">@montagem</button>
            }

            @if (DadosDoVentilador.Montagem(atual) is { Length: > 0 } linhaDaMontagem)
            {
                <span class="val-count">@linhaDaMontagem</span>
            }
        </div>

        <div class="toolbar" style="flex-wrap:wrap">
            <strong style="min-width:210px">@Campo("Aplicação")</strong>
            <input class="cell" style="flex:1; max-width:520px"
                   placeholder="onde o ventilador vai trabalhar"
                   value="@atual.Aplicacao"
                   @onchange="e => atual.Aplicacao = e.Value?.ToString() ?? string.Empty" />
        </div>

        @if (modelo is not null)
        {
            <div class="panel" style="padding:0; overflow-x:auto; margin-bottom:14px">
                <table class="grid">
                    <thead>
                        <tr>
                            <th class="nowrap">Série</th>
                            <th class="nowrap">Fan Diameter</th>
                            <th class="nowrap">Fan Hub Diameter</th>
                            <th class="nowrap">FB/HB</th>
                            <th class="nowrap">Nº de estágios</th>
                            <th class="nowrap">Código</th>
                            <th class="nowrap right">Preço @_proposta.Moeda.Rotulo()</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="nowrap"><span class="val-count">@modelo.Serie</span></td>
                            <td class="nowrap"><strong>@modelo.Diametro</strong></td>
                            <td class="nowrap"><strong>@modelo.Cubo</strong></td>
                            <td class="nowrap">@(modelo.FbHb.Length > 0 ? modelo.FbHb : "—")</td>
                            <td class="nowrap">@(modelo.Estagios.Length > 0 ? modelo.Estagios : "—")</td>
                            <td class="nowrap">@(modelo.Codigo.Length > 0 ? modelo.Codigo : "—")</td>
                            <td class="right">@Preco(atual, "equipamento", PrecoDoModelo(atual))</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="panel empty" style="padding:16px; margin-bottom:14px">
                Escolha o modelo: é ele que diz o Fan Diameter, e é pelo Fan Diameter que os
                preços de base, cone, silenciador, difusor, conexão a manga e damper são
                puxados.
            </div>
        }

        @foreach (var lista in _listas)
        {
            var grupo = lista;
            var opcoes = _porGrupo.GetValueOrDefault(grupo, new());
            if (opcoes.Count == 0) { continue; }

            var comOpcoes = opcoes.Where(o => !FamiliaDePreco.EhAusencia(o.Valor)).ToList();
            var escolhida = atual.Escolhas.GetValueOrDefault(grupo, "");
            var temItem = escolhida.Length > 0 && !FamiliaDePreco.EhAusencia(escolhida);

            <div class="toolbar" style="flex-wrap:wrap; border-top:1px solid var(--border); padding-top:12px">
                <strong style="min-width:210px">@Campo(grupo, LinhaDaPlanilha(grupo))</strong>

                <button class="@(escolhida.Length > 0 && !temItem ? "btn-primary" : "btn-ghost")"
                        @onclick="() => MarcarSem(atual, grupo)">Sem</button>
                <button class="@(temItem ? "btn-primary" : "btn-ghost")"
                        @onclick="() => MarcarCom(atual, grupo)">Com</button>

                @if (temItem && comOpcoes.Count > 1)
                {
                    <select class="cell" style="min-width:250px" value="@escolhida"
                            @onchange="e => atual.Escolhas[grupo] = e.Value?.ToString() ?? string.Empty">
                        @foreach (var o in comOpcoes)
                        {
                            <option value="@o.Valor" selected="@(o.Valor == escolhida)">@o.Valor</option>
                        }
                    </select>
                }
                else if (temItem)
                {
                    <span class="val-count">@escolhida</span>
                }

                @if (escolhida.Length > 0)
                {
                    var linha = Resolver(atual, grupo, escolhida);
                    @PrecoNaLista(atual, $"lista:{grupo}", linha.Codigo, linha.Valor, linha.Origem)
                }
            </div>
        }

        <!-- ---------- parte elétrica: motor, partidor e instrumentação ---------- -->
        <div class="toolbar" style="flex-wrap:wrap; border-top:2px solid var(--border); padding-top:14px; margin-top:14px">
            <h3 style="margin:0; font-size:14px">Parte Elétrica</h3>
            <span class="subtitle" style="margin:0">
                o motor elétrico, o partidor e a instrumentação — cada um com o seu flag
            </span>
        </div>

        <div class="toolbar" style="flex-wrap:wrap">
            <strong style="min-width:210px">@Campo("Motor elétrico")</strong>
            <button class="@(atual.ComMotor ? "btn-ghost" : "btn-primary")"
                    @onclick="() => atual.ComMotor = false">Sem</button>
            <button class="@(atual.ComMotor ? "btn-primary" : "btn-ghost")"
                    @onclick="() => atual.ComMotor = true">Com</button>

            <span class="subtitle" style="margin:0">
                o catálogo de motores, já filtrado pela série
                @(modelo is null ? "do modelo" : $"\"{modelo.Serie}\"") — motor marcado como
                "as duas" serve às duas linhas
            </span>
        </div>

        @if (atual.ComMotor)
        {
            var candidatos = Candidatos(atual);

            <div class="panel" style="margin:0 0 14px; border-left:3px solid var(--azul, #0b3d6b)">
                <div class="form3">
                    @foreach (var campo in EscopoProposta.CamposDoMotor)
                    {
                        var rotulo = campo.Rotulo;
                        var opcoes = OpcoesDoCampo(atual, campo);

                        <label>
                            @rotulo
                            <select class="cell" value="@atual.FiltroMotor.GetValueOrDefault(rotulo, "")"
                                    @onchange="e => FiltrarMotor(atual, rotulo, e.Value?.ToString() ?? string.Empty)">
                                <option value="">— todos (@opcoes.Count) —</option>
                                @foreach (var o in opcoes)
                                {
                                    <option value="@o" selected="@(o == atual.FiltroMotor.GetValueOrDefault(rotulo, ""))">@o</option>
                                }
                            </select>
                        </label>
                    }
                </div>

                <div class="toolbar" style="margin:14px 0 0; flex-wrap:wrap">
                    <span class="val-count">@candidatos.Count motor(es) atendem</span>
                    <span class="subtitle" style="margin:0">
                        @MotoresComPreco(candidatos) com preço em @_proposta.Moeda.Rotulo()
                    </span>
                    <button class="btn-link" @onclick="() => LimparFiltro(atual)">limpar filtro</button>
                    <span style="flex:1"></span>

                    <div style="display:flex; align-items:center; gap:8px; flex:0 1 auto; min-width:0">
                        @if (MotorDe(atual) is { } motor)
                        {
                            <strong>@(motor.Codigo.Length > 0 ? $"código {motor.Codigo}" : "sem código")</strong>

                            @if (PrecoDoMotor(motor) is null && !EhManual(atual, "motor"))
                            {
                                <span class="subtitle" style="margin:0; color:#c98a00; white-space:nowrap">
                                    este motor não tem preço em @_proposta.Moeda.Rotulo() — ponha à mão ao lado
                                </span>
                            }
                            else
                            {
                                <span class="subtitle" style="margin:0; white-space:nowrap">
                                    @(EhManual(atual, "motor") ? "preço à mão" : "catálogo de motores")
                                </span>
                            }
                        }
                        else
                        {
                            <span class="subtitle" title="aperte o filtro até sobrar um motor — aí vêm o código e a observação"
                                  style="margin:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis">
                                sem motor ainda — o preço dá para pôr à mão
                            </span>
                        }

                        @Preco(atual, "motor", PrecoDoMotor(atual))
                    </div>
                </div>

                @if (MotorDe(atual) is { } escolhido && escolhido.Observacoes.Length > 0)
                {
                    <p class="subtitle" style="margin:10px 0 0">
                        <strong>Observação:</strong> @escolhido.Observacoes
                    </p>
                }

                @if (AvisoDoMotor(atual) is { } aviso)
                {
                    <div class="aviso aviso-alerta" style="margin-top:10px">@aviso</div>
                }
            </div>
        }

        <!-- partidor: o preço vem da potência do motor -->
        <div class="toolbar" style="flex-wrap:wrap">
            <strong style="min-width:210px">@ListaDosPartidores</strong>
            <button class="@(atual.ComPartidor ? "btn-ghost" : "btn-primary")"
                    @onclick="() => atual.ComPartidor = false">Sem</button>
            <button class="@(atual.ComPartidor ? "btn-primary" : "btn-ghost")"
                    @onclick="() => LigarPartidor(atual)">Com</button>

            @if (atual.ComPartidor)
            {
                <select class="cell" style="min-width:260px" value="@atual.Partidor"
                        @onchange="e => atual.Partidor = e.Value?.ToString() ?? string.Empty">
                    <option value="">— escolher —</option>
                    @foreach (var o in OpcoesReais(ListaDosPartidores))
                    {
                        <option value="@o.Valor" selected="@(o.Valor == atual.Partidor)">@o.Valor</option>
                    }
                </select>

                @if (LinhaDoPartidor(atual) is { } linha)
                {
                    @PrecoNaLista(atual, "partidor", linha.Codigo, linha.Valor, linha.Origem)
                }
            }
        </div>

        <!-- instrumentação: pode ser mais de uma -->
        <div class="toolbar" style="flex-wrap:wrap">
            <strong style="min-width:210px">@ListaDaInstrumentacao</strong>
            <button class="@(atual.ComInstrumentacao ? "btn-ghost" : "btn-primary")"
                    @onclick="() => DesligarInstrumentacao(atual)">Sem</button>
            <button class="@(atual.ComInstrumentacao ? "btn-primary" : "btn-ghost")"
                    @onclick="() => atual.ComInstrumentacao = true">Com</button>
            @if (atual.ComInstrumentacao)
            {
                <span class="subtitle" style="margin:0">
                    pode marcar mais de uma — cada uma entra com o seu código e o seu preço
                </span>
            }
        </div>

        @if (atual.ComInstrumentacao)
        {
            <div class="panel" style="margin:0 0 14px; border-left:3px solid var(--azul, #0b3d6b)">
                @foreach (var o in OpcoesReais(ListaDaInstrumentacao))
                {
                    var opcao = o;
                    var marcada = atual.Instrumentacao.Contains(opcao.Valor);
                    var linha = Resolver(atual, opcao.Grupo, opcao.Valor);

                    <div class="toolbar" style="flex-wrap:wrap; margin-bottom:6px">
                        <label style="display:flex; align-items:center; gap:8px; min-width:380px">
                            <input type="checkbox" checked="@marcada"
                                   @onchange="e => MarcarInstrumentacao(atual, opcao.Valor, (bool)(e.Value ?? false))" />
                            <span>@opcao.Valor</span>
                        </label>
                        @if (marcada)
                        {
                            @PrecoNaLista(atual, $"instr:{opcao.Valor}", linha.Codigo, linha.Valor,
                                linha.Origem)
                        }
                        else
                        {
                            <span class="subtitle" style="margin:0">
                                @(linha.Codigo.Length > 0 ? $"código {linha.Codigo}" : "sem código")
                                ·
                                @(linha.Valor is null ? linha.Origem : Dinheiro(linha.Valor))
                            </span>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

<!-- ---------- resumo ---------- -->
<div class="panel" style="margin-bottom:18px">
    <h2 style="margin:0 0 14px; font-size:15px">Resumo da proposta</h2>

    @foreach (var (item, indice) in _proposta.Itens.Select((x, i) => (x, i)))
    {
        var doItem = item;
        var modelo = ModeloDe(doItem);
        var itens = Itens(doItem);

        <div class="toolbar" style="flex-wrap:wrap; margin-top:@(indice == 0 ? "0" : "18px")">
            <strong>Equipamento @(indice + 1)</strong>
            <span class="val-count">@doItem.Quantos ×</span>
            <span>@(modelo is null ? "sem modelo escolhido" : modelo.Rotulo)</span>
            <span style="flex:1"></span>
            <strong>Código:</strong>
            <span class="val-count">@(CodigoDe(doItem).Length > 0 ? CodigoDe(doItem) : "—")</span>
        </div>

        <div class="panel" style="padding:0; overflow-x:auto">
            <table class="grid">
                <thead>
                    <tr>
                        <th class="nowrap">Item</th>
                        <th class="nowrap">Escolha</th>
                        <th class="nowrap">Código</th>
                        <th class="nowrap">De onde vem o preço</th>
                        <th class="nowrap right" style="width:210px">Unitário @_proposta.Moeda.Rotulo()</th>
                    </tr>
                </thead>
                <tbody>
                    @if (modelo is not null)
                    {
                        <tr>
                            <td class="nowrap"><strong>Equipamento</strong></td>
                            <td class="nowrap">@modelo.Rotulo</td>
                            <td class="nowrap">@(modelo.Codigo.Length > 0 ? modelo.Codigo : "—")</td>
                            <td class="nowrap"><span class="subtitle">lista cruzada de equipamentos</span></td>
                            <td>@Preco(doItem, "equipamento", PrecoDoModelo(doItem))</td>
                        </tr>
                    }
                    @foreach (var linha in itens)
                    {
                        <tr>
                            <td class="nowrap">@linha.Lista</td>
                            <td class="nowrap">@linha.Opcao</td>
                            <td class="nowrap">@(linha.Codigo.Length > 0 ? linha.Codigo : "—")</td>
                            <td class="nowrap"><span class="subtitle">@linha.Origem</span></td>
                            <td>@Preco(doItem, $"lista:{linha.Lista}", linha.Valor)</td>
                        </tr>
                    }
                    @if (doItem.ComMotor)
                    {
                        var motor = MotorDe(doItem);
                        <tr>
                            <td class="nowrap"><strong>Motor elétrico</strong></td>
                            <td class="nowrap">@(motor is null ? "motor ainda não definido" : motor.Descricao)</td>
                            <td class="nowrap">@(motor is null || motor.Codigo.Length == 0 ? "—" : motor.Codigo)</td>
                            <td class="nowrap">
                                <span class="subtitle">
                                    @(motor is null
                                        ? "aperte o filtro até sobrar um motor"
                                        : motor.Observacoes.Length > 0 ? motor.Observacoes : "catálogo de motores")
                                </span>
                            </td>
                            <td>@Preco(doItem, "motor", PrecoDoMotor(doItem))</td>
                        </tr>
                    }
                    @if (doItem.ComPartidor && LinhaDoPartidor(doItem) is { } partidor)
                    {
                        <tr>
                            <td class="nowrap">@ListaDosPartidores</td>
                            <td class="nowrap">@(doItem.Partidor.Length > 0 ? doItem.Partidor : "não escolhido")</td>
                            <td class="nowrap">@(partidor.Codigo.Length > 0 ? partidor.Codigo : "—")</td>
                            <td class="nowrap"><span class="subtitle">@partidor.Origem</span></td>
                            <td>@Preco(doItem, "partidor", partidor.Valor)</td>
                        </tr>
                    }
                    @foreach (var nome in doItem.ComInstrumentacao ? doItem.Instrumentacao : new List<string>())
                    {
                        var linha = Resolver(doItem, ListaDaInstrumentacao, nome);
                        <tr>
                            <td class="nowrap">@ListaDaInstrumentacao</td>
                            <td class="nowrap">@nome</td>
                            <td class="nowrap">@(linha.Codigo.Length > 0 ? linha.Codigo : "—")</td>
                            <td class="nowrap"><span class="subtitle">@linha.Origem</span></td>
                            <td>@Preco(doItem, $"instr:{nome}", linha.Valor)</td>
                        </tr>
                    }
                    <tr>
                        <td colspan="4" class="right">
                            <strong>Unitário</strong> × @doItem.Quantos
                        </td>
                        <td class="nowrap right"><strong>@Dinheiro(SubtotalDe(doItem))</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>
    }

    <div class="toolbar" style="margin:16px 0 0">
        <span style="flex:1"></span>
        <strong style="font-size:15px">Custo total</strong>
        <span class="val-count" style="font-size:15px">@Dinheiro(Total)</span>
        <span class="subtitle" style="margin:0">vai para a célula E33 do pricing</span>
    </div>

    @if (FaltaPreco > 0)
    {
        <p class="subtitle" style="margin:10px 0 0">
            @FaltaPreco item(ns) escolhido(s) ainda sem preço — nem do cadastro, nem à mão. O
            custo conta só o que já tem valor; para os outros, digite o preço na própria linha
            do escopo.
        </p>
    }
</div>

<!-- ---------- pricing ---------- -->
<div class="panel" style="margin-bottom:18px">
    @{
        var pricing = Pricing();
        var mudouRisco = Math.Abs(Risco - CalculoPricing.RiscoAdicionalPadrao) > 0.00001m;
        var mudouNegoc = Math.Abs(Negociacao - CalculoPricing.MargemNegociacaoPadrao) > 0.00001m;
        var mudouMargem = Math.Abs(pricing.Margem - CalculoPricing.MargemAlvoPadrao) > 0.0005m;
    }

    <div class="toolbar" style="flex-wrap:wrap">
        <h2 style="margin:0; font-size:15px">Pricing</h2>
        <span class="subtitle" style="margin:0">
            margem, comissões e impostos — a mesma conta da aba PRICING da planilha
        </span>
        <span style="flex:1"></span>
        <button class="btn-primary" @onclick="GerarPricing">⬇ Gerar pricing</button>
    </div>

    <div class="form3">
        <label>@Campo("Risco adicional (%)", "pricing D36")
            <input class="cell num" value="@_proposta.RiscoAdicional"
                   @onchange="e => _proposta.RiscoAdicional = e.Value?.ToString() ?? string.Empty" />
            @if (mudouRisco)
            {
                <span class="aviso-vermelho">Solicitar aprovação de Pricing</span>
            }
        </label>

        <label>@Campo("Margem de negociação (%)", "pricing D46")
            <input class="cell num" value="@_proposta.MargemNegociacao"
                   @onchange="e => _proposta.MargemNegociacao = e.Value?.ToString() ?? string.Empty" />
            @if (mudouNegoc)
            {
                <span class="aviso-vermelho">Solicitar aprovação de Pricing</span>
            }
        </label>

        <label>Calcular preço
            <div style="display:flex; gap:6px">
                <button class="@(PelaMargem ? "btn-primary" : "btn-ghost")"
                        @onclick="@(() => _proposta.ModoDoPreco = "margem")">pela margem</button>
                <button class="@(PelaMargem ? "btn-ghost" : "btn-primary")"
                        @onclick="@(() => _proposta.ModoDoPreco = "preco")">pelo preço</button>
            </div>
        </label>

        @if (PelaMargem)
        {
            <label>Margem pedida (%)
                <input class="cell num" value="@_proposta.MargemAlvo"
                       @onchange="e => _proposta.MargemAlvo = e.Value?.ToString() ?? string.Empty" />
            </label>
        }
        else
        {
            <label>Preço-meta (@_proposta.Moeda.Rotulo())
                <input class="cell num" placeholder="quanto o cliente aceita"
                       value="@_proposta.PrecoMeta"
                       @onchange="e => _proposta.PrecoMeta = e.Value?.ToString() ?? string.Empty" />
            </label>
        }
    </div>

    @if (mudouMargem)
    {
        <div class="aviso aviso-erro" style="margin-top:12px">
            <strong>Solicitar aprovação de Pricing</strong> — a margem ficou em
            @Pct(pricing.Margem), e o padrão é @Pct(CalculoPricing.MargemAlvoPadrao).
        </div>
    }

    @foreach (var aviso in pricing.Avisos)
    {
        <div class="aviso aviso-alerta" style="margin-top:8px">@aviso</div>
    }

    <div class="panel" style="padding:0; overflow-x:auto; margin-top:14px">
        <table class="grid">
            <thead>
                <tr>
                    <th class="nowrap">Linha do pricing</th>
                    <th class="nowrap">Célula</th>
                    <th class="nowrap right">Valor</th>
                    <th class="nowrap right">%</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="nowrap"><strong>Custo total</strong></td>
                    <td class="nowrap"><span class="subtitle">E33</span></td>
                    <td class="nowrap right">@Dinheiro(pricing.CustoTotal)</td>
                    <td class="nowrap right">—</td>
                </tr>
                <tr>
                    <td class="nowrap">Risco adicional</td>
                    <td class="nowrap"><span class="subtitle">D36 · E36</span></td>
                    <td class="nowrap right">@Dinheiro(pricing.Risco)</td>
                    <td class="nowrap right">@Pct(Risco)</td>
                </tr>
                <tr>
                    <td class="nowrap"><strong>Custo com riscos</strong></td>
                    <td class="nowrap"><span class="subtitle">E38</span></td>
                    <td class="nowrap right">@Dinheiro(pricing.CustoComRiscos)</td>
                    <td class="nowrap right">—</td>
                </tr>
                <tr>
                    <td class="nowrap">Markup</td>
                    <td class="nowrap"><span class="subtitle">E40</span></td>
                    <td class="nowrap right">@pricing.Markup.ToString("N4", Br)</td>
                    <td class="nowrap right">—</td>
                </tr>
                <tr>
                    <td class="nowrap">Venda pura</td>
                    <td class="nowrap"><span class="subtitle">E41</span></td>
                    <td class="nowrap right">@Dinheiro(pricing.VendaPura)</td>
                    <td class="nowrap right">—</td>
                </tr>
                <tr>
                    <td class="nowrap">Comissões</td>
                    <td class="nowrap"><span class="subtitle">D45</span></td>
                    <td class="nowrap right">@Dinheiro(pricing.VendaLiquida * pricing.Comissoes)</td>
                    <td class="nowrap right">@Pct(pricing.Comissoes)</td>
                </tr>
                <tr>
                    <td class="nowrap">Negociação, PM/SACH, garantia e portal</td>
                    <td class="nowrap"><span class="subtitle">D46 · D47 · D48 · D49</span></td>
                    <td class="nowrap right">
                        @Dinheiro(pricing.VendaLiquida * (pricing.PercentuaisDeVenda - pricing.Comissoes))
                    </td>
                    <td class="nowrap right">@Pct(pricing.PercentuaisDeVenda - pricing.Comissoes)</td>
                </tr>
                <tr>
                    <td class="nowrap"><strong>Venda líquida (sem impostos)</strong></td>
                    <td class="nowrap"><span class="subtitle">E51</span></td>
                    <td class="nowrap right"><strong>@Dinheiro(pricing.VendaLiquida)</strong></td>
                    <td class="nowrap right">—</td>
                </tr>
                <tr>
                    <td class="nowrap">Margem do projeto</td>
                    <td class="nowrap"><span class="subtitle">D54</span></td>
                    <td class="nowrap right">@Dinheiro(pricing.VendaLiquida * pricing.Margem)</td>
                    <td class="nowrap right">
                        <strong class="@(mudouMargem ? "texto-vermelho" : "")">@Pct(pricing.Margem)</strong>
                    </td>
                </tr>
                @if (pricing.PrecoComImpostos != pricing.VendaLiquida)
                {
                    <tr>
                        <td class="nowrap">PIS</td>
                        <td class="nowrap"><span class="subtitle">E60</span></td>
                        <td class="nowrap right">@Dinheiro(pricing.ValorPis)</td>
                        <td class="nowrap right">@Pct(CalculoPricing.Pis)</td>
                    </tr>
                    <tr>
                        <td class="nowrap">COFINS</td>
                        <td class="nowrap"><span class="subtitle">E61</span></td>
                        <td class="nowrap right">@Dinheiro(pricing.ValorCofins)</td>
                        <td class="nowrap right">@Pct(CalculoPricing.Cofins)</td>
                    </tr>
                    <tr>
                        <td class="nowrap">ICMS</td>
                        <td class="nowrap"><span class="subtitle">E62</span></td>
                        <td class="nowrap right">@Dinheiro(pricing.ValorIcms)</td>
                        <td class="nowrap right">
                            @Pct(CalculoPricing.IcmsDoEstado(EstadoDoPricing,
                                ListasDaProposta.CodigoDaBu(_proposta.Bu)) ?? 0m)
                        </td>
                    </tr>
                }
                @if (pricing.PrecoComImpostos == pricing.VendaLiquida)
                {
                    <tr>
                        <td class="nowrap">Impostos</td>
                        <td class="nowrap"><span class="subtitle">E60 · E61 · E62</span></td>
                        <td class="nowrap right">—</td>
                        <td class="nowrap right">
                            <span class="subtitle">
                                @(EhBrasil
                                    ? "destino fora do Brasil: a planilha zera ICMS, PIS e COFINS"
                                    : $"venda fora do Brasil ({_proposta.Pais}): sem ICMS, PIS nem COFINS")
                            </span>
                        </td>
                    </tr>
                }
                <tr>
                    <td class="nowrap"><strong>Preço ao cliente</strong></td>
                    <td class="nowrap"><span class="subtitle">S76</span></td>
                    <td class="nowrap right"><strong>@Dinheiro(pricing.PrecoComImpostos)</strong></td>
                    <td class="nowrap right">—</td>
                </tr>
            </tbody>
        </table>
    </div>

    <p class="subtitle" style="margin:12px 0 0">
        <strong>O sistema escreve todas as entradas do preço</strong> — inclusive BU (E8),
        segmento (J3) e estado (J6) —, então a planilha gerada calcula exatamente a mesma
        venda líquida que a prévia acima.
    </p>

    <p class="subtitle" style="margin:8px 0 0">
        O botão <strong>Gerar pricing</strong> baixa a planilha da equipe com as sete abas,
        as fórmulas e as macros intactas — só as células de entrada são preenchidas
        (@string.Join(", ", PricingExcel.Mapa.Take(6).Select(m => m.Celula))…). O Excel
        refaz a conta sozinho; os números acima são a prévia.
    </p>
</div>

<!-- ---------- proposta comercial ---------- -->
<div class="panel" style="margin-bottom:18px">
    <div class="toolbar" style="flex-wrap:wrap">
        <h2 style="margin:0; font-size:15px">Proposta comercial</h2>
        <span class="subtitle" style="margin:0">
            o modelo em Word da equipe, preenchido — com o preço de VENDA, não o custo
        </span>
        <span style="flex:1"></span>
        <button class="btn-primary" @onclick="GerarProposta">⬇ Gerar proposta</button>
    </div>

    @if (_proposta.Itens.Count == 0)
    {
        <div class="panel empty" style="padding:16px; margin-top:14px">
            Escolha ao menos um equipamento no escopo — a proposta comercial é a lista deles.
        </div>
    }
    else
    {
        <p class="subtitle" style="margin:12px 0 10px">
            Sai em <strong>@_proposta.Idioma</strong> (muda no cabeçalho). Cada equipamento vira um
            item da tabela de preço; a descrição abaixo é um rascunho montado do escopo:
            <strong>corrija o que não interessa ao cliente</strong> — é ela que sai no documento.
            Em branco, o sistema monta de novo.
        </p>

        @for (var i = 0; i < _proposta.Itens.Count; i++)
        {
            var indice = i;
            var item = _proposta.Itens[indice];
            var rascunho = EscopoEmTexto.Texto(item, _custo, _proposta.Moeda, TextosDaProposta.Do(Idioma));

            <div class="panel" style="margin:0 0 12px; padding:14px">
                <div class="toolbar" style="margin-bottom:8px">
                    <strong>Item @((indice + 1).ToString("D2"))</strong>
                    <span class="subtitle">@item.Quantos un. · @Dinheiro(PrecoDeVenda(indice))</span>
                    <span style="flex:1"></span>
                    @if (item.Descricao.Trim().Length > 0)
                    {
                        <button class="btn-ghost" title="Voltar ao rascunho do sistema"
                                @onclick="() => VoltarDescricao(indice)">↺ rascunho</button>
                    }
                </div>

                <textarea class="cell" rows="@(rascunho.Split('\n').Length + 1)" style="width:100%; font-family:inherit"
                          value="@(item.Descricao.Trim().Length > 0 ? item.Descricao : rascunho)"
                          @onchange="e => MudarDescricao(indice, e.Value?.ToString() ?? string.Empty)"></textarea>
            </div>
        }

        @if (FaltamParaProposta is { Count: > 0 } faltam)
        {
            <div class="panel" style="margin:12px 0 0; padding:12px; border-left:3px solid #c98a00">
                <div style="font-size:12.5px"><strong>Falta preencher para o documento sair completo:</strong></div>
                <div class="subtitle" style="margin-top:4px">@string.Join(" · ", faltam)</div>
            </div>
        }
    }
</div>

<!-- ---------- proposta técnica ---------- -->
<div class="panel" style="margin-bottom:18px">
    <div class="toolbar" style="flex-wrap:wrap">
        <h2 style="margin:0; font-size:15px">Proposta técnica</h2>
        <span class="subtitle" style="margin:0">
            a seleção e a curva de cada equipamento
        </span>
        <span style="flex:1"></span>
        <button class="btn-primary" @onclick="GerarTecnica">⬇ Gerar proposta técnica</button>
    </div>

    @if (_proposta.Itens.Count == 0)
    {
        <div class="panel empty" style="padding:16px; margin-top:14px">
            Escolha os equipamentos no escopo — é deles que sai a lista aqui embaixo.
        </div>
    }
    else
    {
        <p class="subtitle" style="margin:12px 0 10px">
            Um bloco por equipamento do escopo (@_proposta.Itens.Count no momento). Os valores
            saem do relatório de seleção como estão escritos nele, com a unidade ao lado —
            confira e corrija o que precisar.
        </p>

        @for (var i = 0; i < _proposta.Itens.Count; i++)
        {
            var indice = i;
            var item = _proposta.Itens[indice];
            var modelo = ModeloDe(item);

            <div class="panel" style="margin:0 0 14px; padding:14px">
                <div class="toolbar" style="flex-wrap:wrap; margin-bottom:10px">
                    <strong>Item @((indice + 1).ToString("D2"))</strong>
                    <span class="subtitle">
                        @(modelo is not null ? modelo.Rotulo : "sem modelo escolhido")
                    </span>
                </div>

                @* ----- seleção ----- *@
                <div class="toolbar" style="flex-wrap:wrap">
                    <strong style="min-width:150px; font-size:12.5px">Seleção</strong>
                    <InputFile OnChange="@(e => SubirSelecao(e, indice))" accept=".txt,.docx" class="cell" />
                    <span class="subtitle">.txt (Joy) ou .docx (VAX)</span>
                    @if (item.ArquivoDaSelecao.Length > 0)
                    {
                        <span class="val-count">@item.ArquivoDaSelecao</span>
                        <button class="btn-link" @onclick="() => TirarSelecao(indice)">✕ tirar</button>
                    }
                </div>

                @if (_faltouNaSelecao.TryGetValue(indice, out var faltou) && faltou.Count > 0)
                {
                    <p class="subtitle" style="margin:8px 0 0; color:#c98a00">
                        Não achei no arquivo: @string.Join(", ", faltou) — preencher à mão.
                    </p>
                }

                <div class="form3" style="margin-top:12px">
                    @foreach (var (chave, rotulo) in SelecaoTecnica.Campos)
                    {
                        var campo = chave;
                        var dado = item.Tecnicos.GetValueOrDefault(campo, new DadoTecnico("", ""));

                        <label>@Campo(rotulo, item.Tecnicos.ContainsKey(campo) ? "da seleção" : null)
                            <div class="toolbar" style="gap:6px; margin:0">
                                <input class="cell" style="flex:1" value="@dado.Valor"
                                       @onchange="e => MudarTecnico(item, campo, e.Value?.ToString() ?? string.Empty, dado.Unidade)" />
                                <input class="cell" style="width:90px" placeholder="unid."
                                       value="@dado.Unidade"
                                       @onchange="e => MudarTecnico(item, campo, dado.Valor, e.Value?.ToString() ?? string.Empty)" />
                            </div>
                        </label>
                    }
                </div>

                @* ----- o que vai na tabela do documento ----- *@
                <div style="margin-top:14px; padding-top:12px;
                            border-top:1px solid var(--linha, #e6e8ec)">
                    <div class="subtitle" style="margin-bottom:8px">
                        <strong>DATOS DEL VENTILADOR</strong> — como a tabela vai sair no documento
                    </div>

                    <div class="panel" style="padding:0; overflow-x:auto; margin:0">
                        <table class="grid">
                            <tbody>
                                @foreach (var linha in DadosDoVentilador.De(item, ModeloDe(item), MotorDe(item), TextosDaProposta.Do(Idioma)))
                                {
                                    <tr>
                                        <td class="nowrap" style="width:280px">@linha.Rotulo</td>
                                        <td>
                                            @if (linha.Falta)
                                            {
                                                <span class="subtitle">— em branco —</span>
                                            }
                                            else
                                            {
                                                <strong>@linha.Valor</strong>
                                            }
                                        </td>
                                        <td class="nowrap right" style="width:120px">
                                            @if (linha.Origem.Length > 0)
                                            {
                                                <span class="val-count">@linha.Origem</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @* ----- parte elétrica ----- *@
                <div style="margin-top:14px; padding-top:12px;
                            border-top:1px solid var(--linha, #e6e8ec)">
                    <div class="subtitle" style="margin-bottom:8px">
                        <strong>@EletricaTextos.Secao.ToUpperInvariant()</strong>
                        — sai depois da curva, em página própria
                    </div>

                    @if (DadosEletricos.De(item, _custo, _proposta.Moeda, EletricaTextos)
                         is { Count: > 0 } eletrica)
                    {
                        @foreach (var quadro in eletrica)
                        {
                            <div class="panel" style="padding:0; overflow-x:auto; margin:0 0 10px">
                                <table class="grid">
                                    <thead><tr><th>@quadro.Titulo</th></tr></thead>
                                    <tbody>
                                        @foreach (var linha in quadro.Linhas)
                                        {
                                            <tr><td>@linha</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="subtitle" style="margin:0">
                            Sem motor no escopo — a parte elétrica não entra no documento.
                            Com motor e sem partidor, sai só a tabela do motor, sem a linha do
                            método de partida.
                        </p>
                    }
                </div>

                @* ----- curvas ----- *@
                <div class="toolbar" style="flex-wrap:wrap; margin-top:14px; padding-top:12px;
                                            border-top:1px solid var(--linha, #e6e8ec)">
                    <strong style="min-width:150px; font-size:12.5px">
                        Curvas de performance
                        @if (item.Curvas.Count > 0)
                        {
                            <span class="val-count" style="margin-left:6px">@item.Curvas.Count</span>
                        }
                    </strong>
                    <InputFile OnChange="@(e => SubirCurva(e, indice))"
                               accept=".pdf,.png,.jpg,.jpeg" class="cell" />
                    <span class="subtitle">PDF ou imagem — dá para juntar mais de uma</span>
                </div>

                @* o que a tela mostra é a IMAGEM, que é o que vai para o
                   documento — não o PDF que foi anexado *@
                @for (var c = 0; c < item.Curvas.Count; c++)
                {
                    var posicao = c;
                    var curva = item.Curvas[posicao];

                    <div style="margin-top:10px; text-align:center">
                        <div class="toolbar" style="justify-content:center">
                            <span class="val-count">@curva.Nome</span>
                            <span class="subtitle">@TamanhoDaCurva(curva)</span>
                            <button class="btn-link" @onclick="() => TirarCurva(indice, posicao)">✕ tirar</button>
                        </div>
                        <img src="/axiais/anexo/@_proposta.Id/@curva.Imagem"
                             alt="Curva @(posicao + 1) do item @(indice + 1)"
                             style="max-width:100%; max-height:420px; border:1px solid var(--linha, #e6e8ec); border-radius:6px" />
                    </div>
                }

                @if (item.Curvas.Count > 0)
                {
                    <div class="subtitle" style="margin-top:4px; text-align:center">
                        @(item.Curvas.Count == 1
                            ? "é esta imagem que vai para a proposta técnica"
                            : "são estas imagens que vão para a proposta técnica")
                    </div>
                }

                @* ----- alcance de fornecimento ----- *@
                @{
                    var rascunhoEscopo = EscopoDaHowden.Rascunho(item, _custo, _proposta.Moeda,
                        EscopoTextos);
                    var escopoDoItem = item.EscopoIncluso.Trim().Length > 0
                        ? item.EscopoIncluso
                        : rascunhoEscopo;
                }

                <div style="margin-top:14px; padding-top:12px;
                            border-top:1px solid var(--linha, #e6e8ec)">
                    <div class="toolbar" style="flex-wrap:wrap; margin-bottom:8px">
                        <strong style="font-size:12.5px">@EscopoTextos.Incluso</strong>
                        <span class="subtitle">uma linha por item — é o que sai na lista</span>
                        <span style="flex:1"></span>
                        @if (item.EscopoIncluso.Trim().Length > 0)
                        {
                            <button class="btn-ghost" title="Voltar ao rascunho do sistema"
                                    @onclick="() => VoltarEscopo(indice)">↺ rascunho</button>
                        }
                    </div>

                    <textarea class="cell" rows="@(escopoDoItem.Split('\n').Length + 1)"
                              style="width:100%; font-family:inherit"
                              value="@escopoDoItem"
                              @onchange="e => MudarEscopoIncluso(indice, e.Value?.ToString() ?? string.Empty)"></textarea>

                    @if (item.EscopoExtra.Count > 0)
                    {
                        <div class="toolbar" style="flex-wrap:wrap; gap:6px; margin-top:8px">
                            <span class="subtitle" style="margin:0">juntadas à mão:</span>
                            @foreach (var chave in item.EscopoExtra.ToList())
                            {
                                var daLista = chave;
                                <button class="btn-primary" style="font-size:11.5px"
                                        title="Tirar da lista"
                                        @onclick="() => TirarDoEscopo(indice, daLista)">
                                    @EscopoTextos.Catalogo.GetValueOrDefault(daLista, daLista) ✕
                                </button>
                            }
                        </div>
                    }

                    @if (ForaDoCatalogo(item) is { Count: > 0 } faltamNoEscopo)
                    {
                        <div class="subtitle" style="margin-top:8px">
                            O cadastro não escolhe estes — clique para juntar à lista:
                        </div>
                        <div class="toolbar" style="flex-wrap:wrap; gap:6px; margin-top:6px">
                            @foreach (var chave in faltamNoEscopo)
                            {
                                var daLista = chave;
                                <button class="btn-ghost" style="font-size:11.5px"
                                        @onclick="() => JuntarAoEscopo(indice, daLista)">
                                    + @EscopoTextos.Catalogo[daLista]
                                </button>
                            }
                        </div>
                    }

                    <div class="toolbar" style="flex-wrap:wrap; margin:16px 0 8px">
                        <strong style="font-size:12.5px">@EscopoTextos.Excluido</strong>
                        <span class="subtitle">
                            o que o cliente pediu e não vai — em branco, a seção não sai
                        </span>
                    </div>

                    <textarea class="cell" rows="3" style="width:100%; font-family:inherit"
                              placeholder="uma linha por item"
                              value="@item.EscopoExcluido"
                              @onchange="e => MudarEscopoExcluido(indice, e.Value?.ToString() ?? string.Empty)"></textarea>

                    <p class="subtitle" style="margin:8px 0 0">
                        A documentação, os comentários e as normas são iguais em toda proposta e
                        saem sozinhos; o texto do ventilador sai pela série do equipamento
                        (@(SerieDoItem(item) is { Length: > 0 } serie ? serie : "sem modelo escolhido")).
                    </p>
                </div>
            </div>
        }

        @if (SemCurvas is { Count: > 0 } semCurva)
        {
            <div class="panel" style="margin:0; padding:12px; border-left:3px solid #c98a00">
                <div style="font-size:12.5px">
                    <strong>Falta a curva de:</strong> @string.Join(", ", semCurva)
                </div>
            </div>
        }
    }
</div>

@code {
    private Proposta _proposta = Nascer();
    private List<Proposta> _gravadas = new();

    private List<Equipamento> _equipamentos = new();
    private List<Motor> _motores = new();
    private List<LimiteMotor> _limites = new();

    /// <summary>A conta da proposta — a mesma que a lista de propostas usa.</summary>
    private CustoDaProposta _custo = default!;
    private List<string> _listas = new();
    private Dictionary<string, List<Caracteristica>> _porGrupo = new();
    private List<Caracteristica> _caracteristicas = new();
    private List<PrecoReferencia> _precos = new();

    /// <summary>Qual equipamento da proposta está aberto nas abas do escopo.</summary>
    private int _aberto;

    private string? _msg;
    private bool _erro;
    private bool _apagando;
    private int? _apagandoItem;
    private bool _lendo;

    // o que a última leitura da folha de dados trouxe, e o que ela não traz
    private List<string> _daPlanilha = new();
    private List<string> _avisos = new();

    /// <summary>
    /// O que o relatório de seleção não trouxe, por equipamento. É por
    /// equipamento porque cada um tem o seu arquivo — o aviso de um não pode
    /// aparecer embaixo do outro.
    /// </summary>
    private Dictionary<int, List<string>> _faltouNaSelecao = new();

    // ---------- entrega e pagamento ----------
    private List<CondicaoPagamento> _condicoes = new();
    private bool _cadastrandoPagamento;
    private string _novaCondicao = "";

    /// <summary>
    /// Marcas de "não é nenhuma das opções, é o que eu digitei": o
    /// &lt;select&gt; precisa de um value para a opção livre, e ele não pode
    /// ser igual a nenhuma condição cadastrada nem a nenhum incoterm.
    /// </summary>
    private const string OutroPagamento = "(outra condição de pagamento)";
    private const string OutroIncoterm = "(outro incoterm)";

    private bool _pagamentoLivre;
    private bool _incotermLivre;

    /// <summary>
    /// Como chamar o lugar que falta: CIF pede um porto, DAP e DDP pedem o
    /// lugar de entrega. O que se digita é só o nome — "Puerto de" e
    /// "UBICACIÓN de" já vêm na frase do modelo.
    /// </summary>
    private string RotuloDoDestino =>
        Textos.Igual(_proposta.Incoterm, "CIF") ? "Porto de destino" : "Local de destino";

    private string ExemploDoDestino =>
        Textos.Igual(_proposta.Incoterm, "CIF")
            ? "Ex.: Valparaíso (CHILE) — sem repetir \"Puerto de\""
            : "Ex.: Antofagasta (CHILE) — sem repetir \"UBICACIÓN de\"";

    /// <summary>O incoterm escolhido pede que alguém diga o lugar (CIF, DAP, DDP)?</summary>
    private bool PedeDestino => ListasDaProposta.Incoterms
        .Any(i => Textos.Igual(i.Codigo, _proposta.Incoterm) && i.Destino);

    /// <summary>Id na rota: /axiais/proposta/{id} abre aquela proposta direto.</summary>
    [Parameter] public string? Id { get; set; }

    protected override void OnInitialized() => Recarregar();

    /// <summary>
    /// A rota manda. Como a mesma página atende /axiais/proposta e
    /// /axiais/proposta/{id}, isto roda também quando a lista navega para cá.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Id) || Id == _proposta.Id) return;

        if (Repo.Achar(Id) is { } achada)
        {
            _proposta = achada;
            AjustarEscolhasLivres();
            _aberto = 0;
            Aviso($"Proposta {achada.Numero} aberta.");
        }
        else
        {
            Aviso("Essa proposta não está mais no banco.", erro: true);
        }
    }

    /// <summary>
    /// Uma proposta em branco, já com o que dá para adivinhar: hoje, o ano
    /// corrente e a primeira opção de cada lista de cabeçalho.
    /// </summary>
    private static Proposta Nascer() => new()
    {
        Data = DateTime.Now.ToString("yyyy-MM-dd"),
        Ano = DateTime.Now.Year.ToString(),
        Fase = ListasDaProposta.Fases[0],
        Bu = ListasDaProposta.Bus[0].Codigo,
        Produto = ListasDaProposta.Produtos[0],
        MarketSegment = ListasDaProposta.Segmentos[0],
    };

    private void Recarregar()
    {
        _gravadas = Repo.Todas();
        _condicoes = Pagamentos.Todas();
        _equipamentos = Equipamentos.Todos();
        _motores = Motores.Todos();
        _limites = Limites.Todos();
        _precos = Precos.Todos();

        _caracteristicas = Caracteristicas.Todas();
        _porGrupo = _caracteristicas.GroupBy(c => c.Grupo).ToDictionary(g => g.Key, g => g.ToList());

        _custo = new CustoDaProposta(_equipamentos, _motores, _caracteristicas,
            Caracteristicas.Grupos(), _precos);

        // o escopo do ventilador mostra as listas na ordem do cadastro, menos as
        // que se precificam pelo motor — o partidor entra quando a proposta
        // escolher o motor, e não o ventilador
        _listas = Caracteristicas.Grupos()
            .OrderBy(g => g.Ordem)
            .Select(g => g.Nome)
            .Where(nome => !EhDaParteEletrica(nome))
            .ToList();

        // o partidor e a instrumentação são da parte elétrica, e não do escopo
        // do ventilador: o preço do partidor vem da potência do motor, e a
        // instrumentação aceita mais de uma escolha
        ListaDosPartidores = Caracteristicas.Grupos()
            .Select(g => g.Nome)
            .FirstOrDefault(n => Textos.Simples(n).Contains("partidor")) ?? "PARTIDORES";

        ListaDaInstrumentacao = Caracteristicas.Grupos()
            .Select(g => g.Nome)
            .FirstOrDefault(n => Textos.Simples(n).Contains("instrumenta")) ?? "INSTRUMENTAÇÃO";
    }

