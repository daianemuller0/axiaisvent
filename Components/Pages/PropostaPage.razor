    private void MarcarSem(ItemProposta item, string grupo)
    {
        var ausencia = _porGrupo.GetValueOrDefault(grupo, new())
            .FirstOrDefault(o => FamiliaDePreco.EhAusencia(o.Valor));

        if (ausencia is null)
        {
            Aviso($"A lista \"{Exibir(grupo)}\" não tem uma opção de \"sem\" cadastrada.", erro: true);
            return;
        }

        item.Escolhas[grupo] = ausencia.Valor;
    }

    private void MarcarCom(ItemProposta item, string grupo)
    {
        var primeira = _porGrupo.GetValueOrDefault(grupo, new())
            .FirstOrDefault(o => !FamiliaDePreco.EhAusencia(o.Valor));

        if (primeira is null)
        {
            Aviso($"A lista \"{Exibir(grupo)}\" só tem a opção de \"sem\".", erro: true);
            return;
        }

        // já marcado "com": mantém a sub-opção escolhida
        var atual = item.Escolhas.GetValueOrDefault(grupo, "");
        if (atual.Length > 0 && !FamiliaDePreco.EhAusencia(atual)) return;

        item.Escolhas[grupo] = primeira.Valor;
    }

    private void Acrescentar()
    {
        _proposta.Itens.Add(new ItemProposta());
