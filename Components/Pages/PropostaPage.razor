    @* entrega e pagamento saem inteiros na proposta comercial: o pagamento na
       sua seção, o incoterm com a descrição do lugar e, logo abaixo dele, a
       frase de armado ou desarmado *@
    <div style="margin-top:18px; padding-top:16px; border-top:1px solid var(--border)">
        <h3 class="cond-sub">Entrega e pagamento</h3>

        <div class="form3">
            <label>@Campo("Condição de pagamento")
                <select id="f-pagamento" class="@CelulaDaCondicao("pagamento")" title="@TituloDoLembrado("pagamento")"
                        value="@(_pagamentoLivre ? OutroPagamento : _proposta.CondicaoPagamento)"
                        @onchange='e => { EscolherPagamento(e.Value?.ToString() ?? string.Empty); Editou("pagamento"); }'>
                    <option value="">— escolher —</option>
                    @foreach (var c in _condicoes)
                    {
                        <option value="@c.Texto" selected="@(!_pagamentoLivre && c.Texto == _proposta.CondicaoPagamento)">
                            @c.Texto
                        </option>
                    }
                    <option value="@OutroPagamento" selected="@_pagamentoLivre">— outra (digitar) —</option>
                </select></label>

            <label>@Campo("Entrega (Incoterm 2020)")
                <select id="f-incoterm" class="@CelulaDaCondicao("incoterm")" title="@TituloDoLembrado("incoterm")"
                        value="@(_incotermLivre ? OutroIncoterm : _proposta.Incoterm)"
                        @onchange='e => { EscolherIncoterm(e.Value?.ToString() ?? string.Empty); Editou("incoterm"); }'>
                    <option value="">— escolher —</option>
                    @foreach (var i in ListasDaProposta.Incoterms)
                    {
                        <option value="@i.Codigo" selected="@(!_incotermLivre && i.Codigo == _proposta.Incoterm)">
                            @i.Codigo
                        </option>
                    }
                    <option value="@OutroIncoterm" selected="@_incotermLivre">— outro (digitar) —</option>
                </select></label>

            <label>@Campo("Entrega do equipamento")
                <select id="f-armado" class="@CelulaDaCondicao("entrega")" title="@TituloDoLembrado("entrega")"
                        @bind="_proposta.Armado" @bind:after='() => Editou("entrega")'>
                    <option value="">— escolher —</option>
                    @foreach (var (codigo, _) in ListasDaProposta.Armados)
                    {
                        <option value="@codigo">@codigo</option>
                    }
                </select></label>
