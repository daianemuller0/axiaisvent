    // ---------- entrega e pagamento ----------

    private void EscolherPagamento(string valor)
    {
        _pagamentoLivre = valor == OutroPagamento;
        if (!_pagamentoLivre) _proposta.CondicaoPagamento = valor;
    }

    private void EscolherIncoterm(string valor)
    {
        _incotermLivre = valor == OutroIncoterm;
        if (_incotermLivre) return;

        _proposta.Incoterm = valor;
        // trocar para um incoterm que já diz o lugar apaga o destino digitado,
        // para ele não reaparecer se a equipe voltar para CIF
        if (!PedeDestino) _proposta.IncotermDestino = "";
    }

    /// <summary>
    /// Qual dos dois campos de texto livre abrir ao abrir a proposta: o que
    /// está gravado não está na lista, então foi digitado.
    /// </summary>
    private void AjustarEscolhasLivres()
    {
        _pagamentoLivre = _proposta.CondicaoPagamento.Length > 0
            && !_condicoes.Any(c => Textos.Igual(c.Texto, _proposta.CondicaoPagamento));

        _incotermLivre = _proposta.Incoterm.Length > 0
            && !ListasDaProposta.Incoterms.Any(i => Textos.Igual(i.Codigo, _proposta.Incoterm));
    }

    private void AdicionarCondicao()
    {
        var texto = _novaCondicao.Trim();
        if (texto.Length == 0) return;

        // repetida não entra: a lista é para escolher, e duas linhas iguais só
        // deixam a escolha ambígua
        if (_condicoes.FirstOrDefault(c => Textos.Igual(c.Texto, texto)) is { } jaTem)
        {
            _novaCondicao = "";
            _proposta.CondicaoPagamento = jaTem.Texto;
            _pagamentoLivre = false;
            Aviso("Essa condição já estava cadastrada.");
            return;
        }

        Pagamentos.Salvar(new CondicaoPagamento { Texto = texto });
        _novaCondicao = "";
        _condicoes = Pagamentos.Todas();
    }

    private void RenomearCondicao(CondicaoPagamento c, string texto)
    {
        if (texto.Trim().Length == 0) return;

        var antigo = c.Texto;
        c.Texto = texto.Trim();
        Pagamentos.Salvar(c);
        _condicoes = Pagamentos.Todas();

        // a proposta aberta guarda o TEXTO, não o id: corrigir a condição no
        // cadastro tem de corrigir a proposta que estava com ela
        if (Textos.Igual(_proposta.CondicaoPagamento, antigo)) _proposta.CondicaoPagamento = c.Texto;
    }

    private void ApagarCondicao(CondicaoPagamento c)
    {
        Pagamentos.Apagar(c.Id);
        _condicoes = Pagamentos.Todas();
        AjustarEscolhasLivres();
    }

    // ---------- seleção do ventilador ----------

    /// <summary>
    /// Põe a seleção lida no equipamento e devolve quantas curvas vieram
    /// junto (no VAX elas vêm dentro do Word).
    /// </summary>
    private async Task<int> AplicarSelecao(SelecaoTecnica.Resultado resultado, string extensao,
        byte[] bytes, string nome, int indice)
    {
        _faltouNaSelecao.Remove(indice);

        var item = _proposta.Itens[indice];
        foreach (var (chave, dado) in resultado.Dados) item.Tecnicos[chave] = dado;
        item.ArquivoDaSelecao = nome;

        if (resultado.NaoAchados.Count > 0) _faltouNaSelecao[indice] = resultado.NaoAchados;

        var curvas = extensao == ".docx" ? await CurvasDoWord(new MemoryStream(bytes), indice) : 0;

        // a seleção entrou: o motor pode fechar por ela (item 16, num arquivo à parte)
        DepoisDaSelecao(item);
        return curvas;
    }

    /// <summary>
    /// Desfaz a leitura da seleção — para quando o arquivo subiu errado.
    ///
    /// Apaga os dados junto com o nome do arquivo: subir o certo por cima não
    /// bastaria, porque um campo que só existia no arquivo errado ficaria lá,
    /// parecendo ter vindo do novo.
    /// </summary>
    private void TirarSelecao(int indice)
    {
        var item = _proposta.Itens[indice];

        item.Tecnicos.Clear();
        item.ArquivoDaSelecao = "";
        _faltouNaSelecao.Remove(indice);
    }

    /// <summary>
    /// Traz a curva de dentro do Word da seleção, que é onde ela vem no VAX.
    ///
    /// Só entra quando o equipamento ainda não tem curva: quem anexou uma à
    /// mão escolheu aquela, e subir a seleção depois não pode trocá-la sem
    /// avisar.
    /// </summary>
    private async Task<int> CurvasDoWord(MemoryStream docx, int indice)
    {
        var item = _proposta.Itens[indice];
        if (item.Curvas.Count > 0) return 0;

        docx.Position = 0;
        var figuras = ImagemDoWord.Curvas(docx);
        if (figuras.Count == 0) return 0;

        GarantirGravada();

        for (var i = 0; i < figuras.Count; i++)
        {
            using var imagem = new MemoryStream(figuras[i].Bytes);
            var arquivo = await Anexos.Guardar(_proposta.Id, imagem, "curva" + figuras[i].Extensao);

            item.Curvas.Add(new CurvaAnexada
            {
                Arquivo = arquivo,
                Nome = $"curva {i + 1} da seleção",
                // já é imagem: não há PDF para desenhar
                Imagem = arquivo,
            });
        }

        return figuras.Count;
    }

    private static void MudarTecnico(ItemProposta item, string chave, string valor, string unidade)
    {
        if (valor.Trim().Length == 0 && unidade.Trim().Length == 0)
        {
            item.Tecnicos.Remove(chave);
            return;
        }

        item.Tecnicos[chave] = new DadoTecnico(valor.Trim(), unidade.Trim());
    }

    /// <summary>
    /// Guarda a curva nos anexos, com a imagem que vai para o documento.
    ///
    /// O arquivo vai para a pasta de anexos, e a proposta guarda só o nome —
    /// ver <see cref="Anexos"/>. Como o anexo é gravado na hora, a proposta
    /// precisa de um id antes: sem ele, a curva não teria pasta onde morar.
    /// (A seleção e a curva entram pela área de soltar da aba Técnica, que usa
    /// a mesma importação da etapa Começar — ver ImportarArquivos.)
    /// </summary>
    private async Task AnexarCurva(byte[] bytes, string nome, int indice)
    {
        GarantirGravada();

        using var original = new MemoryStream(bytes);
        var curva = new CurvaAnexada
        {
            Arquivo = await Anexos.Guardar(_proposta.Id, original, nome),
            Nome = nome,
        };

        // a curva é um desenho, e é como imagem que ela vai para a
        // proposta: o PDF vira PNG aqui, já aparado, e a tela mostra
        // exatamente o que vai ser colado no documento — e o TXT (os dados de
        // performance em texto) também vira imagem
        var extensao = Path.GetExtension(nome).ToLowerInvariant();
        if (extensao is ".pdf" or ".txt")
        {
            var png = extensao == ".pdf" ? CurvaEmImagem.De(bytes) : TextoEmImagem.De(bytes);
            using var imagem = new MemoryStream(png);
            curva.Imagem = await Anexos.Guardar(_proposta.Id, imagem, "curva.png");
        }
        else
        {
            curva.Imagem = curva.Arquivo;
        }

        GuardarTamanho(curva, bytes.Length);
        _proposta.Itens[indice].Curvas.Add(curva);
    }

    /// <summary>
    /// Anexo precisa de pasta, e a pasta é a da proposta GRAVADA: uma proposta
    /// nova é gravada antes do primeiro anexo. Antes ela ganhava um id
    /// provisório, e o primeiro "Salvar" — que via ali uma revisão nova —
    /// trocava o id e deixava as curvas para trás.
    /// </summary>
    private void GarantirGravada()
    {
        if (_proposta.Id.Trim().Length > 0) return;
        Salvar();
    }

    private void TirarCurva(int indice, int posicao)
    {
        var item = _proposta.Itens[indice];
        if (posicao < 0 || posicao >= item.Curvas.Count) return;

        Apagar(item.Curvas[posicao]);
        item.Curvas.RemoveAt(posicao);
    }

    /// <summary>
    /// Os arquivos das curvas tiradas, com o id da proposta de onde saíram,
    /// esperando o Salvar. Apagar na hora tirava a curva da proposta GRAVADA:
    /// numa "Nova revisão" ainda não gravada o id é o da revisão anterior (a
    /// que o cliente recebeu), e o Descartar voltava a uma proposta que ainda
    /// lista uma curva cujo arquivo já não existia.
    /// </summary>
    private readonly List<(string Proposta, string Arquivo)> _anexosATirar = new();

    /// <summary>Os arquivos de uma curva (o original e a imagem dele) saem no próximo Salvar.</summary>
    private void Apagar(CurvaAnexada curva)
    {
        if (curva.Arquivo.Length > 0) _anexosATirar.Add((_proposta.Id, curva.Arquivo));

        if (curva.Imagem.Length > 0 && curva.Imagem != curva.Arquivo)
            _anexosATirar.Add((_proposta.Id, curva.Imagem));
    }

    /// <summary>
    /// Depois de gravar: apaga da pasta da proposta gravada agora os arquivos
    /// das curvas tiradas que nenhum equipamento ainda menciona. Numa revisão
    /// nova, o id já é o novo e a pasta é a cópia dela; a pasta da anterior
    /// não é tocada. Tirados de outra proposta (abriu outra sem gravar)
    /// ficam: um arquivo a mais na pasta não estraga nada.
    /// </summary>
    private void ApagarAnexosTirados(string idAnterior)
    {
        var usados = _proposta.Itens
            .SelectMany(i => i.Curvas.SelectMany(c => new[] { c.Arquivo, c.Imagem }).Append(i.Curva).Append(i.CurvaImagem))
            .Where(a => a.Length > 0)
            .ToHashSet();

        foreach (var (proposta, arquivo) in _anexosATirar)
        {
            if (proposta != idAnterior || usados.Contains(arquivo)) continue;
            try
            {
                Anexos.Apagar(_proposta.Id, arquivo);
            }
            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
            {
                // aberto em outro programa: fica na pasta, sem ninguém que o mencione
            }
            _tamanhoDasCurvas.Remove(_proposta.Id + "/" + arquivo);
        }

        _anexosATirar.Clear();
    }

    private string TamanhoDaCurva(CurvaAnexada curva)
    {
        // lido uma vez por arquivo (PropostaPage.Tecnica.cs): a pasta pode ser de rede
        var bytes = TamanhoEmBytes(curva);
        if (bytes <= 0) return "arquivo não encontrado";

        return bytes < 1024 * 1024
            ? $"{bytes / 1024d:N0} KB"
            : $"{bytes / (1024d * 1024d):N1} MB";
    }

    /// <summary>Os equipamentos que ainda não têm curva, para o aviso do rodapé.</summary>
    private List<string> SemCurvas => _proposta.Itens
        .Select((item, i) => (item, i))
        .Where(x => x.item.Curvas.Count == 0)
        .Select(x => $"item {(x.i + 1):D2}")
        .ToList();

    // ---------- folha de dados ----------

    /// <summary>
    /// Lê a folha de dados (ver <see cref="FolhaDeDados"/>) e devolve quantos
    /// equipamentos ela criou. Na importação é a primeira a ser lida: é ela
    /// que cria os equipamentos onde as seleções e as curvas vão entrar.
    /// </summary>
    private int LerFolha(byte[] bytes)
    {
        using var fluxo = new MemoryStream(bytes);
        var resultado = FolhaDeDados.Ler(fluxo, _proposta, _caracteristicas, _equipamentos);

        _avisos.AddRange(resultado.Avisos);
        _daPlanilha.AddRange(resultado.Preenchidos);
        _aberto = 0;
        return resultado.Equipamentos;
    }

    // ---------- gravar / abrir ----------

    /// <summary>
    /// Mudou o número da revisão de uma proposta que já estava gravada? Aí o que
    /// se grava é outra proposta.
    /// </summary>
    private bool NovaRevisaoPendente =>
        _proposta.Id.Length > 0 && _proposta.Revisao.Trim() != _revisaoAberta.Trim();

    /// <summary>
    /// Grava a proposta. Falso quando não gravou (a revisão já existia).
    ///
    /// Sem nada mudado desde a última gravação, não escreve: cada gravação é um
    /// arquivo novo na pasta de rede, e passar por uma etapa, gerar de novo ou
    /// um documento avulso logo depois do Gerar tudo não são motivo para outro.
    /// <paramref name="explicito"/> é o Salvar do painel e o Ctrl+S: só aí a tela diz
    /// que não havia o que gravar.
    /// </summary>
    private bool Salvar(bool explicito = false)
    {
        if (_proposta.Id.Length > 0 && !NovaRevisaoPendente && !TemAlteracao)
        {
            if (explicito) Aviso("Nada mudou desde a última gravação.");
            return true;
        }

        var novaRevisao = NovaRevisaoPendente;
        var idAnterior = _proposta.Id;

        if (novaRevisao)
        {
            var revisao = _proposta.Revisao.Trim();

            // a revisão que já existe não se sobrescreve nem por este caminho —
            // nem a que um colega gravou de outra máquina: a leitura vai à pasta
            Repo.Atualizar();
            if (Repo.Todas().Any(x => x.Id != _proposta.Id && x.Numero == _proposta.Numero
                                      && x.Revisao.Trim() == revisao))
            {
                Aviso($"A revisão {revisao} da proposta {_proposta.Numero} já existe. " +
                      "Abra-a pela Base de Dados ou use outro número de revisão.", erro: true);
                return false;
            }

            // a anterior fica intacta no banco: o que se grava daqui é uma
            // proposta nova, com o mesmo número e a revisão atualizada — e ainda
            // não enviada, porque ninguém mandou esta revisão ao cliente
            _proposta.Id = "";
            _proposta.CriadaEm = "";
            _proposta.EnviadaEm = "";

            // o tempo daqui em diante é o de montar uma revisão, não uma proposta
            _origem = "revisao";
        }

        Repo.Salvar(_proposta);

        // a revisão nova tem outro id: as curvas que ela herdou vão junto
        // para a pasta dela
        if (novaRevisao)
        {
            try
            {
                Anexos.CopiarTodos(idAnterior, _proposta.Id);
            }
            catch (IOException)
            {
                // sem a cópia, a técnica avisa da curva que falta
            }
        }

        // só agora, com a proposta gravada, as curvas tiradas saem da pasta
        ApagarAnexosTirados(idAnterior);

        _revisaoAberta = _proposta.Revisao;
        _baseSalva = Foto();
        AtualizarGravadas();

        // a revisão nova é uma consequência a ler (outra proposta no banco); o
        // "gravada" comum some sozinho
        if (novaRevisao)
            Aviso($"Revisão {_proposta.Revisao.Trim()} gravada como uma proposta nova — a revisão anterior continua como estava.",
                fica: true);
        else
            Aviso($"Proposta {_proposta.Numero} gravada.");
        return true;
    }

    private void Nova()
    {
        _proposta = NovaComPadroes();
        _revisaoAberta = "";
        _anexosATirar.Clear();
        _padraoDaNova = Foto();
        _baseSalva = _padraoDaNova;
        _sugestaoCliente = null;
        _antesDoCliente = null;
        _importados = new();
        _faltouNaSelecao.Clear();
        _abaItem = "escopo";
        _taxaDoDia = false;
        ZerarCronometro();
        _origem = "nova";
        AjustarEscolhasLivres();
        _aberto = 0;
        _apagando = false;
        _apagandoItem = null;
        _daPlanilha = new();
        _avisos = new();
        AtualizarGravadas();
        Aviso("Proposta nova — o número é gerado ao gravar.");
    }

    private void Abrir(string id)
    {
        _apagando = false;
        _apagandoItem = null;

        if (id.Length == 0)
        {
            Nova();
            return;
        }

        var achada = Repo.Achar(id);
        if (achada is null)
        {
            Aviso("Essa proposta não está mais no banco.", erro: true);
            return;
        }

        _proposta = achada;
        _revisaoAberta = achada.Revisao;
        _anexosATirar.Clear();
        _baseSalva = Foto();
        AjustarEscolhasLivres();
        _aberto = 0;
        _abaItem = "escopo";
        _sugestaoCliente = null;
        _faltouNaSelecao.Clear();
        ZerarCronometro();
        _origem = "aberta";
        Aviso($"Proposta {achada.Numero} aberta.");
    }

    /// <summary>
    /// Registra que a proposta saiu para o cliente. A data de envio é o que
    /// separa rascunho de histórico — e é por ela que a lista ordena.
    /// </summary>
    private void MarcarEnviada()
    {
        if (NovaRevisaoPendente)
        {
            Aviso("A revisão mudou: grave a nova revisão (Salvar) antes de marcar como enviada.", erro: true);
            return;
        }

        _proposta.EnviadaEm = DateTime.Now.ToString("yyyy-MM-dd");
        Repo.Salvar(_proposta);
        ApagarAnexosTirados(_proposta.Id);
        _baseSalva = Foto();

        AtualizarGravadas();
        Aviso($"Proposta {_proposta.Numero} marcada como enviada em {DataCurta(_proposta.EnviadaEm)}.");
    }

    private void DesmarcarEnviada()
    {
        if (NovaRevisaoPendente)
        {
            Aviso("A revisão mudou: grave a nova revisão (Salvar) antes.", erro: true);
            return;
        }

        _proposta.EnviadaEm = "";
        Repo.Salvar(_proposta);
        ApagarAnexosTirados(_proposta.Id);
        _baseSalva = Foto();

        AtualizarGravadas();
        Aviso($"Proposta {_proposta.Numero} voltou para \"em elaboração\".");
    }

    private static string DataCurta(string texto) =>
        DateTime.TryParse(texto, out var data) ? data.ToString("dd/MM/yyyy") : texto;

    private void Apagar()
    {
        var numero = _proposta.Numero;
        Repo.Apagar(_proposta.Id);
        _apagando = false;

        Nova();
        Recarregar();
        Aviso($"Proposta {numero} apagada.");
    }

    /// <summary>
    /// O botão dividido "Gerar tudo": o botão grande salva e baixa os três
    /// documentos; a seta abre os quatro avulsos. Um só, para o painel e a
    /// etapa Documentos mostrarem o mesmo botão — <paramref name="onde"/>
    /// separa o menu de cada lugar.
    /// </summary>
    private RenderFragment GerarTudoDividido(string onde) => @<div class="split menu-dono">
        <button class="btn-accent split-principal" disabled="@_gerandoTudo" @onclick="GerarTudo"
                title="Salva e baixa a proposta comercial, a técnica e o pricing">
            <Icone Nome="baixar" /> Gerar tudo
        </button>
        <button id="@($"seta-gerar-{onde}")" class="btn-accent split-seta" aria-haspopup="menu"
                aria-expanded="@(_gerarAberto == onde ? "true" : "false")" aria-controls="@($"menu-gerar-{onde}")"
                title="Gerar um documento só" aria-label="Gerar um documento só"
                @onclick="() => AlternarGerar(onde)">
            <Icone Nome="seta" />
        </button>
        @if (_gerarAberto == onde)
        {
            <div class="menu-pop" id="@($"menu-gerar-{onde}")" role="menu" aria-label="Gerar um documento só">
                <button role="menuitem" tabindex="-1" @onclick="() => DoMenuGerar(onde, GerarProposta)">Proposta comercial</button>
                <button role="menuitem" tabindex="-1" @onclick="() => DoMenuGerar(onde, GerarTecnica)">Proposta técnica</button>
                <button role="menuitem" tabindex="-1" @onclick="() => DoMenuGerar(onde, GerarPricing)">Pricing</button>
                <button role="menuitem" tabindex="-1" @onclick="() => DoMenu(IrParaCustoPrevisto)"
                        title="Pede o número do projeto e do pedido">Custo previsto…</button>
            </div>
        }
    </div>;
}
