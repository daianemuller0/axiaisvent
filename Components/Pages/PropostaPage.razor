    private void Remover()
    {
        if (_proposta.Itens.Count == 0) return;

        // os anexos do equipamento vão com ele, no próximo Salvar: sem isso as
        // curvas ficariam na pasta sem ninguém que as mencione, e ninguém
        // saberia que dá para apagar
        foreach (var curva in _proposta.Itens[PosicaoValida].Curvas) Apagar(curva);

        _proposta.Itens.RemoveAt(PosicaoValida);
        _faltouNaSelecao.Clear();
        _aberto = 0;
        _apagandoItem = null;
        _rolarPara = ConteudoDoEquipamento;
    }

