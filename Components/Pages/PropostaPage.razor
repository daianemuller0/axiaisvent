                               @onchange="e => RenomearCondicao(c, e.Value?.ToString() ?? string.Empty)" />
                        <button class="btn-ghost btn-icone" title="Remover esta condição" aria-label="Remover esta condição"
                                @onclick="() => ApagarCondicao(c)"><Icone Nome="fechar" /></button>
                    </div>
