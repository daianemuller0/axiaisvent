    private string RotuloDaSerie(string serie, IEnumerable<Equipamento> modelos)
    {
        var todos = modelos.ToList();
        var comPreco = todos.Count(e => PrecoDoEquipamento(e) is not null);

        return $"{serie} — {comPreco} de {todos.Count} com preço em {_proposta.Moeda.Rotulo()}";
    }

