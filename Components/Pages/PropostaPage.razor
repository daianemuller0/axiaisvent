    /// <summary>
    /// Troca o modelo do equipamento.
    ///
    /// Joga fora o preço que tinha sido digitado à mão para a linha do
    /// equipamento: ele era o preço do modelo ANTERIOR, e carregá-lo para o
    /// novo é cotar um ventilador pelo valor de outro. Os preços à mão das
    /// outras linhas ficam — eles são da opção, não do modelo.
    /// </summary>
    private void TrocarModelo(ItemProposta item, string id)
    {
        if (item.EquipamentoId == id) return;

        var primeiroModelo = item.EquipamentoId.Length == 0;
        var tinha = item.PrecosManuais.TryGetValue("equipamento", out var antigo)
            && antigo.Trim().Length > 0;
        // o diâmetro do ventilador é do modelo: o gancho compara o anterior com o novo
        var modeloAnterior = ModeloDe(item);

        item.EquipamentoId = id;
        if (primeiroModelo)
        {
            AplicarPadraoSeHouver(item);
            // o resto do primeiro modelo entra pelos ganchos, cada um num
            // arquivo à parte da fase B: o escopo inicial (item 15) e o
            // diâmetro e a altitude lembrados (item 09)
            DepoisDoPrimeiroModelo(item);
            DadosTecnicosDoPrimeiroModelo(item);
        }
        else DadosTecnicosDoModeloTrocado(item, modeloAnterior);

        if (tinha)
        {
            item.PrecosManuais.Remove("equipamento");
            Aviso($"Modelo trocado: o preço à mão do anterior ({antigo}) foi descartado.", fica: true);
        }

        // por último, com o escopo inicial já posto: o motor fecha pelo modelo
        // novo quando ele já está ligado (item 16)
        DepoisDeTrocarModelo(item, primeiroModelo);
    }

