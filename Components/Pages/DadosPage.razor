@page "/axiais/dados"
@page "/axiais/motores"
@page "/axiais/caracteristicas"
@attribute [Authorize]
@rendermode InteractiveServer
@inject EquipamentoRepository Equipamentos
@inject ItemModeloRepository ItensModelo
@inject LimiteMotorRepository Limites
@inject MotorRepository Motores
@inject CaracteristicaRepository Caracteristicas
@inject IJSRuntime JS
@inject NavigationManager Navegacao

<div class="page-head">
    <div>
        <h1>Dados</h1>
        <p class="subtitle">
            Modelos, motores e características — tudo numa guia só. O Excel leva e traz de
            volta o conteúdo inteiro desta página.
        </p>
    </div>
    <div class="page-actions">
        <button class="btn-ghost" @onclick="Exportar">⬇ Exportar Excel</button>
    </div>
</div>

<div class="panel" style="margin-bottom:18px">
    <div class="toolbar" style="margin-bottom:0; flex-wrap:wrap">
        <strong>Importar Excel</strong>
        <InputFile OnChange="Importar" accept=".xlsx,.xlsm" class="cell" />
        @if (_lendo)
        {
            <span class="saved-flag">lendo o arquivo…</span>
        }
        <span class="subtitle" style="margin:0">
            o mesmo arquivo que o botão <em>Exportar Excel</em> gera
        </span>
    </div>

    @if (_msg is not null)
    {
        <div class="@(_erro ? "aviso aviso-erro" : "aviso aviso-ok")" style="margin-top:12px">@_msg</div>
    }

    <p class="subtitle" style="margin:10px 0 0">
        Uma aba por tabela: <strong>Modelos</strong>, <strong>Ventiladores</strong>,
        <strong>Cubos</strong>, <strong>Limites de motor</strong>, <strong>Motores</strong>
        e <strong>Características</strong>. A importação sempre
        <em>atualiza e acrescenta</em> — nada é apagado por ausência, e aba que não vier no
        arquivo não é tocada. Também aceita uma planilha de uma aba só com Item/Subitem
        (ou Grupo/Valor) e Código.
    </p>
</div>

<!-- ---------------- limpar ---------------- -->
<div class="panel" style="margin-bottom:18px">
    <div class="toolbar" style="margin-bottom:0; flex-wrap:wrap">
        <strong>Limpar dados</strong>

        <label style="display:flex; align-items:center; gap:6px">
            <input type="checkbox" checked="@_limparModelos"
                   @onchange="e => _limparModelos = (bool?)e.Value ?? false" />
            <span>Modelos</span>
            <span class="val-count">@_contaModelos</span>
        </label>

        <label style="display:flex; align-items:center; gap:6px">
            <input type="checkbox" checked="@_limparMotores"
                   @onchange="e => _limparMotores = (bool?)e.Value ?? false" />
            <span>Motores</span>
            <span class="val-count">@_contaMotores</span>
        </label>

        <label style="display:flex; align-items:center; gap:6px">
            <input type="checkbox" checked="@_limparCaracteristicas"
                   @onchange="e => _limparCaracteristicas = (bool?)e.Value ?? false" />
            <span>Características</span>
            <span class="val-count">@_contaCaracteristicas</span>
        </label>

        @if (_confirmandoLimpeza)
        {
            <span class="aviso aviso-alerta" style="margin:0; padding:6px 10px">
                ⚠ Apaga @Alvos(). <strong>Não dá para desfazer.</strong>
            </span>
            <button class="btn-primary" @onclick="Limpar">Sim, limpar</button>
            <button class="btn-ghost" @onclick="@(() => _confirmandoLimpeza = false)">Cancelar</button>
        }
        else
        {
            <button class="btn-ghost" disabled="@(!AlgoSelecionado)"
                    @onclick="@(() => _confirmandoLimpeza = true)">
                🗑 Limpar selecionados
            </button>
        }
    </div>

    <p class="subtitle" style="margin:10px 0 0">
        Esvazia as tabelas marcadas para a equipe subir as dela — pela planilha ou digitando.
        A tabela de fábrica <strong>não volta</strong> na próxima abertura: a limpeza fica
        gravada. A aba <a href="/axiais/base">Base</a> não é tocada.
    </p>
</div>

<!-- ----------------------------------------------------------------
     Uma seção de cada vez. Desenhar as três juntas dava 11 mil elementos
     e 2.780 campos numa página só — o Blazor Server monta e compara essa
     árvore inteira a cada evento, e abrir a guia levava mais de um
     segundo. Trocar de seção agora não recarrega a página: é só o pedaço.
     ---------------------------------------------------------------- -->
<div class="tabs" style="margin-top:22px">
    @foreach (var (chave, titulo) in Secoes)
    {
        var s = chave;
        <button class="tab @(_secao == s ? "active" : "")" @onclick="() => Mostrar(s)">@titulo</button>
    }
</div>

@if (_secao == "modelos")
{
    <VistaModelos @key="@("modelos-" + _versao)" />
}
else if (_secao == "motores")
{
    <VistaMotores @key="@("motores-" + _versao)" />
}
else
{
    <VistaCaracteristicas @key="@("caract-" + _versao)" />
}

@code {
    private const long TamanhoMaximo = 30L * 1024 * 1024;

    /// <summary>
    /// Muda depois de uma importação: como as vistas levam esta versão na @key,
    /// trocá-la recria as três e cada uma relê o que gravou.
    /// </summary>
    private int _versao;

    private static readonly (string Chave, string Titulo)[] Secoes =
    {
        ("modelos", "Modelos"), ("motores", "Motores"), ("caracteristicas", "Características"),
    };

    /// <summary>A seção à vista. Começa pela que a rota pediu.</summary>
    private string _secao = "modelos";

    private void Mostrar(string secao) => _secao = secao;

    private bool _lendo;
    private string? _msg;
    private bool _erro;

    private bool _limparModelos = true;
    private bool _limparMotores;
    private bool _limparCaracteristicas;
    private bool _confirmandoLimpeza;

    private int _contaModelos;
    private int _contaMotores;
    private int _contaCaracteristicas;

    private bool AlgoSelecionado => _limparModelos || _limparMotores || _limparCaracteristicas;

    protected override void OnInitialized()
    {
        // /axiais/motores e /axiais/caracteristicas continuam valendo: abrem a
        // guia já na seção certa
        var rota = Navegacao.ToBaseRelativePath(Navegacao.Uri).ToLowerInvariant();
        if (rota.Contains("motores")) _secao = "motores";
        else if (rota.Contains("caracteristicas")) _secao = "caracteristicas";

        Contar();
    }

    private void Contar()
    {
        _contaModelos = Equipamentos.Todos().Count;
        _contaMotores = Motores.Todos().Count;
        _contaCaracteristicas = Caracteristicas.Todas().Count;
    }

    private string Alvos()
    {
        var partes = new List<string>();
        if (_limparModelos)
            partes.Add($"{_contaModelos} combinação(ões), com os ventiladores, os cubos e os limites de motor");
        if (_limparMotores) partes.Add($"{_contaMotores} frame(s)");
        if (_limparCaracteristicas) partes.Add($"{_contaCaracteristicas} subitem(ns) e as listas deles");

        return partes.Count switch
        {
            0 => "nada",
            1 => partes[0],
            _ => string.Join(", ", partes.Take(partes.Count - 1)) + " e " + partes[^1],
        };
    }

    /// <summary>
    /// Esvazia as tabelas marcadas. Cada repositório, além de apagar, grava a
    /// marca de "a tabela de fábrica já foi carregada" — senão a semeadura da
    /// próxima abertura desfaria a limpeza.
    /// </summary>
    private void Limpar()
    {
        var apagado = Alvos();

        if (_limparModelos)
        {
            Equipamentos.Limpar();
            ItensModelo.Limpar();
            Limites.Limpar();
        }
        if (_limparMotores) Motores.Limpar();
        if (_limparCaracteristicas) Caracteristicas.Limpar();

        _confirmandoLimpeza = false;
        _versao++;   // recria as vistas, agora vazias
        Contar();
        Aviso($"Limpo: {apagado}. Agora é subir a sua tabela — pela planilha ou digitando.");
    }

    private async Task Exportar()
    {
        var bytes = DadosExcel.Exportar(
            Equipamentos.Todos(), ItensModelo.Todos(), Limites.Todos(), Motores.Todos(),
            Caracteristicas.Grupos(), Caracteristicas.Todas());

        await JS.InvokeVoidAsync("appDownload",
            $"dados-axiais-{DateTime.Now:yyyy-MM-dd}.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            Convert.ToBase64String(bytes));
    }

    private async Task Importar(InputFileChangeEventArgs e)
    {
        var arquivo = e.File;
        _msg = null;
        _erro = false;

        var ext = Path.GetExtension(arquivo.Name).ToLowerInvariant();
        if (ext is not (".xlsx" or ".xlsm"))
        {
            Aviso($"\"{arquivo.Name}\" não é uma planilha do Excel. Use .xlsx ou .xlsm.", erro: true);
            return;
        }

        _lendo = true;
        try
        {
            // o ClosedXML precisa de um stream posicionável; o do navegador é sequencial
            using var memoria = new MemoryStream();
            await arquivo.OpenReadStream(TamanhoMaximo).CopyToAsync(memoria);
            memoria.Position = 0;

            var resumo = DadosExcel.Importar(memoria, Equipamentos, ItensModelo,
                Limites, Motores, Caracteristicas);

            var partes = new List<string>();
            if (resumo.Modelos > 0) partes.Add($"{resumo.Modelos} modelo(s)");
            if (resumo.ItensModelo > 0) partes.Add($"{resumo.ItensModelo} ventilador(es)/cubo(s)");
            if (resumo.Limites > 0) partes.Add($"{resumo.Limites} limite(s) de motor");
            if (resumo.Motores > 0) partes.Add($"{resumo.Motores} frame(s)");
            if (resumo.Caracteristicas > 0) partes.Add($"{resumo.Caracteristicas} subitem(ns)");

            var texto = partes.Count == 0
                ? $"\"{arquivo.Name}\": nada foi gravado."
                : $"\"{arquivo.Name}\": {string.Join(", ", partes)} gravado(s).";

            if (resumo.Avisos.Count > 0) texto += " " + string.Join(" ", resumo.Avisos);

            _versao++;   // recria as três vistas com o conteúdo novo
            Contar();
            Aviso(texto, erro: resumo.Total == 0);
        }
        catch (Exception ex)
        {
            Aviso("Não consegui ler a planilha: " + ex.Message, erro: true);
        }
        finally
        {
            _lendo = false;
        }
    }

    private void Aviso(string texto, bool erro = false)
    {
        _msg = texto;
        _erro = erro;
    }
}
