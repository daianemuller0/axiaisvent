@page "/axiais/dados"
@page "/axiais/motores"
@page "/axiais/caracteristicas"
@attribute [Authorize]
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="page-head">
    <div>
        <h1>Dados</h1>
    </div>
</div>

<div class="views">
    @foreach (var v in Vistas)
    {
        var vista = v;
        <button class="view @(vista.Chave == _vista ? "active" : "")"
                @onclick="() => _vista = vista.Chave">@vista.Titulo</button>
    }
</div>

@switch (_vista)
{
    case "motores":
        <VistaMotores />
        break;
    case "caracteristicas":
        <VistaCaracteristicas />
        break;
    default:
        <VistaModelos />
        break;
}

@code {
    private static readonly (string Chave, string Titulo)[] Vistas =
    {
        ("modelos", "Modelos"),
        ("motores", "Motores"),
        ("caracteristicas", "Características"),
    };

    private string _vista = "modelos";

    /// <summary>
    /// As três listas moram na MESMA aba, como a equipe pediu. As rotas antigas
    /// (/axiais/motores) continuam valendo e abrem direto na vista certa.
    /// </summary>
    protected override void OnInitialized()
    {
        var caminho = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        _vista = caminho switch
        {
            "/axiais/motores" => "motores",
            "/axiais/caracteristicas" => "caracteristicas",
            _ => "modelos",
        };
    }
}
