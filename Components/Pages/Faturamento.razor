@page "/axiais/faturamento"
@attribute [Authorize]
@rendermode InteractiveServer
@inject FaturamentoRepository Repo

<div class="page-head">
    <div>
        <h1>Dados de Faturamento</h1>
        <p class="subtitle">
            Razão social, endereço, registro e banco de cada BU emissora — o bloco
            "DADOS PARA FATURAMENTO" impresso no fim da proposta.
        </p>
    </div>
    <div class="page-actions">
        @if (_salvo)
        {
            <span class="saved-flag">Salvo ✓</span>
        }
    </div>
</div>

<div class="tabs">
    @foreach (var b in _itens)
    {
        <button class="tab @(b.Id == _aba ? "active" : "")" @onclick="() => _aba = b.Id">@b.Id</button>
    }
</div>

@if (Atual is { } f)
{
    <div class="panel">
        <h3 class="dash-title">@f.Id</h3>
        <div class="form-grid" style="max-width:820px">
            <label>Razão social
                <input class="cell" @bind="f.Razao" @bind:after="() => Salvar(f)" />
            </label>
            <label>Endereço
                <input class="cell" @bind="f.Endereco" @bind:after="() => Salvar(f)" />
            </label>
            <label>Registro (CNPJ / Inscrição Estadual)
                <input class="cell" @bind="f.Registro" @bind:after="() => Salvar(f)" />
            </label>
        </div>

        <h3 class="dash-title" style="margin-top:18px">Banco</h3>
        <div class="form3">
            <label>Banco
                <input class="cell" @bind="f.BancoNome" @bind:after="() => Salvar(f)" />
            </label>
            <label>Agência
                <input class="cell" @bind="f.Agencia" @bind:after="() => Salvar(f)" />
            </label>
            <label>Conta
                <input class="cell" @bind="f.Conta" @bind:after="() => Salvar(f)" />
            </label>
        </div>
    </div>
}

@code {
    private List<BillingInfo> _itens = new();
    private string _aba = "HSA-SP";
    private bool _salvo;

    private BillingInfo? Atual => _itens.FirstOrDefault(x => x.Id == _aba);

    protected override void OnInitialized()
    {
        _itens = Repo.All();
        if (_itens.Count == 0) _itens = Seed.Faturamento();
        if (!_itens.Any(x => x.Id == _aba)) _aba = _itens[0].Id;
    }

    private void Salvar(BillingInfo f)
    {
        Repo.Save(f);
        _salvo = true;
    }
}
