@page "/axiais/propostas"
@attribute [Authorize]
@rendermode InteractiveServer
@inject PropostaRepository Propostas
@inject NavigationManager Nav

<div class="page-head">
    <div>
        <h1>Propostas Enviadas</h1>
        <p class="subtitle">Todas as propostas de serviço cadastradas no banco (Parquet na pasta de dados).</p>
    </div>
    <div class="page-actions">
        <a class="btn-ghost" href="/axiais/propostas/export">Exportar CSV</a>
        <a class="btn-primary" href="/axiais/documento">Nova proposta</a>
    </div>
</div>

<div class="kpis">
    <div class="kpi k-risk">
        <div class="kpi-label">Propostas</div>
        <div class="kpi-value">@_filtradas.Count</div>
        <div class="kpi-sub">de @_todas.Count no banco</div>
    </div>
    <div class="kpi k-ren">
        <div class="kpi-label">Valor total (c/ impostos)</div>
        <div class="kpi-value">R$ @Pricing.Moeda0(_filtradas.Sum(p => Pricing.Num(p.Total)))</div>
        <div class="kpi-sub">soma das listadas</div>
    </div>
    <div class="kpi k-aten">
        <div class="kpi-label">Custo total</div>
        <div class="kpi-value">R$ @Pricing.Moeda0(_filtradas.Sum(p => Pricing.Num(p.CustoTotal)))</div>
        <div class="kpi-sub">soma das listadas</div>
    </div>
</div>

<div class="toolbar">
    <input class="cell" style="min-width:320px" placeholder="Buscar por cliente, número, projeto…"
           @bind="_busca" @bind:event="oninput" />
    <span class="saved-flag">@_filtradas.Count resultado(s)</span>
</div>

<table class="grid">
    <thead>
        <tr>
            <th>Número</th><th>Data</th><th>Cliente</th><th>Projeto</th>
            <th>BU</th><th>Feita por</th><th>KAM</th>
            <th class="right">Diária normal</th>
            <th class="right">Custo</th><th class="right">Total c/ impostos</th>
            <th>Status</th><th></th>
        </tr>
    </thead>
    <tbody>
        @if (_filtradas.Count == 0)
        {
            <tr><td colspan="12" class="empty">Nenhuma proposta cadastrada ainda.</td></tr>
        }
        @foreach (var p in _filtradas)
        {
            <tr>
                <td class="nowrap"><strong>@p.Numero</strong> <span style="color:var(--muted)">rev. @p.Revisao</span></td>
                <td class="nowrap">@Axiais.FmtData(p.Data)</td>
                <td>@p.Cliente<div class="score">@p.Cidade</div></td>
                <td class="truncate" style="max-width:180px">@p.Projeto</td>
                <td>@p.Bu</td>
                <td class="nowrap">@(string.IsNullOrWhiteSpace(p.PreparadaPor) ? "—" : p.PreparadaPor)</td>
                <td class="nowrap">@(string.IsNullOrWhiteSpace(p.AssinaNome) ? "—" : p.AssinaNome)</td>
                <td class="right nowrap">@Axiais.Simbolo(p.Moeda) @Pricing.Moeda(Diaria(p))</td>
                <td class="right nowrap">@Axiais.Simbolo(p.Moeda) @Pricing.Moeda(Pricing.Num(p.CustoTotal))</td>
                <td class="right nowrap"><strong>@Axiais.Simbolo(p.Moeda) @Pricing.Moeda(Pricing.Num(p.Total))</strong></td>
                <td><span class="badge @Cor(p.Status)">@p.Status</span></td>
                <td class="nowrap">
                    <button class="btn-link" @onclick="() => Abrir(p)">Abrir</button>
                    <button class="btn-link" @onclick="() => Duplicar(p)">Duplicar</button>
                    <button class="btn-link" @onclick="() => Excluir(p)">Excluir</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<Proposta> _todas = new();
    private string _busca = "";
    private readonly Dictionary<string, double> _diarias = new();

    private List<Proposta> _filtradas => _todas
        .Where(p => string.IsNullOrWhiteSpace(_busca) ||
                    $"{p.Numero} {p.Cliente} {p.Projeto} {p.Cidade} {p.Referencia} {p.PreparadaPor} {p.AssinaNome}"
                        .Contains(_busca, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override void OnInitialized() => Recarregar();

    private void Recarregar()
    {
        _todas = Propostas.All();
        // diária normal recalculada dos itens salvos — uma vez por proposta
        _diarias.Clear();
        foreach (var p in _todas) _diarias[p.Id] = Axiais.DiariaNormalGravada(p);
    }

    private double Diaria(Proposta p) => _diarias.GetValueOrDefault(p.Id);

    private static string Cor(string status) => status switch
    {
        "Enviada" => "st-atencao",
        "Aprovada" => "st-ok",
        "Perdida" => "st-vencida",
        _ => "st-plan",
    };

    private void Abrir(Proposta p) => Nav.NavigateTo($"/axiais/documento?id={p.Id}");

    /// <summary>
    /// Duplica a oportunidade: cadastro NOVO com os mesmos dados (id e data
    /// próprios, status Rascunho) e já abre a cópia para editar — a original
    /// fica intacta no banco.
    /// </summary>
    private void Duplicar(Proposta p)
    {
        var copia = Axiais.DuplicarProposta(p);
        Propostas.Save(copia);
        Nav.NavigateTo($"/axiais/documento?id={copia.Id}");
    }

    private void Excluir(Proposta p)
    {
        Propostas.Delete(p.Id);
        Recarregar();
    }
}
