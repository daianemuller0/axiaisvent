@page "/axiais/documento"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits PaginaProposta
@inject PropostaRepository Propostas
@inject BrandingRepository Branding
@inject FaturamentoRepository Faturamentos
@inject RepresentanteRepository Representantes
@inject VendedorRepository Vendedores

<div class="no-print">

<div class="page-head">
    <div>
        <h1>Proposta</h1>
        <p class="subtitle">
            Preencha direto no documento: empresa, contato e as quantidades (campos amarelos).
            Os valores saem calculados na hora. Margem, comissões e custos finos ficam em
            <a href="/axiais/proposta">Pricing e Custos</a> — tudo sincronizado.
        </p>
    </div>
    <div class="page-actions">
        <select class="cell" style="width:auto" @bind="P.ModoApresentacao" title="Como o documento sai para o cliente">
            <option value="ComDespesas">Mostrar despesas (custo + taxa adm.)</option>
            <option value="SemDespesas">Sem despesas (embutidas nas diárias)</option>
        </select>
        <button class="btn-ghost" @onclick="Zerar">Nova proposta</button>
        <button class="btn-accent" @onclick="Cadastrar">🗄 Cadastrar</button>
        <button class="btn-primary" @onclick="Imprimir">🖨 PDF</button>
        <button class="btn-ghost" @onclick="GerarWord">📄 Word</button>
        <button class="btn-ghost" @onclick="GerarExcel">📊 Excel</button>
    </div>
</div>

<div class="doc-grid">
<div class="doc-main">

<div class="paper">
    @* ---------- cabeçalho ---------- *@
    <table style="width:100%; border-collapse:collapse">
        <tr>
            <td style="vertical-align:top">
                <div style="font-weight:bold; font-size:17px; color:#141E32">Howden South America</div>
                <div style="margin-top:10px">
                    <select class="de" style="font-weight:bold; width:240px" value="@P.AssinaNome" @onchange="MudarVendedor">
                        <option value="">— quem assina (vendedor) —</option>
                        @foreach (var v in _vendedores) { <option value="@v.Nome">@v.Nome</option> }
                    </select><br />
                    <input class="de" style="width:240px" placeholder="Cargo" @bind="P.AssinaCargo" /><br />
                    <input class="de" style="width:240px" placeholder="E-mail" @bind="P.AssinaEmail" /><br />
                    <input class="de" style="width:240px" placeholder="Telefones" @bind="P.AssinaFones" />
                </div>
            </td>
            <td style="vertical-align:top; text-align:right">
                @((MarkupString)Axiais.LogoHtml(_logo))
            </td>
        </tr>
    </table>

    @* ---------- dados do cliente + caixa azul ---------- *@
    <table style="width:100%; border-collapse:collapse; margin-top:22px">
        <tr>
            <td style="vertical-align:top">
                <div class="doc-navy" style="font-size:14px">DADOS DO CLIENTE</div>
                <div style="margin-top:8px">
                    Cliente: <input class="de" style="width:280px; font-weight:700" placeholder="Empresa cliente" @bind="P.Cliente" /><br />
                    Aos cuidados de: <input class="de" style="width:240px" placeholder="Nome do contato" @bind="P.ContatoNome" /><br />
                    E-mail: <input class="de" style="width:240px" placeholder="contato@empresa.com" @bind="P.ContatoEmail" /><br />
                    Telefone: <input class="de" style="width:200px" placeholder="+55 …" @bind="P.ContatoTelefone" />
                </div>
                <div style="margin-top:10px">
                    Representante:
                    <select class="de" style="width:250px" value="@P.Representante" @onchange="e => MudarRep(e, 1)">
                        <option value="-">— sem representante —</option>
                        @foreach (var x in _reps) { <option value="@x.Nome">@x.Nome</option> }
                    </select>
                    @if (RepInfo() is { } info)
                    {
                        <div class="doc-muted" style="margin-top:3px; font-size:11.5px">@info</div>
                    }
                </div>
            </td>
            <td style="vertical-align:top; width:330px">
                <table class="doc-bluebox" style="width:100%; border-collapse:collapse">
                    <tr><td colspan="2" style="font-weight:bold">
                        Proposta <input class="de" style="width:170px" placeholder="número (gera sozinho)" @bind="P.Numero" />
                        · Rev. <input class="de" style="width:34px" @bind="P.Revisao" />
                    </td></tr>
                    <tr>
                        <td style="font-weight:bold">DATA</td>
                        <td style="text-align:right"><input class="de" type="date" @bind="DataProposta" /></td>
                    </tr>
                    <tr>
                        <td style="font-weight:bold">VALIDADE</td>
                        <td style="text-align:right">
                            <input class="de num" style="width:44px" @bind="P.ValidadeDias" /> dias → @Axiais.ValidadeData(P)
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <hr class="doc-hr" />

    @* ---------- projeto / cidade / estado / prazo ---------- *@
    <table style="width:100%; border-collapse:collapse">
        <tr>
            <td style="width:38%"><span class="doc-navy">PROJETO</span><br />
                <input class="de" style="width:95%" placeholder="—" @bind="P.Projeto" /></td>
            <td style="width:32%"><span class="doc-navy">CIDADE</span><br />
                <input class="de" style="width:90%" placeholder="Jaguarari - BA" @bind="P.Cidade" /></td>
            <td style="width:30%"><span class="doc-navy">ESTADO</span><br />
                <select class="de" @bind="P.Estado">
                    @foreach (var o in Axiais.Estados) { <option value="@o">@o</option> }
                </select></td>
        </tr>
    </table>
    <div style="margin-top:10px">
        <span class="doc-navy">Ref.:</span>
        <input class="de" style="width:60%" placeholder="Suporte Engenharia de Ventilação" @bind="P.Referencia" />
    </div>
    <div style="margin-top:8px">
        Prazo de entrega: <input class="de" style="width:110px" placeholder="digite" @bind="P.PrazoEntregaDias" /> ·
        Qtd. de técnicos: <input class="de qtd" @bind="R.Params.QtdTecnicos" /> ·
        Moeda: <select class="de" @bind="P.Moeda">
            @foreach (var o in Axiais.Moedas) { <option value="@o">@o</option> }
        </select> ·
        Idioma: <select class="de" @bind="P.Idioma">
            @foreach (var o in Axiais.Idiomas) { <option value="@o">@o</option> }
        </select>
    </div>

    @* ---------- assessoria técnica ---------- *@
    <h2 style="display:flex; align-items:baseline; gap:8px; flex-wrap:wrap">
        ASSESSORIA TÉCNICA @(string.IsNullOrWhiteSpace(P.EscopoServico) ? "" : "-")
        <input class="de" style="min-width:340px; font-size:13px; font-weight:600" list="escopos"
               placeholder="— escopo do serviço (escolha ou digite) —" @bind="P.EscopoServico" />
        <datalist id="escopos">
            @foreach (var e in Axiais.EscoposServico) { <option value="@e"></option> }
        </datalist>
    </h2>
    <table class="doc-tbl">
        <thead>
            <tr>
                <th>SERVIÇOS</th><th>OBS</th>
                <th style="text-align:center">HORAS</th>
                <th style="text-align:right" class="doc-interno">CUSTO HORA ᵢ</th>
                <th style="text-align:right">VALOR HORA</th>
                <th style="text-align:right">VALOR 1 DIARIA</th>
                <th style="text-align:center">QTD. DIARIA</th>
                <th style="text-align:right">VALOR TOTAL</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in R.ItensMO)
            {
                var linha = LinhaDe(i);
                <tr class="@(linha is null ? "zero" : "")">
                    <td><input class="de" style="width:97%" @bind="i.Servico" /></td>
                    <td><input class="de" style="width:95%" @bind="i.Obs" /></td>
                    <td class="center"><input class="de num" style="width:40px; text-align:center" @bind="i.Horas" /></td>
                    <td class="right doc-interno"><input class="de num" style="width:64px" @bind="i.CustoHora" /></td>
                    <td class="right">@(linha is null ? "—" : Pricing.Moeda(linha.ValorHora))</td>
                    <td class="right">@(linha is null || linha.ValorDiaria <= 0 ? "—" : Pricing.Moeda(linha.ValorDiaria))</td>
                    <td class="center">
                        <input class="de qtd" @bind="i.QtdDiaria" @bind:after="SincronizarDiarias" />
                        @if (Pricing.EhHoraExtra(i.Servico))
                        {
                            <div class="doc-muted no-print" style="font-size:10px">= horas</div>
                        }
                    </td>
                    <td class="right">@(linha is null ? "—" : $"{Cifrao} {Pricing.Moeda(linha.ValorTotal)}")</td>
                </tr>
            }
            <tr class="total-row">
                <td colspan="7">TOTAL ASSESSORIA @(SemImpostos ? "TÉCNICA" : "C/ IMPOSTOS")</td>
                <td class="right">@Cifrao @Pricing.Moeda(DocA.TotalMO)</td>
            </tr>
        </tbody>
    </table>

    @* ---------- despesas ---------- *@
    @if (P.ModoApresentacao == "SemDespesas")
    {
        <div class="side-note no-print" style="margin-top:16px">
            Modo <strong>sem despesas</strong>: a tabela abaixo é interna (não sai no documento) —
            os valores das despesas estão embutidos nas diárias da assessoria.
        </div>
    }
    <h2>
        DESPESAS @(P.ModoApresentacao == "SemDespesas" ? "(interno)" : "")
        @if (P.ModoApresentacao != "SemDespesas" && Pricing.Num(R.Params.TaxaAdmPct) > 0)
        {
            <span class="doc-muted" style="font-weight:400; font-size:11.5px">(Incluso @Pricing.Moeda0(Pricing.Num(R.Params.TaxaAdmPct))% de taxa administrativa)</span>
        }
    </h2>
    <table class="doc-tbl">
        <thead>
            <tr>
                <th>DESPESAS</th><th>OBS</th>
                <th style="text-align:center">QTD</th>
                <th style="text-align:right" class="doc-interno">CUSTO UNIT. ᵢ</th>
                <th style="text-align:right">VALOR UNITARIO</th>
                <th style="text-align:right">VALOR TOTAL</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in R.ItensDespesa)
            {
                var linha = LinhaDe(d);
                <tr class="@(linha is null ? "zero" : "")">
                    <td><input class="de" style="width:97%" @bind="d.Despesa" /></td>
                    <td><input class="de" style="width:95%" @bind="d.Obs" /></td>
                    <td class="center"><input class="de qtd" @bind="d.Qtd" /></td>
                    <td class="right doc-interno"><input class="de num" style="width:64px" @bind="d.CustoUnitario" /></td>
                    <td class="right">@(linha is null ? "—" : Pricing.Moeda(linha.ValorUnitario))</td>
                    <td class="right">@(linha is null ? "—" : $"{Cifrao} {Pricing.Moeda(linha.ValorTotal)}")</td>
                </tr>
            }
            <tr class="total-row">
                <td colspan="5">TOTAL DESPESAS @(SemImpostos ? "" : "C/ IMPOSTOS")</td>
                <td class="right">@Cifrao @Pricing.Moeda(DocA.TotalDespesas)</td>
            </tr>
        </tbody>
    </table>

    @* ---------- total ---------- *@
    @if (DocA.Deslocamento > 0)
    {
        <table class="doc-tbl" style="margin-top:10px">
            <tr>
                <td>
                    <span class="doc-navy">DESPESAS DE DESLOCAMENTO</span>
                    <span class="doc-muted" style="font-size:11px"> — táxi + passagem aérea: custo + @Pricing.Moeda0(DocA.TaxaAdmPct > 0 ? DocA.TaxaAdmPct : Pricing.Num(R.Params.TaxaAdmPct))% de taxa adm.; a diferença fica embutida nas diárias</span>
                </td>
                <td class="right doc-navy" style="width:170px; font-weight:700">
                    @Cifrao @Pricing.Moeda(DocA.Deslocamento)
                </td>
            </tr>
        </table>
    }
    <table style="width:100%; border-collapse:collapse; margin-top:10px">
        <tr>
            <td></td>
            <td class="doc-total" style="width:220px">@(SemImpostos ? "VALOR TOTAL" : "TOTAL C/ IMPOSTOS")</td>
            <td class="doc-total" style="width:170px; text-align:right">@Cifrao @Pricing.Moeda(DocA.Total)</td>
        </tr>
    </table>

    @if (!SemImpostos)
    {
    <table class="doc-tbl" style="margin-top:14px; max-width:520px">
        @{ var resumo = Pricing.ResumoDoTotal(DocA); }
        <tr><td>VALOR SEM IMPOSTOS</td><td class="right">@Cifrao @Pricing.Moeda(resumo.SemImpostos)</td></tr>
        <tr><td>VALOR C/ PIS E COFINS</td><td class="right">@Cifrao @Pricing.Moeda(resumo.ComPisCofins)</td></tr>
        <tr class="total-row"><td>VALOR C/ PIS, COFINS E ISS</td><td class="right">@Cifrao @Pricing.Moeda(DocA.Total)</td></tr>
    </table>
    }

    @* ---------- diárias adicionais (sempre no documento) ---------- *@
    @if (Pricing.DiariasAdicionais(DocA) is { Count: > 0 } adicionais)
    {
        <h2 style="margin-top:18px">DIÁRIAS ADICIONAIS</h2>
        <div class="doc-muted" style="font-size:11.5px; margin-bottom:4px">Valores para dias e horas além do contratado — não incluem despesas de deslocamento (táxi e passagem aérea): o técnico já está na planta</div>
        <table class="doc-tbl">
            <thead>
                <tr><th>SERVIÇOS</th><th>OBS</th><th class="right" style="width:170px">VALOR</th></tr>
            </thead>
            <tbody>
                @foreach (var a in adicionais)
                {
                    <tr>
                        <td class="doc-navy" style="font-weight:600">@a.Servico</td>
                        <td>@a.Obs</td>
                        <td class="right">@Cifrao @Pricing.Moeda(a.Valor)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @* ---------- escopo detalhado (texto livre; em branco não sai na proposta) ---------- *@
    <h2 style="margin-top:18px">ESCOPO DO SERVIÇO</h2>
    <textarea class="de" rows="5"
              style="width:100%; resize:vertical; font-family:inherit; font-size:12.5px"
              placeholder="— digite o escopo detalhado (opcional: em branco, esta seção não sai na proposta) —"
              @bind="P.EscopoDetalhado"></textarea>

    @* ---------- notas (incluso / excluso / gerais) — tic escolhe o que sai ---------- *@
    @{
        var todasNotas = Axiais.NotasDaProposta(P, R.ItensMO, R.ItensDespesa, R.Params, DocA);
        var notasFora = Axiais.NotasDesmarcadas(P);
    }
    @if (todasNotas.Count > 0)
    {
        <div style="margin:20px 0 4px; padding:7px 10px; background:#f0f4fa; border:1px dashed #b9c6dd; border-radius:6px; font-size:12px; display:flex; gap:10px; align-items:center; flex-wrap:wrap">
            <span>Notas com tic ✓ saem na proposta — desmarque as que não quer.</span>
            <button class="btn-ghost" style="font-size:12px; padding:3px 10px" @onclick="SalvarNotasPadrao">Salvar seleção como padrão</button>
            @if (!string.IsNullOrEmpty(MsgNotas))
            {
                <span style="color:#0a7a41; font-weight:600">@MsgNotas</span>
            }
        </div>
        foreach (var (secao, titulo, cor) in new[]
        {
            ("incluso", "INCLUSO NO FORNECIMENTO DA HOWDEN:", "#004785"),
            ("excluso", "EXCLUSOS DO FORNECIMENTO DA HOWDEN:", "#004785"),
            ("gerais", "Notas Gerais:", "#141E32"),
        })
        {
            var itens = todasNotas.Where(n => n.Secao == secao).ToList();
            if (itens.Count == 0) { continue; }
            <p style="margin:14px 0 2px; font-weight:bold; font-size:13px; color:@cor; text-decoration:underline">@titulo</p>
            <ul style="margin:4px 0 0; padding-left:4px; list-style:none">
                @foreach (var nota in itens)
                {
                    var marcada = !notasFora.Contains(nota.Chave);
                    <li style="margin:3px 0; font-size:12px; color:#3C465A; @(marcada ? "" : "opacity:.42; text-decoration:line-through")">
                        <label style="display:flex; gap:7px; align-items:flex-start; cursor:pointer">
                            <input type="checkbox" style="margin-top:2px; flex:none" checked="@marcada"
                                   @onchange="e => AlternarNota(nota.Chave, (bool)e.Value!)" />
                            <span>@((MarkupString)nota.Texto)</span>
                        </label>
                    </li>
                }
            </ul>
        }
    }

    @* ---------- faturamento ---------- *@
    <h2>DADOS PARA FATURAMENTO</h2>
    <div>
        <span class="doc-navy">@Fat.Razao</span><br />
        @Fat.Endereco@(string.IsNullOrWhiteSpace(Fat.Registro) ? "" : "")<br />
        <span class="doc-muted">@Fat.Registro</span>
    </div>
    @if (!string.IsNullOrWhiteSpace(Fat.BancoNome))
    {
        <div style="margin-top:10px">
            <span style="border:1px solid #d5dae4; border-radius:3px; padding:5px 12px; display:inline-block">
                <b>Banco: @Fat.BancoNome – Agência: @Fat.Agencia Conta: @Fat.Conta</b>
            </span>
        </div>
    }

    <div class="doc-muted" style="font-style:italic; margin-top:22px">
        Preparada por: <input class="de" style="width:170px" @bind="P.PreparadaPor" /> ·
        BU: <select class="de" value="@P.Bu" @onchange="MudarBu">
            @foreach (var o in Axiais.Bus) { <option value="@o">@o</option> }
        </select> ·
        Margem: <strong>@Pricing.Porcento(Doc.Calculo.ProjectMargin)</strong> ·
        Situação: <select class="de" @bind="P.Status">
            <option value="Rascunho">Rascunho</option>
            <option value="Enviada">Enviada</option>
            <option value="Aprovada">Aprovada</option>
            <option value="Perdida">Perdida</option>
        </select>
    </div>
</div>

<div style="max-width:1080px; margin-top:14px; display:flex; justify-content:space-between; align-items:center">
    <div class="side-note" style="flex:1; margin-right:14px">
        ✦ Campos <span class="de qtd" style="padding:1px 8px">amarelos</span> = quantidades.
        Colunas <strong>ᵢ (internas)</strong> = custo, já preenchido pelo padrão e ajustável aqui
        — elas não saem no PDF/Word. A linha <strong>OUTROS nunca aparece na proposta</strong>:
        o valor dela é diluído nas diárias. Margem e comissões: <a href="/axiais/proposta">Pricing e Custos</a>.
    </div>
    <div style="display:flex; gap:8px">
        <a class="btn-ghost" href="@Axiais.MailtoEnvio(P, DocA, Cfg)">✉ E-mail de envio</a>
        <a class="btn-ghost" href="@Axiais.MailtoAprovacao(P, Doc, Cfg)">✅ E-mail de aprovação</a>
    </div>
</div>

</div> @* /doc-main *@

<aside class="ferr-side">
    @if (_erro is not null)
    {
        <div class="alert-error">@_erro</div>
    }
    @if (_msg is not null)
    {
        <div class="side-ok">@_msg</div>
    }
    <div class="panel ferramentas">
        <div class="ferr-bloco">
            <h3 class="dash-title">Margem (GM)</h3>
            <div class="ferr-linha">
                <label>% do projeto
                    <input class="cell num" style="width:80px" @bind="R.Params.MargemAlvoPct" @bind:after="MargemEditada" />
                </label>
            </div>
            <div class="ferr-status" style="color:var(--muted)">
                atual: <strong>@Pricing.Porcento(R.Calculo().ProjectMargin)</strong>
            </div>
        </div>
        <div class="ferr-bloco">
            <h3 class="dash-title">Proposta anterior</h3>
            <div class="ferr-linha">
                <label>Diária anterior (R$, c/ imp.)
                    <input class="cell num" style="width:120px" @bind="R.Params.PropAnteriorValor" />
                </label>
                <label>% a mais
                    <input class="cell num" style="width:64px" @bind="R.Params.PropAnteriorPct" />
                </label>
            </div>
            <div class="ferr-linha">
                <button class="btn-ghost" @onclick="AcaoFecharDiaria">🔒 Fechar a diária</button>
            </div>
            @if (MetaAnterior > 0)
            {
                <div class="ferr-status @(FaltaParaAnterior > 0 ? "dias-vencida" : "saved-flag")">
                    Diária meta: R$ @Pricing.Moeda(MetaAnterior) · atual: R$ @Pricing.Moeda(DiariaAtual)
                    @(FaltaParaAnterior > 0 ? $"— faltam R$ {Pricing.Moeda(FaltaParaAnterior)}" : "— já supera ✓")
                </div>
            }
        </div>
        <div class="ferr-bloco">
            <h3 class="dash-title">Chegar no valor (meta)</h3>
            <div class="ferr-linha">
                <label>Valor final desejado (R$)
                    <input class="cell num" style="width:130px" @bind="R.Params.MetaValor" />
                </label>
                <button class="btn-ghost" @onclick="AcaoFecharTotal">🔒 Fechar o valor</button>
            </div>
            @if (Pricing.Num(R.Params.MetaValor) > 0)
            {
                <div class="ferr-status @(MargemDaMeta < 0 ? "dias-vencida" : "")">
                    Com essa meta a margem fica <strong>@Pricing.Porcento(MargemDaMeta)</strong>
                </div>
            }
        </div>
        <div class="ferr-bloco">
            <h3 class="dash-title">Os dois ao mesmo tempo</h3>
            <div class="ferr-linha">
                <button class="btn-primary" @onclick="AcaoFecharAmbos">🔒🔒 Fechar diária + valor</button>
            </div>
            <div class="ferr-nota">
                Com os multiplicadores fixos o total acompanha a diária — se as metas não casarem, mostro o par exato.
            </div>
        </div>
        <div class="ferr-bloco">
            <div class="ferr-status" style="color:var(--muted)">
                Total c/ impostos: <strong>@Cifrao @Pricing.Moeda(DocA.Total)</strong><br />
                Diária normal: <strong>@Cifrao @Pricing.Moeda(DiariaAtual)</strong>
            </div>
        </div>
    </div>
</aside>

</div> @* /doc-grid *@

</div> @* /no-print *@

<div class="proposal-doc">@((MarkupString)Axiais.DocBody(P, DocA, _logo, Fat, RepInfo(), Axiais.NotasHtml(P, R.ItensMO, R.ItensDespesa, R.Params, DocA)))</div>

@code {
    [SupplyParameterFromQuery(Name = "id")] public string? PropostaId { get; set; }

    private string? _msg, _erro, _logo;
    private List<BillingInfo> _faturamentos = new();
    private List<Representante> _reps = new();
    private List<Vendedor> _vendedores = new();

    private Proposta P => R.Proposta;
    private bool SemImpostos => Doc.Calculo.Pis + Doc.Calculo.Cofins + Doc.Calculo.Iss <= 0.005;
    private Pricing.Documento Doc => R.Documento();
    private Pricing.Documento DocA =>
        Pricing.Apresentar(Doc, P.ModoApresentacao, Pricing.Num(R.Params.TaxaAdmPct),
            Pricing.Num(R.Params.DiariaTravada), Pricing.Num(R.Params.TotalTravado));
    private string Cifrao => Axiais.Simbolo(P.Moeda);

    private DateTime DataProposta
    {
        get => DateTime.TryParse(P.Data, out var d) ? d : DateTime.Today;
        set => P.Data = value.ToString("yyyy-MM-dd");
    }

    private BillingInfo Fat =>
        _faturamentos.FirstOrDefault(x => x.Id == P.Bu && !string.IsNullOrWhiteSpace(x.Razao))
        ?? Axiais.FaturamentoPadrao(P.Bu);

    // Linha precificada correspondente a cada item (os itens sem valor ficam esmaecidos).
    private Dictionary<object, object>? _mapa;
    private Pricing.LinhaMO? LinhaDe(ItemMO i) { Mapear(); return _mapa!.TryGetValue(i, out var l) ? (Pricing.LinhaMO)l : null; }
    private Pricing.LinhaDespesa? LinhaDe(ItemDespesa d) { Mapear(); return _mapa!.TryGetValue(d, out var l) ? (Pricing.LinhaDespesa)l : null; }

    private void Mapear()
    {
        var doc = DocA;
        // No modo sem despesas a lista apresentada fica vazia — a tabela interna
        // da tela mostra os valores reais distribuídos (Doc), para conferência.
        var docDespesas = doc.Despesas.Count > 0 ? doc : Doc;
        var tec = Math.Max(Pricing.Inteiro(R.Params.QtdTecnicos), 1);
        _mapa = new Dictionary<object, object>();
        var im = 0;
        foreach (var i in R.ItensMO)
            if (Pricing.CustoMO(i, tec) > 0 && im < doc.MO.Count) _mapa[i] = doc.MO[im++];
        var usandoApresentado = doc.Despesas.Count > 0;
        var id = 0;
        foreach (var d in R.ItensDespesa)
        {
            if (Pricing.CustoDespesa(d, tec) <= 0) continue;
            if (usandoApresentado && Pricing.EhOutros(d.Despesa)) continue;   // OUTROS não sai na proposta
            if (id < docDespesas.Despesas.Count) _mapa[d] = docDespesas.Despesas[id++];
        }
    }

    protected override bool ShouldRender() { _mapa = null; return true; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _logo = Branding.GetLogo();
        _faturamentos = Faturamentos.All();
        _reps = Representantes.All();
        _vendedores = Vendedores.All();

        if (!string.IsNullOrWhiteSpace(PropostaId))
        {
            var salva = Propostas.All().FirstOrDefault(x => x.Id == PropostaId);
            if (salva is null) _erro = "Proposta não encontrada no banco de dados.";
            else
            {
                R.Carregar(salva);
                _msg = $"Proposta {Axiais.NumeroCompleto(salva)} carregada.";
            }
        }
    }

    private void AcaoFecharDiaria() { _erro = null; _msg = FecharDiaria(); }
    private void AcaoFecharTotal() { _erro = null; _msg = FecharTotal(); }
    private void AcaoFecharAmbos() { _erro = null; _msg = FecharAmbos(); }

    private async Task Zerar()
    {
        await NovaProposta();
        _msg = "Proposta nova.";
        _erro = null;
        if (string.IsNullOrWhiteSpace(P.PreparadaPor)) P.PreparadaPor = Usuario;
    }

    private void MudarBu(ChangeEventArgs e) => AplicarBu(e.Value?.ToString() ?? P.Bu);

    private void MudarVendedor(ChangeEventArgs e)
    {
        var nome = e.Value?.ToString() ?? "";
        P.AssinaNome = nome;
        var v = _vendedores.FirstOrDefault(x => x.Nome == nome);
        if (v is null) return;
        P.AssinaCargo = string.IsNullOrWhiteSpace(v.Area) ? v.Cargo : $"{v.Cargo} – {v.Area}";
        P.AssinaEmail = v.Email;
        P.AssinaFones = v.Fones;
    }

    private void MudarRep(ChangeEventArgs e, int qual)
    {
        var nome = e.Value?.ToString() ?? "-";
        var rep = _reps.FirstOrDefault(x => x.Nome == nome);
        if (qual == 1) { P.Representante = nome; R.Params.Rep1Pct = rep?.ComissaoPct ?? "0"; }
        else { P.Representante2 = nome; R.Params.Rep2Pct = rep?.ComissaoPct ?? "0"; }
    }

    private string? RepInfo()
    {
        var partes = new[] { P.Representante, P.Representante2 }
            .Where(n => n is not ("" or "-"))
            .Select(n => _reps.FirstOrDefault(x => x.Nome == n)?.Contato ?? "")
            .Where(c => c != "");
        var txt = string.Join(" · ", partes);
        return txt == "" ? null : txt;
    }

    private void Cadastrar()
    {
        _erro = null; _msg = null;
        if (string.IsNullOrWhiteSpace(P.Cliente)) { _erro = "Informe o cliente antes de cadastrar."; return; }
        if (Doc.MO.Count == 0 && Doc.Despesas.Count == 0) { _erro = "A proposta não tem nenhum item com valor."; return; }

        var virouNova = NovoCadastroSeMudouNumeroOuRevisao(Propostas.All());
        if (string.IsNullOrWhiteSpace(P.Id)) P.Id = Axiais.NovoIdProposta();
        if (string.IsNullOrWhiteSpace(P.Numero))
            P.Numero = $"SRV-{P.Ano}-{Propostas.All().Count + 1:D3}";
        if (string.IsNullOrWhiteSpace(P.CriadaEm))
            P.CriadaEm = DateTime.Now.ToString("yyyy-MM-dd HH:mm");
        if (string.IsNullOrWhiteSpace(P.Status)) P.Status = "Rascunho";

        Propostas.Save(R.ParaGravar());
        _msg = virouNova
            ? $"Número/revisão mudou → cadastro NOVO criado ({Axiais.NumeroCompleto(P)}). O registro antigo continua no banco."
            : $"Proposta {P.Numero} cadastrada.";
    }

    private async Task Imprimir() => await JS.InvokeVoidAsync("appPrint");

    private async Task GerarWord()
    {
        var html = Axiais.DocHtml(P, DocA, _logo, Fat, RepInfo(), Axiais.NotasHtml(P, R.ItensMO, R.ItensDespesa, R.Params, DocA));
        var b64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(html));
        var prefixo = P.Idioma switch { "English" => "Quote", "Español" => "Propuesta", _ => "Proposta" };
        var nome = $"{prefixo}-{(string.IsNullOrWhiteSpace(P.Numero) ? "rascunho" : P.Numero)}.doc";
        await JS.InvokeVoidAsync("appDownload", nome, "application/msword", b64);
    }

    // A PLANILHA ORIGINAL (subir.xlsm) preenchida com a proposta, p/ guardar na pasta.
    private async Task GerarExcel()
    {
        try
        {
            var bytes = PlanilhaExport.Gerar(P, R.ItensMO, R.ItensDespesa, R.Params, DocA);
            var nome = $"{(string.IsNullOrWhiteSpace(P.Numero) ? "Proposta-rascunho" : Axiais.NumeroCompleto(P))} - {P.Cliente}.xlsm".Trim(' ', '-');
            await JS.InvokeVoidAsync("appDownload", nome,
                "application/vnd.ms-excel.sheet.macroEnabled.12",
                Convert.ToBase64String(bytes));
            _erro = null;
        }
        catch (Exception ex)
        {
            _erro = "Não consegui gerar a planilha: " + ex.Message;
        }
    }
}
