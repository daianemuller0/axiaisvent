@page "/axiais/proposta"
@page "/axiais/custo"
@page "/axiais/pricing"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits PaginaProposta
@inject PropostaRepository Propostas
@inject BrandingRepository Branding
@inject FaturamentoRepository Faturamentos
@inject RepresentanteRepository Representantes

<div class="no-print">

<div class="page-head">
    <div>
        <h1>Pricing e Custos</h1>
        <p class="subtitle">
            A cozinha da proposta: margem, comissões, riscos, impostos e custos em detalhe.
            O preenchimento do dia a dia é na aba <a href="/axiais/documento">Proposta</a> —
            as duas telas trabalham na mesma proposta, sempre sincronizadas.
        </p>
    </div>
    <div class="page-actions">
        <button class="btn-ghost" @onclick="Zerar">Nova proposta</button>
    </div>
</div>

<div class="prop-grid">
    <div>
        @* ================== 1. DADOS DO CLIENTE E DA PROPOSTA ================== *@
        <div class="panel">
            <h3 class="dash-title">1 · Dados do cliente e da proposta</h3>
            <div class="form3">
                <label>Cliente
                    <input class="cell" placeholder="Empresa cliente" @bind="P.Cliente" />
                </label>
                <label>Cidade / UF do serviço
                    <input class="cell" placeholder="Jaguarari - BA" @bind="P.Cidade" />
                </label>
                <label>Estado
                    <select class="cell" @bind="P.Estado">
                        @foreach (var o in Axiais.Estados) { <option value="@o">@o</option> }
                    </select>
                </label>
                <label>Aos cuidados de
                    <input class="cell" @bind="P.ContatoNome" />
                </label>
                <label>E-mail
                    <input class="cell" placeholder="contato@empresa.com" @bind="P.ContatoEmail" />
                </label>
                <label>Telefone
                    <input class="cell" @bind="P.ContatoTelefone" />
                </label>
                <label>Projeto
                    <input class="cell" @bind="P.Projeto" />
                </label>
                <label>Referência / escopo
                    <input class="cell" placeholder="Suporte Engenharia de Ventilação" @bind="P.Referencia" />
                </label>
                <label>Escopo do serviço (título da assessoria)
                    <input class="cell" list="escopos-gp" placeholder="escolha ou digite" @bind="P.EscopoServico" />
                    <datalist id="escopos-gp">
                        @foreach (var o in Axiais.EscoposServico) { <option value="@o"></option> }
                    </datalist>
                </label>
                <label style="grid-column:1 / -1">Escopo detalhado (opcional — em branco não sai na proposta)
                    <textarea class="cell" rows="4" style="font-family:inherit; resize:vertical"
                              placeholder="texto livre, impresso antes das notas da proposta"
                              @bind="P.EscopoDetalhado"></textarea>
                </label>
                <label>Representante 1
                    <select class="cell" value="@P.Representante" @onchange="e => MudarRep(e, 1)">
                        <option value="-">— sem representante —</option>
                        @foreach (var x in _reps) { <option value="@x.Nome">@x.Nome</option> }
                    </select>
                </label>
                <label>Representante 2
                    <select class="cell" value="@P.Representante2" @onchange="e => MudarRep(e, 2)">
                        <option value="-">— sem representante —</option>
                        @foreach (var x in _reps) { <option value="@x.Nome">@x.Nome</option> }
                    </select>
                </label>
                <label>Número da proposta
                    <input class="cell" placeholder="Gera sozinho se ficar vazio" @bind="P.Numero" />
                </label>
                <label>Revisão
                    <input class="cell" @bind="P.Revisao" />
                </label>
                <label>Data
                    <input class="cell" type="date" @bind="DataProposta" />
                </label>
                <label>BU emissora
                    <select class="cell" value="@P.Bu" @onchange="MudarBu">
                        @foreach (var o in Axiais.Bus) { <option value="@o">@o</option> }
                    </select>
                </label>
                <label>Idioma da proposta
                    <select class="cell" @bind="P.Idioma">
                        @foreach (var o in Axiais.Idiomas) { <option value="@o">@o</option> }
                    </select>
                </label>
                <label>Moeda
                    <select class="cell" @bind="P.Moeda">
                        @foreach (var o in Axiais.Moedas) { <option value="@o">@o</option> }
                    </select>
                </label>
                <label>Validade (dias)
                    <input class="cell num" @bind="P.ValidadeDias" />
                </label>
                <label>Prazo de entrega
                    <input class="cell" placeholder="digite (ex.: 30 ou A combinar)" @bind="P.PrazoEntregaDias" />
                </label>
                <label>Segmento (margem)
                    <select class="cell" value="@P.Segmento" @onchange="MudarSegmento">
                        @foreach (var o in Axiais.Segmentos) { <option value="@o">@o</option> }
                    </select>
                </label>
                <label>Market segment
                    <select class="cell" @bind="P.MarketSegment">
                        @foreach (var o in Axiais.MarketSegments) { <option value="@o">@o</option> }
                    </select>
                </label>
                <label>Venda para
                    <select class="cell" @bind="P.VendaPara">
                        @foreach (var o in Axiais.VendasPara) { <option value="@o">@o</option> }
                    </select>
                </label>
                <label>Destino
                    <select class="cell" @bind="P.Destino">
                        @foreach (var o in Axiais.Destinos) { <option value="@o">@o</option> }
                    </select>
                </label>
                <label>Preparada por
                    <input class="cell" @bind="P.PreparadaPor" />
                </label>
                <label>Revisada por
                    <input class="cell" @bind="P.RevisadaPor" />
                </label>
                <label>Situação
                    <select class="cell" @bind="P.Status">
                        <option value="Rascunho">Rascunho</option>
                        <option value="Enviada">Enviada</option>
                        <option value="Aprovada">Aprovada</option>
                        <option value="Perdida">Perdida</option>
                    </select>
                </label>
            </div>

            <h3 class="dash-title" style="margin-top:18px">Contato que assina o documento</h3>
            <div class="form3">
                <label>Nome
                    <input class="cell" @bind="P.AssinaNome" />
                </label>
                <label>Cargo
                    <input class="cell" @bind="P.AssinaCargo" />
                </label>
                <label>E-mail
                    <input class="cell" @bind="P.AssinaEmail" />
                </label>
                <label>Telefones
                    <input class="cell" @bind="P.AssinaFones" />
                </label>
            </div>
        </div>

        @* ================== 2. MARGEM, COMISSÕES, RISCOS E IMPOSTOS ================== *@
        <div class="panel" style="margin-top:16px">
            <h3 class="dash-title">2 · Margem, comissões, riscos e impostos</h3>

            <h4 style="margin:0 0 8px; font-size:13px; color:var(--muted)">Margem e risco</h4>
            <div class="form3">
                <label>Margem alvo — Project Margin (%)
                    <input class="cell num" @bind="R.Params.MargemAlvoPct" @bind:after="MargemEditada" />
                </label>
                <label>Risco de variação (%)
                    <input class="cell num" @bind="R.Params.RiscoPct" />
                </label>
                <label>Qtd. de técnicos
                    <input class="cell num" @bind="R.Params.QtdTecnicos" />
                </label>
            </div>
            <div class="side-note" style="margin:10px 0 14px">
                A margem padrão vem do segmento (Service 50% · NB 32% · AFM 52% · Intercompany 28%)
                e pode ser alterada aqui, só para esta proposta.
            </div>

            <h4 style="margin:0 0 8px; font-size:13px; color:var(--muted)">Comissões (% sobre a venda líquida) — total @Pricing.Porcento(Pricing.ComissoesFrac(R.Params))</h4>
            <div class="form3">
                <label>PPR (%)
                    <input class="cell num" @bind="R.Params.PprPct" />
                </label>
                <label>Sales Director / ELG (%)
                    <input class="cell num" @bind="R.Params.SalesDirPct" />
                </label>
                <label>Sales Industrial (%)
                    <input class="cell num" @bind="R.Params.SalesIndPct" />
                </label>
                <label>DSR sobre comissões internas (%)
                    <input class="cell num" @bind="R.Params.DsrFatorPct" />
                </label>
                <label>Representante 1 (%)
                    <input class="cell num" @bind="R.Params.Rep1Pct" />
                </label>
                <label>Representante 2 (%)
                    <input class="cell num" @bind="R.Params.Rep2Pct" />
                </label>
            </div>
            <div class="side-note" style="margin:10px 0 14px">
                Ao escolher o representante na seção 1, a comissão dele entra sozinha —
                e continua editável aqui, sem mexer no cadastro.
            </div>

            <h4 style="margin:0 0 8px; font-size:13px; color:var(--muted)">Provisões</h4>
            <div class="form3">
                <label>Margem de negociação (%)
                    <input class="cell num" @bind="R.Params.MargemNegociacaoPct" />
                </label>
                <label>PM + SACH (%)
                    <input class="cell num" @bind="R.Params.PmSachPct" />
                </label>
                <label>Garantia do projeto (%)
                    <input class="cell num" @bind="R.Params.GarantiaProjetoPct" />
                </label>
                <label>Portal (como na planilha)
                    <select class="cell" value="@(Pricing.Num(R.Params.PortalPct) > 0 ? "Sim" : "Não")" @onchange="MudarPortal">
                        <option value="Não">Não</option>
                        <option value="Sim">Sim (0,7%)</option>
                    </select>
                </label>
                <label>Taxa adm. mostrada sobre despesas (%)
                    <input class="cell num" @bind="R.Params.TaxaAdmPct" />
                </label>
            </div>

            <h4 style="margin:14px 0 8px; font-size:13px; color:var(--muted)">
                Seguro garantia / carta de fiança
                <span class="@(Pricing.TaxaGarantia(R.Params.FiancaTipo) > 0 ? "saved-flag" : "")" style="margin-left:8px">
                    @(Pricing.TaxaGarantia(R.Params.FiancaTipo) > 0 ? "LIGADA — entra no preço" : "desligada")
                </span>
            </h4>
            <div class="form3">
                <label>Fiança / Seguro garantia?
                    <select class="cell" @bind="R.Params.FiancaTipo">
                        @foreach (var g in Pricing.GarantiaTipos)
                        {
                            <option value="@g.Nome">@g.Nome @(g.TaxaAnualPct > 0 ? $"({g.TaxaAnualPct}% a.a.)" : "")</option>
                        }
                    </select>
                </label>
                <label>% da venda coberta
                    <input class="cell num" @bind="R.Params.FiancaPctVenda" />
                </label>
                <label>Dias de cobertura (vazio = prazo de entrega)
                    <input class="cell num" placeholder="= prazo" @bind="R.Params.FiancaDias" />
                </label>
            </div>

            <h4 style="margin:14px 0 8px; font-size:13px; color:var(--muted)">Impostos do serviço</h4>
            <div class="form3">
                <label>PIS (%)
                    <input class="cell num" @bind="R.Params.PisPct" />
                </label>
                <label>COFINS (%)
                    <input class="cell num" @bind="R.Params.CofinsPct" />
                </label>
                <label>ISS (%)
                    <input class="cell num" @bind="R.Params.IssPct" />
                </label>
            </div>
            <div class="side-note" style="margin-top:12px">
                O preço é montado a partir da margem alvo: custo + risco, dividido por
                (1 − provisões − margem), e depois acrescido de PIS, COFINS e ISS.
                ISS padrão: 2% (Itatiba — HSA-SP) ou 5% (Serra — HSA-ES); em outro município, 7%.
            </div>
        </div>

        @* ================== FERRAMENTAS DE PREÇO ================== *@
        <div class="panel" style="margin-top:16px">
            <h3 class="dash-title">Ferramentas de preço</h3>
            <div style="display:flex; gap:18px 36px; flex-wrap:wrap; align-items:flex-start">
                <div>
                    <h4 style="margin:0 0 8px; font-size:13px; color:var(--muted)">Proposta anterior</h4>
                    <div style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap">
                        <label style="display:flex; flex-direction:column; gap:4px; font-size:12px; color:var(--muted)">
                            Valor anterior (R$)
                            <input class="cell num" style="width:120px" @bind="R.Params.PropAnteriorValor" />
                        </label>
                        <label style="display:flex; flex-direction:column; gap:4px; font-size:12px; color:var(--muted)">
                            % a mais
                            <input class="cell num" style="width:64px" @bind="R.Params.PropAnteriorPct" />
                        </label>
                        <button class="btn-ghost" @onclick="AcaoFecharDiaria">🔒 Fechar a diária</button>
                    </div>
                    @if (MetaAnterior > 0)
                    {
                        <div style="margin-top:6px; font-size:12.5px" class="@(FaltaParaAnterior > 0 ? "dias-vencida" : "saved-flag")">
                            Diária meta: R$ @Pricing.Moeda(MetaAnterior) · atual: R$ @Pricing.Moeda(DiariaAtual)
                            @(FaltaParaAnterior > 0 ? $"— faltam R$ {Pricing.Moeda(FaltaParaAnterior)}" : "— já supera ✓")
                        </div>
                    }
                </div>
                <div>
                    <h4 style="margin:0 0 8px; font-size:13px; color:var(--muted)">Chegar no valor (meta)</h4>
                    <div style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap">
                        <label style="display:flex; flex-direction:column; gap:4px; font-size:12px; color:var(--muted)">
                            Valor final desejado (R$)
                            <input class="cell num" style="width:130px" @bind="R.Params.MetaValor" />
                        </label>
                        <button class="btn-ghost" @onclick="AcaoFecharTotal">🔒 Fechar o valor final</button>
                    </div>
                    @if (Pricing.Num(R.Params.MetaValor) > 0)
                    {
                        <div style="margin-top:6px; font-size:12.5px" class="@(MargemDaMeta < 0 ? "dias-vencida" : "")">
                            Com essa meta a margem fica <strong>@Pricing.Porcento(MargemDaMeta)</strong>
                        </div>
                    }
                </div>
                <div>
                    <h4 style="margin:0 0 8px; font-size:13px; color:var(--muted)">Os dois ao mesmo tempo</h4>
                    <button class="btn-primary" @onclick="AcaoFecharAmbos">🔒🔒 Fechar diária + valor</button>
                    <div style="margin-top:6px; font-size:12px; color:var(--muted); max-width:220px">
                        Com os multiplicadores fixos o total acompanha a diária — se as metas não casarem, mostro o par exato.
                    </div>
                </div>
            </div>
            <div class="side-note" style="margin-top:12px">
                "Fechar a diária" crava só a diária normal — sobe por OUTROS ou, quando não há
                custo para tirar, desce pela margem (GM). "Fechar o valor final" crava só o total
                via margem. As demais linhas acompanham SEMPRE a diária normal pelos
                multiplicadores (2º turno 1,5× · sáb/dom 2× · HE semana 1,5×/h · HE sáb/dom 2×/h).
                A linha OUTROS nunca sai na proposta — é diluída nas diárias.
            </div>
        </div>

        @* ================== 3. CUSTOS: MÃO DE OBRA ================== *@
        <div class="panel" style="margin-top:16px">
            <div class="toolbar" style="justify-content:space-between">
                <h3 class="dash-title" style="margin:0">3 · Custo — mão de obra</h3>
                <label style="display:flex; align-items:center; gap:8px; font-size:13px; color:var(--muted)">
                    Hora-base 1º turno (R$)
                    <input class="cell num" style="width:90px" @bind="R.Params.HoraBase" @bind:after="AplicarBase" />
                </label>
            </div>
            <div class="side-note" style="margin-bottom:12px">
                Os valores de hora vêm do custo padrão: 2º turno e HE = 1,5× a hora-base;
                sábado/domingo/feriado = 2×. Mudou a hora-base, essas linhas acompanham —
                e qualquer valor pode ser ajustado direto na linha, só nesta proposta.
            </div>
            <table class="grid tbl-custo">
                <thead>
                    <tr>
                        <th class="col-desc">Serviço</th>
                        <th class="col-obs">Obs</th>
                        <th class="right col-num">Horas</th>
                        <th class="right col-num">Custo hora</th>
                        <th class="right col-num">Qtd. diária</th>
                        <th class="center col-flag">× técnicos</th>
                        <th class="right col-total">Custo total</th>
                        <th class="col-acao"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in R.ItensMO)
                    {
                        <tr>
                            <td><input class="cell" @bind="i.Servico" /></td>
                            <td><input class="cell" @bind="i.Obs" /></td>
                            <td><input class="cell num" @bind="i.Horas" /></td>
                            <td><input class="cell num" @bind="i.CustoHora" /></td>
                            <td><input class="cell num" @bind="i.QtdDiaria" @bind:after="SincronizarDiarias" /></td>
                            <td class="center"><input type="checkbox" @bind="i.PorTecnico" /></td>
                            <td class="right nowrap"><strong>R$ @Pricing.Moeda(Pricing.CustoMO(i, Tec))</strong></td>
                            <td class="center"><button class="btn-link" title="Remover" @onclick="() => R.ItensMO.Remove(i)">✕</button></td>
                        </tr>
                    }
                    <tr class="total">
                        <td colspan="6"><strong>TOTAL MO</strong></td>
                        <td class="right nowrap"><strong>R$ @Pricing.Moeda(Calc.TotalMO)</strong></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
            <button class="btn-ghost" style="margin-top:10px" @onclick="() => R.ItensMO.Add(new ItemMO())">+ Adicionar serviço</button>
        </div>

        @* ================== 4. CUSTOS: DESPESAS ================== *@
        <div class="panel" style="margin-top:16px">
            <h3 class="dash-title">4 · Custo — despesas</h3>
            <table class="grid tbl-custo">
                <thead>
                    <tr>
                        <th class="col-desc">Despesa</th>
                        <th class="col-obs">Obs</th>
                        <th class="right col-num">Qtd</th>
                        <th class="right col-num">Custo unitário</th>
                        <th class="center col-flag">× técnicos</th>
                        <th class="right col-total">Custo total</th>
                        <th class="col-acao"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in R.ItensDespesa)
                    {
                        <tr>
                            <td><input class="cell" @bind="d.Despesa" /></td>
                            <td><input class="cell" @bind="d.Obs" /></td>
                            <td><input class="cell num" @bind="d.Qtd" /></td>
                            <td><input class="cell num" @bind="d.CustoUnitario" /></td>
                            <td class="center"><input type="checkbox" @bind="d.PorTecnico" /></td>
                            <td class="right nowrap"><strong>R$ @Pricing.Moeda(Pricing.CustoDespesa(d, Tec))</strong></td>
                            <td class="center"><button class="btn-link" title="Remover" @onclick="() => R.ItensDespesa.Remove(d)">✕</button></td>
                        </tr>
                    }
                    <tr class="total">
                        <td colspan="5"><strong>TOTAL DESPESAS</strong></td>
                        <td class="right nowrap"><strong>R$ @Pricing.Moeda(Calc.TotalDespesas)</strong></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
            <button class="btn-ghost" style="margin-top:10px" @onclick="() => R.ItensDespesa.Add(new ItemDespesa())">+ Adicionar despesa</button>
        </div>

        @* ================== 5. COMPOSIÇÃO DO PREÇO ================== *@
        <div class="panel" style="margin-top:16px">
            <h3 class="dash-title">5 · Do custo ao preço</h3>
            <table class="grid">
                <thead>
                    <tr><th>Etapa</th><th class="right">%</th><th class="right">Valor (R$)</th></tr>
                </thead>
                <tbody>
                    <tr><td>Custo total (MO + despesas)</td><td class="right">—</td><td class="right nowrap">@Pricing.Moeda(Calc.CustoTotal)</td></tr>
                    <tr><td>Risco de variação</td><td class="right">@R.Params.RiscoPct%</td><td class="right nowrap">@Pricing.Moeda(Calc.Risco)</td></tr>
                    <tr><td>Seguro garantia / fiança (@R.Params.FiancaTipo)</td><td class="right">—</td><td class="right nowrap">@Pricing.Moeda(Calc.Fianca)</td></tr>
                    <tr><td>Comissões (PPR @R.Params.PprPct% · Sales @R.Params.SalesDirPct% · DSR · Rep @R.Params.Rep1Pct%@(Pricing.Num(R.Params.Rep2Pct) > 0 ? $" + {R.Params.Rep2Pct}%" : ""))</td><td class="right">@Pricing.Porcento(Calc.ComissoesFracTotal)</td><td class="right nowrap">@Pricing.Moeda(Calc.Comissoes)</td></tr>
                    <tr><td>Provisões (negociação + PM/SACH + garantia + portal)</td><td class="right">—</td><td class="right nowrap">@Pricing.Moeda(Calc.MargemNegociacao + Calc.PmSach + Calc.GarantiaProjeto + Calc.Portal)</td></tr>
                    <tr><td><strong>VENDA LÍQUIDA (sem impostos)</strong></td><td class="right">margem @Pricing.Porcento(Calc.ProjectMargin)</td><td class="right nowrap"><strong>@Pricing.Moeda(Calc.VendaLiquida)</strong></td></tr>
                    <tr><td>PIS + COFINS + ISS</td><td class="right">—</td><td class="right nowrap">@Pricing.Moeda(Calc.Pis + Calc.Cofins + Calc.Iss)</td></tr>
                    <tr><td><strong>PREÇO DE VENDA (com impostos)</strong></td><td class="right">fator @Calc.FatorComImpostos.ToString("0.0000")</td><td class="right nowrap"><strong>@Pricing.Moeda(Calc.ComImpostos)</strong></td></tr>
                </tbody>
            </table>
        </div>

        @* ================== 6. A PROPOSTA (itens precificados) ================== *@
        <div class="panel" style="margin-top:16px">
            <div class="toolbar" style="justify-content:space-between">
                <h3 class="dash-title" style="margin:0">6 · A proposta — como o cliente vê</h3>
                <select class="cell" style="width:auto" @bind="P.ModoApresentacao">
                    <option value="ComDespesas">Mostrar despesas (custo + taxa adm.)</option>
                    <option value="SemDespesas">Sem despesas (embutidas nas diárias)</option>
                </select>
            </div>
            @if (DocA.MO.Count == 0 && DocA.Despesas.Count == 0)
            {
                <p class="empty" style="padding:14px 0">Nenhum item com valor — lance as diárias e despesas nas seções 3 e 4.</p>
            }
            else
            {
                @if (DocA.MO.Count > 0)
                {
                    <table class="grid">
                        <thead>
                            <tr>
                                <th>Serviço</th><th>Obs</th><th class="right">Horas</th>
                                <th class="right">Valor hora</th><th class="right">Valor 1 diária</th>
                                <th class="right">Qtd. diária</th><th class="right">Valor total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in DocA.MO)
                            {
                                <tr>
                                    <td>@i.Servico</td>
                                    <td>@i.Obs</td>
                                    <td class="right">@Pricing.Moeda0(i.Horas)</td>
                                    <td class="right nowrap">@Pricing.Moeda(i.ValorHora)</td>
                                    <td class="right nowrap">@Pricing.Moeda(i.ValorDiaria)</td>
                                    <td class="right">@Pricing.Moeda0(i.QtdDiaria)</td>
                                    <td class="right nowrap"><strong>@Cifrao @Pricing.Moeda(i.ValorTotal)</strong></td>
                                </tr>
                            }
                            <tr>
                                <td colspan="6"><strong>TOTAL ASSESSORIA C/ IMPOSTOS</strong></td>
                                <td class="right nowrap"><strong>@Cifrao @Pricing.Moeda(DocA.TotalMO)</strong></td>
                            </tr>
                        </tbody>
                    </table>
                }

                @if (DocA.Deslocamento > 0)
                {
                    <div class="summary-bar" style="margin-top:12px">
                        <strong>DESPESAS DE DESLOCAMENTO</strong> (táxi + passagem aérea: custo + taxa adm.; a diferença fica nas diárias):
                        <strong>@Cifrao @Pricing.Moeda(DocA.Deslocamento)</strong> — linha própria abaixo do total no documento.
                    </div>
                }
                @if (DocA.Despesas.Count > 0)
                {
                    <table class="grid" style="margin-top:12px">
                        <thead>
                            <tr>
                                <th>Despesa</th><th>Obs</th><th class="right">Qtd</th>
                                <th class="right">Valor unitário</th><th class="right">Valor total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in DocA.Despesas)
                            {
                                <tr>
                                    <td>@d.Despesa</td>
                                    <td>@d.Obs</td>
                                    <td class="right">@Pricing.Moeda0(d.Qtd)</td>
                                    <td class="right nowrap">@Pricing.Moeda(d.ValorUnitario)</td>
                                    <td class="right nowrap"><strong>@Cifrao @Pricing.Moeda(d.ValorTotal)</strong></td>
                                </tr>
                            }
                            <tr>
                                <td colspan="4"><strong>TOTAL DESPESAS C/ IMPOSTOS</strong></td>
                                <td class="right nowrap"><strong>@Cifrao @Pricing.Moeda(DocA.TotalDespesas)</strong></td>
                            </tr>
                        </tbody>
                    </table>
                }

            }
        </div>
    </div>

    @* ================== RESUMO LATERAL (sempre visível) ================== *@
    <div class="prop-side">
        <div class="side-total">
            <div class="kpi-label" style="color:#cfe3f7">Total da proposta (c/ impostos)</div>
            <div class="side-total-value">@Cifrao @Pricing.Moeda(DocA.Total)</div>
        </div>

        <div class="panel" style="padding:14px">
            @{ var resumoSide = Pricing.ResumoDoTotal(DocA); var semImp = Calc.Pis + Calc.Cofins + Calc.Iss <= 0.005; }
            <div class="side-item"><span>Custo total</span><strong>@Cifrao @Pricing.Moeda(Calc.CustoTotal)</strong></div>
            @if (!semImp)
            {
                <div class="side-item"><span>Valor sem impostos</span><strong>@Cifrao @Pricing.Moeda(resumoSide.SemImpostos)</strong></div>
                <div class="side-item"><span>Valor c/ PIS e COFINS</span><strong>@Cifrao @Pricing.Moeda(resumoSide.ComPisCofins)</strong></div>
            }
            <div class="side-item side-item-total"><span>@(semImp ? "Valor total (líquido)" : "Valor c/ PIS, COFINS e ISS")</span><strong>@Cifrao @Pricing.Moeda(DocA.Total)</strong></div>
        </div>

        <div class="side-note">
            ✦ Margem do projeto: <strong>@Pricing.Porcento(Calc.ProjectMargin)</strong> ·
            markup @Calc.Markup.ToString("0.0000") · fator @Calc.FatorComImpostos.ToString("0.0000")
        </div>

        @if (_erro is not null)
        {
            <div class="alert-error">@_erro</div>
        }
        @if (_msg is not null)
        {
            <div class="side-ok">@_msg</div>
        }

        <button class="btn-accent btn-block" @onclick="Cadastrar">🗄 Cadastrar no banco de dados</button>
        <div class="side-caption">Salva em Banco de Dados › Propostas Enviadas</div>
        <button class="btn-primary btn-block" @onclick="Imprimir">🖨 Gerar proposta (PDF)</button>
        <button class="btn-ghost btn-block" @onclick="GerarWord">📄 Gerar proposta (Word)</button>
        <button class="btn-ghost btn-block" @onclick="GerarExcel">📊 Gerar Excel (registro p/ pasta)</button>
        <a class="btn-ghost btn-block" href="@Axiais.MailtoEnvio(P, DocA, Cfg)">✉ E-mail de envio ao cliente</a>
        <a class="btn-ghost btn-block" href="@Axiais.MailtoAprovacao(P, Doc, Cfg)">✅ E-mail de aprovação (interno)</a>
        <div class="side-caption">Os e-mails abrem já preenchidos no seu cliente de e-mail — anexe o PDF/Word gerado.</div>
    </div>
</div>

</div>

<div class="proposal-doc">@((MarkupString)Axiais.DocBody(P, DocA, _logo, Faturamento(), RepInfo(), Axiais.NotasHtml(P, R.ItensMO, R.ItensDespesa, R.Params, DocA)))</div>

@code {
    [SupplyParameterFromQuery(Name = "id")] public string? PropostaId { get; set; }

    private string? _msg, _erro, _logo;
    private List<BillingInfo> _faturamentos = new();
    private List<Representante> _reps = new();

    private Proposta P => R.Proposta;
    private Pricing.Documento Doc => R.Documento();
    private Pricing.Documento DocA =>
        Pricing.Apresentar(Doc, P.ModoApresentacao, Pricing.Num(R.Params.TaxaAdmPct),
            Pricing.Num(R.Params.DiariaTravada), Pricing.Num(R.Params.TotalTravado));
    private Pricing.Resultado Calc => R.Calculo();
    private string Cifrao => Axiais.Simbolo(P.Moeda);
    private int Tec => Math.Max(Pricing.Inteiro(R.Params.QtdTecnicos), 1);

    private DateTime DataProposta
    {
        get => DateTime.TryParse(P.Data, out var d) ? d : DateTime.Today;
        set => P.Data = value.ToString("yyyy-MM-dd");
    }

    private BillingInfo Faturamento() =>
        _faturamentos.FirstOrDefault(x => x.Id == P.Bu && !string.IsNullOrWhiteSpace(x.Razao))
        ?? Axiais.FaturamentoPadrao(P.Bu);

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _logo = Branding.GetLogo();
        _faturamentos = Faturamentos.All();
        _reps = Representantes.All();

        if (!string.IsNullOrWhiteSpace(PropostaId))
        {
            var salva = Propostas.All().FirstOrDefault(x => x.Id == PropostaId);
            if (salva is null) _erro = "Proposta não encontrada no banco de dados.";
            else
            {
                R.Carregar(salva);
                _msg = $"Proposta {Axiais.NumeroCompleto(salva)} carregada para edição.";
            }
        }
    }

    private void AcaoFecharDiaria() { _erro = null; _msg = FecharDiaria(); }
    private void AcaoFecharTotal() { _erro = null; _msg = FecharTotal(); }
    private void AcaoFecharAmbos() { _erro = null; _msg = FecharAmbos(); }

    private async Task Zerar()
    {
        await NovaProposta();
        _msg = "Proposta nova — itens recarregados da Tabela de Custos.";
        _erro = null;
        if (string.IsNullOrWhiteSpace(P.PreparadaPor)) P.PreparadaPor = Usuario;
    }

    private void MudarBu(ChangeEventArgs e) => AplicarBu(e.Value?.ToString() ?? P.Bu);

    // Portal como na planilha (P4): Sim = 0,7% sobre a venda, Não = 0.
    private void MudarPortal(ChangeEventArgs e) =>
        R.Params.PortalPct = e.Value?.ToString() == "Sim" ? "0.7" : "0";

    private void MudarSegmento(ChangeEventArgs e)
    {
        P.Segmento = e.Value?.ToString() ?? P.Segmento;
        R.Params.MargemAlvoPct = Axiais.MargemPadrao(P.Segmento, Cfg);
    }

    // Escolheu o representante → a comissão do cadastro entra sozinha (e segue editável).
    private void MudarRep(ChangeEventArgs e, int qual)
    {
        var nome = e.Value?.ToString() ?? "-";
        var rep = _reps.FirstOrDefault(x => x.Nome == nome);
        if (qual == 1)
        {
            P.Representante = nome;
            R.Params.Rep1Pct = rep?.ComissaoPct ?? "0";
        }
        else
        {
            P.Representante2 = nome;
            R.Params.Rep2Pct = rep?.ComissaoPct ?? "0";
        }
    }

    private void AplicarBase() => R.AplicarHoraBase();

    // Contato do representante impresso no documento (linha abaixo do cadastro do cliente).
    private string? RepInfo()
    {
        var partes = new[] { P.Representante, P.Representante2 }
            .Where(n => n is not ("" or "-"))
            .Select(n => _reps.FirstOrDefault(x => x.Nome == n)?.Contato ?? "")
            .Where(c => c != "");
        var txt = string.Join(" · ", partes);
        return txt == "" ? null : txt;
    }

    private void Cadastrar()
    {
        _erro = null; _msg = null;
        if (string.IsNullOrWhiteSpace(P.Cliente)) { _erro = "Informe o cliente antes de cadastrar."; return; }
        if (Doc.MO.Count == 0 && Doc.Despesas.Count == 0) { _erro = "A proposta não tem nenhum item com valor."; return; }

        var virouNova = NovoCadastroSeMudouNumeroOuRevisao(Propostas.All());
        if (string.IsNullOrWhiteSpace(P.Id)) P.Id = Axiais.NovoIdProposta();
        if (string.IsNullOrWhiteSpace(P.Numero))
            P.Numero = $"SRV-{P.Ano}-{Propostas.All().Count + 1:D3}";
        if (string.IsNullOrWhiteSpace(P.CriadaEm))
            P.CriadaEm = DateTime.Now.ToString("yyyy-MM-dd HH:mm");
        if (string.IsNullOrWhiteSpace(P.Status)) P.Status = "Rascunho";

        Propostas.Save(R.ParaGravar());
        _msg = virouNova
            ? $"Número/revisão mudou → cadastro NOVO criado ({Axiais.NumeroCompleto(P)}). O registro antigo continua no banco."
            : $"Proposta {P.Numero} cadastrada no banco de dados.";
    }

    private async Task Imprimir() => await JS.InvokeVoidAsync("appPrint");

    private async Task GerarWord()
    {
        var html = Axiais.DocHtml(P, DocA, _logo, Faturamento(), RepInfo(), Axiais.NotasHtml(P, R.ItensMO, R.ItensDespesa, R.Params, DocA));
        var b64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(html));
        var prefixo = P.Idioma switch { "English" => "Quote", "Español" => "Propuesta", _ => "Proposta" };
        var nome = $"{prefixo}-{(string.IsNullOrWhiteSpace(P.Numero) ? "rascunho" : P.Numero)}.doc";
        await JS.InvokeVoidAsync("appDownload", nome, "application/msword", b64);
    }

    private async Task GerarExcel()
    {
        try
        {
            var bytes = PlanilhaExport.Gerar(P, R.ItensMO, R.ItensDespesa, R.Params, DocA);
            var nome = $"{(string.IsNullOrWhiteSpace(P.Numero) ? "Proposta-rascunho" : Axiais.NumeroCompleto(P))} - {P.Cliente}.xlsm".Trim(' ', '-');
            await JS.InvokeVoidAsync("appDownload", nome,
                "application/vnd.ms-excel.sheet.macroEnabled.12",
                Convert.ToBase64String(bytes));
            _erro = null;
        }
        catch (Exception ex)
        {
            _erro = "Não consegui gerar a planilha: " + ex.Message;
        }
    }
}
