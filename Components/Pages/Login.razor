@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]

<div class="login2">
    <div class="login2-left">
        <div class="login2-top">
            <div class="login2-logo">
                <div class="login2-logo-fallback">Howden<small>A Chart Industries Company</small></div>
            </div>
            <div class="login2-tag">Enterprise Platform · Ventiladores Axiais</div>
        </div>

        <div class="login2-body">
            <div class="login2-overline">Ventiladores Axiais</div>
            <h1 class="login2-title">A base de ventiladores em <em>um lugar só</em></h1>
            <p class="login2-desc">
                A planilha da equipe vira uma base compartilhada: sobe uma vez, fica na
                pasta da rede e todo mundo trabalha sobre a mesma informação.
            </p>
            <ul class="login2-list">
                <li>Subir a planilha em .xlsx, .xlsm ou .csv</li>
                <li>Ajustar as linhas direto na tela, com gravação automática</li>
                <li>Procurar em todas as colunas</li>
                <li>Exportar a base em Excel ou CSV quando precisar</li>
            </ul>
            <div class="login2-chips">
                <span class="login2-chip">Base</span>
                <span class="login2-chip">Planilha</span>
                <span class="login2-chip">Exportação</span>
            </div>
        </div>
    </div>

    <div class="login2-right">
        <div class="login2-card">
            <div class="login2-overline">Ventiladores Axiais</div>
            <h2>Acesso ao ambiente corporativo</h2>
            <p class="login2-sub">
                Entre para consultar e ajustar a base de ventiladores axiais da equipe.
            </p>

            @if (Error)
            {
                <div class="login2-err">Usuário ou senha inválidos.</div>
            }

            <form method="post" action="/auth/login">
                <label for="usuario">Usuário</label>
                <input type="text" id="usuario" name="usuario" placeholder="usuario@howden.com" autocomplete="username" required />
                <label for="senha">Senha</label>
                <input type="password" id="senha" name="senha" placeholder="••••••••" autocomplete="current-password" required />
                <button type="submit" class="login2-btn">Acessar plataforma →</button>
            </form>

            <div class="login2-note">
                <span>🔒</span>
                <span>Ambiente corporativo seguro · Acesso exclusivo para usuários autorizados</span>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorFlag { get; set; }

    private bool Error => ErrorFlag == "1";
}
