@page "/axiais/configuracoes"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ConfigRepository Repo

<div class="page-head">
    <div>
        <h1>E-mails e Padrões</h1>
        <p class="subtitle">
            Personalize os textos dos e-mails e os valores que já vêm preenchidos numa
            proposta nova. Campo em branco = usa o padrão de fábrica. Tudo salva sozinho.
        </p>
    </div>
    <div class="page-actions">
        @if (_salvo)
        {
            <span class="saved-flag">Salvo ✓</span>
        }
    </div>
</div>

<div class="panel" style="max-width:1080px">
    <h3 class="dash-title">Padrões da proposta nova</h3>
    <div class="side-note" style="margin-bottom:12px">
        Aplicados ao clicar em "Nova proposta". A proposta em andamento não muda.
    </div>
    <div class="form3">
        <label>BU emissora
            <select class="cell" value="@V("padrao.bu", "HSA-SP")" @onchange='e => Set("padrao.bu", e)'>
                @foreach (var o in Axiais.Bus) { <option value="@o">@o</option> }
            </select>
        </label>
        <label>Estado
            <select class="cell" value="@V("padrao.estado", "SP")" @onchange='e => Set("padrao.estado", e)'>
                @foreach (var o in Axiais.Estados) { <option value="@o">@o</option> }
            </select>
        </label>
        <label>Segmento (margem)
            <select class="cell" value="@V("padrao.segmento", "Service")" @onchange='e => Set("padrao.segmento", e)'>
                @foreach (var o in Axiais.Segmentos) { <option value="@o">@o</option> }
            </select>
        </label>
        <label>Idioma
            <select class="cell" value="@V("padrao.idioma", "Português")" @onchange='e => Set("padrao.idioma", e)'>
                @foreach (var o in Axiais.Idiomas) { <option value="@o">@o</option> }
            </select>
        </label>
        <label>Moeda
            <select class="cell" value="@V("padrao.moeda", "BRL")" @onchange='e => Set("padrao.moeda", e)'>
                @foreach (var o in Axiais.Moedas) { <option value="@o">@o</option> }
            </select>
        </label>
        <label>Modo de apresentação
            <select class="cell" value="@V("padrao.modo", "ComDespesas")" @onchange='e => Set("padrao.modo", e)'>
                <option value="ComDespesas">Mostrar despesas (custo + taxa adm.)</option>
                <option value="SemDespesas">Sem despesas (embutidas nas diárias)</option>
            </select>
        </label>
        <label>Validade (dias)
            <input class="cell num" value="@V("padrao.validade", "30")" @onchange='e => Set("padrao.validade", e)' />
        </label>
        <label>Prazo de entrega
            <input class="cell num" placeholder="em branco = digitar na proposta"
                   value="@V("padrao.prazo", "")" @onchange='e => Set("padrao.prazo", e)' />
        </label>
        <label>Taxa administrativa (%)
            <input class="cell num" value="@V("padrao.taxaAdm", "40")" @onchange='e => Set("padrao.taxaAdm", e)' />
        </label>
        <label>Risco de variação (%)
            <input class="cell num" value="@V("padrao.risco", "5")" @onchange='e => Set("padrao.risco", e)' />
        </label>
        <label>Fiança / Seguro garantia
            <select class="cell" value="@V("padrao.fiancaTipo", "HSA C. Fiança (Banco)")" @onchange='e => Set("padrao.fiancaTipo", e)'>
                @foreach (var g in Pricing.GarantiaTipos) { <option value="@g.Nome">@g.Nome</option> }
            </select>
        </label>
        <label>Fiança — % da venda coberta
            <input class="cell num" value="@V("padrao.fiancaPct", "30")" @onchange='e => Set("padrao.fiancaPct", e)' />
        </label>
        <label>% a mais sobre a proposta anterior
            <input class="cell num" value="@V("padrao.percAMais", "5")" @onchange='e => Set("padrao.percAMais", e)' />
        </label>
    </div>

    <h4 style="margin:16px 0 8px; font-size:13px; color:var(--muted)">Margem padrão por segmento (%)</h4>
    <div class="form3">
        <label>Service
            <input class="cell num" value="@V("margem.Service", "50")" @onchange='e => Set("margem.Service", e)' />
        </label>
        <label>NB
            <input class="cell num" value="@V("margem.NB", "32")" @onchange='e => Set("margem.NB", e)' />
        </label>
        <label>AFM
            <input class="cell num" value="@V("margem.AFM", "52")" @onchange='e => Set("margem.AFM", e)' />
        </label>
        <label>Intercompany
            <input class="cell num" value="@V("margem.Intercompany", "28")" @onchange='e => Set("margem.Intercompany", e)' />
        </label>
    </div>
</div>

<div class="panel" style="max-width:1080px; margin-top:16px">
    <h3 class="dash-title">Modelos de e-mail</h3>
    <div class="side-note" style="margin-bottom:12px">
        Variáveis que são trocadas na hora do envio: <code>{numero}</code> <code>{rev}</code>
        <code>{cliente}</code> <code>{cidade}</code> <code>{contato}</code> <code>{referencia}</code>
        <code>{bu}</code> <code>{total}</code> <code>{validade}</code> <code>{prazo}</code>
        <code>{preparada_por}</code> — e no de aprovação também <code>{custo_total}</code>
        <code>{custo_riscos}</code> <code>{venda_liquida}</code> <code>{valor_impostos}</code>
        <code>{pm}</code> <code>{cm}</code> <code>{markup}</code>.
        Apague o texto para voltar ao padrão de fábrica.
    </div>

    @foreach (var (titulo, chave, padrao) in Emails())
    {
        <h4 style="margin:14px 0 6px; font-size:13px; color:var(--muted)">@titulo</h4>
        <div style="display:grid; gap:8px">
            <input class="cell" placeholder="Assunto — padrão: @padrao.Assunto"
                   value="@V($"{chave}.assunto", "")" @onchange='e => Set($"{chave}.assunto", e)' />
            <textarea class="cell" rows="6" style="font-family:inherit; resize:vertical"
                      placeholder="@padrao.Corpo"
                      value="@V($"{chave}.corpo", "")" @onchange='e => Set($"{chave}.corpo", e)'></textarea>
        </div>
    }

    <h4 style="margin:14px 0 6px; font-size:13px; color:var(--muted)">E-mail de aprovação — destinatário</h4>
    <input class="cell" style="max-width:420px" placeholder="ex.: gerente@chartindustries.com (vazio = escolher na hora)"
           value="@V("email.aprovacao.para", "")" @onchange='e => Set("email.aprovacao.para", e)' />
</div>

@code {
    private Dictionary<string, string> _cfg = new();
    private bool _salvo;

    protected override void OnInitialized() => _cfg = Repo.All();

    private string V(string chave, string padrao) =>
        _cfg.TryGetValue(chave, out var v) && !string.IsNullOrWhiteSpace(v) ? v : padrao;

    private void Set(string chave, ChangeEventArgs e)
    {
        var valor = e.Value?.ToString() ?? "";
        Repo.Set(chave, valor);
        if (string.IsNullOrWhiteSpace(valor)) _cfg.Remove(chave); else _cfg[chave] = valor;
        _salvo = true;
    }

    private IEnumerable<(string Titulo, string Chave, (string Assunto, string Corpo) Padrao)> Emails()
    {
        yield return ("E-mail de envio — Português", "email.envio.pt", Axiais.ModeloEnvioPadrao("Português"));
        yield return ("E-mail de envio — Inglês", "email.envio.en", Axiais.ModeloEnvioPadrao("English"));
        yield return ("E-mail de envio — Espanhol", "email.envio.es", Axiais.ModeloEnvioPadrao("Español"));
        yield return ("E-mail de aprovação (interno)", "email.aprovacao", Axiais.ModeloAprovacaoPadrao());
    }
}
