<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="app.css?v=@Versao" />
    <title>Howden Ventiladores Axiais</title>
    <HeadOutlet />
</head>

<body>
    @* o menu recolhido antes do primeiro desenho, sem piscar aberto no notebook:
       a mesma regra do appMenu (app.js), que só carrega no fim da página *@
    <script>try { var m = localStorage.getItem('axiais.pref.menuRecolhido'); if (m === 'sim' || (m !== 'nao' && window.innerWidth < 1400)) document.body.classList.add('menu-recolhido'); } catch (e) { }</script>
    <Routes />
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script src="app.js?v=@Versao"></script>
</body>

</html>

@code {
    // Carimbo de versão: muda a cada build, então o navegador nunca fica com
    // CSS/JS antigo em cache depois de uma atualização do sistema.
    private static readonly string Versao =
        System.IO.File.GetLastWriteTimeUtc(typeof(App).Assembly.Location).Ticks.ToString();
}
