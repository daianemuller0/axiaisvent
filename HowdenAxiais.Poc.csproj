<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HowdenAxiais.Poc</RootNamespace>
    <!-- Os projetos desktop e launcher moram em subpastas deste repositório —
         não fazem parte deste projeto web. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);desktop/**;launcher/**;out/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provider ADO.NET do DuckDB (inclui a lib nativa) — mesmo padrão do projeto Licenças. -->
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.1.3" />
    <!-- Leitura e geração das planilhas da aba Base (.xlsx/.xlsm) -->
    <PackageReference Include="ClosedXML" Version="0.102.2" />
    <!-- Geração da proposta comercial em Word. A versão é a que o ClosedXML aceita
         (ele exige <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />lt; 3.0.0), para as duas bibliotecas conviverem. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="2.20.0" />
    <!-- Converte a página do PDF da curva em imagem, para colar no documento.
         Leva um componente nativo (PDFium); o publicar.ps1 já publica
         self-contained para win-x64, então ele vai junto. -->
    <PackageReference Include="PDFtoImage" Version="4.1.1" />
  </ItemGroup>

</Project>
